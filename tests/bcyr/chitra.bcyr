# tests/bcyr/chitra.bcyr — chitra decode benchmarks.
#
# Usage: cyrius bench tests/bcyr/chitra.bcyr   (= `make bench`)
#
# WHAT THIS MEASURES, AND WHY IT BUILDS ITS OWN FIXTURES
#
# chitra's in-tree TEST fixtures are 2x2 to 16x16 — deliberately tiny, because
# a test wants a known-answer, not a workload. Benchmarking those would report
# almost pure fixed overhead (allocation, header parse, table setup) and tell
# you nothing about decode THROUGHPUT, which is what a consumer loading a
# texture actually cares about.
#
# So this harness GENERATES its fixtures at run time, at realistic sizes:
#   - PNG  — real scanlines run through sankoch's `zlib_compress`, so the
#            decode side exercises the genuine inflate + unfilter path, not a
#            stored-block shortcut. Adam7 fixtures are interleaved using
#            chitra's OWN pass-geometry helpers (`_adam7_xs` / `_ys` /
#            `_xstep` / `_ystep`), so encoder and decoder cannot disagree
#            about the layout.
#   - JPEG — assembled with an in-harness MSB-first bit writer (0xFF stuffing
#            included) over the Annex K DC luminance table plus a compact AC
#            table, emitting real DC + AC coefficients per block.
#   - BMP  — the plain path has no compression, so the generator is just
#            header + palette + bottom-up rows; the RLE8 fixture is
#            run-length encoded in-harness so the decode side walks real
#            opcodes rather than a stored run.
#   - GIF  — the only format needing a real encoder on the fixture side:
#            the harness LZW-compresses the index plane so the decode side
#            exercises the genuine dictionary build, not a clear-code
#            passthrough.
#
# Every generated fixture is DECODE-VERIFIED before it is timed (see
# `_verify`). A benchmark that silently measures a rejected input is worse
# than no benchmark: it reports the cost of the error path and calls it
# throughput.
#
# Reported per benchmark: total/avg/min/max via `bench_report`, plus a
# `CSV:<name>,<min_ns>` line for bench-history.csv, and a ns/pixel figure so
# results stay comparable across image sizes.

include "src/lib.cyr"

# ================================================================
# CSV row for bench-history.csv (schema: timestamp,commit,branch,
# benchmark,estimate_ns — this emits the last two; scripts/bench-csv.sh
# prepends the rest).
# ================================================================
fn _csv_row(b): i64 {
    var name = bench_name(b);
    syscall(1, 1, "CSV:", 4);
    syscall(1, 1, name, strlen(name));
    syscall(1, 1, ",", 1);
    fmt_int(bench_min_ns(b));
    syscall(1, 1, "\n", 1);
    return 0;
}

# Throughput line: ns per pixel at the observed minimum.
fn _per_pixel(b, npix): i64 {
    syscall(1, 1, "    ", 4);
    fmt_int(bench_min_ns(b) / npix);
    syscall(1, 1, " ns/px over ", 12);
    fmt_int(npix);
    syscall(1, 1, " px\n", 4);
    return 0;
}

# ================================================================
# PNG generation — real scanlines, real DEFLATE.
# ================================================================
var PNG_SIG_0 = 137;

fn _put_u32be(p, v): i64 {
    store8(p + 0, (v / 16777216) & 255);
    store8(p + 1, (v / 65536) & 255);
    store8(p + 2, (v / 256) & 255);
    store8(p + 3, v & 255);
    return 0;
}

# Append a chunk (len + type + data + CRC32) at `p`; returns the new cursor.
fn _put_chunk(p, t0, t1, t2, t3, data, dlen): i64 {
    _put_u32be(p, dlen);
    store8(p + 4, t0);
    store8(p + 5, t1);
    store8(p + 6, t2);
    store8(p + 7, t3);
    var i = 0;
    while (i < dlen) { store8(p + 8 + i, load8(data + i)); i = i + 1; }
    var c = crc32(p + 4, 4 + dlen);
    _put_u32be(p + 8 + dlen, c & 4294967295);
    return p + 12 + dlen;
}

# Deterministic sample value — a diagonal gradient plus a low-amplitude ripple.
# Compressible (like real imagery) but not degenerate: a constant image would
# make DEFLATE trivial and the unfilter path unrealistically cache-friendly.
fn _sample(x, y, c): i64 {
    return (x + y * 3 + c * 40 + ((x * y) / 16)) & 255;
}

# Build a PNG. `ct` is the PNG color type (0/2/3/6), `depth` 8 or 16,
# `interlace` 0 or 1. Returns the buffer; sets *len_out.
#
# Palette (ct 3) emits a 256-entry PLTE and uses the sample value directly as
# the index, so the color pass does a real per-pixel palette lookup.
fn _mk_png(w, h, ct, depth, interlace, len_out): i64 {
    var chans = 1;
    if (ct == 2) { chans = 3; }
    if (ct == 6) { chans = 4; }
    var bypp = chans * (depth / 8);
    if (ct == 3) { bypp = 1; }
    var row_bytes = w * bypp;

    # ---- raw (filtered) scanlines: filter byte 0 + row data --------------
    # Interlaced streams are the 7 Adam7 passes concatenated, each with its
    # own filter byte per row. Pass geometry comes from chitra's own helpers.
    var raw_cap = (h + 8) * (row_bytes + 1) + 4096;
    var raw = alloc(raw_cap);
    var off = 0;
    var x = 0;
    var y = 0;
    var c = 0;
    var s = 0;
    if (interlace == 0) {
        y = 0;
        while (y < h) {
            store8(raw + off, 0);
            off = off + 1;
            x = 0;
            while (x < w) {
                c = 0;
                while (c < chans) {
                    s = _sample(x, y, c);
                    if (depth == 16) {
                        store8(raw + off, s);
                        store8(raw + off + 1, (s * 7) & 255);
                        off = off + 2;
                    } else {
                        store8(raw + off, s);
                        off = off + 1;
                    }
                    c = c + 1;
                }
                x = x + 1;
            }
            y = y + 1;
        }
    } else {
        var p = 0;
        while (p < 7) {
            var xs = _adam7_xs(p);
            var ys = _adam7_ys(p);
            var xstep = _adam7_xstep(p);
            var ystep = _adam7_ystep(p);
            var pw = _adam7_count(w, xs, xstep);
            var ph = _adam7_count(h, ys, ystep);
            if (pw > 0 && ph > 0) {
                var py = 0;
                while (py < ph) {
                    store8(raw + off, 0);
                    off = off + 1;
                    var px = 0;
                    while (px < pw) {
                        c = 0;
                        while (c < chans) {
                            s = _sample(xs + px * xstep, ys + py * ystep, c);
                            if (depth == 16) {
                                store8(raw + off, s);
                                store8(raw + off + 1, (s * 7) & 255);
                                off = off + 2;
                            } else {
                                store8(raw + off, s);
                                off = off + 1;
                            }
                            c = c + 1;
                        }
                        px = px + 1;
                    }
                    py = py + 1;
                }
            }
            p = p + 1;
        }
    }

    # ---- real DEFLATE -----------------------------------------------------
    var zcap = off + (off / 2) + 4096;
    var z = alloc(zcap);
    var zlen = zlib_compress(raw, off, z, zcap);

    # ---- assemble ---------------------------------------------------------
    var out = alloc(zlen + 4096);
    store8(out + 0, 137); store8(out + 1, 80);  store8(out + 2, 78);  store8(out + 3, 71);
    store8(out + 4, 13);  store8(out + 5, 10);  store8(out + 6, 26);  store8(out + 7, 10);
    var cur = out + 8;

    var ihdr[13];
    _put_u32be(&ihdr + 0, w);
    _put_u32be(&ihdr + 4, h);
    store8(&ihdr + 8, depth);
    store8(&ihdr + 9, ct);
    store8(&ihdr + 10, 0);
    store8(&ihdr + 11, 0);
    store8(&ihdr + 12, interlace);
    cur = _put_chunk(cur, 0x49, 0x48, 0x44, 0x52, &ihdr, 13);

    if (ct == 3) {
        var plte = alloc(768);
        var e = 0;
        while (e < 256) {
            store8(plte + e * 3 + 0, e);
            store8(plte + e * 3 + 1, (e * 3) & 255);
            store8(plte + e * 3 + 2, (e * 7) & 255);
            e = e + 1;
        }
        cur = _put_chunk(cur, 0x50, 0x4C, 0x54, 0x45, plte, 768);
    }

    cur = _put_chunk(cur, 0x49, 0x44, 0x41, 0x54, z, zlen);
    cur = _put_chunk(cur, 0x49, 0x45, 0x4E, 0x44, out, 0);
    store64(len_out, cur - out);
    return out;
}

# ================================================================
# Fixture verification. A benchmark that times a REJECTED input is
# measuring the error path and calling it throughput, so every generated
# fixture is decoded and spot-checked against the generator before it is
# timed. Any mismatch aborts the run loudly rather than reporting a number.
# ================================================================
var _verify_fail = 0;

fn _fail(label): i64 {
    _verify_fail = 1;
    syscall(1, 2, "  VERIFY FAIL: ", 15);
    syscall(1, 2, label, strlen(label));
    syscall(1, 2, "\n", 1);
    return 0;
}

# The 8-bit value a generated sample decodes to. At depth 8 that is the sample
# itself; at depth 16 the generator writes high byte `s` and low byte
# `(s * 7) & 255`, and chitra RESCALES the pair per PNG § 13.13 rather than
# keeping the high byte (0.7.1).
#
# This helper exists because the verifier used to expect `s` outright, which
# was the truncation rule restated — the harness was checking chitra against
# chitra, exactly as the depth-16 test cells were. It caught the 0.7.1 change
# and aborted the run, which is the harness working: a benchmark whose fixture
# decodes wrongly is timing the wrong thing.
fn _expect8(s, depth): i64 {
    if (depth == 8) { return s; }
    var v = s * 256 + ((s * 7) & 255);
    return (v * 255 + 32767) / 65535;
}

fn _verify_png(bytes, len, w, h, ct, depth, label): i64 {
    var err = 0;
    var img = chitra_png_decode(bytes, len, &err);
    if (img == 0) { _fail(label); return 0; }
    if (chitra_image_width(img) != w) { _fail(label); return 0; }
    if (chitra_image_height(img) != h) { _fail(label); return 0; }
    var px = chitra_image_pixels(img);
    # spot-check three interior pixels against the generator
    var probes[24];        # 3 x i64 — BYTES, not entries
    store64(&probes + 0, 0);
    store64(&probes + 8, (h / 2) * w + (w / 2));
    store64(&probes + 16, w * h - 1);
    var pi = 0;
    while (pi < 3) {
        var idx = load64(&probes + pi * 8);
        var x = idx % w;
        var y = idx / w;
        var o = px + idx * 4;
        var s0 = _sample(x, y, 0);
        if (ct == 0) {
            if (load8(o + 0) != _expect8(s0, depth)) { _fail(label); return 0; }
            if (load8(o + 3) != 255) { _fail(label); return 0; }
        }
        if (ct == 2) {
            if (load8(o + 0) != _expect8(s0, depth)) { _fail(label); return 0; }
            if (load8(o + 1) != _expect8(_sample(x, y, 1), depth)) { _fail(label); return 0; }
            if (load8(o + 2) != _expect8(_sample(x, y, 2), depth)) { _fail(label); return 0; }
        }
        if (ct == 6) {
            if (load8(o + 0) != _expect8(s0, depth)) { _fail(label); return 0; }
            if (load8(o + 3) != _expect8(_sample(x, y, 3), depth)) { _fail(label); return 0; }
        }
        if (ct == 3) {
            # Palette indices are 8-bit whatever the sample depth, and the PLTE
            # entries are bytes — no rescale applies on this path.
            if (load8(o + 0) != s0) { _fail(label); return 0; }
            if (load8(o + 1) != ((s0 * 3) & 255)) { _fail(label); return 0; }
            if (load8(o + 2) != ((s0 * 7) & 255)) { _fail(label); return 0; }
        }
        pi = pi + 1;
    }
    return 1;
}

# ================================================================
# JPEG generation — a real entropy-coded baseline scan.
#
# There is no JPEG encoder in the dependency set, so this harness writes the
# scan itself: an MSB-first bit writer (with the mandatory 0xFF byte
# stuffing), the Annex K.3.1 DC luminance table, and a compact 2-symbol AC
# table. Each 8x8 block emits a DC coefficient plus three 4-bit AC
# coefficients and an EOB, so the decode side runs the genuine
# DECODE / RECEIVE / EXTEND path per block rather than skipping straight to
# EOB on an all-zero scan.
# ================================================================

# Bit-writer state (32 bytes): +0 buf, +8 pos, +16 accumulator, +24 bit count.
fn _bw_init(st, buf): i64 {
    store64(st + 0, buf);
    store64(st + 8, 0);
    store64(st + 16, 0);
    store64(st + 24, 0);
    return 0;
}

fn _bw_put(st, value, nbits): i64 {
    var i = nbits - 1;
    var bit = 0;
    var acc = 0;
    var n = 0;
    var buf = 0;
    var pos = 0;
    while (i >= 0) {
        bit = (value / (1 << i)) & 1;
        acc = load64(st + 16) * 2 + bit;
        n = load64(st + 24) + 1;
        store64(st + 16, acc);
        store64(st + 24, n);
        if (n == 8) {
            buf = load64(st + 0);
            pos = load64(st + 8);
            store8(buf + pos, acc & 255);
            pos = pos + 1;
            # T.81 § B.1.1.5: a 0xFF data byte must be followed by 0x00 so it
            # is not mistaken for a marker.
            if ((acc & 255) == 255) {
                store8(buf + pos, 0);
                pos = pos + 1;
            }
            store64(st + 8, pos);
            store64(st + 16, 0);
            store64(st + 24, 0);
        }
        i = i - 1;
    }
    return 0;
}

# Pad to a byte boundary with 1-bits (T.81 § F.1.2.3); returns bytes written.
fn _bw_flush(st): i64 {
    var n = load64(st + 24);
    if (n > 0) { _bw_put(st, (1 << (8 - n)) - 1, 8 - n); }
    return load64(st + 8);
}

# One block: DC category 0 (code "00"), three AC coefficients via the
# 2-symbol AC table (symbol 0x04 = run 0, size 4 -> code "01" + 4 magnitude
# bits), then EOB (code "00").
fn _emit_block(st, seed): i64 {
    _bw_put(st, 0, 2);                          # DC: category 0, no extra bits
    var k = 0;
    while (k < 3) {
        _bw_put(st, 1, 2);                      # AC symbol 0x04
        _bw_put(st, (seed + k * 5) & 15, 4);    # 4-bit magnitude
        k = k + 1;
    }
    _bw_put(st, 0, 2);                          # EOB
    return 0;
}

# Build a baseline JPEG. ncomp is 1 (grayscale) or 3 (YCbCr); hs/vs are the
# luma sampling factors (1,1 = 4:4:4; 2,2 = 4:2:0; 2,1 = 4:2:2). Chroma is
# always 1,1. Returns the buffer; sets *len_out.
fn _mk_jpeg(w, h, ncomp, hs, vs, len_out): i64 {
    var cap = (w * h) + 65536;
    var b = alloc(cap);
    var o = 0;
    var i = 0;

    store8(b + 0, 255); store8(b + 1, 216);     # SOI
    o = 2;

    # DQT — table 0, 8-bit precision, all entries 2 (a real dequant multiply,
    # without the quantiser dominating the arithmetic).
    store8(b + o, 255); store8(b + o + 1, 219);
    store8(b + o + 2, 0); store8(b + o + 3, 67);
    store8(b + o + 4, 0);
    o = o + 5;
    i = 0;
    while (i < 64) { store8(b + o + i, 2); i = i + 1; }
    o = o + 64;

    # SOF0
    store8(b + o, 255); store8(b + o + 1, 192);
    var lf = 8 + 3 * ncomp;
    store8(b + o + 2, (lf / 256) & 255); store8(b + o + 3, lf & 255);
    store8(b + o + 4, 8);
    store8(b + o + 5, (h / 256) & 255); store8(b + o + 6, h & 255);
    store8(b + o + 7, (w / 256) & 255); store8(b + o + 8, w & 255);
    store8(b + o + 9, ncomp);
    o = o + 10;
    store8(b + o + 0, 1); store8(b + o + 1, hs * 16 + vs); store8(b + o + 2, 0);
    o = o + 3;
    if (ncomp == 3) {
        store8(b + o + 0, 2); store8(b + o + 1, 17); store8(b + o + 2, 0);
        store8(b + o + 3, 3); store8(b + o + 4, 17); store8(b + o + 5, 0);
        o = o + 6;
    }

    # DHT — DC table 0 (Annex K.3.1 luminance: BITS 0,1,5,1,1,1,1,1,1,0..,
    # HUFFVAL 0..11).
    store8(b + o, 255); store8(b + o + 1, 196);
    store8(b + o + 2, 0); store8(b + o + 3, 31);
    store8(b + o + 4, 0);
    o = o + 5;
    store8(b + o + 0, 0); store8(b + o + 1, 1); store8(b + o + 2, 5);
    store8(b + o + 3, 1); store8(b + o + 4, 1); store8(b + o + 5, 1);
    store8(b + o + 6, 1); store8(b + o + 7, 1); store8(b + o + 8, 1);
    i = 9;
    while (i < 16) { store8(b + o + i, 0); i = i + 1; }
    o = o + 16;
    i = 0;
    while (i < 12) { store8(b + o + i, i); i = i + 1; }
    o = o + 12;

    # DHT — AC table 0: two 2-bit codes, HUFFVAL 0x00 (EOB) and 0x04 (r0/s4).
    store8(b + o, 255); store8(b + o + 1, 196);
    store8(b + o + 2, 0); store8(b + o + 3, 21);
    store8(b + o + 4, 16);
    o = o + 5;
    store8(b + o + 0, 0); store8(b + o + 1, 2);
    i = 2;
    while (i < 16) { store8(b + o + i, 0); i = i + 1; }
    o = o + 16;
    store8(b + o + 0, 0); store8(b + o + 1, 4);
    o = o + 2;

    # SOS
    store8(b + o, 255); store8(b + o + 1, 218);
    var ls = 6 + 2 * ncomp;
    store8(b + o + 2, (ls / 256) & 255); store8(b + o + 3, ls & 255);
    store8(b + o + 4, ncomp);
    o = o + 5;
    store8(b + o + 0, 1); store8(b + o + 1, 0);
    o = o + 2;
    if (ncomp == 3) {
        store8(b + o + 0, 2); store8(b + o + 1, 0);
        store8(b + o + 2, 3); store8(b + o + 3, 0);
        o = o + 4;
    }
    store8(b + o + 0, 0); store8(b + o + 1, 63); store8(b + o + 2, 0);
    o = o + 3;

    # ---- entropy-coded scan ----------------------------------------------
    var bw[32];
    _bw_init(&bw, b + o);
    var mcu_cols = (w + 8 * hs - 1) / (8 * hs);
    var mcu_rows = (h + 8 * vs - 1) / (8 * vs);
    var mi = 0;
    var total = mcu_cols * mcu_rows;
    var by = 0;
    var bx = 0;
    while (mi < total) {
        by = 0;
        while (by < vs) {
            bx = 0;
            while (bx < hs) {
                _emit_block(&bw, mi + by * 3 + bx);
                bx = bx + 1;
            }
            by = by + 1;
        }
        if (ncomp == 3) {
            _emit_block(&bw, mi + 1);
            _emit_block(&bw, mi + 2);
        }
        mi = mi + 1;
    }
    o = o + _bw_flush(&bw);

    store8(b + o, 255); store8(b + o + 1, 217);   # EOI
    o = o + 2;
    store64(len_out, o);
    return b;
}

fn _verify_jpeg(bytes, len, w, h, label): i64 {
    var err = 0;
    var img = chitra_jpeg_decode(bytes, len, &err);
    if (img == 0) { _fail(label); return 0; }
    if (chitra_image_width(img) != w) { _fail(label); return 0; }
    if (chitra_image_height(img) != h) { _fail(label); return 0; }
    if (chitra_image_pixels(img) == 0) { _fail(label); return 0; }
    if (chitra_image_channels(img) != 4) { _fail(label); return 0; }
    return 1;
}

# Generate one fixture and prove it round-trips before anything is timed.
fn _ok(label): i64 {
    syscall(1, 1, "  ", 2);
    syscall(1, 1, label, strlen(label));
    syscall(1, 1, " ok\n", 4);
    return 0;
}

fn _check_png(w, h, ct, depth, il, label): i64 {
    var lo = 0;
    var b = _mk_png(w, h, ct, depth, il, &lo);
    if (_verify_png(b, lo, w, h, ct, depth, label) == 1) { _ok(label); }
    return 0;
}

fn _check_jpeg(w, h, ncomp, hs, vs, label): i64 {
    var lo = 0;
    var b = _mk_jpeg(w, h, ncomp, hs, vs, &lo);
    if (_verify_jpeg(b, lo, w, h, label) == 1) { _ok(label); }
    return 0;
}

# ================================================================
# BMP generation — no compression at all, so the generator is a header, an
# optional palette and rows of samples. Rows are written BOTTOM-UP (the BMP
# default) and padded to a 4-byte boundary, so the decode path under
# measurement is the real one: reverse row walk + stride skip + BGR->RGBA
# channel swap.
# ================================================================
fn _put_u32le(p, v): i64 {
    store8(p + 0, v & 255);
    store8(p + 1, (v / 256) & 255);
    store8(p + 2, (v / 65536) & 255);
    store8(p + 3, (v / 16777216) & 255);
    return 0;
}

fn _mk_bmp(w, h, bpp, len_out): i64 {
    var stride = ((w * bpp + 31) / 32) * 4;
    var pal_n = 0;
    if (bpp == 8) { pal_n = 256; }
    var pal_bytes = pal_n * 4;
    var total = 14 + 40 + pal_bytes + stride * h;
    var b = alloc(total);
    var i = 0;
    while (i < total) { store8(b + i, 0); i = i + 1; }

    store8(b + 0, 0x42);
    store8(b + 1, 0x4D);
    _put_u32le(b + 2, total);
    _put_u32le(b + 10, 14 + 40 + pal_bytes);

    _put_u32le(b + 14, 40);
    _put_u32le(b + 18, w);
    _put_u32le(b + 22, h);
    store8(b + 26, 1);              # planes
    store8(b + 28, bpp & 255);
    store8(b + 29, (bpp / 256) & 255);
    _put_u32le(b + 30, 0);          # BI_RGB
    _put_u32le(b + 46, pal_n);      # clrUsed

    if (pal_n > 0) {
        var e = 0;
        while (e < pal_n) {
            store8(b + 54 + e * 4 + 0, (e * 7) & 255);
            store8(b + 54 + e * 4 + 1, (e * 3) & 255);
            store8(b + 54 + e * 4 + 2, e);
            e = e + 1;
        }
    }

    var data = b + 14 + 40 + pal_bytes;
    var y = 0;
    var x = 0;
    while (y < h) {
        # file row y holds image row (h-1-y): bottom-up
        var iy = h - 1 - y;
        var row = data + y * stride;
        x = 0;
        while (x < w) {
            if (bpp == 8) {
                store8(row + x, _sample(x, iy, 0));
            }
            if (bpp == 24) {
                store8(row + x * 3 + 0, _sample(x, iy, 2));
                store8(row + x * 3 + 1, _sample(x, iy, 1));
                store8(row + x * 3 + 2, _sample(x, iy, 0));
            }
            if (bpp == 32) {
                store8(row + x * 4 + 0, _sample(x, iy, 2));
                store8(row + x * 4 + 1, _sample(x, iy, 1));
                store8(row + x * 4 + 2, _sample(x, iy, 0));
                store8(row + x * 4 + 3, 255);
            }
            x = x + 1;
        }
        y = y + 1;
    }
    store64(len_out, total);
    return b;
}

fn _verify_bmp(bytes, len, w, h, bpp, label): i64 {
    var err = 0;
    var img = chitra_bmp_decode(bytes, len, &err);
    if (img == 0) { _fail(label); return 0; }
    if (chitra_image_width(img) != w) { _fail(label); return 0; }
    if (chitra_image_height(img) != h) { _fail(label); return 0; }
    var px = chitra_image_pixels(img);
    # spot-check that the bottom-up walk landed the right row at the top
    if (bpp != 8) {
        if (load8(px + 0) != _sample(0, 0, 0)) { _fail(label); return 0; }
        if (load8(px + 1) != _sample(0, 0, 1)) { _fail(label); return 0; }
    }
    if (load8(px + 3) != 255) { _fail(label); return 0; }
    return 1;
}

fn _check_bmp(w, h, bpp, label): i64 {
    var lo = 0;
    var b = _mk_bmp(w, h, bpp, &lo);
    if (_verify_bmp(b, lo, w, h, bpp, label) == 1) { _ok(label); }
    return 0;
}

fn _bench_bmp(name, bpp): i64 {
    var lo = 0;
    var bytes = _mk_bmp(BENCH_DIM, BENCH_DIM, bpp, &lo);
    if (_verify_bmp(bytes, lo, BENCH_DIM, BENCH_DIM, bpp, name) == 0) { return 0; }
    var b = bench_new(name);
    var err = 0;
    var r = 0;
    while (r < ROUNDS) {
        bench_start(b);
        chitra_bmp_decode(bytes, lo, &err);
        bench_stop(b);
        r = r + 1;
    }
    bench_report(b);
    _csv_row(b);
    _per_pixel(b, BENCH_DIM * BENCH_DIM);
    return 0;
}

# ================================================================
# GIF generation — the only format here that needs a real ENCODER.
#
# PNG delegates compression to sankoch's zlib_compress and BMP has none, but
# there is no LZW encoder to borrow, so this harness carries a small greedy one.
# That matters for honesty: a GIF benchmark built from literal codes alone
# would never make the decoder walk a dictionary chain, and chain walking is
# where GIF decode actually spends its time. Encoding happens OUTSIDE the timed
# region, so its cost does not pollute the measurement.
#
# The dictionary is a direct-indexed table of 4096 x 256 slots rather than a
# hash — 8 MB, O(1) lookup, and trivially correct. A bench harness can afford
# memory that a decoder cannot.
# ================================================================
var GIFE_MAX = 4096;

# Bit writer, LSB-first (GIF's packing order, opposite to JPEG's).
# State (32 bytes): +0 buf, +8 byte pos, +16 accumulator, +24 bit count.
fn _gife_init(st, buf): i64 {
    store64(st + 0, buf);
    store64(st + 8, 0);
    store64(st + 16, 0);
    store64(st + 24, 0);
    return 0;
}

fn _gife_put(st, code, width): i64 {
    var acc = load64(st + 16);
    var cnt = load64(st + 24);
    acc = acc | (code << cnt);
    cnt = cnt + width;
    var buf = load64(st + 0);
    var pos = load64(st + 8);
    while (cnt >= 8) {
        store8(buf + pos, acc & 255);
        pos = pos + 1;
        acc = acc / 256;
        cnt = cnt - 8;
    }
    store64(st + 8, pos);
    store64(st + 16, acc);
    store64(st + 24, cnt);
    return 0;
}

fn _gife_flush(st): i64 {
    var cnt = load64(st + 24);
    if (cnt > 0) {
        var buf = load64(st + 0);
        var pos = load64(st + 8);
        store8(buf + pos, load64(st + 16) & 255);
        store64(st + 8, pos + 1);
        store64(st + 16, 0);
        store64(st + 24, 0);
    }
    return load64(st + 8);
}

# Greedy LZW encode of `idx` (npix palette indices) into `out`. Returns length.
fn _gife_lzw(idx, npix, mcs, out, table): i64 {
    var clear = 1 << mcs;
    var endc = clear + 1;
    var i = 0;
    while (i < GIFE_MAX * 256) { store64(table + i * 8, 0); i = i + 1; }

    var bw[32];
    _gife_init(&bw, out);
    var width = mcs + 1;
    var next_code = clear + 2;
    _gife_put(&bw, clear, width);

    var prev = load8(idx);
    var k = 1;
    var c = 0;
    var slot = 0;
    var found = 0;
    while (k < npix) {
        c = load8(idx + k);
        slot = prev * 256 + c;
        found = load64(table + slot * 8);
        if (found != 0) {
            prev = found;
        } else {
            _gife_put(&bw, prev, width);
            if (next_code < GIFE_MAX) {
                store64(table + slot * 8, next_code);
                next_code = next_code + 1;
                if (next_code > (1 << width)) {
                    if (width < 12) { width = width + 1; }
                }
            } else {
                _gife_put(&bw, clear, width);
                i = 0;
                while (i < GIFE_MAX * 256) { store64(table + i * 8, 0); i = i + 1; }
                next_code = clear + 2;
                width = mcs + 1;
            }
            prev = c;
        }
        k = k + 1;
    }
    _gife_put(&bw, prev, width);
    _gife_put(&bw, endc, width);
    return _gife_flush(&bw);
}

# Assemble a complete GIF89a: header, screen descriptor, 256-entry global
# color table, image descriptor, and the LZW data chunked into sub-blocks.
fn _mk_gif(w, h, len_out): i64 {
    var npix = w * h;
    var idx = alloc(npix);
    var y = 0;
    var x = 0;
    while (y < h) {
        x = 0;
        while (x < w) {
            store8(idx + y * w + x, _sample(x, y, 0));
            x = x + 1;
        }
        y = y + 1;
    }

    var table = alloc(GIFE_MAX * 256 * 8);
    var lzw = alloc(npix * 2 + 4096);
    var lzw_len = _gife_lzw(idx, npix, 8, lzw, table);

    # sub-block chunking adds one length byte per 255 payload bytes
    var total = 13 + 768 + 10 + 1 + lzw_len + (lzw_len / 255) + 2 + 1;
    var b = alloc(total);
    var o = 0;
    store8(b + 0, 0x47); store8(b + 1, 0x49); store8(b + 2, 0x46);
    store8(b + 3, 0x38); store8(b + 4, 0x39); store8(b + 5, 0x61);
    store8(b + 6, w & 255); store8(b + 7, (w / 256) & 255);
    store8(b + 8, h & 255); store8(b + 9, (h / 256) & 255);
    store8(b + 10, 0xF7);            # GCT present, 256 entries
    store8(b + 11, 0);
    store8(b + 12, 0);
    o = 13;
    var e = 0;
    while (e < 256) {
        store8(b + o + e * 3 + 0, e);
        store8(b + o + e * 3 + 1, (e * 3) & 255);
        store8(b + o + e * 3 + 2, (e * 7) & 255);
        e = e + 1;
    }
    o = o + 768;

    store8(b + o, 0x2C);
    store8(b + o + 1, 0); store8(b + o + 2, 0);
    store8(b + o + 3, 0); store8(b + o + 4, 0);
    store8(b + o + 5, w & 255); store8(b + o + 6, (w / 256) & 255);
    store8(b + o + 7, h & 255); store8(b + o + 8, (h / 256) & 255);
    store8(b + o + 9, 0);            # no LCT, not interlaced
    o = o + 10;
    store8(b + o, 8);                # LZW minimum code size
    o = o + 1;

    var left = lzw_len;
    var src_at = 0;
    var n = 0;
    var j = 0;
    while (left > 0) {
        n = left;
        if (n > 255) { n = 255; }
        store8(b + o, n);
        o = o + 1;
        j = 0;
        while (j < n) {
            store8(b + o + j, load8(lzw + src_at + j));
            j = j + 1;
        }
        o = o + n;
        src_at = src_at + n;
        left = left - n;
    }
    store8(b + o, 0);                # sub-block terminator
    store8(b + o + 1, 0x3B);         # trailer
    o = o + 2;
    store64(len_out, o);
    return b;
}

fn _verify_gif(bytes, len, w, h, label): i64 {
    var err = 0;
    var img = chitra_gif_decode(bytes, len, &err);
    if (img == 0) { _fail(label); return 0; }
    if (chitra_image_width(img) != w) { _fail(label); return 0; }
    if (chitra_image_height(img) != h) { _fail(label); return 0; }
    # the generated palette maps index i -> (i, 3i, 7i), so a round-trip of
    # _sample must come back exactly; this is what proves the encoder and the
    # decoder agree rather than both being wrong the same way
    var px = chitra_image_pixels(img);
    if (load8(px + 0) != _sample(0, 0, 0)) { _fail(label); return 0; }
    if (load8(px + 1) != ((_sample(0, 0, 0) * 3) & 255)) { _fail(label); return 0; }
    if (load8(px + 3) != 255) { _fail(label); return 0; }
    return 1;
}

fn _check_gif(w, h, label): i64 {
    var lo = 0;
    var b = _mk_gif(w, h, &lo);
    if (_verify_gif(b, lo, w, h, label) == 1) { _ok(label); }
    return 0;
}

fn _bench_gif(name): i64 {
    var lo = 0;
    var bytes = _mk_gif(BENCH_DIM, BENCH_DIM, &lo);
    if (_verify_gif(bytes, lo, BENCH_DIM, BENCH_DIM, name) == 0) { return 0; }
    var b = bench_new(name);
    var err = 0;
    var r = 0;
    while (r < ROUNDS) {
        bench_start(b);
        chitra_gif_decode(bytes, lo, &err);
        bench_stop(b);
        r = r + 1;
    }
    bench_report(b);
    _csv_row(b);
    _per_pixel(b, BENCH_DIM * BENCH_DIM);
    return 0;
}

# ================================================================
# BMP run-length (BI_RLE8), 0.5.1.
#
# The content is deliberately BLOCKY rather than the gradient the other
# fixtures use. RLE exists for flat graphic content; encoding a per-pixel
# gradient would produce almost entirely 1-length runs and measure a case
# nobody ships. 8x8 blocks give runs of 8, which is representative.
# ================================================================
fn _rle_val(x, y): i64 {
    return ((x / 8) + (y / 8)) & 255;
}

fn _mk_bmp_rle8(w, h, len_out): i64 {
    var pal_bytes = 256 * 4;
    var cap = 14 + 40 + pal_bytes + w * h * 2 + 4096;
    var b = alloc(cap);
    var i = 0;
    while (i < cap) { store8(b + i, 0); i = i + 1; }

    store8(b + 0, 0x42);
    store8(b + 1, 0x4D);
    _put_u32le(b + 10, 14 + 40 + pal_bytes);
    _put_u32le(b + 14, 40);
    _put_u32le(b + 18, w);
    _put_u32le(b + 22, h);
    store8(b + 26, 1);
    store8(b + 28, 8);
    _put_u32le(b + 30, 1);            # BI_RLE8
    _put_u32le(b + 46, 256);

    var e = 0;
    while (e < 256) {
        store8(b + 54 + e * 4 + 0, (e * 7) & 255);
        store8(b + 54 + e * 4 + 1, (e * 3) & 255);
        store8(b + 54 + e * 4 + 2, e);
        e = e + 1;
    }

    var o = 14 + 40 + pal_bytes;
    var rr = 0;
    var y = 0;
    var x = 0;
    var run = 0;
    var v = 0;
    var scanning = 0;
    while (rr < h) {
        y = h - 1 - rr;               # rows run bottom-up
        x = 0;
        while (x < w) {
            v = _rle_val(x, y);
            # Extend the run while the value holds, the row lasts, and the
            # count stays inside a byte. Flag-driven rather than `break`,
            # which is unreliable in a var-declaring while.
            run = 0;
            scanning = 1;
            while (scanning == 1) {
                scanning = 0;
                if (x + run < w) {
                    if (run < 255) {
                        if (_rle_val(x + run, y) == v) {
                            run = run + 1;
                            scanning = 1;
                        }
                    }
                }
            }
            store8(b + o, run);
            store8(b + o + 1, v);
            o = o + 2;
            x = x + run;
        }
        store8(b + o, 0); store8(b + o + 1, 0);     # end of line
        o = o + 2;
        rr = rr + 1;
    }
    store8(b + o, 0); store8(b + o + 1, 1);         # end of bitmap
    o = o + 2;
    store64(len_out, o);
    return b;
}

fn _verify_bmp_rle(bytes, len, w, h, label): i64 {
    var err = 0;
    var img = chitra_bmp_decode(bytes, len, &err);
    if (img == 0) { _fail(label); return 0; }
    if (chitra_image_width(img) != w) { _fail(label); return 0; }
    if (chitra_image_height(img) != h) { _fail(label); return 0; }
    # Round-trip: the palette maps index i -> (i, 3i, 7i), so every sampled
    # pixel must come back as its own _rle_val. This is what proves the encoder
    # above and chitra's RLE decoder agree rather than being wrong alike.
    var px = chitra_image_pixels(img);
    var vy = 0;
    var vx = 0;
    while (vy < h) {
        vx = 0;
        while (vx < w) {
            if (load8(px + (vy * w + vx) * 4) != _rle_val(vx, vy)) { _fail(label); return 0; }
            vx = vx + 17;
        }
        vy = vy + 13;
    }
    return 1;
}

fn _check_bmp_rle(w, h, label): i64 {
    var lo = 0;
    var b = _mk_bmp_rle8(w, h, &lo);
    if (_verify_bmp_rle(b, lo, w, h, label) == 1) { _ok(label); }
    return 0;
}

fn _bench_bmp_rle(name): i64 {
    var lo = 0;
    var bytes = _mk_bmp_rle8(BENCH_DIM, BENCH_DIM, &lo);
    if (_verify_bmp_rle(bytes, lo, BENCH_DIM, BENCH_DIM, name) == 0) { return 0; }
    var b = bench_new(name);
    var err = 0;
    var r = 0;
    while (r < ROUNDS) {
        bench_start(b);
        chitra_bmp_decode(bytes, lo, &err);
        bench_stop(b);
        r = r + 1;
    }
    bench_report(b);
    _csv_row(b);
    _per_pixel(b, BENCH_DIM * BENCH_DIM);
    return 0;
}

# ================================================================
# Benchmarks
#
# NOTE ON MEMORY: chitra's allocator is a bump allocator and
# `chitra_image_free` is a documented no-op, so every round of every
# benchmark permanently retains its output buffer. That is a property of the
# library, not of this harness — but it means ROUNDS and BENCH_DIM trade
# directly against resident memory, and that a very long run will eventually
# pay for fresh chunk mmaps inside a timed window. Both are kept modest for
# that reason.
# ================================================================
var BENCH_DIM = 256;      # 256x256 = 65,536 px — a realistic small texture
var ROUNDS = 20;

fn _bench_png(name, ct, depth, interlace): i64 {
    var lo = 0;
    var bytes = _mk_png(BENCH_DIM, BENCH_DIM, ct, depth, interlace, &lo);
    if (_verify_png(bytes, lo, BENCH_DIM, BENCH_DIM, ct, depth, name) == 0) { return 0; }
    var b = bench_new(name);
    var err = 0;
    var r = 0;
    while (r < ROUNDS) {
        bench_start(b);
        chitra_png_decode(bytes, lo, &err);
        bench_stop(b);
        r = r + 1;
    }
    bench_report(b);
    _csv_row(b);
    _per_pixel(b, BENCH_DIM * BENCH_DIM);
    return 0;
}

fn _bench_jpeg(name, ncomp, hs, vs): i64 {
    var lo = 0;
    var bytes = _mk_jpeg(BENCH_DIM, BENCH_DIM, ncomp, hs, vs, &lo);
    if (_verify_jpeg(bytes, lo, BENCH_DIM, BENCH_DIM, name) == 0) { return 0; }
    var b = bench_new(name);
    var err = 0;
    var r = 0;
    while (r < ROUNDS) {
        bench_start(b);
        chitra_jpeg_decode(bytes, lo, &err);
        bench_stop(b);
        r = r + 1;
    }
    bench_report(b);
    _csv_row(b);
    _per_pixel(b, BENCH_DIM * BENCH_DIM);
    return 0;
}

# The icon case: a 16x16 decode is dominated by fixed cost (allocation,
# header parse, Huffman/quant table build), not throughput. Reported
# separately so the per-pixel figures above are not read as applying to it.
fn _bench_small(): i64 {
    var lo = 0;
    var bytes = _mk_png(16, 16, 6, 8, 0, &lo);
    var b = bench_new("png_rgba8_16x16_fixed_cost");
    var err = 0;
    var r = 0;
    while (r < 200) {
        bench_start(b);
        chitra_png_decode(bytes, lo, &err);
        bench_stop(b);
        r = r + 1;
    }
    bench_report(b);
    _csv_row(b);

    var jlo = 0;
    var jb = _mk_jpeg(16, 16, 1, 1, 1, &jlo);
    var b2 = bench_new("jpeg_gray_16x16_fixed_cost");
    r = 0;
    while (r < 200) {
        bench_start(b2);
        chitra_jpeg_decode(jb, jlo, &err);
        bench_stop(b2);
        r = r + 1;
    }
    bench_report(b2);
    _csv_row(b2);
    return 0;
}

fn main(): i64 {
    alloc_init();
    # sankoch's crc32 does NOT lazily build its table — chitra calls
    # crc32_init_table() explicitly in chitra_png_parse_raw (png_filter.cyr).
    # This harness synthesises PNG chunks, so it must do the same before it
    # can CRC one.
    crc32_init_table();

    println("=== chitra decode benchmarks ===");
    bench_report_clock();
    println("");
    println("-- fixture self-check (generated fixtures must decode correctly) --");
    _check_png(64, 64, 0, 8, 0, "gray8");
    _check_png(64, 64, 2, 8, 0, "rgb8");
    _check_png(64, 64, 6, 8, 0, "rgba8");
    _check_png(64, 64, 3, 8, 0, "palette8");
    _check_png(64, 64, 6, 16, 0, "rgba16");
    _check_png(63, 61, 6, 8, 1, "rgba8 adam7 odd-dims");
    _check_jpeg(64, 64, 1, 1, 1, "jpeg grayscale");
    _check_jpeg(64, 64, 3, 1, 1, "jpeg ycbcr 4:4:4");
    _check_jpeg(64, 64, 3, 2, 1, "jpeg ycbcr 4:2:2");
    _check_jpeg(64, 64, 3, 2, 2, "jpeg ycbcr 4:2:0");
    _check_bmp(64, 64, 24, "bmp 24bpp bottom-up");
    _check_bmp(64, 64, 32, "bmp 32bpp");
    _check_bmp(64, 64, 8, "bmp 8bpp palette");
    _check_gif(64, 64, "gif lzw round-trip");
    _check_bmp_rle(64, 64, "bmp rle8 round-trip");

    println("");
    println("-- PNG decode, 256x256 --");
    _bench_png("png_gray8_256", 0, 8, 0);
    _bench_png("png_rgb8_256", 2, 8, 0);
    _bench_png("png_rgba8_256", 6, 8, 0);
    _bench_png("png_palette8_256", 3, 8, 0);
    _bench_png("png_rgba16_256", 6, 16, 0);
    _bench_png("png_rgba8_adam7_256", 6, 8, 1);

    println("");
    println("-- JPEG decode, 256x256 --");
    _bench_jpeg("jpeg_gray_256", 1, 1, 1);
    _bench_jpeg("jpeg_ycbcr444_256", 3, 1, 1);
    _bench_jpeg("jpeg_ycbcr422_256", 3, 2, 1);
    _bench_jpeg("jpeg_ycbcr420_256", 3, 2, 2);

    println("");
    println("-- BMP decode, 256x256 --");
    _bench_bmp("bmp_rgb24_256", 24);
    _bench_bmp("bmp_rgba32_256", 32);
    _bench_bmp("bmp_palette8_256", 8);
    _bench_bmp_rle("bmp_rle8_256");

    println("");
    println("-- GIF decode, 256x256 --");
    _bench_gif("gif_lzw_256");

    println("");
    println("-- fixed cost (16x16, throughput-irrelevant) --");
    _bench_small();

    if (_verify_fail != 0) {
        println("");
        println("BENCH ABORTED: a generated fixture failed to decode — the");
        println("numbers above cannot be trusted.");
    }
    return _verify_fail;
}
var exit_code = main();
syscall(60, exit_code);
