# tests/tcyr/jpeg_cmyk.tcyr — chitra_jpeg_decode_cmyk (1.4.0, ADR 0014): a
# 4-component JPEG's C, M, Y, K samples, YCCK converted, with no colour guess.
# Standalone CPU suite; fixtures embedded as hex.
#
# THE ORACLE is libjpeg itself: a 20-line C program asks it for
# out_color_space = JCS_CMYK and writes the scanlines raw. Every fixture below
# matches it byte for byte, and out of tree so do 124 more — plain Adobe CMYK,
# CMYK with no Adobe marker and YCCK, each at 1x1 / 2x2 / 2x1 / 1x2 for the
# first (and, for YCCK, last) component, baseline and progressive, from 1x1
# to 64x40 pixels, plus ImageMagick's own YCCK writer. (djpeg cannot be the
# oracle here: its PPM writer turns CMYK into RGB.)
#
# ⚠ Checked to fail against 1.3.1: the whole suite (chitra_jpeg_decode_cmyk
# did not exist, and every one of these files was CHITRA_ERR_JPEG_COMPONENTS).
#
# REGENERATION. The fixtures are written by a libjpeg encoder (jenc: in
# JCS_CMYK, jpeg_set_colorspace to JCS_CMYK or JCS_YCCK, write_Adobe_marker
# off for the no-Adobe file, quality 85) from C = (37x + 11y) mod 256,
# M = (5x^2 + 29y) mod 256, Y = (255 - 23x + 7y^2) mod 256,
# K = (13x xor 17y) mod 256.

include "src/lib.cyr"
include "lib/assert.cyr"

var _CK_BIG = 1073741824;

fn _ck_hexval(c): i64 {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    return c - 55;
}

fn _ck_hex(b, off, s): i64 {
    var i = 0;
    var n = strlen(s);
    while (i + 1 < n) {
        store8(b + off, _ck_hexval(load8(s + i)) * 16 + _ck_hexval(load8(s + i + 1)));
        off = off + 1;
        i = i + 2;
    }
    return off;
}

fn _ck_code(err): i64 {
    if (err == 0) { return 0 - 1; }
    return chitra_err_code(err);
}

fn _ck_check(jpg, n, want, ctype, name): i64 {
    var err = 0;
    var img = chitra_jpeg_decode_cmyk(0, jpg, n, _CK_BIG, &err);
    assert(img != 0, name);
    assert_eq(err, 0, name);
    if (img == 0) { return 0; }
    assert_eq(chitra_image_width(img), 17, name);
    assert_eq(chitra_image_height(img), 11, name);
    assert_eq(chitra_image_channels(img), 4, name);
    assert_eq(chitra_image_seen_iend(img), 1, name);
    assert_eq(chitra_image_source_color_type(img), ctype, name);
    var px = chitra_image_pixels(img);
    var bad = 0;
    var i = 0;
    while (i < 748) {
        if (load8(px + i) != load8(want + i)) { bad = bad + 1; }
        i = i + 1;
    }
    assert_eq(bad, 0, name);
    return 0;
}

# Offset of the Adobe APP14 transform byte, or -1.
fn _ck_adobe_transform_at(b, lo): i64 {
    var i = 2;
    while (i + 15 < lo) {
        if (load8(b + i) == 0xFF) {
            if (load8(b + i + 1) == 0xEE) { return i + 15; }
        }
        i = i + 1;
    }
    return 0 - 1;
}

