fn test_ck_ycck_prog_17x11(): i64 {
    var lo = 0;
    _ck_check(_ck_fx_ycck_prog_17x11(&lo), lo, _ck_ref_ycck_prog_17x11(), 356,
      "ycck_prog_17x11: byte-identical to libjpeg JCS_CMYK");
    return 0;
