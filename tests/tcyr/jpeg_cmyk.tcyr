# The RGBA entries still refuse every 4-component file: turning C, M, Y, K into
# R, G, B is the colour-space guess ADR 0009 forbids, and 1.4.0 did not change
# that. Through 1.3.x this was the only answer chitra had for these files.
fn test_ck_rgba_entries_still_refuse() {
    var lo = 0;
    var b = _ck_fx_ycck_420_17x11(&lo);
    var err = 0;
    assert(chitra_jpeg_decode(b, lo, &err) == 0, "chitra_jpeg_decode refuses a YCCK file");
    assert_eq(_ck_code(err), CHITRA_ERR_JPEG_COMPONENTS, "...as CHITRA_ERR_JPEG_COMPONENTS");
    assert(chitra_image_decode(b, lo, &err) == 0, "the router refuses it");
    assert_eq(_ck_code(err), CHITRA_ERR_JPEG_COMPONENTS, "...as CHITRA_ERR_JPEG_COMPONENTS");
    assert(chitra_image_decode_budget_via(0, b, lo, _CK_BIG, &err) == 0, "the budget entry refuses it");
    assert_eq(_ck_code(err), CHITRA_ERR_JPEG_COMPONENTS, "...as CHITRA_ERR_JPEG_COMPONENTS");
    return 0;
}

# A 3-component file is not CMYK: chitra_image_decode is its entry. A 24x16
# 4:2:0 JFIF built by the budget suite's recipe would do; this mutates the
# CMYK fixture's SOF component count instead, which the walk checks first.
fn test_ck_refuses_what_is_not_cmyk() {
    var lo = 0;
    var b = _ck_fx_cmyk_17x11(&lo);
    var i = 2;
    var sof = 0 - 1;
    while (i + 1 < lo) {
        if (sof < 0) {
            if (load8(b + i) == 0xFF) {
                if (load8(b + i + 1) == 0xC0) { sof = i; }
            }
        }
        i = i + 1;
    }
    store8(b + sof + 9, 3);                       # Nf 4 -> 3
    var err = 0;
    assert(chitra_jpeg_decode_cmyk(0, b, lo, _CK_BIG, &err) == 0, "a 3-component frame is refused by the CMYK entry");
    assert_eq(_ck_code(err), CHITRA_ERR_JPEG_COMPONENTS, "...as CHITRA_ERR_JPEG_COMPONENTS");
    var png[8];
    store8(&png, 0x89);
    assert(chitra_jpeg_decode_cmyk(0, &png, 8, _CK_BIG, &err) == 0, "not a JPEG");
    assert_eq(_ck_code(err), CHITRA_ERR_SIGNATURE, "...as CHITRA_ERR_SIGNATURE");
    return 0;
}

# An Adobe transform that names no 4-component space is declined, not guessed
# (libjpeg warns and assumes YCCK). ⚠ Mutation-checked: without the 4-component
# arm of _chitra_jpeg_colour_evidence_ok both files decode.
fn test_ck_undefined_transform_declined() {
    var lo = 0;
    var b = _ck_fx_cmyk_17x11(&lo);
    var t = _ck_adobe_transform_at(b, lo);
    var err = 0;
    store8(b + t, 1);
    assert(chitra_jpeg_decode_cmyk(0, b, lo, _CK_BIG, &err) == 0, "Adobe transform 1 on four components is declined");
    assert_eq(_ck_code(err), CHITRA_ERR_UNSUPPORTED, "...as CHITRA_ERR_UNSUPPORTED");
    store8(b + t, 3);
    assert(chitra_jpeg_decode_cmyk(0, b, lo, _CK_BIG, &err) == 0, "Adobe transform 3 is declined");
    assert_eq(_ck_code(err), CHITRA_ERR_UNSUPPORTED, "...as CHITRA_ERR_UNSUPPORTED");
    return 0;
}

# The budget: 17 x 11 x 4 = 748 bytes of output.
fn test_ck_budget() {
    var lo = 0;
    var b = _ck_fx_cmyk_17x11(&lo);
    var err = 0;
    var before = alloc_used();
    assert(chitra_jpeg_decode_cmyk(0, b, lo, 747, &err) == 0, "747 B budget refuses a 748 B output");
    assert_eq(_ck_code(err), CHITRA_ERR_BUDGET, "...as CHITRA_ERR_BUDGET");
    assert_lte(alloc_used() - before, 16, "...for the ChitraErr alone");
    assert(chitra_jpeg_decode_cmyk(0, b, lo, 748, &err) != 0, "748 B budget decodes");
    assert(chitra_jpeg_decode_cmyk(0, b, lo, 0, &err) == 0, "a zero budget refuses");
    assert_eq(_ck_code(err), CHITRA_ERR_BUDGET, "...as CHITRA_ERR_BUDGET");
    return 0;
}

# Through a caller's Allocator: two blocks live, then none; a refusal leaves none.
fn _ck_ta_alloc(state, size): i64 {
    var p = alloc(size);
    if (p != 0) { store64(state, load64(state) + 1); }
    return p;
}
fn _ck_ta_realloc(state, o, os, ns): i64 { return 0; }
fn _ck_ta_free(state, ptr): i64 {
    store64(state, load64(state) - 1);
    return 0;
}
fn _ck_ta_reset(state): i64 { return 0; }

fn test_ck_via_allocator() {
    var st = alloc(8);
    store64(st, 0);
    var a = allocator_new(&_ck_ta_alloc, &_ck_ta_realloc, &_ck_ta_free, &_ck_ta_reset, st);
    var lo = 0;
    var err = 0;
    var img = chitra_jpeg_decode_cmyk(a, _ck_fx_ycck_prog_17x11(&lo), lo, _CK_BIG, &err);
    assert(img != 0, "CMYK via an Allocator decodes");
    assert_eq(load64(st), 2, "CMYK via: record + pixels live");
    chitra_image_free(img);
    assert_eq(load64(st), 0, "CMYK via: nothing live after chitra_image_free");
    var b = _ck_fx_cmyk_17x11(&lo);
    store8(b + _ck_adobe_transform_at(b, lo), 1);
    assert(chitra_jpeg_decode_cmyk(a, b, lo, _CK_BIG, &err) == 0, "CMYK via: a declined file");
    assert_eq(load64(st), 0, "CMYK via: a refusal returns every block");
    return 0;
}

fn main(): i64 {
    test_ck_cmyk_17x11();
    test_ck_ycck_420_17x11();
    test_ck_noadobe_prog_17x11();
    test_ck_ycck_prog_17x11();
    test_ck_rgba_entries_still_refuse();
    test_ck_refuses_what_is_not_cmyk();
    test_ck_undefined_transform_declined();
    test_ck_budget();
    test_ck_via_allocator();
    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
