fn fx_bmp_rle8_run_overflow(len_out): i64 {
    var b = alloc(74);
    store64(len_out, 74);
    store8(b + 0, 66);
    store8(b + 1, 77);
    store8(b + 2, 74);
    store8(b + 3, 0);
    store8(b + 4, 0);
    store8(b + 5, 0);
    store8(b + 6, 0);
    store8(b + 7, 0);
    store8(b + 8, 0);
    store8(b + 9, 0);
    store8(b + 10, 70);
    store8(b + 11, 0);
    store8(b + 12, 0);
    store8(b + 13, 0);
    store8(b + 14, 40);
    store8(b + 15, 0);
    store8(b + 16, 0);
