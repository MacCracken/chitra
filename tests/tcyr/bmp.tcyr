# ---- 0.5.3 audit regression -------------------------------------------
# A 32-bpp BI_BITFIELDS file that declares R/G/B masks but NO alpha mask used
# to fall through to a fixed B,G,R byte read and silently ignore its own masks.
# This fixture's red mask is the LOW byte, so the pre-repair decoder returned
# red and blue swapped — a wrong-output bug with no crash, invisible to the
# fuzzers. Expectations are ImageMagick's decode of the same bytes.
fn test_bmp32_bitfields_no_alpha_mask() {
    var lo = 0;
    var b = fx_bf32_noalpha(&lo);
    var err = 0;
    var img = chitra_bmp_decode(b, lo, &err);
    assert(img != 0, "32bpp BITFIELDS without alpha mask decodes");
    assert_eq(chitra_image_width(img), 2, "bf32-noalpha width");
    var px = chitra_image_pixels(img);
    # masks are R=0x000000FF, G=0x0000FF00, B=0x00FF0000 — i.e. RGB order, the
    # reverse of the BGRA default. Honouring them is the whole point.
    _bpx(px, 0, 200, 100, 50, 255, "bf32-noalpha px0 honours declared masks");
    _bpx(px, 1, 10, 20, 30, 255, "bf32-noalpha px1 honours declared masks");
    return 0;
}

