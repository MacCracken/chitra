# A ~1 KB RLE8 file declaring 4096x4096. BI_RGB cannot do this — its pixel span
# is stride*height and the header check forces the file to carry those bytes —
# but an RLE stream has no computable length, so nothing bounded it. It
# allocated ~84 MB that the bump allocator never reclaims. PNG and JPEG have
# had an amplification cap for cuts; this is the RLE analogue.
fn test_bmp_rle_amplification_bomb() {
    var lo = 0;
    var b = fx_rle_bomb(&lo);
    assert(lo < 2000, "the bomb really is about a kilobyte");
    _breject(b, lo, CHITRA_ERR_DIMENSIONS, "RLE amplification bomb rejected");
    return 0;
}

# The cap must not reject legitimate RLE. Both the ImageMagick-encoded file and
# the hand-built opcode fixtures stay decodable — a cap that refuses valid
# input would be worse than the bug it closes.
fn test_bmp_rle_cap_allows_real_files() {
    var lo = 0;
    var err = 0;
    assert(chitra_bmp_decode(fx_bmp_rle8_real(&lo), lo, &err) != 0,
      "cap allows the ImageMagick-encoded RLE8 file");
    var l2 = 0;
    var e2 = 0;
    assert(chitra_bmp_decode(fx_bmp_rle4(&l2), l2, &e2) != 0,
      "cap allows the hand-built RLE4 fixture");
    return 0;
}

