# tests/tcyr/bmp.tcyr — BMP decode across the whole matrix: the DIB header
# allow-list (12 / 40 / 52 / 56 / 64 OS-2-2.x / 108 V4 / 124 V5), both row
# orders, 1/4/8 bpp palette, 16/24/32 bpp, BI_RLE8 + BI_RLE4 (0.5.1),
# BI_BITFIELDS channel masks (0.5.2), the amplification cap, and the
# permanent BI_JPEG / BI_PNG refusals.
#
# Fixtures are real BMP byte arrays generated by a throwaway python script and
# embedded — no file I/O. Pixel values are deliberately distinct per position
# so a row-order or channel-order mistake cannot pass: BMP stores rows
# BOTTOM-UP and channels as B,G,R, so a decoder that ignored either would
# return the right *set* of pixels in the wrong places.

include "src/lib.cyr"
include "lib/assert.cyr"
fn fx_bmp24_2x2(len_out): i64 {
    var b = alloc(70);
    store64(len_out, 70);
    store8(b + 0, 66);
    store8(b + 1, 77);
    store8(b + 2, 70);
    store8(b + 3, 0);
    store8(b + 4, 0);
    store8(b + 5, 0);
    store8(b + 6, 0);
    store8(b + 7, 0);
    store8(b + 8, 0);
    store8(b + 9, 0);
    store8(b + 10, 54);
    store8(b + 11, 0);
    store8(b + 12, 0);
    store8(b + 13, 0);
    store8(b + 14, 40);
    store8(b + 15, 0);
    store8(b + 16, 0);
    store8(b + 17, 0);
    store8(b + 18, 2);
    store8(b + 19, 0);
    store8(b + 20, 0);
    store8(b + 21, 0);
    store8(b + 22, 2);
    store8(b + 23, 0);
    store8(b + 24, 0);
    store8(b + 25, 0);
    store8(b + 26, 1);
    store8(b + 27, 0);
    store8(b + 28, 24);
    store8(b + 29, 0);
    store8(b + 30, 0);
    store8(b + 31, 0);
    store8(b + 32, 0);
    store8(b + 33, 0);
    store8(b + 34, 0);
    store8(b + 35, 0);
    store8(b + 36, 0);
    store8(b + 37, 0);
    store8(b + 38, 0);
    store8(b + 39, 0);
    store8(b + 40, 0);
    store8(b + 41, 0);
    store8(b + 42, 0);
    store8(b + 43, 0);
    store8(b + 44, 0);
    store8(b + 45, 0);
    store8(b + 46, 0);
    store8(b + 47, 0);
    store8(b + 48, 0);
    store8(b + 49, 0);
    store8(b + 50, 0);
    store8(b + 51, 0);
    store8(b + 52, 0);
    store8(b + 53, 0);
    store8(b + 54, 90);
    store8(b + 55, 80);
    store8(b + 56, 70);
    store8(b + 57, 120);
    store8(b + 58, 110);
    store8(b + 59, 100);
    store8(b + 60, 0);
