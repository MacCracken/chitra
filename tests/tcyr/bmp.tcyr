# ================================================================
# Helpers
# ================================================================
fn _bpx(px, i, r, g, b, a, label) {
    assert_eq(load8(px + i * 4 + 0), r, label);
    assert_eq(load8(px + i * 4 + 1), g, label);
    assert_eq(load8(px + i * 4 + 2), b, label);
    assert_eq(load8(px + i * 4 + 3), a, label);
    return 0;
}

fn _breject(bytes, lo, code, label) {
    var err = 0;
    var img = chitra_bmp_decode(bytes, lo, &err);
    assert(img == 0, label);
    assert(err != 0, label);
    if (err != 0) { assert_eq(chitra_err_code(err), code, label); }
    return 0;
}

# ================================================================
# Signature
# ================================================================
fn test_bmp_signature() {
    var buf[4];
    store8(&buf + 0, 0x42);
    store8(&buf + 1, 0x4D);
    assert_eq(chitra_bmp_check_signature(&buf, 2), 1, "BM is a BMP signature");
    store8(&buf + 1, 0x4E);
    assert_eq(chitra_bmp_check_signature(&buf, 2), 0, "BN is not");
    # length-guarded: a 0/1-byte buffer must be a clean 0, not a read
    assert_eq(chitra_bmp_check_signature(&buf, 0), 0, "len 0 -> 0");
    assert_eq(chitra_bmp_check_signature(&buf, 1), 0, "len 1 -> 0");
    return 0;
}

# ================================================================
# 24 bpp — the canonical case, and the row-order contract.
# The fixture's IMAGE rows are top=(10,20,30),(40,50,60) and
# bottom=(70,80,90),(100,110,120). Bottom-up storage means the FILE's first
# row is the image's LAST row; if the decoder ignored that, px0 would come
# back as (70,80,90) and this assertion is what catches it.
# ================================================================
fn test_bmp24_bottom_up() {
    var lo = 0;
    var b = fx_bmp24_2x2(&lo);
    var err = 0;
    var img = chitra_bmp_decode(b, lo, &err);
    assert(img != 0, "bmp24 decodes");
    assert_eq(chitra_image_width(img), 2, "bmp24 width");
    assert_eq(chitra_image_height(img), 2, "bmp24 height");
    assert_eq(chitra_image_channels(img), 4, "bmp24 channels");
    assert_eq(chitra_image_source_color_type(img), 512 + 24, "bmp24 src_ctype 0x218");
    var px = chitra_image_pixels(img);
    _bpx(px, 0, 10, 20, 30, 255, "bmp24 px(0,0) top-left");
    _bpx(px, 1, 40, 50, 60, 255, "bmp24 px(1,0)");
    _bpx(px, 2, 70, 80, 90, 255, "bmp24 px(0,1)");
    _bpx(px, 3, 100, 110, 120, 255, "bmp24 px(1,1) bottom-right");
    return 0;
}

# A negative header height means top-down. Decoded output must be IDENTICAL
# to the bottom-up fixture above — same image, different storage order.
fn test_bmp24_top_down() {
    var lo = 0;
    var b = fx_bmp24_2x2_topdown(&lo);
    var err = 0;
    var img = chitra_bmp_decode(b, lo, &err);
    assert(img != 0, "bmp24 top-down decodes");
    assert_eq(chitra_image_height(img), 2, "bmp24 top-down height is |h|");
    var px = chitra_image_pixels(img);
    _bpx(px, 0, 10, 20, 30, 255, "topdown px(0,0) matches bottom-up");
    _bpx(px, 3, 100, 110, 120, 255, "topdown px(1,1) matches bottom-up");
    return 0;
}

# ================================================================
# 32 bpp — and the undefined-fourth-byte heuristic.
# ================================================================
fn test_bmp32_alpha() {
    var lo = 0;
    var b = fx_bmp32_2x2_alpha(&lo);
    var err = 0;
    var img = chitra_bmp_decode(b, lo, &err);
    assert(img != 0, "bmp32 decodes");
    assert_eq(chitra_image_source_color_type(img), 512 + 32, "bmp32 src_ctype 0x220");
    var px = chitra_image_pixels(img);
    _bpx(px, 0, 10, 20, 30, 255, "bmp32 px(0,0) alpha 255");
    _bpx(px, 1, 40, 50, 60, 128, "bmp32 px(1,0) alpha honoured");
    _bpx(px, 2, 70, 80, 90, 64, "bmp32 px(0,1) alpha honoured");
    _bpx(px, 3, 100, 110, 120, 0, "bmp32 px(1,1) alpha 0 honoured");
    return 0;
}

# BI_RGB leaves the fourth byte UNDEFINED. When every one of them is zero it is
# padding, not alpha — trusting it would render the whole image invisible. This
# is the case that heuristic exists for.
fn test_bmp32_zero_padding_is_opaque() {
    var lo = 0;
    var b = fx_bmp32_2x2_zeropad(&lo);
    var err = 0;
    var img = chitra_bmp_decode(b, lo, &err);
    assert(img != 0, "bmp32 zero-pad decodes");
    var px = chitra_image_pixels(img);
    _bpx(px, 0, 10, 20, 30, 255, "all-zero 4th byte -> opaque, not invisible");
    _bpx(px, 3, 100, 110, 120, 255, "all-zero 4th byte -> opaque (px3)");
    return 0;
}

# ================================================================
# Indexed depths — palette is B,G,R and indices are MSB-first.
# ================================================================
fn test_bmp8_palette() {
    var lo = 0;
    var b = fx_bmp8_2x2(&lo);
    var err = 0;
    var img = chitra_bmp_decode(b, lo, &err);
    assert(img != 0, "bmp8 decodes");
    assert_eq(chitra_image_source_color_type(img), 512 + 8, "bmp8 src_ctype 0x208");
    var px = chitra_image_pixels(img);
    _bpx(px, 0, 10, 20, 30, 255, "bmp8 px0 -> palette[0]");
    _bpx(px, 1, 40, 50, 60, 255, "bmp8 px1 -> palette[1]");
    _bpx(px, 2, 70, 80, 90, 255, "bmp8 px2 -> palette[2]");
    _bpx(px, 3, 100, 110, 120, 255, "bmp8 px3 -> palette[3]");
    return 0;
}

# 4 bpp packs two pixels per byte, HIGH nibble first. 0x01,0x23 -> 0,1,2,3.
fn test_bmp4_palette() {
    var lo = 0;
    var b = fx_bmp4_4x1(&lo);
    var err = 0;
    var img = chitra_bmp_decode(b, lo, &err);
    assert(img != 0, "bmp4 decodes");
    assert_eq(chitra_image_width(img), 4, "bmp4 width 4");
    var px = chitra_image_pixels(img);
    _bpx(px, 0, 10, 20, 30, 255, "bmp4 high nibble first (px0)");
    _bpx(px, 1, 40, 50, 60, 255, "bmp4 low nibble second (px1)");
    _bpx(px, 2, 70, 80, 90, 255, "bmp4 px2");
    _bpx(px, 3, 100, 110, 120, 255, "bmp4 px3");
    return 0;
}

# 1 bpp, MSB-first: 0xAA = 1,0,1,0,1,0,1,0 against a black/white palette.
fn test_bmp1_palette() {
    var lo = 0;
    var b = fx_bmp1_8x1(&lo);
    var err = 0;
    var img = chitra_bmp_decode(b, lo, &err);
    assert(img != 0, "bmp1 decodes");
    assert_eq(chitra_image_width(img), 8, "bmp1 width 8");
    var px = chitra_image_pixels(img);
    _bpx(px, 0, 255, 255, 255, 255, "bmp1 bit7 set -> white");
    _bpx(px, 1, 0, 0, 0, 255, "bmp1 bit6 clear -> black");
    _bpx(px, 7, 0, 0, 0, 255, "bmp1 bit0 clear -> black");
    return 0;
}

# BITMAPCOREHEADER: 12-byte DIB, 16-bit dims, 3-byte palette entries.
fn test_bmp_core_header() {
    var lo = 0;
    var b = fx_bmpcore24_2x2(&lo);
    var err = 0;
    var img = chitra_bmp_decode(b, lo, &err);
    assert(img != 0, "BITMAPCOREHEADER decodes");
    assert_eq(chitra_image_width(img), 2, "core width");
    var px = chitra_image_pixels(img);
    _bpx(px, 0, 10, 20, 30, 255, "core px0 matches the INFO-header fixture");
    return 0;
}

# ================================================================
# Deferred modes and malformed headers reject with distinct codes.
# ================================================================
# RLE8/RLE4 landed in 0.5.1 and BITFIELDS in 0.5.2, so the only compressions
# still refused are the embedded-stream ones — and those are refused
# PERMANENTLY, not deferred: honouring them re-enters the decoder.
fn test_bmp_reject_compression() {
    var lo = 0;
    var b = fx_bmp24_2x2(&lo);
    store8(b + 30, 4);        # BI_JPEG
    _breject(b, lo, CHITRA_ERR_BMP_COMPRESSION, "BI_JPEG refused");
    var l2 = 0;
    var b2 = fx_bmp24_2x2(&l2);
    store8(b2 + 30, 5);       # BI_PNG
    _breject(b2, l2, CHITRA_ERR_BMP_COMPRESSION, "BI_PNG refused");
    return 0;
}

# 16 bpp decodes as of 0.5.2; only depths outside {1,4,8,16,24,32} reject.
fn test_bmp_reject_depth() {
    var lo = 0;
    var b = fx_bmp24_2x2(&lo);
    store8(b + 28, 7);        # 7 bpp is not a thing
    _breject(b, lo, CHITRA_ERR_BMP_DEPTH, "7 bpp rejected");
    return 0;
}

fn test_bmp_reject_header() {
    var lo = 0;
    _breject(fx_bmp_bad_planes(&lo), lo, CHITRA_ERR_BMP_HEADER, "planes != 1 rejected");
    # V4/V5 headers decode as of 0.5.2; an UNKNOWN size still rejects.
    var l2 = 0;
    var b2 = fx_bmp24_2x2(&l2);
    store8(b2 + 14, 99);      # DIB size 99 matches no defined header
    _breject(b2, l2, CHITRA_ERR_BMP_HEADER, "unknown DIB header size rejected");
    return 0;
}

# A palette index past the declared entry count must HARD REJECT, never read
# past the palette — the same posture as the PNG palette path.
fn test_bmp_reject_palette_index() {
    var lo = 0;
    _breject(fx_bmp8_bad_index(&lo), lo, CHITRA_ERR_BMP_PALETTE, "OOB palette index rejected");
    return 0;
}

fn test_bmp_reject_bad_signature() {
    var buf[16];
    var i = 0;
    while (i < 16) { store8(&buf + i, 0x41); i = i + 1; }
    _breject(&buf, 16, CHITRA_ERR_SIGNATURE, "non-BM rejected at the signature");
    return 0;
}

# Every prefix of a valid BMP must reject cleanly, never read past the buffer.
fn test_bmp_truncation_sweep() {
    var lo = 0;
    var b = fx_bmp24_2x2(&lo);
    var cut = 0;
    var err = 0;
    var img = 0;
    while (cut < lo) {
        err = 0;
        img = chitra_bmp_decode(b, cut, &err);
        assert(img == 0, "truncated BMP rejected");
        assert(err != 0, "truncated BMP sets err_out");
        cut = cut + 1;
    }
    return 0;
}

fn test_bmp_degenerate_lengths() {
    var lo = 0;
    var b = fx_bmp24_2x2(&lo);
    var err = 0;
    assert(chitra_bmp_decode(b, 0, &err) == 0, "len 0 rejected");
    err = 0;
    assert(chitra_bmp_decode(b, 0 - 1, &err) == 0, "negative len rejected");
    assert(err != 0, "negative len sets err_out");
    return 0;
}

# ================================================================
# The router must now sniff three formats.
# ================================================================
fn test_bmp_router() {
    var lo = 0;
    var b = fx_bmp24_2x2(&lo);
    var err = 0;
    var img = chitra_image_decode(b, lo, &err);
    assert(img != 0, "chitra_image_decode routes BMP");
    assert_eq(chitra_image_width(img), 2, "router BMP width");
    var px = chitra_image_pixels(img);
    _bpx(px, 0, 10, 20, 30, 255, "router BMP px0");
    return 0;
}

# The _rgba8 convenience wrapper mirrors the PNG/JPEG pair.
fn test_bmp_rgba8_wrapper() {
    var lo = 0;
    var b = fx_bmp24_2x2(&lo);
    var w = 0;
    var h = 0;
    var px = chitra_bmp_decode_rgba8(b, lo, &w, &h);
    assert(px != 0, "bmp _rgba8 returns pixels");
    assert_eq(w, 2, "bmp _rgba8 width");
    assert_eq(h, 2, "bmp _rgba8 height");
    assert_eq(load8(px + 0), 10, "bmp _rgba8 px0 red");
    # failure path leaves w/h at 0
    var w2 = 0;
    var h2 = 0;
    var buf[4];
    store8(&buf + 0, 0x41);
    assert_eq(chitra_bmp_decode_rgba8(&buf, 4, &w2, &h2), 0, "bmp _rgba8 rejects garbage");
    assert_eq(w2, 0, "bmp _rgba8 leaves w at 0 on failure");
    return 0;
}

