    store8(b + 2, 0x4E);
    store8(b + 10, 0x46);
    store8(b + 14, 0x34);
    store8(b + 18, 0x02);
    store8(b + 22, 0x01);
    store8(b + 26, 0x01);
    store8(b + 28, 0x20);
    store8(b + 30, 0x06);
    store8(b + 38, 0x13);
    store8(b + 39, 0x0B);
    store8(b + 42, 0x13);
    store8(b + 43, 0x0B);
    store8(b + 56, 0xFF);
    store8(b + 59, 0xFF);
    store8(b + 62, 0xFF);
    store8(b + 69, 0xFF);
    store8(b + 70, 0x33);
    store8(b + 71, 0x22);
    store8(b + 72, 0x11);
    store8(b + 73, 0x80);
    store8(b + 74, 0x66);
    store8(b + 75, 0x55);
    store8(b + 76, 0x44);
    store8(b + 77, 0x40);
    return b;
}
