# The BI_RGB default masks used to be injected into ANY file whose colour masks
# were all zero — including a BI_BITFIELDS file that declared none. That did two
# things: it invented a layout the file never stated, and it made the "at least
# one colour channel" guard UNREACHABLE, because the defaults erased exactly the
# condition that guard tests. A guard that cannot fire is a CHANGELOG claim with
# nothing behind it. This file declares an alpha mask and no colour channels.
fn test_bmp_bitfields_no_color_channel_rejected() {
    var lo = 0;
    var b = fx_bf_no_color(&lo);
    _breject(b, lo, CHITRA_ERR_BMP_MASK, "BITFIELDS declaring no colour channel rejected");
    return 0;
}

# ================================================================
# 0.7.2 — BMP loose ends
# ================================================================# OS/2 2.x BITMAPCOREHEADER2 (64 bytes), 2x1 24bpp.
# Its first 40 bytes are laid
# out exactly like BITMAPINFOHEADER, so it parses on the INFO path. ImageMagick
# decodes it to (17,34,51) and (68,85,102); chitra matched byte-for-byte once
# the size was admitted to the allow-list.
fn fx_bmp_os2_64(len_out): i64 {
    var b = alloc(86);
    store64(len_out, 86);
    var i = 0;
    while (i < 86) {
        store8(b + i, 0);
        i = i + 1;
    }
    store8(b + 0, 0x42);
    store8(b + 1, 0x4D);
    store8(b + 2, 0x56);
    store8(b + 10, 0x4E);
    store8(b + 14, 0x40);
    store8(b + 18, 0x02);
    store8(b + 22, 0x01);
    store8(b + 26, 0x01);
    store8(b + 28, 0x18);
    store8(b + 34, 0x08);
    store8(b + 38, 0x13);
    store8(b + 39, 0x0B);
    store8(b + 42, 0x13);
    store8(b + 43, 0x0B);
    store8(b + 78, 0x33);
    store8(b + 79, 0x22);
    store8(b + 80, 0x11);
    store8(b + 81, 0x66);
    store8(b + 82, 0x55);
    store8(b + 83, 0x44);
    return b;
}
# The same header truncated to 16 bytes. The OS/2 2.x spec permits it, but
# below 40 the compression and clrused fields are simply absent and would have
# to be defaulted with nothing to check the defaults against — ImageMagick
# refuses it too ("improper image header"). Stays rejected, deliberately.
fn fx_bmp_os2_16(len_out): i64 {
    var b = alloc(38);
    store64(len_out, 38);
    var i = 0;
    while (i < 38) {
        store8(b + i, 0);
        i = i + 1;
    }
    store8(b + 0, 0x42);
    store8(b + 1, 0x4D);
    store8(b + 2, 0x26);
    store8(b + 10, 0x1E);
    store8(b + 14, 0x10);
    store8(b + 18, 0x02);
    store8(b + 22, 0x01);
    store8(b + 26, 0x01);
    store8(b + 28, 0x18);
    store8(b + 30, 0x33);
    store8(b + 31, 0x22);
    store8(b + 32, 0x11);
    store8(b + 33, 0x66);
    store8(b + 34, 0x55);
    store8(b + 35, 0x44);
    return b;
}
# 52-byte BITMAPV2INFOHEADER declaring BI_ALPHABITFIELDS — four masks, in a
# header with room for three. The per-pixel alphas are 0x80 and 0x40.
fn fx_bmp_v2_alphabits(len_out): i64 {
    var b = alloc(78);
    store64(len_out, 78);
