fn fx_bmp_bitfields(len_out): i64 {
    var b = alloc(70);
    store64(len_out, 70);
    store8(b + 0, 66);
    store8(b + 1, 77);
    store8(b + 2, 70);
    store8(b + 3, 0);
    store8(b + 4, 0);
