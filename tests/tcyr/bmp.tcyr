# The real 8-bit RLE stream ImageMagick ENCODED, decoded back. The three
# hand-built fixtures above prove chitra reads each opcode; this proves it reads
# what a real encoder actually emits.
fn test_bmp_rle8_real_encoder() {
    var lo = 0;
    var b = fx_bmp_rle8_real(&lo);
    var err = 0;
    var img = chitra_bmp_decode(b, lo, &err);
    assert(img != 0, "ImageMagick-encoded RLE8 decodes");
    assert_eq(chitra_image_width(img), 8, "real RLE8 width");
    assert_eq(chitra_image_height(img), 4, "real RLE8 height");
    var px = chitra_image_pixels(img);
    _bpx(px, 0, 255, 0, 0, 255, "real RLE8 px0");
    _bpx(px, 1, 255, 0, 0, 255, "real RLE8 px1");
    _bpx(px, 2, 0, 255, 0, 255, "real RLE8 px2");
    _bpx(px, 7, 255, 255, 0, 255, "real RLE8 px7");
    return 0;
}

# ---- the guards, which are the bulk of the work in RLE ----------------
fn test_bmp_rle_guards() {
    var lo = 0;
    # A delta jumping far outside the bitmap is rejected AT THE JUMP, not left
    # to the per-write check — a delta past the end followed by no writes is
    # still malformed.
    _breject(fx_bmp_rle8_delta_oob(&lo), lo, CHITRA_ERR_BMP_RLE,
      "delta outside the bitmap rejected");
    # An encoded run longer than the row is rejected, never clipped: clipping
    # would silently decode a different image than the file encodes.
    var l2 = 0;
    _breject(fx_bmp_rle8_run_overflow(&l2), l2, CHITRA_ERR_BMP_RLE,
      "run past the row end rejected");
    # Absolute-mode literals that run off the end of the file.
    var l3 = 0;
    _breject(fx_bmp_rle8_absolute_truncated(&l3), l3, CHITRA_ERR_TRUNCATED,
      "absolute run past end-of-file rejected");
    # A stream with no end-of-bitmap escape must terminate on input exhaustion
    # rather than spinning — every opcode consumes >= 2 bytes, so it does.
    var l4 = 0;
    _breject(fx_bmp_rle8_unterminated(&l4), l4, CHITRA_ERR_TRUNCATED,
      "unterminated RLE stream rejected");
    return 0;
}

# RLE is bit-depth specific: RLE8 means 8 bpp, RLE4 means 4 bpp. A mismatch is
# a malformed header, because the payloads mean different things at each depth.
fn test_bmp_rle_depth_mismatch() {
    var lo = 0;
    var b = fx_bmp_rle4(&lo);
    store8(b + 28, 8);        # claim 8 bpp while declaring BI_RLE4
    _breject(b, lo, CHITRA_ERR_BMP_HEADER, "RLE4 with bpp 8 rejected");
    var l2 = 0;
    var b2 = fx_bmp_rle8_absolute(&l2);
    store8(b2 + 28, 4);       # claim 4 bpp while declaring BI_RLE8
    _breject(b2, l2, CHITRA_ERR_BMP_HEADER, "RLE8 with bpp 4 rejected");
    return 0;
}

# MS: "Top-down DIBs cannot be compressed." The end-of-line escape counts rows
# from the bottom, so the two conventions have no consistent meaning together.
fn test_bmp_rle_topdown_rejected() {
    var lo = 0;
    var b = fx_bmp_rle8_absolute(&lo);
    # negate the height field (offset 22, i32 LE): 4 -> -4
    store8(b + 22, 252); store8(b + 23, 255); store8(b + 24, 255); store8(b + 25, 255);
    _breject(b, lo, CHITRA_ERR_BMP_HEADER, "top-down RLE rejected");
    return 0;
}

