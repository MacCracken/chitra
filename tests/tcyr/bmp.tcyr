    store8(b + 1104, 2);
    store8(b + 1105, 0);
    store8(b + 1106, 0);
    store8(b + 1107, 0);
    store8(b + 1108, 2);
    store8(b + 1109, 0);
    store8(b + 1110, 2);
    store8(b + 1111, 1);
    store8(b + 1112, 2);
    store8(b + 1113, 3);
    store8(b + 1114, 2);
    store8(b + 1115, 2);
    store8(b + 1116, 0);
    store8(b + 1117, 0);
    store8(b + 1118, 0);
    store8(b + 1119, 1);
    return b;
}

# ---- 0.5.1: BMP run-length compression -------------------------------
# Expectations are ImageMagick's decode of the same bytes. The RLE4 encoded-run,
# RLE8 absolute and RLE4 absolute fixtures all encode the SAME image by three
# different opcode paths, so they must decode identically — a cross-check the
# single-fixture-per-feature style would miss.

fn test_bmp_rle4() {
    var lo = 0;
    var b = fx_bmp_rle4(&lo);
    var err = 0;
    var img = chitra_bmp_decode(b, lo, &err);
    assert(img != 0, "RLE4 encoded runs decodes");
    assert_eq(chitra_image_width(img), 8, "RLE4 encoded runs width");
    assert_eq(chitra_image_height(img), 4, "RLE4 encoded runs height");
    var px = chitra_image_pixels(img);
    _bpx(px, 0, 255, 0, 0, 255, "RLE4 encoded runs px0");
    _bpx(px, 1, 255, 0, 0, 255, "RLE4 encoded runs px1");
