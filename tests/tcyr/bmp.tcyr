fn fx_bmp32_v4_alpha(len_out): i64 {
    var b = alloc(154);
    store64(len_out, 154);
    store8(b + 0, 66);
    store8(b + 1, 77);
    store8(b + 2, 154);
    store8(b + 3, 0);
    store8(b + 4, 0);
    store8(b + 5, 0);
    store8(b + 6, 0);
    store8(b + 7, 0);
    store8(b + 8, 0);
    store8(b + 9, 0);
    store8(b + 10, 122);
    store8(b + 11, 0);
    store8(b + 12, 0);
