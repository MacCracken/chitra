# The first version of the RLE cap measured against the file length, so
# appending ignored junk raised the attacker's own allowance and let the bomb
# through. It now measures the bytes the stream actually CONSUMED — the only
# denominator an attacker cannot inflate.
fn test_bmp_rle_bomb_resists_padding() {
    var lo = 0;
    var b = fx_rle_bomb_pad(&lo);
    assert(lo > 500000, "the padded bomb really is half a megabyte");
    _breject(b, lo, CHITRA_ERR_DIMENSIONS, "padded RLE bomb still rejected");
    return 0;
}

# Microsoft: the V4/V5 mask fields are "valid only if compression is
# BI_BITFIELDS". Real writers populate them anyway under BI_RGB. Honouring a
# stale alpha mask there rendered the ENTIRE IMAGE transparent — this file's
# alpha bytes are 0 and it must come back fully opaque. ImageMagick agrees.
fn test_bmp_v4_birgb_ignores_stale_masks() {
    var lo = 0;
    var b = fx_v4_birgb(&lo);
    var err = 0;
    var img = chitra_bmp_decode(b, lo, &err);
    assert(img != 0, "V4 + BI_RGB decodes");
    var px = chitra_image_pixels(img);
    _bpx(px, 0, 255, 128, 64, 255, "V4 BI_RGB px0 opaque, masks ignored");
    _bpx(px, 1, 32, 64, 96, 255, "V4 BI_RGB px1 opaque, masks ignored");
    return 0;
}

