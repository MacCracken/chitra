fn _b72_reject(b, lo, code, name): i64 {
    var err = 0;
    var img = chitra_bmp_decode(b, lo, &err);
    assert(img == 0, name);
    assert(err != 0, name);
    if (err != 0) { assert_eq(chitra_err_code(err), code, name); }
    return 0;
}

fn test_bmp_os2_core2_header_decodes() {
    var lo = 0;
    var b = fx_bmp_os2_64(&lo);
    var err = 0;
    var img = chitra_bmp_decode(b, lo, &err);
    assert(img != 0, "64-byte OS/2 BITMAPCOREHEADER2 decodes");
    assert_eq(err, 0, "OS/2 core2: no error");
    if (img != 0) {
        assert_eq(chitra_image_width(img), 2, "OS/2 core2: width 2");
        assert_eq(chitra_image_height(img), 1, "OS/2 core2: height 1");
        # ImageMagick's values for the same bytes.
        assert_eq(load8(chitra_image_pixels(img) + 0), 17, "OS/2 core2 px0.r = 17");
        assert_eq(load8(chitra_image_pixels(img) + 1), 34, "OS/2 core2 px0.g = 34");
        assert_eq(load8(chitra_image_pixels(img) + 2), 51, "OS/2 core2 px0.b = 51");
        assert_eq(load8(chitra_image_pixels(img) + 4), 68, "OS/2 core2 px1.r = 68");
    }
    return 0;
}

fn test_bmp_os2_truncated_header_rejected() {
    var lo = 0;
    _b72_reject(fx_bmp_os2_16(&lo), lo, CHITRA_ERR_BMP_HEADER,
      "16-byte OS/2 header still rejected");
    return 0;
}

fn test_bmp_alphabitfields_without_room_rejected() {
    # BI_ALPHABITFIELDS names four masks; a 52-byte V2 header ends at the blue
    # one. Through 0.7.1 this DECODED, silently opaque — every per-pixel alpha
    # discarded with no error, because the in-header alpha read is gated on
    # V3-or-later. Rejecting beats inventing a location for the fourth mask.
    var lo = 0;
    _b72_reject(fx_bmp_v2_alphabits(&lo), lo, CHITRA_ERR_BMP_MASK,
      "BI_ALPHABITFIELDS with no alpha-mask field rejected");
    return 0;
}

fn test_bmp_rle_end_of_line_overshoot_rejected() {
    # The delta escape has always checked its landing point "even if the stream
    # then writes nothing"; the end-of-line escape did not, so the two overshoot
    # routes in one function disagreed. No write was ever at risk, and
    # ImageMagick accepts this file — a consistency guard, not a repair.
    var lo = 0;
    _b72_reject(fx_bmp_rle_eol_over(&lo), lo, CHITRA_ERR_BMP_RLE,
      "RLE end-of-line past the last row rejected");
    return 0;
}

fn test_bmp_rle_single_trailing_end_of_line_decodes() {
    # The control. `y == h` is legal: one trailing end-of-line after the last
    # row is ordinary output, and a guard at `y >= h` would refuse real files.
    var lo = 0;
    var b = fx_bmp_rle_eol_ok(&lo);
    var err = 0;
    var img = chitra_bmp_decode(b, lo, &err);
    assert(img != 0, "one trailing end-of-line still decodes");
    assert_eq(err, 0, "trailing EOL: no error");
    # BMP rows are bottom-up, so image row 0 is the LAST RLE row.
    if (img != 0) { assert_eq(load8(chitra_image_pixels(img) + 0), 20, "trailing EOL px0 = 20"); }
    return 0;
}

fn main() {
    test_bmp_signature();
    test_bmp24_bottom_up();
    test_bmp24_top_down();
    test_bmp32_alpha();
    test_bmp32_zero_padding_is_opaque();
    test_bmp8_palette();
    test_bmp4_palette();
    test_bmp1_palette();
    test_bmp_core_header();
    test_bmp_reject_compression();
    test_bmp_rle4();
    test_bmp_rle8_absolute();
    test_bmp_rle4_absolute();
    test_bmp_rle8_delta();
    test_bmp_rle8_real_encoder();
    test_bmp_rle_guards();
    test_bmp_rle_depth_mismatch();
    test_bmp_rle_topdown_rejected();
    test_bmp16_rgb555();
    test_bmp16_bitfields565();
    test_bmp32_v4_alpha();
    test_bmp32_v5_alpha();
    test_bmp_mask_guards();
    test_bmp16_is_not_indexed();
    test_bmp32_bitfields_no_alpha_mask();
    test_bmp_rle_amplification_bomb();
    test_bmp_rle_cap_allows_real_files();
    test_bmp_rle_bomb_resists_padding();
    test_bmp_v4_birgb_ignores_stale_masks();
    test_bmp_bitfields_no_color_channel_rejected();
    test_bmp_reject_depth();
    test_bmp_reject_header();
    test_bmp_reject_palette_index();
    test_bmp_reject_bad_signature();
    test_bmp_truncation_sweep();
    test_bmp_degenerate_lengths();
    test_bmp_router();
    test_bmp_rgba8_wrapper();
    test_bmp_os2_core2_header_decodes();
    test_bmp_os2_truncated_header_rejected();
    test_bmp_alphabitfields_without_room_rejected();
    test_bmp_rle_end_of_line_overshoot_rejected();
    test_bmp_rle_single_trailing_end_of_line_decodes();
    return assert_summary();
}
var exit_code = main();
syscall(60, exit_code);
