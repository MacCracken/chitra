# ---- 0.5.2: BI_BITFIELDS, 16 bpp, and the V4/V5 headers ---------------
# Expectations are ImageMagick's decode of the same bytes. The cross-check
# earned its place immediately: it caught that channel scaling must ROUND, not
# truncate — a 5-bit 16 is 131.6/255, and truncating would have put every
# 16-bit pixel one level under the reference.

fn test_bmp16_rgb555() {
    var lo = 0;
    var b = fx_bmp16_rgb555(&lo);
    var err = 0;
    var img = chitra_bmp_decode(b, lo, &err);
    assert(img != 0, "16bpp BI_RGB 5-5-5 decodes");
    assert_eq(chitra_image_width(img), 4, "16bpp BI_RGB 5-5-5 width");
    assert_eq(chitra_image_height(img), 2, "16bpp BI_RGB 5-5-5 height");
    var px = chitra_image_pixels(img);
    _bpx(px, 0, 255, 0, 0, 255, "16bpp BI_RGB 5-5-5 px0");
    _bpx(px, 1, 0, 255, 0, 255, "16bpp BI_RGB 5-5-5 px1");
    _bpx(px, 2, 0, 0, 255, 255, "16bpp BI_RGB 5-5-5 px2");
    _bpx(px, 3, 255, 255, 255, 255, "16bpp BI_RGB 5-5-5 px3");
    _bpx(px, 4, 132, 66, 33, 255, "16bpp BI_RGB 5-5-5 px4");
    _bpx(px, 5, 33, 132, 66, 255, "16bpp BI_RGB 5-5-5 px5");
    _bpx(px, 6, 66, 33, 132, 255, "16bpp BI_RGB 5-5-5 px6");
    _bpx(px, 7, 0, 0, 0, 255, "16bpp BI_RGB 5-5-5 px7");
    return 0;
}

fn test_bmp16_bitfields565() {
    var lo = 0;
    var b = fx_bmp16_bitfields565(&lo);
    var err = 0;
    var img = chitra_bmp_decode(b, lo, &err);
    assert(img != 0, "16bpp BITFIELDS 5-6-5 decodes");
    assert_eq(chitra_image_width(img), 4, "16bpp BITFIELDS 5-6-5 width");
    assert_eq(chitra_image_height(img), 2, "16bpp BITFIELDS 5-6-5 height");
    var px = chitra_image_pixels(img);
    _bpx(px, 0, 255, 0, 0, 255, "16bpp BITFIELDS 5-6-5 px0");
    _bpx(px, 1, 0, 255, 0, 255, "16bpp BITFIELDS 5-6-5 px1");
    _bpx(px, 2, 0, 0, 255, 255, "16bpp BITFIELDS 5-6-5 px2");
    _bpx(px, 3, 255, 255, 255, 255, "16bpp BITFIELDS 5-6-5 px3");
    _bpx(px, 4, 132, 130, 33, 255, "16bpp BITFIELDS 5-6-5 px4");
    _bpx(px, 5, 33, 65, 66, 255, "16bpp BITFIELDS 5-6-5 px5");
    _bpx(px, 6, 66, 195, 132, 255, "16bpp BITFIELDS 5-6-5 px6");
    _bpx(px, 7, 0, 0, 0, 255, "16bpp BITFIELDS 5-6-5 px7");
    return 0;
}

# V4 and V5 carry the masks INSIDE the header (at +40..+55) rather than after
# it. Both encode the same image, so they must decode identically — and their
# declared alpha mask is what RETIRES the 32-bpp alpha heuristic for these
# files: chitra reads the mask instead of inferring from whether the padding
# bytes happen to be zero.

fn test_bmp32_v4_alpha() {
    var lo = 0;
    var b = fx_bmp32_v4_alpha(&lo);
    var err = 0;
    var img = chitra_bmp_decode(b, lo, &err);
    assert(img != 0, "32bpp V4 header + alpha mask decodes");
    assert_eq(chitra_image_width(img), 4, "32bpp V4 header + alpha mask width");
    assert_eq(chitra_image_height(img), 2, "32bpp V4 header + alpha mask height");
    var px = chitra_image_pixels(img);
    _bpx(px, 0, 255, 0, 0, 255, "32bpp V4 header + alpha mask px0");
    _bpx(px, 1, 0, 255, 0, 128, "32bpp V4 header + alpha mask px1");
    _bpx(px, 2, 0, 0, 255, 64, "32bpp V4 header + alpha mask px2");
    _bpx(px, 3, 255, 255, 0, 0, "32bpp V4 header + alpha mask px3");
    _bpx(px, 4, 10, 20, 30, 255, "32bpp V4 header + alpha mask px4");
    _bpx(px, 5, 40, 50, 60, 200, "32bpp V4 header + alpha mask px5");
    _bpx(px, 6, 70, 80, 90, 100, "32bpp V4 header + alpha mask px6");
    _bpx(px, 7, 1, 2, 3, 0, "32bpp V4 header + alpha mask px7");
    return 0;
}

fn test_bmp32_v5_alpha() {
    var lo = 0;
    var b = fx_bmp32_v5_alpha(&lo);
    var err = 0;
    var img = chitra_bmp_decode(b, lo, &err);
    assert(img != 0, "32bpp V5 header + alpha mask decodes");
    assert_eq(chitra_image_width(img), 4, "32bpp V5 header + alpha mask width");
    assert_eq(chitra_image_height(img), 2, "32bpp V5 header + alpha mask height");
    var px = chitra_image_pixels(img);
    _bpx(px, 0, 255, 0, 0, 255, "32bpp V5 header + alpha mask px0");
    _bpx(px, 1, 0, 255, 0, 128, "32bpp V5 header + alpha mask px1");
    _bpx(px, 2, 0, 0, 255, 64, "32bpp V5 header + alpha mask px2");
    _bpx(px, 3, 255, 255, 0, 0, "32bpp V5 header + alpha mask px3");
    _bpx(px, 4, 10, 20, 30, 255, "32bpp V5 header + alpha mask px4");
    _bpx(px, 5, 40, 50, 60, 200, "32bpp V5 header + alpha mask px5");
    _bpx(px, 6, 70, 80, 90, 100, "32bpp V5 header + alpha mask px6");
    _bpx(px, 7, 1, 2, 3, 0, "32bpp V5 header + alpha mask px7");
    return 0;
}

# The masks are attacker-controlled, so all three malformed shapes reject.
fn test_bmp_mask_guards() {
    var lo = 0;
    # 0xA800 is two runs of bits — it names no channel any format produces.
    _breject(fx_bmp16_mask_noncontig(&lo), lo, CHITRA_ERR_BMP_MASK,
      "non-contiguous mask rejected");
    # Two channels claiming the same bit is a contradiction, not a blend.
    var l2 = 0;
    _breject(fx_bmp16_mask_overlap(&l2), l2, CHITRA_ERR_BMP_MASK,
      "overlapping masks rejected");
    # A 24-bit mask on a 16-bpp image reads bits that are not there.
    var l3 = 0;
    _breject(fx_bmp16_mask_toowide(&l3), l3, CHITRA_ERR_BMP_MASK,
      "mask wider than the pixel rejected");
    return 0;
}

# 16 bpp is packed-pixel, not palette-indexed. `bpp < 24` used to be a safe
# shorthand for "indexed" and stopped being one the moment 16 bpp landed; this
# asserts a 16-bit image is not routed through the palette path.
fn test_bmp16_is_not_indexed() {
    var lo = 0;
    var b = fx_bmp16_rgb555(&lo);
    var err = 0;
    var img = chitra_bmp_decode(b, lo, &err);
    assert(img != 0, "16bpp decodes without a palette");
    assert_eq(err, 0, "16bpp leaves err_out at 0");
    assert_eq(chitra_image_source_color_type(img), 512 + 16, "16bpp src_ctype 0x210");
    return 0;
}

