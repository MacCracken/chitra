# Delta moves the write cursor by an attacker-chosen (dx, dy). Pixels it skips
# are never written, so they keep index 0 — ImageMagick resolves them the same
# way, which is what settles the gap semantics rather than assumption.

fn test_bmp_rle8_delta() {
    var lo = 0;
    var b = fx_bmp_rle8_delta(&lo);
    var err = 0;
    var img = chitra_bmp_decode(b, lo, &err);
    assert(img != 0, "RLE8 delta decodes");
    assert_eq(chitra_image_width(img), 8, "RLE8 delta width");
    assert_eq(chitra_image_height(img), 4, "RLE8 delta height");
    var px = chitra_image_pixels(img);
    _bpx(px, 0, 0, 255, 0, 255, "RLE8 delta px0");
    _bpx(px, 1, 0, 255, 0, 255, "RLE8 delta px1");
    _bpx(px, 2, 0, 255, 0, 255, "RLE8 delta px2");
    _bpx(px, 3, 0, 255, 0, 255, "RLE8 delta px3");
    _bpx(px, 4, 0, 255, 0, 255, "RLE8 delta px4");
    _bpx(px, 5, 0, 255, 0, 255, "RLE8 delta px5");
    _bpx(px, 6, 0, 255, 0, 255, "RLE8 delta px6");
