# tests/tcyr/bmp.tcyr — BMP decode: header variants, row order, bit depths,
# palette, and the deferred-mode rejections (0.4.0).
#
# Fixtures are real BMP byte arrays generated by a throwaway python script and
# embedded — no file I/O. Pixel values are deliberately distinct per position
# so a row-order or channel-order mistake cannot pass: BMP stores rows
# BOTTOM-UP and channels as B,G,R, so a decoder that ignored either would
# return the right *set* of pixels in the wrong places.

include "src/lib.cyr"
include "lib/assert.cyr"
fn fx_bmp24_2x2(len_out): i64 {
    var b = alloc(70);
    store64(len_out, 70);
    store8(b + 0, 66);
    store8(b + 1, 77);
