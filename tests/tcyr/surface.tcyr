fn _sf_depth(b, lo, want_ctype, want_depth, name): i64 {
    var err = 0;
    var img = chitra_image_decode(b, lo, &err);
    assert(img != 0, name);
    if (img != 0) {
        assert_eq(chitra_image_source_color_type(img), want_ctype, name);
        assert_eq(chitra_image_source_depth(img), want_depth, name);
    }
    return 0;
}

fn test_source_depth_reports_the_precision_that_was_discarded() {
    # The output is always 8 bits per channel, so without this a depth-16 PNG
    # and a depth-8 one are indistinguishable in the result — and § 13.13
    # rescaling is lossy by construction. A consumer that wants to warn about
    # precision loss, or pick a higher-precision path, has nothing else to key
    # on. Added before the freeze because adding it after is an ABI event.
    var lo = 0;
    _sf_depth(fx_sf_png16(&lo), lo, 0, 16, "depth-16 grayscale PNG reports 16");
    var l2 = 0;
    _sf_depth(fx_sf_png8(&l2), l2, 2, 8, "depth-8 RGB PNG reports 8");
    var l3 = 0;
    _sf_depth(fx_sf_bmp24(&l3), l3, 0x218, 8, "24-bpp BMP reports 8 bits per channel");
    var l4 = 0;
    # 5-6-5: bits per CHANNEL, and the WIDEST one — the number the RGBA8 output
    # was bit-replicated up from. Not bits per pixel, which src_ctype carries.
    _sf_depth(fx_sf_bmp565(&l4), l4, 0x210, 6, "5-6-5 BMP reports 6, its widest channel");
    var l5 = 0;
    _sf_depth(fx_sf_gif(&l5), l5, 0x302, 8, "GIF reports 8 — palette entries are bytes");
    var l6 = 0;
    _sf_depth(fx_sf_jpeg(&l6), l6, 0x103, 8, "baseline JPEG reports 8 by definition");
    return 0;
}

fn test_chitra_image_record_layout_is_append_only() {
    # mabda reads width/height/pixels through accessors compiled against the
    # 0.1.x offsets. Every field added since has gone on the END, and this cell
    # is what would catch a reordering that looks harmless in source.
    assert_eq(IMAGE_WIDTH_OFFSET, 0, "width stays at +0");
    assert_eq(IMAGE_HEIGHT_OFFSET, 8, "height stays at +8");
    assert_eq(IMAGE_PIXELS_OFFSET, 16, "pixels stays at +16");
    assert_eq(IMAGE_CHANNELS_OFFSET, 24, "channels stays at +24");
    assert_eq(IMAGE_SEEN_IEND_OFFSET, 32, "seen_iend stays at +32");
    assert_eq(IMAGE_SRC_CTYPE_OFFSET, 40, "src_ctype stays at +40");
    assert_eq(IMAGE_SRC_DEPTH_OFFSET, 48, "src_depth appended at +48");
    assert_eq(CHITRA_IMAGE_SIZE, 56, "ChitraImage is 56 bytes");
    return 0;
}

fn test_chitra_err_record_is_gpuerr_compatible() {
    # ADR 0003: 16 bytes, +0 code, +8 detail, so a decode failure maps onto
    # mabda's GpuErr without a shim. Widening it is the one change the record
    # cannot take.
    var e = chitra_err_new(CHITRA_ERR_CRC, 0);
    assert(e != 0, "chitra_err_new returns a record");
    assert_eq(chitra_err_code(e), CHITRA_ERR_CRC, "code reads back at +0");
    assert_eq(chitra_err_detail(e), 0, "detail reads back at +8");
    return 0;
}

fn test_error_names_describe_validity_not_capability() {
    # Reworded in 0.9.0. Both codes fire ONLY on genuinely illegal values —
    # chitra decodes Adam7 and every spec-legal depth — so "unsupported" told a
    # consumer the wrong story about its own file. Changing public
    # chitra_err_name output is exactly what the freeze makes expensive, which
    # is why it happened before the freeze rather than after.
    assert_streq(chitra_err_name(CHITRA_ERR_INTERLACE), "illegal interlace method",
      "INTERLACE names an illegal value, not a missing feature");
    assert_streq(chitra_err_name(CHITRA_ERR_BIT_DEPTH), "illegal bit depth for color type",
      "BIT_DEPTH names an illegal combination, not a missing feature");
    # Every code must have a name — a null here is a downstream deref.
    var c = 0;
    while (c <= 34) {
        assert(chitra_err_name(c) != 0, "every error code has a printable name");
        c = c + 1;
    }
    assert(chitra_err_name(99) != 0, "the catch-all has a name too");
    return 0;
}

fn test_signature_predicates_are_reachable_and_exclusive() {
    # kii calls both of these directly. Each must accept its own format and
    # reject the other three, or the router's dispatch order would be load-
    # bearing in a way no caller could see.
    var lo = 0;
    var p = fx_sf_png8(&lo);
    var l2 = 0;
    var j = fx_sf_jpeg(&l2);
    var l3 = 0;
    var g = fx_sf_gif(&l3);
    var l4 = 0;
    var b = fx_sf_bmp24(&l4);
    assert_eq(chitra_png_check_signature(p, lo), 1, "png predicate accepts PNG");
    assert_eq(chitra_png_check_signature(j, l2), 0, "png predicate rejects JPEG");
    assert_eq(chitra_jpeg_check_signature(j, l2), 1, "jpeg predicate accepts JPEG");
    assert_eq(chitra_jpeg_check_signature(p, lo), 0, "jpeg predicate rejects PNG");
    assert_eq(chitra_gif_check_signature(g, l3), 1, "gif predicate accepts GIF");
    assert_eq(chitra_bmp_check_signature(b, l4), 1, "bmp predicate accepts BMP");
    assert_eq(chitra_bmp_check_signature(g, l3), 0, "bmp predicate rejects GIF");
    return 0;
}

fn test_version_is_packed_consistently() {
    # major*10000 + minor*100 + patch. make version-check gates this against
    # VERSION; the cell exists so a consumer's compile-time comparison has a
    # runtime counterpart.
    assert(chitra_version() > 0, "chitra_version is non-zero");
    assert(chitra_version() >= 10000, "chitra_version is at least 1.0.0");
    return 0;
}

fn main(): i64 {
    test_source_depth_reports_the_precision_that_was_discarded();
    test_chitra_image_record_layout_is_append_only();
    test_chitra_err_record_is_gpuerr_compatible();
    test_error_names_describe_validity_not_capability();
    test_signature_predicates_are_reachable_and_exclusive();
    test_version_is_packed_consistently();
    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
