# 4x4 24-bpp BMP.
fn fx_sf_bmp24(len_out): i64 {
    var b = alloc(102);
    store64(len_out, 102);
    var i = 0;
    while (i < 102) {
        store8(b + i, 0);
        i = i + 1;
    }
    store8(b + 0, 0x42);
    store8(b + 1, 0x4D);
    store8(b + 2, 0x66);
    store8(b + 10, 0x36);
    store8(b + 14, 0x28);
    store8(b + 18, 0x04);
    store8(b + 22, 0x04);
    store8(b + 26, 0x01);
    store8(b + 28, 0x18);
    store8(b + 34, 0x30);
    store8(b + 54, 0xFF);
    store8(b + 57, 0xFF);
    store8(b + 60, 0xFF);
    store8(b + 63, 0xFF);
    store8(b + 66, 0xAA);
    store8(b + 68, 0x55);
    store8(b + 69, 0xAA);
    store8(b + 71, 0x55);
    store8(b + 72, 0xAA);
    store8(b + 74, 0x55);
    store8(b + 75, 0xAA);
    store8(b + 77, 0x55);
    store8(b + 78, 0x55);
    store8(b + 80, 0xAA);
    store8(b + 81, 0x55);
    store8(b + 83, 0xAA);
    store8(b + 84, 0x55);
    store8(b + 86, 0xAA);
    store8(b + 87, 0x55);
    store8(b + 89, 0xAA);
    store8(b + 92, 0xFF);
    store8(b + 95, 0xFF);
    store8(b + 98, 0xFF);
    store8(b + 101, 0xFF);
    return b;
}

# 2x1 16-bpp BI_BITFIELDS BMP, 5-6-5.
fn fx_sf_bmp565(len_out): i64 {
    var b = alloc(70);
    store64(len_out, 70);
    var i = 0;
    while (i < 70) {
        store8(b + i, 0);
        i = i + 1;
    }
    store8(b + 0, 0x42);
    store8(b + 1, 0x4D);
    store8(b + 2, 0x46);
    store8(b + 10, 0x42);
    store8(b + 14, 0x34);
    store8(b + 18, 0x02);
    store8(b + 22, 0x01);
    store8(b + 26, 0x01);
    store8(b + 28, 0x10);
    store8(b + 30, 0x03);
    store8(b + 38, 0x13);
    store8(b + 39, 0x0B);
    store8(b + 42, 0x13);
    store8(b + 43, 0x0B);
    store8(b + 55, 0xF8);
    store8(b + 58, 0xE0);
    store8(b + 59, 0x07);
    store8(b + 62, 0x1F);
    store8(b + 66, 0x1F);
    store8(b + 67, 0xF8);
    store8(b + 68, 0xE0);
    store8(b + 69, 0x07);
    return b;
}

# 4x4 GIF.
fn fx_sf_gif(len_out): i64 {
    var b = alloc(54);
