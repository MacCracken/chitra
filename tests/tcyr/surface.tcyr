# tests/tcyr/surface.tcyr — the public surface itself (0.9.0).
#
# Everything here is about the API rather than about decoding: the accessors a
# consumer reads, the error names it prints, and the record layout it depends
# on. These are the assertions that make "the surface is frozen" checkable
# rather than merely asserted, and they are deliberately in one file so that a
# freeze review has one place to look.
#
# Known consumers, which is why these particular names matter:
#   mabda — chitra_png_decode_rgba8, chitra_jpeg_decode_rgba8.
#   kii   — chitra_image_decode, chitra_image_{width,height,pixels,seen_iend,
#           source_color_type}, chitra_{png,jpeg}_check_signature,
#           chitra_err, chitra_err_code.
include "src/lib.cyr"
include "lib/assert.cyr"

# 8x1 depth-16 grayscale PNG with samples chosen so rescaling is visible.
fn fx_sf_png16(len_out): i64 {
    var b = alloc(83);
    store64(len_out, 83);
    var i = 0;
    while (i < 83) {
        store8(b + i, 0);
        i = i + 1;
    }
    store8(b + 0, 0x89);
    store8(b + 1, 0x50);
    store8(b + 2, 0x4E);
    store8(b + 3, 0x47);
    store8(b + 4, 0x0D);
    store8(b + 5, 0x0A);
    store8(b + 6, 0x1A);
    store8(b + 7, 0x0A);
    store8(b + 11, 0x0D);
    store8(b + 12, 0x49);
    store8(b + 13, 0x48);
    store8(b + 14, 0x44);
    store8(b + 15, 0x52);
    store8(b + 19, 0x08);
    store8(b + 23, 0x01);
    store8(b + 24, 0x10);
    store8(b + 29, 0x96);
    store8(b + 30, 0xFB);
    store8(b + 31, 0x6C);
    store8(b + 32, 0xDC);
    store8(b + 36, 0x1A);
    store8(b + 37, 0x49);
    store8(b + 38, 0x44);
    store8(b + 39, 0x41);
    store8(b + 40, 0x54);
    store8(b + 41, 0x78);
    store8(b + 42, 0x9C);
    store8(b + 43, 0x63);
    store8(b + 44, 0x60);
    store8(b + 45, 0x60);
    store8(b + 46, 0x60);
    store8(b + 47, 0xF8);
    store8(b + 48, 0xCF);
    store8(b + 49, 0xC8);
    store8(b + 50, 0xC0);
    store8(b + 51, 0xF8);
    store8(b + 52, 0xBF);
    store8(b + 53, 0xFE);
    store8(b + 54, 0x7F);
    store8(b + 55, 0x43);
    store8(b + 56, 0xC3);
    store8(b + 57, 0xBF);
    store8(b + 58, 0xFF);
    store8(b + 59, 0xFF);
    store8(b + 60, 0xFF);
    store8(b + 61, 0x03);
    store8(b + 63, 0x30);
    store8(b + 64, 0x74);
    store8(b + 65, 0x08);
    store8(b + 66, 0x7A);
    store8(b + 67, 0x0C);
    store8(b + 68, 0x6B);
    store8(b + 69, 0x5A);
    store8(b + 70, 0xDD);
    store8(b + 75, 0x49);
    store8(b + 76, 0x45);
    store8(b + 77, 0x4E);
    store8(b + 78, 0x44);
    store8(b + 79, 0xAE);
    store8(b + 80, 0x42);
    store8(b + 81, 0x60);
    store8(b + 82, 0x82);
    return b;
}

