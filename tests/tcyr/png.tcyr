# ---- 0.5.3 audit regressions ------------------------------------------
# 0.3.3's H-1 made the depth-8/16 tRNS key a FULL-WIDTH compare, but the
# sub-byte grayscale path kept reading only the low byte. A key of 0x0105 names
# no 4-bit sample (max 15), yet the low byte 5 aliased onto a real one and
# turned those pixels transparent. Assembling both bytes makes it match
# nothing, which is correct. ImageMagick reaches the same outcome by a
# different route — it warns "tRNS chunk has out-of-range samples for
# bit_depth" and ignores the key.
fn test_subbyte_trns_out_of_range_key() {
    var lo = 0;
    var b = fx_gray4_oob_key(&lo);
    var err = 0;
    var img = chitra_png_decode(b, lo, &err);
    assert(img != 0, "gray4 with an out-of-range tRNS key decodes");
    var px = chitra_image_pixels(img);
    # samples 0,5,10,15 -> scaled x17; NONE may be keyed transparent
    _assert_px(px, 0, 0, 0, 0, 255, "oob-key px0 opaque");
    _assert_px(px, 1, 85, 85, 85, 255, "oob-key px1 (sample 5) NOT keyed");
    _assert_px(px, 2, 170, 170, 170, 255, "oob-key px2 opaque");
    _assert_px(px, 3, 255, 255, 255, 255, "oob-key px3 opaque");
    return 0;
}

# Spec § 5.6 / § 11.3.2: for a palette image tRNS must FOLLOW PLTE — its
# entries are per-palette-entry alphas and mean nothing before the palette they
# index exists. 0.3.3's comment claimed this rule; the code enforced only
# at-most-once and before-IDAT until 0.5.3. Note ImageMagick TOLERATES this
# ordering; chitra rejects it, consistent with its posture elsewhere (it also
# rejects unknown critical chunks per § 5.4, which many decoders skip).
fn test_palette_trns_before_plte_rejected() {
    var lo = 0;
    var b = fx_pal_trns_before_plte(&lo);
    var err = 0;
    var img = chitra_png_decode(b, lo, &err);
    assert(img == 0, "tRNS before PLTE rejected");
    assert(err != 0, "tRNS before PLTE sets err_out");
    if (err != 0) {
        assert_eq(chitra_err_code(err), CHITRA_ERR_BAD_CHUNK, "tRNS before PLTE -> BAD_CHUNK");
    }
    return 0;
}

# ================================================================
# 0.7.1 — chunks the spec FORBIDS, which chitra silently accepted
#
# Three rules from PNG § 5.6 and § 11.2.3 / § 11.3.2 that went unenforced. Each
# was found by reading the code, not by any marker in it, and each left chitra's
# posture inverted: it has rejected tRNS-before-PLTE since 0.5.3 — an ordering
# ImageMagick tolerates — while accepting chunks the spec forbids outright.
#
# ImageMagick accepts all three of these files. chitra rejects them, which is
# the same call it already made for chunk ordering: a stream whose structure
# contradicts its own header is not something to render a guess from.
#
# Regenerate: see the python3 recipe in the 0.7.1 CHANGELOG entry.
# ================================================================
