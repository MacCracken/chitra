# ---- 0.3.3 chunk-ordering / § 5.4 hardening regressions ---------------
fn _expect_reject(bytes, lo, code, label) {
    var err = 0;
    var img = chitra_png_decode(bytes, lo, &err);
    assert(img == 0, label);
    assert(err != 0, label);
    if (err != 0) { assert_eq(chitra_err_code(err), code, label); }
    return 0;
}

fn test_reject_plte_after_empty_idat() {
    var lo = 0;
    var b = fx_plte_after_empty_idat(&lo);
    _expect_reject(b, lo, CHITRA_ERR_BAD_CHUNK, "PLTE after zero-length IDAT rejected");
    return 0;
}

fn test_reject_duplicate_trns() {
    var lo = 0;
    var b = fx_trns_duplicate(&lo);
    _expect_reject(b, lo, CHITRA_ERR_BAD_CHUNK, "duplicate tRNS rejected");
    return 0;
}

fn test_reject_trns_after_idat() {
    var lo = 0;
    var b = fx_trns_after_idat(&lo);
    _expect_reject(b, lo, CHITRA_ERR_BAD_CHUNK, "tRNS after IDAT rejected");
    return 0;
}

fn test_reject_unknown_critical_chunk() {
    var lo = 0;
    var b = fx_unknown_critical(&lo);
    _expect_reject(b, lo, CHITRA_ERR_UNSUPPORTED, "unknown critical chunk rejected (§ 5.4)");
    return 0;
}

# The control: § 5.4 rejection must NOT have become blanket rejection.
# An unknown ANCILLARY chunk stays skippable and the image still decodes.
fn test_unknown_ancillary_chunk_still_decodes() {
    var lo = 0;
    var b = fx_unknown_ancillary(&lo);
    var err = 0;
    var img = chitra_png_decode(b, lo, &err);
    assert(img != 0, "unknown ancillary chunk still decodes");
    assert(err == 0, "unknown ancillary chunk sets no error");
    if (img != 0) {
        assert(chitra_image_width(img) == 2, "ancillary-chunk image width 2");
        var px = chitra_image_pixels(img);
        _assert_px(px, 0, 10, 10, 10, 255, "ancillary-chunk px0 intact");
    }
    return 0;
}

fn test_decode_gray16_trns() {
    var lo = 0;
    var bytes = fx_gray16_trns_2x1(&lo);
    var err = 0;
    var img = chitra_png_decode(bytes, lo, &err);
    assert(img != 0, "gray16t ok");
    var px = chitra_image_pixels(img);
    _assert_px(px, 0, 18, 18, 18, 0, "gray16t px0 keyed");
    _assert_px(px, 1, 255, 255, 255, 255, "gray16t px1");
    return 0;
}

# Regression (0.3.3): the depth-16 tRNS color key must be compared at FULL
# sample width. px0 (0x1234) is the key and is transparent; px1 (0x12FF)
# shares the key's high byte and reduces to the SAME 8-bit output value, so
# a high-byte-only comparison made it transparent too — 256x too many pixels
# keyed. px1 must come back OPAQUE.
fn test_decode_gray16_trns_no_high_byte_alias() {
    var lo = 0;
    var bytes = fx_gray16_trns_alias_3x1(&lo);
    var err = 0;
    var img = chitra_png_decode(bytes, lo, &err);
    assert(img != 0, "gray16t-alias decodes");
    assert(chitra_image_width(img) == 3, "gray16t-alias width 3");
    var px = chitra_image_pixels(img);
    _assert_px(px, 0, 18, 18, 18, 0, "gray16t-alias px0 (0x1234 == key) keyed");
    # 0x12FF rescales to 19, and the point of the cell is unchanged: it is NOT
    # keyed transparent, because the tRNS compare is full-width. Reading the
    # rescaled value here would key on the wrong number entirely.
    _assert_px(px, 1, 19, 19, 19, 255, "gray16t-alias px1 (0x12FF) NOT keyed");
    _assert_px(px, 2, 255, 255, 255, 255, "gray16t-alias px2 opaque");
    return 0;
}

