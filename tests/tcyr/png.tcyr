    store8(b + 44, 0xE0);
    store8(b + 45, 0x3A);
    store8(b + 46, 0xA0);
    store8(b + 47, 0x5B);
    store8(b + 48, 0xF3);
    store8(b + 49, 0xFC);
    store8(b + 53, 0x06);
    store8(b + 54, 0x49);
    store8(b + 55, 0x44);
    store8(b + 56, 0x41);
    store8(b + 57, 0x54);
    store8(b + 58, 0x01);
    store8(b + 61, 0xDF);
    store8(b + 63, 0xD3);
    store8(b + 64, 0x62);
    store8(b + 65, 0xA5);
    store8(b + 66, 0x3B);
    store8(b + 67, 0x06);
    store8(b + 72, 0x49);
    store8(b + 73, 0x45);
    store8(b + 74, 0x4E);
    store8(b + 75, 0x44);
    store8(b + 76, 0xAE);
    store8(b + 77, 0x42);
    store8(b + 78, 0x60);
    store8(b + 79, 0x82);
    return b;
}

fn _conf_reject(b, lo, name): i64 {
    var err = 0;
    var img = chitra_png_decode(b, lo, &err);
    assert(img == 0, name);
    assert(err != 0, name);
    if (err != 0) { assert_eq(chitra_err_code(err), CHITRA_ERR_BAD_CHUNK, name); }
    return 0;
}

fn test_reject_plte_on_grayscale() {
    # § 11.2.3: PLTE is required for colour type 3, optional for 2 and 6 (a
    # suggested palette), and forbidden for 0 and 4 — a greyscale image has no
    # palette to suggest. Accepted and ignored through 0.7.0.
    var lo = 0;
    _conf_reject(fx_png_plte_on_gray(&lo), lo, "PLTE on colour type 0 rejected");
    return 0;
}

fn test_reject_trns_on_rgba() {
    # § 11.3.2: tRNS is forbidden for colour types 4 and 6, which already carry
    # a full alpha channel — a tRNS there is a second, contradictory statement
    # about the same pixels. Accepted and ignored through 0.7.0, which is the
    # inversion this cut fixes: chitra refused a legal ordering while accepting
    # an illegal chunk.
    var lo = 0;
    _conf_reject(fx_png_trns_on_rgba(&lo), lo, "tRNS on colour type 6 rejected");
    return 0;
}

fn test_reject_chunk_between_idats() {
    # § 5.6: "there shall not be any other chunks between the IDAT chunks".
    # chitra fused every IDAT it met regardless of what sat between them, so
    # this file decoded as though the two payloads were adjacent — a different
    # image than the file describes, with no error.
    var lo = 0;
    _conf_reject(fx_png_idat_split_by_text(&lo), lo, "tEXt between IDATs rejected");
    return 0;
}

fn test_consecutive_idats_still_decode() {
    # The control, and the reason the guard is a `idat_closed` flag rather than
    # "more than one IDAT". Multiple IDAT chunks are not merely legal, they are
    # the normal shape of any PNG over 8 KB — a guard that rejected them would
    # break almost every real file. This cell passes both before and after the
    # repair, which is what makes it a control.
    var lo = 0;
    var b = fx_png_idat_split_ok(&lo);
    var err = 0;
    var img = chitra_png_decode(b, lo, &err);
    assert(img != 0, "consecutive IDATs still decode");
    assert_eq(err, 0, "consecutive IDATs: no error");
    if (img != 0) {
        assert_eq(load8(chitra_image_pixels(img) + 0), 10, "split IDAT px0 = 10");
        assert_eq(load8(chitra_image_pixels(img) + 4), 200, "split IDAT px1 = 200");
    }
    return 0;
}

# ================================================================
# 1.0.1 — an image too large for the linked decompressor is REFUSED BEFORE
# ALLOCATING, with its own error code.
# ================================================================
# ⛔⛔ WHAT THIS EXISTS TO PIN, AND WHY IT IS NOT A COSMETIC ERROR-CODE CHANGE.
# `CHITRA_MAX_RAW_BYTES` is 256 MB — **sixteen times** what the linked `sankoch` will emit
# (`DECOMPRESS_MAX_OUTPUT`, 16 MiB, enforced identically by its one-shot and streaming decoders, so
# no entry point exceeds it). So a 4096x2160 RGB PNG passed every guard, chitra allocated the IDAT
# concatenation AND a 26.5 MB inflate buffer, and `zlib_decompress` then refused.
# ⚠ MEASURED BY crab, 2026-08-31: **26,617,512 bytes spent to return 0** — and cyrius's allocator is
# a bump allocator with no `free()`, so those bytes never came back. A consumer thumbnailing a photo
# directory ran itself out of memory learning nothing.
#
# The fixture declares 3000x3000 RGB: inflated = 3000 * (1 + 3000*3) = 27,003,000 bytes, past the
# ceiling. ⚠ Its IDAT is 25,000 bytes of filler — never inflated, because the refusal happens first
# — sized only to keep `inflated/idat` under `CHITRA_MAX_INFLATE_RATIO` so this reaches the new
# check rather than the bomb cap. That sizing is the whole point of the second test below.
fn fx_oversize_rgb(len_out, idat_len): i64 {
    var total = 8 + 25 + (12 + idat_len) + 12;
    var b = alloc(total);
    var o = 0;
    # signature
    store8(b + 0, 137); store8(b + 1, 80); store8(b + 2, 78); store8(b + 3, 71);
    store8(b + 4, 13); store8(b + 5, 10); store8(b + 6, 26); store8(b + 7, 10);
    o = 8;
    # IHDR: length 13, "IHDR", w=3000, h=3000, depth 8, colour 2 (RGB), 0,0,0
    store8(b + o, 0); store8(b + o + 1, 0); store8(b + o + 2, 0); store8(b + o + 3, 13);
    o = o + 4;
    var tstart = o;
    store8(b + o, 73); store8(b + o + 1, 72); store8(b + o + 2, 68); store8(b + o + 3, 82);
    o = o + 4;
    store8(b + o, 0); store8(b + o + 1, 0); store8(b + o + 2, 11); store8(b + o + 3, 184);   # 3000
    o = o + 4;
    store8(b + o, 0); store8(b + o + 1, 0); store8(b + o + 2, 11); store8(b + o + 3, 184);   # 3000
    o = o + 4;
    store8(b + o, 8); store8(b + o + 1, 2); store8(b + o + 2, 0);
    store8(b + o + 3, 0); store8(b + o + 4, 0);
    o = o + 5;
    crc32_init_table();
    var c1 = crc32(b + tstart, 17);
    store8(b + o, (c1 >> 24) & 255); store8(b + o + 1, (c1 >> 16) & 255);
    store8(b + o + 2, (c1 >> 8) & 255); store8(b + o + 3, c1 & 255);
    o = o + 4;
    # IDAT: filler bytes. Never read — the refusal happens before any inflate.
    store8(b + o, (idat_len >> 24) & 255); store8(b + o + 1, (idat_len >> 16) & 255);
    store8(b + o + 2, (idat_len >> 8) & 255); store8(b + o + 3, idat_len & 255);
    o = o + 4;
    var istart = o;
    store8(b + o, 73); store8(b + o + 1, 68); store8(b + o + 2, 65); store8(b + o + 3, 84);
    o = o + 4;
    var i = 0;
    while (i < idat_len) { store8(b + o + i, (i * 7) & 255); i = i + 1; }
    o = o + idat_len;
    var c2 = crc32(b + istart, 4 + idat_len);
    store8(b + o, (c2 >> 24) & 255); store8(b + o + 1, (c2 >> 16) & 255);
    store8(b + o + 2, (c2 >> 8) & 255); store8(b + o + 3, c2 & 255);
    o = o + 4;
    # IEND
    store8(b + o, 0); store8(b + o + 1, 0); store8(b + o + 2, 0); store8(b + o + 3, 0);
    o = o + 4;
    var estart = o;
    store8(b + o, 73); store8(b + o + 1, 69); store8(b + o + 2, 78); store8(b + o + 3, 68);
    o = o + 4;
    var c3 = crc32(b + estart, 4);
    store8(b + o, (c3 >> 24) & 255); store8(b + o + 1, (c3 >> 16) & 255);
    store8(b + o + 2, (c3 >> 8) & 255); store8(b + o + 3, c3 & 255);
    o = o + 4;
    store64(len_out, o);
    return b;
}

fn test_inflate_limit_is_its_own_error() {
    var lo = 0;
    var bytes = fx_oversize_rgb(&lo, 25000);
    var err = 0;
    # ⭐ THE COST IS THE HEADLINE. Before 1.0.1 this call allocated ~26.6 MB before failing; the
    # refusal is now a comparison against a number already computed.
    var before = alloc_used();
    var raw = _chitra_png_parse_raw(bytes, lo, &err);
    var spent = alloc_used() - before;
    assert_eq(raw, 0, "an image past the decompressor ceiling is refused");
    assert_eq(chitra_err_code(err), CHITRA_ERR_INFLATE_LIMIT,
      "...with its OWN code, not a bare CHITRA_ERR_INFLATE");
    # ⛔ THE WHOLE POINT: refused CHEAPLY. A generous bound rather than an exact one, because the
    # allocator's alignment and the err record are not this test's business — but it is three orders
    # of magnitude below the 26,617,512 bytes the old path spent.
    assert(spent < 65536, "...and BEFORE allocating the inflate buffer (< 64 KiB spent)");
    return 0;
}

# ⛔ A DECOMPRESSION BOMB MUST STILL REPORT AS A BOMB. The new check sits AFTER the ratio cap
# precisely so that a tiny IDAT claiming an enormous image keeps its `CHITRA_ERR_DIMENSIONS`
# classification — a first draft checked first and silently reclassified every bomb as "too large
# for this decompressor", which tells a caller the file is fine when it is hostile.
fn test_bomb_still_reports_as_a_bomb() {
    var lo = 0;
    # ⛔ A REAL BOMB, BUILT AS ONE — same 3000x3000 IHDR, but only 8 bytes of IDAT, so
    # inflated/idat = 3,375,375 against a `CHITRA_MAX_INFLATE_RATIO` of 1100.
    # ⚠ A FIRST DRAFT BUILT THIS BY OVERWRITING THE 25,000-BYTE FIXTURE'S LENGTH FIELD IN PLACE, and
    # that made the test VACUOUS: the chunk CRC no longer matched, so `CHITRA_ERR_CRC` fired before
    # either cap and the assertion below passed without the bomb path ever running. It was caught by
    # a mutation — moving the ceiling check before the bomb caps — that the test failed to detect.
    # ⇒ Build the fixture you mean to test; do not corrupt another one into it.
    var bytes = fx_oversize_rgb(&lo, 8);
    var err = 0;
    var raw = _chitra_png_parse_raw(bytes, lo, &err);
    assert_eq(raw, 0, "a bomb is still refused");
    assert_eq(chitra_err_code(err), CHITRA_ERR_DIMENSIONS,
      "...as CHITRA_ERR_DIMENSIONS — a bomb is a hostile file, not merely a large one");
    assert(chitra_err_code(err) != CHITRA_ERR_INFLATE_LIMIT,
      "...and specifically NOT as a decompressor-ceiling refusal");
    return 0;
}

# ================================================================
# B-1 (1.0.3) — sankoch's CRC-table allocation can fail, and its return
# is load-bearing.
#
# ⛔⛔ THIS TEST MUST RUN FIRST, and it detects for itself when it does not.
# `crc32_init_table()` builds a 16 KB slice-by-8 table once per process and
# early-returns forever after, so the failure path is reachable ONLY on the
# first PNG decode. If this is moved below any other decode the table is
# already built, the injected failure never fires, the decode SUCCEEDS, and
# the first assertion below fails loudly rather than passing vacuously.
#
# ⚠ THE INJECTION INDEX IS SANKOCH'S INTERNAL ORDER, NOT OURS — AND IT HAS
# ALREADY MOVED ONCE. Through sankoch 2.7.x the arena canary was armed with
# `_sankoch_alloc(8)`, which consumed injection index 0, so the table was #1.
# sankoch 2.8.x (the 6.6.20 pin, 1.0.4) arms it with a plain `alloc(8)`, so
# the table is now #0 — and index 1 landed inside zlib_decompress, refusing
# the decode as CHITRA_ERR_INFLATE (5) while the CRC table built fine. (That
# code was itself the misclassification png-2 repaired in 1.1.1: an allocation
# failure inside zlib_decompress is now CHITRA_ERR_OOM — see
# test_inflate_oom_is_oom_not_inflate.)
# ⇒ The `crc32_table` assertions below pin WHICH allocation failed, so the
# next reorder fails as "the injection missed the table", not as a code
# mismatch that reads like a chitra regression.
#
# ⚠ MUTATION-CHECKED (1.0.3 at index 1; re-checked 1.0.4 at index 0). Against
# the pre-repair line (`crc32_init_table();`, return discarded) this does not
# fail — it SIGSEGVs, exit 139, reading through a NULL table base from
# _chitra_parse_ihdr's crc32() call.
# ================================================================
fn test_crc_table_oom_is_reported_not_dereferenced() {
    var lo = 0;
    var bytes = fx_rgba8_2x2(&lo);
    assert_eq(crc32_table, 0,
      "the CRC table is unbuilt before the first decode (if this fails, the test is no longer first in main())");
    # Fail the FIRST fault-injectable sankoch allocation of this process: the CRC table.
    _sankoch_alloc_set_fail_at(0);
    var err = 0;
    var img = chitra_png_decode(bytes, lo, &err);
    assert_eq(crc32_table, 0,
      "...and the injected failure landed on the CRC table (else sankoch's alloc order moved)");
    assert_eq(img, 0, "CRC-table OOM refuses the decode");
    assert_eq(chitra_err_code(err), CHITRA_ERR_OOM,
      "...as CHITRA_ERR_OOM, the documented allocation-failure contract");
    # Leave the injector disarmed so the rest of the suite is unaffected.
    _sankoch_alloc_set_fail_at(0 - 1);
    # And prove the arena is still usable: the very next decode succeeds.
    var err2 = 0;
    var img2 = chitra_png_decode(bytes, lo, &err2);
    assert_neq(img2, 0, "a refused CRC-table alloc does not poison the next decode");
    return 0;
}

# ================================================================
# B-12 (1.0.3) — the four frozen `_rgba8` wrappers had no test that could tell
# width from height.
#
# ⛔ NOT A LIVE DEFECT — A BLIND SPOT IN THE GATE STACK. Every wrapper test in
# the tree used a SQUARE fixture (PNG 2x2, BMP 2x2, GIF 4x4, JPEG 16x16), so
# swapping the two stores in `chitra_png_decode_rgba8` — transposing the
# dimensions a caller gets back — passed all 13 suites, all 3,035 assertions and
# all 10.7 M fuzz assertions with nothing red. Verified by doing exactly that.
# `chitra_png_decode_rgba8` is mabda's primary entry point, and a transposed
# w/h uploads a garbled texture with no ChitraErr to show for it.
#
# ⚠ Only `jpeg_noninterleaved.tcyr`'s 24x16 cell could see it, and only for
# JPEG. These fixtures close the other three, and the assertions below compare
# the wrapper's w/h against the FULL decoder's accessors on the same bytes —
# so the two entry points cannot disagree either.
# ================================================================
# 3x2 RGB8 PNG — 3x2, deliberately NON-SQUARE (B-12, 1.0.3).
