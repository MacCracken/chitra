    _gpx(px, 47, 255, 0, 0, 255, "interlaced 8x8 GIF px47");
    _gpx(px, 48, 0, 0, 255, 255, "interlaced 8x8 GIF px48");
    _gpx(px, 49, 255, 255, 0, 255, "interlaced 8x8 GIF px49");
    _gpx(px, 50, 255, 0, 0, 255, "interlaced 8x8 GIF px50");
    _gpx(px, 51, 0, 255, 0, 255, "interlaced 8x8 GIF px51");
    _gpx(px, 52, 0, 0, 255, 255, "interlaced 8x8 GIF px52");
    _gpx(px, 53, 255, 255, 0, 255, "interlaced 8x8 GIF px53");
    _gpx(px, 54, 255, 0, 0, 255, "interlaced 8x8 GIF px54");
