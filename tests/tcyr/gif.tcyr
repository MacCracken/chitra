fn test_gif_bomb_resists_padding() {
    var lo = 0;
    var b = fx_gif_bomb_pad(&lo);
    assert(lo > 500000, "the padded bomb really is half a megabyte");
    _greject(b, lo, CHITRA_ERR_DIMENSIONS, "padded GIF bomb still rejected");
    return 0;
}

# ================================================================
# 0.6.1 — the optimised-animation shape the 0.5.3 canvas cap rejected
#
# An 8x8 ImageMagick GIF whose Logical Screen Descriptor has been patched to a
# 1920x1080 canvas. The frame rect still lies inside the screen, so the file is
# structurally valid, and `magick identify` reports it as
# "GIF 8x8 1920x1080+0+0" without complaint.
#
# This is the ordinary shape of an optimised animation: name a large canvas,
# paint a small first frame into it. 0.5.3 shipped an amplification check that
# bounded `screen_w * screen_h * 4` against the FIRST FRAME's compressed bytes,
# so this 81-byte file was refused with CHITRA_ERR_DIMENSIONS — it would have
# needed 506 bytes of LZW to earn an 8 MB canvas. The canvas and the frame are
# different quantities: the ratio now bounds only the frame, and the canvas is
# bounded by CHITRA_MAX_DIM / CHITRA_MAX_PIXELS / CHITRA_MAX_RAW_BYTES like
# every other format's declared dimensions.
#
# Regenerate:
#   magick -size 8x8 gradient:red-blue GIF:small.gif
#   python3 -c "d=bytearray(open('small.gif','rb').read()); \
#       d[6:8]=(1920).to_bytes(2,'little'); d[8:10]=(1080).to_bytes(2,'little'); \
#       open('bigcanvas.gif','wb').write(bytes(d))"
# ================================================================
fn fx_gif_big_canvas(len_out): i64 {
    var b = alloc(81);
    store64(len_out, 81);
    store8(b + 0, 0x47);
    store8(b + 1, 0x49);
    store8(b + 2, 0x46);
    store8(b + 3, 0x38);
    store8(b + 4, 0x39);
    store8(b + 5, 0x61);
    store8(b + 6, 0x80);
    store8(b + 7, 0x07);
    store8(b + 8, 0x38);
    store8(b + 9, 0x04);
    store8(b + 10, 0xF2);
    store8(b + 11, 0x00);
    store8(b + 12, 0x00);
    store8(b + 13, 0xFF);
    store8(b + 14, 0x00);
    store8(b + 15, 0x00);
    store8(b + 16, 0xDB);
    store8(b + 17, 0x00);
    store8(b + 18, 0x24);
