# tests/tcyr/gif.tcyr — GIF decode: LZW, interlacing, transparency, palettes,
# and the first-frame contract (0.5.0, ADR 0005).
#
# Fixtures are REAL GIFs produced by ImageMagick, embedded as byte arrays —
# not hand-rolled by the same understanding that wrote the decoder. Expected
# pixels are ImageMagick's own decode, independently corroborated by a
# from-spec Python decoder; the two agree pixel-for-pixel on every fixture.
#
# That cross-check mattered: ImageMagick's `-interlace line` GIF *writer* does
# not round-trip its own source (a writer quirk), so agreement between two
# independent *readers* is what established the interlaced expectations rather
# than assuming the encoder preserved row order.

include "src/lib.cyr"
include "lib/assert.cyr"
fn fx_gif_plain(len_out): i64 {
    var b = alloc(54);
    store64(len_out, 54);
    store8(b + 0, 71);
    store8(b + 1, 73);
    store8(b + 2, 70);
    store8(b + 3, 56);
    store8(b + 4, 57);
    store8(b + 5, 97);
    store8(b + 6, 4);
    store8(b + 7, 0);
    store8(b + 8, 4);
    store8(b + 9, 0);
    store8(b + 10, 241);
    store8(b + 11, 0);
    store8(b + 12, 0);
    store8(b + 13, 255);
    store8(b + 14, 0);
    store8(b + 15, 0);
    store8(b + 16, 0);
    store8(b + 17, 255);
    store8(b + 18, 0);
    store8(b + 19, 255);
    store8(b + 20, 255);
    store8(b + 21, 0);
    store8(b + 22, 0);
    store8(b + 23, 0);
    store8(b + 24, 255);
    store8(b + 25, 33);
    store8(b + 26, 249);
    store8(b + 27, 4);
    store8(b + 28, 0);
    store8(b + 29, 0);
    store8(b + 30, 0);
    store8(b + 31, 0);
    store8(b + 32, 0);
    store8(b + 33, 44);
    store8(b + 34, 0);
    store8(b + 35, 0);
    store8(b + 36, 0);
    store8(b + 37, 0);
    store8(b + 38, 4);
    store8(b + 39, 0);
    store8(b + 40, 4);
    store8(b + 41, 0);
    store8(b + 42, 0);
    store8(b + 43, 2);
    store8(b + 44, 7);
    store8(b + 45, 68);
    store8(b + 46, 38);
    store8(b + 47, 39);
    store8(b + 48, 128);
    store8(b + 49, 182);
    store8(b + 50, 87);
    store8(b + 51, 0);
    store8(b + 52, 0);
    store8(b + 53, 59);
    return b;
}

