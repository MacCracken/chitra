# ================================================================
# Helpers
# ================================================================
fn _gpx(px, i, r, g, b, a, label) {
    assert_eq(load8(px + i * 4 + 0), r, label);
    assert_eq(load8(px + i * 4 + 1), g, label);
    assert_eq(load8(px + i * 4 + 2), b, label);
    assert_eq(load8(px + i * 4 + 3), a, label);
    return 0;
}

fn _greject(bytes, lo, code, label) {
    var err = 0;
    var img = chitra_gif_decode(bytes, lo, &err);
    assert(img == 0, label);
    assert(err != 0, label);
    if (err != 0) { assert_eq(chitra_err_code(err), code, label); }
    return 0;
}

fn test_gif_signature() {
    var buf[8];
    store8(&buf + 0, 0x47); store8(&buf + 1, 0x49); store8(&buf + 2, 0x46);
    store8(&buf + 3, 0x38); store8(&buf + 4, 0x39); store8(&buf + 5, 0x61);
    assert_eq(chitra_gif_check_signature(&buf, 6), 1, "GIF89a recognised");
    store8(&buf + 4, 0x37);
    assert_eq(chitra_gif_check_signature(&buf, 6), 1, "GIF87a recognised");
    store8(&buf + 4, 0x38);
    assert_eq(chitra_gif_check_signature(&buf, 6), 0, "GIF88a rejected");
    assert_eq(chitra_gif_check_signature(&buf, 5), 0, "short buffer -> 0, no read");
    assert_eq(chitra_gif_check_signature(&buf, 0), 0, "len 0 -> 0");
    return 0;
}

# Baseline: non-interlaced, global color table, GIF89a.
# Expectations are ImageMagick's decode, independently corroborated by a
# from-spec Python decoder (the two agree pixel-for-pixel on every fixture).
fn test_gif_plain() {
    var lo = 0;
    var b = fx_gif_plain(&lo);
    var err = 0;
    var img = chitra_gif_decode(b, lo, &err);
    assert(img != 0, "plain GIF decodes");
    assert_eq(chitra_image_width(img), 4, "plain GIF width");
    assert_eq(chitra_image_height(img), 4, "plain GIF height");
    assert_eq(chitra_image_channels(img), 4, "plain GIF channels");
    var px = chitra_image_pixels(img);
    _gpx(px, 0, 255, 0, 0, 255, "plain GIF px0");
    _gpx(px, 1, 0, 255, 0, 255, "plain GIF px1");
    _gpx(px, 2, 0, 0, 255, 255, "plain GIF px2");
    _gpx(px, 3, 255, 255, 0, 255, "plain GIF px3");
    _gpx(px, 4, 0, 255, 0, 255, "plain GIF px4");
    _gpx(px, 5, 0, 0, 255, 255, "plain GIF px5");
    _gpx(px, 6, 255, 255, 0, 255, "plain GIF px6");
    _gpx(px, 7, 255, 0, 0, 255, "plain GIF px7");
    _gpx(px, 8, 0, 0, 255, 255, "plain GIF px8");
    _gpx(px, 9, 255, 255, 0, 255, "plain GIF px9");
    _gpx(px, 10, 255, 0, 0, 255, "plain GIF px10");
    _gpx(px, 11, 0, 255, 0, 255, "plain GIF px11");
    _gpx(px, 12, 255, 255, 0, 255, "plain GIF px12");
    _gpx(px, 13, 255, 0, 0, 255, "plain GIF px13");
    _gpx(px, 14, 0, 255, 0, 255, "plain GIF px14");
    _gpx(px, 15, 0, 0, 255, 255, "plain GIF px15");
    return 0;
}

# GIF interlacing is FOUR passes over rows only (starts 0/4/2/1, steps
# 8/8/4/2) — a different schedule from PNG Adam7, which subsamples both axes.
# At 4x4 only three passes are non-empty, which is itself worth covering.
fn test_gif_interlaced() {
    var lo = 0;
    var b = fx_gif_interlaced(&lo);
    var err = 0;
    var img = chitra_gif_decode(b, lo, &err);
    assert(img != 0, "interlaced GIF decodes");
    assert_eq(chitra_image_width(img), 4, "interlaced GIF width");
    assert_eq(chitra_image_height(img), 4, "interlaced GIF height");
    assert_eq(chitra_image_channels(img), 4, "interlaced GIF channels");
    var px = chitra_image_pixels(img);
    _gpx(px, 0, 255, 0, 0, 255, "interlaced GIF px0");
    _gpx(px, 1, 0, 255, 0, 255, "interlaced GIF px1");
    _gpx(px, 2, 0, 0, 255, 255, "interlaced GIF px2");
    _gpx(px, 3, 255, 255, 0, 255, "interlaced GIF px3");
    _gpx(px, 4, 0, 0, 255, 255, "interlaced GIF px4");
    _gpx(px, 5, 255, 255, 0, 255, "interlaced GIF px5");
    _gpx(px, 6, 255, 0, 0, 255, "interlaced GIF px6");
    _gpx(px, 7, 0, 255, 0, 255, "interlaced GIF px7");
    _gpx(px, 8, 255, 255, 0, 255, "interlaced GIF px8");
    _gpx(px, 9, 255, 0, 0, 255, "interlaced GIF px9");
    _gpx(px, 10, 0, 255, 0, 255, "interlaced GIF px10");
    _gpx(px, 11, 0, 0, 255, 255, "interlaced GIF px11");
    _gpx(px, 12, 0, 255, 0, 255, "interlaced GIF px12");
    _gpx(px, 13, 0, 0, 255, 255, "interlaced GIF px13");
    _gpx(px, 14, 255, 255, 0, 255, "interlaced GIF px14");
    _gpx(px, 15, 255, 0, 0, 255, "interlaced GIF px15");
    return 0;
}

# 8x8 makes all FOUR interlace passes non-empty — the 4x4 case above cannot
# reach pass 2 (start 4, step 8).
fn test_gif_interlaced8() {
    var lo = 0;
    var b = fx_gif_interlaced8(&lo);
    var err = 0;
    var img = chitra_gif_decode(b, lo, &err);
    assert(img != 0, "interlaced 8x8 GIF decodes");
    assert_eq(chitra_image_width(img), 8, "interlaced 8x8 GIF width");
    assert_eq(chitra_image_height(img), 8, "interlaced 8x8 GIF height");
    assert_eq(chitra_image_channels(img), 4, "interlaced 8x8 GIF channels");
    var px = chitra_image_pixels(img);
    _gpx(px, 0, 255, 0, 0, 255, "interlaced 8x8 GIF px0");
