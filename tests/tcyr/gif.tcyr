# ---- 0.5.3 audit regression -------------------------------------------
# A ~800-byte GIF declaring a 4096x4096 logical screen. Nothing bounded the
# canvas allocation against the input, so it produced ~67 MB the bump allocator
# never reclaims. The GIF cap is deliberately looser than PNG's (LZW compresses
# degenerate content close to the bomb ratio — a genuinely solid 4096x4096 GIF
# is a real ~13 KB file), so it bounds the extreme case rather than the merely
# aggressive one.
fn test_gif_amplification_bomb() {
    var lo = 0;
    var b = fx_gif_bomb(&lo);
    assert(lo < 1000, "the bomb really is under a kilobyte");
    _greject(b, lo, CHITRA_ERR_DIMENSIONS, "GIF amplification bomb rejected");
    return 0;
}

# The cap must not reject legitimate GIFs.
fn test_gif_cap_allows_real_files() {
    var lo = 0;
    var err = 0;
    assert(chitra_gif_decode(fx_gif_plain(&lo), lo, &err) != 0, "cap allows the plain fixture");
    var l2 = 0;
    var e2 = 0;
    assert(chitra_gif_decode(fx_gif_interlaced8(&l2), l2, &e2) != 0, "cap allows the interlaced fixture");
    return 0;
}

fn fx_gif_bomb_pad(len_out): i64 {
    var b = alloc(525085);
    store64(len_out, 525085);
    var i = 0;
    while (i < 525085) { store8(b + i, 0); i = i + 1; }
    store8(b + 0, 71);
    store8(b + 1, 73);
    store8(b + 2, 70);
    store8(b + 3, 56);
    store8(b + 4, 57);
    store8(b + 5, 97);
    store8(b + 7, 16);
    store8(b + 9, 16);
    store8(b + 10, 247);
    store8(b + 16, 1);
    store8(b + 17, 1);
    store8(b + 18, 1);
    store8(b + 19, 2);
    store8(b + 20, 2);
    store8(b + 21, 2);
