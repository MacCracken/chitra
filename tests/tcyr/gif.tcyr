fn test_gif_large_canvas_small_frame_decodes() {
    # The regression cell for the 0.5.3 canvas cap. Before the repair this
    # returned CHITRA_ERR_DIMENSIONS.
    var lo = 0;
    var b = fx_gif_big_canvas(&lo);
    assert(lo < 200, "the fixture really is under 200 bytes");
    var err = 0;
    var img = chitra_gif_decode(b, lo, &err);
    assert(img != 0, "1920x1080 canvas with an 8x8 first frame decodes");
    assert_eq(err, 0, "large canvas, small frame: no error");
    if (img != 0) {
        assert_eq(chitra_image_width(img), 1920, "canvas width is the logical screen");
        assert_eq(chitra_image_height(img), 1080, "canvas height is the logical screen");
        # The canvas the frame does not paint stays transparent, per ADR 0005 —
        # chitra decoded nothing there and alpha 0 says exactly that.
        assert_eq(load8(chitra_image_pixels(img) + (1000 * 1920 + 1000) * 4 + 3), 0,
          "unpainted canvas is transparent, not background-filled");
    }
    return 0;
}

# ================================================================
# 0.7.2 — GIF transparent-index range check
# ================================================================# A GCE naming transparent index 200 against a
# 2-entry global colour table.
# Out of range it simply never matches a pixel, so this is a validation gap
# rather than a wrong-output one — ImageMagick accepts the file. It is closed
# for the same reason the pixel-index check exists: an index that names nothing
# is a statement the file cannot mean.
fn fx_gif_trns_idx_oob(len_out): i64 {
    var b = alloc(53);
    store64(len_out, 53);
    var i = 0;
    while (i < 53) {
        store8(b + i, 0);
        i = i + 1;
    }
    store8(b + 0, 0x47);
    store8(b + 1, 0x49);
    store8(b + 2, 0x46);
    store8(b + 3, 0x38);
    store8(b + 4, 0x39);
    store8(b + 5, 0x61);
    store8(b + 6, 0x04);
    store8(b + 8, 0x04);
    store8(b + 10, 0xF0);
    store8(b + 13, 0xFF);
    store8(b + 19, 0x21);
    store8(b + 20, 0xF9);
    store8(b + 21, 0x04);
    store8(b + 27, 0x21);
    store8(b + 28, 0xF9);
    store8(b + 29, 0x04);
    store8(b + 30, 0x01);
    store8(b + 33, 0xC8);
    store8(b + 35, 0x2C);
    store8(b + 40, 0x04);
    store8(b + 42, 0x04);
    store8(b + 45, 0x02);
    store8(b + 46, 0x04);
    store8(b + 47, 0x84);
    store8(b + 48, 0x8F);
    store8(b + 49, 0x09);
    store8(b + 50, 0x05);
    store8(b + 52, 0x3B);
    return b;
}
# The control: the same file naming the last valid entry.
fn fx_gif_trns_idx_ok(len_out): i64 {
    var b = alloc(53);
    store64(len_out, 53);
    var i = 0;
    while (i < 53) {
        store8(b + i, 0);
        i = i + 1;
    }
    store8(b + 0, 0x47);
    store8(b + 1, 0x49);
    store8(b + 2, 0x46);
    store8(b + 3, 0x38);
    store8(b + 4, 0x39);
    store8(b + 5, 0x61);
    store8(b + 6, 0x04);
    store8(b + 8, 0x04);
    store8(b + 10, 0xF0);
    store8(b + 13, 0xFF);
    store8(b + 19, 0x21);
    store8(b + 20, 0xF9);
    store8(b + 21, 0x04);
    store8(b + 27, 0x21);
    store8(b + 28, 0xF9);
    store8(b + 29, 0x04);
    store8(b + 30, 0x01);
    store8(b + 33, 0x01);
    store8(b + 35, 0x2C);
    store8(b + 40, 0x04);
    store8(b + 42, 0x04);
    store8(b + 45, 0x02);
    store8(b + 46, 0x04);
    store8(b + 47, 0x84);
    store8(b + 48, 0x8F);
    store8(b + 49, 0x09);
    store8(b + 50, 0x05);
    store8(b + 52, 0x3B);
    return b;
}

fn test_gif_transparent_index_out_of_range_rejected() {
    var lo = 0;
    var b = fx_gif_trns_idx_oob(&lo);
    var err = 0;
    var img = chitra_gif_decode(b, lo, &err);
    assert(img == 0, "GIF transparent index past the colour table rejected");
    assert(err != 0, "oob transparent index sets err_out");
    if (err != 0) {
        assert_eq(chitra_err_code(err), CHITRA_ERR_GIF_PALETTE,
          "oob transparent index -> GIF_PALETTE");
    }
    return 0;
}

fn test_gif_transparent_index_in_range_decodes() {
    var lo = 0;
    var b = fx_gif_trns_idx_ok(&lo);
    var err = 0;
    var img = chitra_gif_decode(b, lo, &err);
    assert(img != 0, "in-range transparent index still decodes");
    assert_eq(err, 0, "in-range transparent index: no error");
    return 0;
}

# ================================================================
# B-7 (1.0.3) — the LZW dictionary is sized to the stream, not to the format's
# 12-bit ceiling.
#
# ⛔ 69,632 BYTES BEFORE A SINGLE CODE WAS READ — prefix 32,768 + suffix 32,768
# + chain 4,096, on every call, never memoized, on an allocator that never
# frees. A 45-byte GIF paid all of it; so did one the decoder rejected on its
# first code. A thumbnailer walking a directory paid it per image, for ever.
#
# The bound is arithmetic, not a guess: every code costs at least
# `min_code_size + 1` bits and adds at most one entry, so a `data_len`-byte
# stream can add at most `data_len * 8 / (min_code_size + 1)` entries beyond
# the initial table plus Clear and End.
#
# ⚠ MUTATION-CHECKED on COST, because nothing else moves: restore
# _CHITRA_GIF_LZW_MAX_CODES at the three allocations and every other assertion in this
# suite still passes while this one fails. And the correctness direction is
# covered by the 643 cells around it plus a 20-cell ImageMagick differential —
# a cap that were too TIGHT would corrupt output, not merely cost less.
# ================================================================
fn test_gif_lzw_dictionary_is_sized_to_the_stream() {
    var lo = 0;
    var b = fx_gif_plain(&lo);
    var err = 0;
    var before = alloc_used();
    var img = chitra_gif_decode(b, lo, &err);
    var spent = alloc_used() - before;
    assert(img != 0, "the ordinary GIF fixture still decodes");
    assert_lt(spent, 16384,
      "a small GIF costs well under 16 KiB, not the flat 69,632-byte dictionary");
    return 0;
}

# ================================================================
# B-12 (1.0.3) — the four frozen `_rgba8` wrappers had no test that could tell
# width from height.
#
# ⛔ NOT A LIVE DEFECT — A BLIND SPOT IN THE GATE STACK. Every wrapper test in
# the tree used a SQUARE fixture (PNG 2x2, BMP 2x2, GIF 4x4, JPEG 16x16), so
# swapping the two stores in `chitra_png_decode_rgba8` — transposing the
# dimensions a caller gets back — passed all 13 suites, all 3,035 assertions and
# all 10.7 M fuzz assertions with nothing red. Verified by doing exactly that.
# `chitra_png_decode_rgba8` is mabda's primary entry point, and a transposed
# w/h uploads a garbled texture with no ChitraErr to show for it.
#
# ⚠ Only `jpeg_noninterleaved.tcyr`'s 24x16 cell could see it, and only for
# JPEG. These fixtures close the other three, and the assertions below compare
# the wrapper's w/h against the FULL decoder's accessors on the same bytes —
# so the two entry points cannot disagree either.
# ================================================================
# 3x2 GIF — 3x2, deliberately NON-SQUARE (B-12, 1.0.3).
fn fx_gif_3x2_nonsquare(len_out): i64 {
    var b = alloc(44);
    store64(len_out, 44);
    var i = 0;
    while (i < 44) {
        store8(b + i, 0);
        i = i + 1;
    }
    store8(b + 0, 71);
    store8(b + 1, 73);
    store8(b + 2, 70);
    store8(b + 3, 56);
    store8(b + 4, 57);
    store8(b + 5, 97);
    store8(b + 6, 3);
    store8(b + 8, 2);
    store8(b + 10, 240);
    store8(b + 13, 255);
    store8(b + 18, 255);
    store8(b + 19, 33);
    store8(b + 20, 249);
    store8(b + 21, 4);
    store8(b + 27, 44);
    store8(b + 32, 3);
    store8(b + 34, 2);
    store8(b + 37, 2);
    store8(b + 38, 3);
    store8(b + 39, 132);
    store8(b + 40, 131);
    store8(b + 41, 5);
    store8(b + 43, 59);
    return b;
}

fn test_gif_rgba8_wrapper_distinguishes_w_from_h() {
    var lo = 0;
    var b = fx_gif_3x2_nonsquare(&lo);
    var w = 0;
    var h = 0;
    var px = chitra_gif_decode_rgba8(b, lo, &w, &h);
    assert(px != 0, "the non-square GIF decodes through the wrapper");
    assert_eq(w, 3, "wrapper w = 3 (not the height)");
    assert_eq(h, 2, "wrapper h = 2 (not the width)");
    assert_neq(w, h, "the fixture really is non-square, or this cell proves nothing");
    return 0;
}

# ================================================================
# 1.1.1 P(-1) sweep — the GIF guards no cell could tell from their absence, and
# the GIF/LZW repairs that sweep made.
#
# ⛔ THROUGH 1.1.0, 26 GIF/LZW GUARDS COULD BE DELETED WITH ALL 13 SUITES AND
# BOTH FUZZERS GREEN (gate-4 counted 25, gif-gate-1 the 26th; gif-gate-2 /
# gate-5 the two 0.5.3 GCE repairs among them). Four were the only bound
# between attacker bytes and an out-of-bounds access — the frame rect, the
# pixel index, `code > next_code` and the full-dictionary ceiling — and the
# bump arena absorbs such an access silently, so no fuzzer saw them. Six of
# the 26 cannot be told from their absence by any input. Four could not fire:
# the KwKwK `prev < 0` was removed in 1.1.1, and the gather cap and the two
# chain-walk bounds are kept as documented second bounds. Two — the
# extension-label and sub-block-span checks — only stop a READ past the input
# whose bytes never reach the result, which no outcome cell and no redzone sees.
# ⚠ EVERY CELL BELOW WAS MUTATION-CHECKED: its guard neutered (or its repair
# reverted), the cell seen to FAIL, the source restored. A cell that passes
# both ways proves nothing.
#
# Fixtures are spelled in hex, so the bytes are the record. Each was run
# through ImageMagick and ffmpeg when it was written; where a reference
# DECODES a file chitra refuses, the cell says so and why.
# ================================================================
fn _ghexnib(c): i64 {
    if (c >= 97) { return c - 87; }    # a-f
    if (c >= 65) { return c - 55; }    # A-F
    return c - 48;
}

# Write the bytes a hex string spells at `b + pos`; returns the position just
# past them.
fn _ghx(b, pos, hex): i64 {
    var n = strlen(hex) / 2;
    var i = 0;
    while (i < n) {
        store8(b + pos + i, _ghexnib(load8(hex + i * 2)) * 16 + _ghexnib(load8(hex + i * 2 + 1)));
        i = i + 1;
    }
    return pos + n;
}

fn _gbytes(hex, len_out): i64 {
    var b = alloc(strlen(hex) / 2 + 8);
    store64(len_out, _ghx(b, 0, hex));
    return b;
}

# GIF89a, an `sw` x `sh` logical screen and a 4-entry global table (0a141e
# 28323c 46505a 646e78), then `rest` — the prefix most fixtures below share.
fn _gfx(sw, sh, rest, len_out): i64 {
    var b = alloc(64 + strlen(rest) / 2);
    var p = _ghx(b, 0, "474946383961");
    store8(b + p, sw & 255);
    store8(b + p + 1, (sw >> 8) & 255);
    store8(b + p + 2, sh & 255);
    store8(b + p + 3, (sh >> 8) & 255);
    p = _ghx(b, p + 4, "9100000a141e28323c46505a646e78");
    store64(len_out, _ghx(b, p, rest));
    return b;
}

# Decode, returning the bytes the decode allocated through `spent_out`.
fn _gcost(b, lo, err_out, spent_out): i64 {
    var before = alloc_used();
    var img = chitra_gif_decode(b, lo, err_out);
    store64(spent_out, alloc_used() - before);
    return img;
}

# gif-gate-1 — the frame rect must lie inside the logical screen. The canvas is
# screen_w*screen_h*4 bytes and the paint loop writes at
# ((fy+row)*screen_w + (fx+col))*4; this check is the ONLY bound on that write.
# Neutered, a 3x2 frame one column (or one row) off a 3x2 screen decodes rc 0,
# painting past the canvas.
fn test_gif_frame_rect_must_lie_inside_the_screen() {
    var lo = 0;
    _greject(_gfx(3, 2, "2c0100000003000200000203443456003b", &lo), lo, CHITRA_ERR_GIF_HEADER,
      "frame one column past the screen's right edge rejected");
    var l2 = 0;
    _greject(_gfx(3, 2, "2c0000010003000200000203443456003b", &l2), l2, CHITRA_ERR_GIF_HEADER,
      "frame one row past the screen's bottom edge rejected");
    return 0;
}

# gif-gate-1 — a pixel index past the colour table in force: a 2-entry global
# table and frame indices 0,1,2,3,0,1. Without the check the paint loop reads
# `pal + pi*3` past the table. The second file is the same frame with the
# interlace bit set: since 1.1.1 ONE check covers both paint orders, before the
# canvas exists (gif-canvas-refusal), and these two cells pin it in both.
fn test_gif_pixel_index_past_the_table_rejected() {
    var lo = 0;
    var b = _gbytes("474946383961030002008000000a141e28323c2c0000000003000200000203443456003b", &lo);
    _greject(b, lo, CHITRA_ERR_GIF_PALETTE, "pixel index 2 against a 2-entry table rejected");
    var l2 = 0;
    var b2 = _gbytes("474946383961030002008000000a141e28323c2c0000000003000200400203443456003b", &l2);
    _greject(b2, l2, CHITRA_ERR_GIF_PALETTE, "interlaced: pixel index past the table rejected");
    return 0;
}

# gif-canvas-refusal — the same refusal, paid for BEFORE the canvas. 35 bytes: a
# 4096x4096 screen, a 2-entry table, a 1x1 frame of index 3. Through 1.1.0 the
# index was checked in the paint loop, after the 64 MB canvas was allocated and
# zeroed: 67,109,120 bytes spent to refuse it, cumulative on an allocator that
# never frees. A valid file of the same shape still costs the canvas — that is
# the accepted large-canvas risk; this is only the refusal path.
fn test_gif_index_refused_before_the_canvas_is_paid_for() {
    var lo = 0;
    var b = _gbytes("474946383961001000108000000a141e28323c2c00000000010001000002025c01003b", &lo);
    var err = 0;
    var spent = 0;
    var img = _gcost(b, lo, &err, &spent);
    assert(img == 0, "out-of-range index under a 4096x4096 screen refused");
    if (err != 0) { assert_eq(chitra_err_code(err), CHITRA_ERR_GIF_PALETTE, "-> GIF_PALETTE"); }
    assert_lt(spent, 65536, "refused before the 64 MB canvas, not after (was 67,109,120 bytes)");
    return 0;
}

# gif-gate-1 / gate-4 L-codegt — a code above next_code names no dictionary
# entry. Clear, 1, 7, End at mcs 2: after Clear next_code is 6 and code 1 adds
# nothing, so 7 has no entry. Neutered, the decode reads prefix/suffix slots
# nothing wrote and returns rc 0.
fn test_gif_lzw_code_past_next_code_rejected() {
    var lo = 0;
    _greject(_gfx(3, 2, "2c0000000003000200000202cc0b003b", &lo), lo, CHITRA_ERR_GIF_LZW,
      "LZW code above next_code rejected");
    return 0;
}

# guards-unreachable — KwKwK with no previous code: Clear, 6, End. 6 is
# next_code but there is no string to extend. The dedicated `prev < 0` guard
# was outcome-identical to the `cur < 0` check after the chain walk and was
# removed in 1.1.1; this pins that the refusal did not move, and it is what
# now kills a neutered `cur < 0` (which would read suffix[-1]).
fn test_gif_lzw_kwkwk_without_a_previous_code_rejected() {
    var lo = 0;
    _greject(_gfx(3, 2, "2c00000000030002000002027401003b", &lo), lo, CHITRA_ERR_GIF_LZW,
      "KwKwK as the first code after Clear rejected");
    return 0;
}

# Append `code` LSB-first at bit `bp` of a zeroed buffer; returns bp + width.
fn _gput(buf, bp, code, width): i64 {
    var i = 0;
    var at = 0;
    while (i < width) {
        if (((code >> i) & 1) == 1) {
            at = buf + (bp + i) / 8;
            store8(at, load8(at) | (1 << ((bp + i) & 7)));
        }
        i = i + 1;
    }
    return bp + width;
}

fn _gfd_index(i): i64 { return ((i * 7) + (i / 80)) & 3; }

# 80x60, mcs 2: Clear, then 4,800 ROOT codes, then End, each code written at
# the width the DECODER will read it at. Every code after the first adds a
# dictionary entry, so the table fills at code 4,091 and the last ~700 codes
# are read at 12 bits with no room left — the encoder never sends the Clear
# the spec lets it defer.
fn fx_gif_full_dict(len_out): i64 {
    var lz = alloc(8192);
    var z = 0;
    while (z < 8192) { store8(lz + z, 0); z = z + 1; }
    var size = 3;
    var nxt = 6;
    var bp = _gput(lz, 0, 4, size);
    var i = 0;
    while (i < 4800) {
        bp = _gput(lz, bp, _gfd_index(i), size);
        if (i > 0) {
            if (nxt < 4096) {
                nxt = nxt + 1;
                if (nxt == (1 << size)) {
                    if (size < 12) { size = size + 1; }
                }
            }
        }
        i = i + 1;
    }
    bp = _gput(lz, bp, 5, size);
    var n = (bp + 7) / 8;
    var b = alloc(64 + n + n / 255 + 4);
    var p = _ghx(b, 0, "47494638396150003c00910000");
    p = _ghx(b, p, "0a141ec8323c46b45a646edc2c0000000050003c000002");
    var k = 0;
    var c = 0;
    while (k < n) {
        c = n - k;
        if (c > 255) { c = 255; }
        store8(b + p, c);
        p = p + 1;
        z = 0;
        while (z < c) { store8(b + p + z, load8(lz + k + z)); z = z + 1; }
        p = p + c;
        k = k + c;
    }
    store8(b + p, 0);
    store8(b + p + 1, 59);
    store64(len_out, p + 2);
    return b;
}

# gif-gate-1 / gate-4 L-nextcap, L-maxwidth — a dictionary that fills without a
# Clear. `next_code < table_cap` is the only thing stopping entry 4096 being
# stored past the 32,768-byte prefix array into suffix; no fixture anywhere
# filled the table, and B-7 (1.0.3) rewrote exactly this ceiling with nothing
# pinning it. Neutered (or loosened to `<=`) the table is corrupted and the
# pixels change. The same file kills the width cap: past 12 bits the codes
# after the fill would be misread. The built bytes are checked against the
# Python-generated file ImageMagick and ffmpeg both decode byte-exact.
fn test_gif_full_dictionary_without_clear_decodes() {
    var lo = 0;
    var b = fx_gif_full_dict(&lo);
    assert_eq(lo, 6762, "fixture is the 6,762-byte file the references decoded");
    var sum = 0;
    var q = 0;
    while (q < lo) { sum = sum + load8(b + q); q = q + 1; }
    assert_eq(sum, 109161, "fixture byte sum matches the reference-checked file");
    var err = 0;
    var img = chitra_gif_decode(b, lo, &err);
    assert(img != 0, "a full dictionary with no Clear decodes");
    if (img != 0) {
        assert_eq(chitra_image_seen_iend(img), 1, "full-dictionary frame complete");
        var px = chitra_image_pixels(img);
        var bad = 0;
        var i = 0;
        var e = 0;
        var r = 0;
        var g = 0;
        var bl = 0;
        while (i < 4800) {
            e = _gfd_index(i);
            r = 10;
            g = 20;
            bl = 30;
            if (e == 1) { r = 200; g = 50; bl = 60; }
            if (e == 2) { r = 70; g = 180; bl = 90; }
            if (e == 3) { r = 100; g = 110; bl = 220; }
            if (load8(px + i * 4) != r) { bad = bad + 1; }
            if (load8(px + i * 4 + 1) != g) { bad = bad + 1; }
            if (load8(px + i * 4 + 2) != bl) { bad = bad + 1; }
            if (load8(px + i * 4 + 3) != 255) { bad = bad + 1; }
            i = i + 1;
        }
        assert_eq(bad, 0, "every one of 4,800 pixels is its palette entry");
    }
    return 0;
}

# gif-gate-2 / gate-5 — the 0.5.3 A-5 repair: a later GCE that turns
# transparency OFF revokes an earlier one. GCE(transparent=2), GCE(none), then a
# 3x2 frame of indices 0,1,2,3,2,1; pixels 2 and 4 are index 2 and must be
# opaque. ffmpeg agrees. ImageMagick keeps the stale index and keys both, so it
# cannot be the oracle here. The 0.5.3 audit recorded a regression test for this
# repair that was never written; neutered, both pixels come back alpha 0.
fn test_gif_gce_revoking_transparency_is_honoured() {
    var lo = 0;
    var b = _gfx(3, 2, "21f904010000020021f90400000000002c000000000300020000020444341205003b", &lo);
    var err = 0;
    var img = chitra_gif_decode(b, lo, &err);
    assert(img != 0, "two GCEs, the second revoking transparency, decodes");
    if (img != 0) {
        var px = chitra_image_pixels(img);
        _gpx(px, 0, 10, 20, 30, 255, "revoked GCE px0");
        _gpx(px, 1, 40, 50, 60, 255, "revoked GCE px1");
        _gpx(px, 2, 70, 80, 90, 255, "revoked GCE px2: index 2 is OPAQUE");
        _gpx(px, 3, 100, 110, 120, 255, "revoked GCE px3");
        _gpx(px, 4, 70, 80, 90, 255, "revoked GCE px4: index 2 is OPAQUE");
        _gpx(px, 5, 40, 50, 60, 255, "revoked GCE px5");
    }
    return 0;
}

# gif-gate-2 / gate-5 — the 0.5.3 A-6 repair: a GCE's block size is fixed at 4,
# and every field after it is read by fixed offset. Same frame behind a GCE
# declaring size 5. Neutered, chitra reads the packed byte and transparent index
# from bytes that are not those fields and decodes (ImageMagick does, too).
fn test_gif_gce_block_size_must_be_4() {
    var lo = 0;
    _greject(_gfx(3, 2, "21f9050100000200002c000000000300020000020444341205003b", &lo), lo,
      CHITRA_ERR_GIF_HEADER, "GCE declaring block size 5 rejected");
    return 0;
}

# gif-noend — a missing End code whose last-byte padding is as long as a code.
# 1x2 frame, mcs 2, LZW payload d4 00: Clear, 2, 3, then 7 zero bits. Through
# 1.1.0 those bits read as root code 0, one pixel past a full frame, and the file
# was refused CHITRA_ERR_GIF_LZW — while the same stream WITH its End code
# (d4 0a) decoded. ImageMagick and ffmpeg decode both to e8dbcf, 1dedce.
fn test_gif_missing_end_code_with_padding_decodes() {
    var lo = 0;
    var b = _gbytes("47494638396101000200910000927fb2b2c04ce8dbcf1dedce2c0000000001000200000202d400003b", &lo);
    var err = 0;
    var img = chitra_gif_decode(b, lo, &err);
    assert(img != 0, "End-less stream whose padding fills a code decodes (was GIF_LZW)");
    if (img != 0) {
        assert_eq(chitra_image_seen_iend(img), 1, "End-less stream: the frame IS complete");
        var px = chitra_image_pixels(img);
        _gpx(px, 0, 232, 219, 207, 255, "End-less px0 = e8dbcf");
        _gpx(px, 1, 29, 237, 206, 255, "End-less px1 = 1dedce");
    }
    return 0;
}

# gate-4 L-outcap — the bomb bound itself: more pixels than the frame holds, by
# a whole byte. 1x1 frame, Clear, 1, 2, 3, End; the frame is full after code 1
# with 10 bits still to come, so this is real extra data, not the padding
# gif-noend tolerates. Neutered, the decoder writes past the 1-byte index
# plane. (ImageMagick and ffmpeg stop at a full frame and decode it; chitra
# refuses a stream that describes pixels the frame does not have.)
fn test_gif_stream_past_a_full_frame_rejected() {
    var lo = 0;
    _greject(_gfx(1, 1, "2c00000000010001000002028c56003b", &lo), lo, CHITRA_ERR_GIF_LZW,
      "LZW stream a byte past a full frame rejected");
    return 0;
}

# A 4096x4096 screen and frame whose LZW payload is `n` zero bytes — a valid
# stream (root code 0 at every width, no Clear, no End).
fn fx_gif_ratio(n, len_out): i64 {
    var b = alloc(64 + n + n / 255 + 4);
    var z = 0;
    while (z < 64 + n + n / 255 + 4) { store8(b + z, 0); z = z + 1; }
    var p = _ghx(b, 0, "474946383961001000109100000a141e28323c46505a646e78");
    p = _ghx(b, p, "2c00000000001000100002");
    var left = n;
    var k = 0;
    while (left > 0) {
        k = left;
        if (k > 255) { k = 255; }
        store8(b + p, k);
        p = p + 1 + k;
        left = left - k;
    }
    store8(b + p, 0);
    store8(b + p + 1, 59);
    store64(len_out, p + 2);
    return b;
}

# gif-ratio-units — the amplification cap's boundary, pinned on both sides. The
# check is `fw * fh > comp_len * 16384`: FRAME PIXELS per gathered LZW byte, not
# RGBA bytes as the 0.5.3 record computed it. A 4096x4096 frame (16,777,216
# pixels) therefore needs exactly 1,024 LZW bytes: 1,024 is admitted, 1,023 is
# refused. A cap moved to RGBA units (4x tighter) refuses the first; any cap
# looser than 16,400 pixels per byte admits the second.
fn test_gif_ratio_boundary_is_pixels_per_lzw_byte() {
    var lo = 0;
    var b = fx_gif_ratio(1024, &lo);
    var err = 0;
    var img = chitra_gif_decode(b, lo, &err);
    assert(img != 0, "4096x4096 frame with 1,024 LZW bytes is admitted");
    if (img != 0) {
        assert_eq(chitra_image_width(img), 4096, "admitted at the boundary: width 4096");
        assert_eq(chitra_image_seen_iend(img), 0, "1,024 bytes of codes cannot fill the frame");
    }
    var l2 = 0;
    var b2 = fx_gif_ratio(1023, &l2);
    var e2 = 0;
    var spent = 0;
    var img2 = _gcost(b2, l2, &e2, &spent);
    assert(img2 == 0, "4096x4096 frame with 1,023 LZW bytes is refused");
    if (e2 != 0) { assert_eq(chitra_err_code(e2), CHITRA_ERR_DIMENSIONS, "-> DIMENSIONS"); }
    assert_lt(spent, 65536, "refused before the index plane and canvas");
    return 0;
}

# gif-trunc-doc — a short stream and a cut file are different things. A 1x3
# frame whose codes are Clear, 2, 3, End emits two pixels and stops: that is
# well-formed, so it DECODES, the third pixel zero-filled to palette entry 0
# and seen_iend 0. The same file cut inside its sub-block chain is a chain that
# runs off the input, and is REFUSED CHITRA_ERR_TRUNCATED — the gif.cyr comment
# said the opposite through 1.1.0. The cut cell is also gate-4 G-blockstrunc:
# neutered, its empty gather fell through to the ratio cap as DIMENSIONS.
fn test_gif_short_stream_decodes_cut_chain_refused() {
    var lo = 0;
    var b = _gfx(1, 3, "2c0000000001000300000202d40a003b", &lo);
    var err = 0;
    var img = chitra_gif_decode(b, lo, &err);
    assert(img != 0, "End before the frame is full: decodes");
    if (img != 0) {
        assert_eq(chitra_image_seen_iend(img), 0, "short stream: seen_iend 0");
        var px = chitra_image_pixels(img);
        _gpx(px, 0, 70, 80, 90, 255, "short stream px0 = entry 2");
        _gpx(px, 1, 100, 110, 120, 255, "short stream px1 = entry 3");
        _gpx(px, 2, 10, 20, 30, 255, "short stream px2 zero-filled = entry 0");
    }
    var l2 = 0;
    var b2 = _gfx(1, 3, "2c0000000001000300000202d4", &l2);
    _greject(b2, l2, CHITRA_ERR_TRUNCATED, "file cut inside the sub-block chain refused");
    return 0;
}

# gate-4 G-screen0 — a zero-sized logical screen. Neutered, the frame-rect check
# refuses it instead, as GIF_HEADER: the right outcome under the wrong name.
fn test_gif_zero_logical_screen_rejected() {
    var lo = 0;
    _greject(_gfx(0, 2, "2c0000000003000200000203443456003b", &lo), lo, CHITRA_ERR_DIMENSIONS,
      "logical screen width 0 rejected");
    var l2 = 0;
    _greject(_gfx(3, 0, "2c0000000003000200000203443456003b", &l2), l2, CHITRA_ERR_DIMENSIONS,
      "logical screen height 0 rejected");
    return 0;
}

# gate-4 G-screenpix — a 4097x4097 logical screen is past CHITRA_MAX_PIXELS.
# Neutered, the 67 MB canvas is allocated and the 3x2 frame decodes into it.
fn test_gif_logical_screen_pixel_cap() {
    var lo = 0;
    _greject(_gfx(4097, 4097, "2c0000000003000200000203443456003b", &lo), lo, CHITRA_ERR_DIMENSIONS,
      "4097x4097 logical screen rejected");
    return 0;
}

# gate-4 G-gctspan — a global table declaring 256 entries in a file carrying 4.
# Neutered, the walk starts past the end and reports GIF_NO_IMAGE.
fn test_gif_global_table_past_the_input_rejected() {
    var lo = 0;
    var b = _gfx(3, 2, "2c0000000003000200000203443456003b", &lo);
    store8(b + 10, 0x87);
    _greject(b, lo, CHITRA_ERR_GIF_PALETTE, "256-entry global table in a 42-byte file rejected");
    return 0;
}

# gate-4 G-gcetrunc — a GCE cut short is TRUNCATED whatever size it declares.
# The file ends three bytes into a GCE declaring size 5; neutered, the size
# check reads that byte first and calls it GIF_HEADER.
fn test_gif_gce_cut_short_is_truncated() {
    var lo = 0;
    _greject(_gfx(3, 2, "21f905", &lo), lo, CHITRA_ERR_TRUNCATED, "GCE cut after its size byte");
    return 0;
}

# gate-4 G-frame0 — a zero-sized frame. Neutered, the 0-byte index plane is
# handed to the allocator and the refusal comes back as OOM.
fn test_gif_zero_frame_rejected() {
    var lo = 0;
    _greject(_gfx(3, 2, "2c0000000000000200000203443456003b", &lo), lo, CHITRA_ERR_DIMENSIONS,
      "frame width 0 rejected");
    var l2 = 0;
    _greject(_gfx(3, 2, "2c0000000003000000000203443456003b", &l2), l2, CHITRA_ERR_DIMENSIONS,
      "frame height 0 rejected");
    return 0;
}

# gate-4 G-lctspan — a local table declaring 256 entries six bytes from the end.
# Neutered, the cursor jumps past the input and the refusal becomes TRUNCATED.
fn test_gif_local_table_past_the_input_rejected() {
    var lo = 0;
    var b = _gbytes("474946383961030002000000002c000000000300020087000000000000", &lo);
    _greject(b, lo, CHITRA_ERR_GIF_PALETTE, "256-entry local table past the input rejected");
    return 0;
}

# gate-4 G-paln0 — neither table present. Refused before anything is gathered
# or decoded; neutered, the same code comes out of the index check, but only
# after the gather buffer, the index plane and the LZW tables are paid for.
fn test_gif_no_colour_table_refused_up_front() {
    var lo = 0;
    var b = _gbytes("474946383961030002000000002c0000000003000200000203443456003b", &lo);
    var err = 0;
    var spent = 0;
    var img = _gcost(b, lo, &err, &spent);
    assert(img == 0, "no colour table at all rejected");
    if (err != 0) { assert_eq(chitra_err_code(err), CHITRA_ERR_GIF_PALETTE, "-> GIF_PALETTE"); }
    assert_lt(spent, 64, "refused before the gather, the index plane and the dictionary");
    return 0;
}

# gate-4 G-mcstrunc — the file ends right after the image descriptor, behind a
# 256-entry global table, so the min-code-size byte is not there. Neutered, it
# is read from past the input and the whole 791-byte file is copied into a
# gather buffer before the chain walk refuses it; the refusal must come first.
fn test_gif_cut_before_min_code_size_refused_up_front() {
    var b = alloc(800);
    var p = _ghx(b, 0, "47494638396103000200f70000");
    var i = 0;
    while (i < 768) { store8(b + p + i, i / 3); i = i + 1; }
    p = _ghx(b, p + 768, "2c000000000300020000");
    var err = 0;
    var spent = 0;
    var img = _gcost(b, p, &err, &spent);
    assert(img == 0, "file ending before the LZW min-code-size byte rejected");
    if (err != 0) { assert_eq(chitra_err_code(err), CHITRA_ERR_TRUNCATED, "-> TRUNCATED"); }
    assert_lt(spent, 256, "refused before a file-sized gather buffer is allocated");
    return 0;
}

# gate-4 L-mcshi — min code size 9 with codes a 9-bit dictionary can decode:
# Clear(512), 1, 2, 3, 0, 1, 2, End(513) at 10 bits. The existing size-9 cell
# patched a size-2 stream, which then failed on a garbage code either way, so
# it could not see the guard. Spec § 22 caps the size at 8; ImageMagick and
# ffmpeg read this file anyway, chitra does not.
fn test_gif_min_code_size_9_with_decodable_codes_rejected() {
    var lo = 0;
    _greject(_gfx(3, 2, "2c000000000300020000090a000620c0000004204080003b", &lo), lo,
      CHITRA_ERR_GIF_LZW, "min code size 9 rejected even when its codes decode");
    return 0;
}

fn main() {
    test_gif_rgba8_wrapper_distinguishes_w_from_h();
    test_gif_lzw_dictionary_is_sized_to_the_stream();
    test_gif_signature();
    test_gif_plain();
    test_gif_interlaced();
    test_gif_interlaced8();
    test_gif_transparent();
    test_gif_animated();
    test_gif_reject_bad_signature();
    test_gif_truncation_sweep();
    test_gif_degenerate_lengths();
    test_gif_no_image();
    test_gif_reject_bad_min_code_size();
    test_gif_router();
    test_gif_rgba8_wrapper();
    test_gif_amplification_bomb();
    test_gif_cap_allows_real_files();
    test_gif_large_canvas_small_frame_decodes();
    test_gif_bomb_resists_padding();
    test_gif_transparent_index_out_of_range_rejected();
    test_gif_transparent_index_in_range_decodes();
    test_gif_frame_rect_must_lie_inside_the_screen();
    test_gif_pixel_index_past_the_table_rejected();
    test_gif_index_refused_before_the_canvas_is_paid_for();
    test_gif_lzw_code_past_next_code_rejected();
    test_gif_lzw_kwkwk_without_a_previous_code_rejected();
    test_gif_full_dictionary_without_clear_decodes();
    test_gif_gce_revoking_transparency_is_honoured();
    test_gif_gce_block_size_must_be_4();
    test_gif_missing_end_code_with_padding_decodes();
    test_gif_stream_past_a_full_frame_rejected();
    test_gif_ratio_boundary_is_pixels_per_lzw_byte();
    test_gif_short_stream_decodes_cut_chain_refused();
    test_gif_zero_logical_screen_rejected();
    test_gif_logical_screen_pixel_cap();
    test_gif_global_table_past_the_input_rejected();
    test_gif_gce_cut_short_is_truncated();
    test_gif_zero_frame_rejected();
    test_gif_local_table_past_the_input_rejected();
    test_gif_no_colour_table_refused_up_front();
    test_gif_cut_before_min_code_size_refused_up_front();
    test_gif_min_code_size_9_with_decodable_codes_rejected();
    return assert_summary();
}
var exit_code = main();
syscall(60, exit_code);
