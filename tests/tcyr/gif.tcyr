# Transparency lives in a Graphic Control Extension BEFORE the image
# descriptor and names a palette index; that index decodes to alpha 0.
fn test_gif_transparent() {
    var lo = 0;
    var b = fx_gif_transparent(&lo);
    var err = 0;
    var img = chitra_gif_decode(b, lo, &err);
    assert(img != 0, "transparent GIF decodes");
    assert_eq(chitra_image_width(img), 4, "transparent GIF width");
    assert_eq(chitra_image_height(img), 4, "transparent GIF height");
    assert_eq(chitra_image_channels(img), 4, "transparent GIF channels");
    var px = chitra_image_pixels(img);
    _gpx(px, 0, 0, 0, 0, 0, "transparent GIF px0");
    _gpx(px, 1, 170, 170, 0, 255, "transparent GIF px1");
    _gpx(px, 2, 0, 0, 255, 255, "transparent GIF px2");
    _gpx(px, 3, 170, 170, 0, 255, "transparent GIF px3");
    _gpx(px, 4, 0, 0, 0, 0, "transparent GIF px4");
    _gpx(px, 5, 0, 0, 255, 255, "transparent GIF px5");
    _gpx(px, 6, 170, 170, 0, 255, "transparent GIF px6");
    _gpx(px, 7, 170, 170, 0, 255, "transparent GIF px7");
    _gpx(px, 8, 0, 0, 0, 0, "transparent GIF px8");
    _gpx(px, 9, 170, 170, 0, 255, "transparent GIF px9");
    _gpx(px, 10, 170, 170, 0, 255, "transparent GIF px10");
    _gpx(px, 11, 170, 170, 0, 255, "transparent GIF px11");
    _gpx(px, 12, 0, 0, 0, 0, "transparent GIF px12");
    _gpx(px, 13, 170, 170, 0, 255, "transparent GIF px13");
    _gpx(px, 14, 170, 170, 0, 255, "transparent GIF px14");
    _gpx(px, 15, 0, 0, 255, 255, "transparent GIF px15");
    return 0;
}

# ADR 0005: chitra decodes the FIRST frame of an animated GIF and returns it as
# a single ChitraImage. It does not reject the file for having more frames, and
# it does not composite them. This fixture has two frames; the expectation is
# ImageMagick's decode of frame 0 specifically ("anim.gif[0]").

fn test_gif_animated() {
    var lo = 0;
    var b = fx_gif_animated(&lo);
    var err = 0;
    var img = chitra_gif_decode(b, lo, &err);
    assert(img != 0, "animated GIF first frame decodes");
    assert_eq(chitra_image_width(img), 4, "animated GIF first frame width");
    assert_eq(chitra_image_height(img), 4, "animated GIF first frame height");
    assert_eq(chitra_image_channels(img), 4, "animated GIF first frame channels");
    var px = chitra_image_pixels(img);
    _gpx(px, 0, 255, 0, 0, 255, "animated GIF first frame px0");
    _gpx(px, 1, 0, 255, 0, 255, "animated GIF first frame px1");
    _gpx(px, 2, 0, 0, 255, 255, "animated GIF first frame px2");
    _gpx(px, 3, 255, 255, 0, 255, "animated GIF first frame px3");
    _gpx(px, 4, 0, 255, 0, 255, "animated GIF first frame px4");
    _gpx(px, 5, 0, 0, 255, 255, "animated GIF first frame px5");
    _gpx(px, 6, 255, 255, 0, 255, "animated GIF first frame px6");
    _gpx(px, 7, 255, 0, 0, 255, "animated GIF first frame px7");
    _gpx(px, 8, 0, 0, 255, 255, "animated GIF first frame px8");
    _gpx(px, 9, 255, 255, 0, 255, "animated GIF first frame px9");
    _gpx(px, 10, 255, 0, 0, 255, "animated GIF first frame px10");
    _gpx(px, 11, 0, 255, 0, 255, "animated GIF first frame px11");
    _gpx(px, 12, 255, 255, 0, 255, "animated GIF first frame px12");
    _gpx(px, 13, 255, 0, 0, 255, "animated GIF first frame px13");
    _gpx(px, 14, 0, 255, 0, 255, "animated GIF first frame px14");
    _gpx(px, 15, 0, 0, 255, 255, "animated GIF first frame px15");
    return 0;
}

# ================================================================
# Rejections and bounds
# ================================================================
fn test_gif_reject_bad_signature() {
    var buf[32];
    var i = 0;
    while (i < 32) { store8(&buf + i, 0x41); i = i + 1; }
    _greject(&buf, 32, CHITRA_ERR_SIGNATURE, "non-GIF rejected at the signature");
    return 0;
}

# Every prefix of a valid GIF must honour the CONTRACT — never read past the
# end, and never return 0 without setting *err_out. Note the assertion is the
# contract, not "must reject": chopping only the trailing 0x3B leaves the image
# data complete, and that prefix legitimately decodes. chitra tolerates a
# missing GIF trailer for the same reason it tolerates a missing PNG IEND.
fn test_gif_truncation_sweep() {
    var lo = 0;
    var b = fx_gif_plain(&lo);
    var cut = 0;
    var err = 0;
    var img = 0;
    while (cut < lo) {
        err = 0;
        img = chitra_gif_decode(b, cut, &err);
        if (img == 0) { assert(err != 0, "truncated GIF sets err_out"); }
        if (img != 0) {
            assert(err == 0, "successful truncated decode leaves err_out 0");
            assert(chitra_image_pixels(img) != 0, "truncated decode has pixels");
        }
        cut = cut + 1;
    }
    # A cut inside the LZW data — not merely the trailer — must reject.
    err = 0;
    assert(chitra_gif_decode(b, lo / 2, &err) == 0, "mid-data truncation rejected");
    assert(err != 0, "mid-data truncation sets err_out");
    return 0;
}

fn test_gif_degenerate_lengths() {
    var lo = 0;
    var b = fx_gif_plain(&lo);
    var err = 0;
    assert(chitra_gif_decode(b, 0, &err) == 0, "len 0 rejected");
    err = 0;
    assert(chitra_gif_decode(b, 0 - 1, &err) == 0, "negative len rejected");
    assert(err != 0, "negative len sets err_out");
    return 0;
}

# A GIF whose stream ends at the trailer with no image descriptor is
# structurally valid but has nothing to decode.
fn test_gif_no_image() {
    var b = alloc(14);
    var lo = 14;
    store8(b + 0, 0x47); store8(b + 1, 0x49); store8(b + 2, 0x46);
    store8(b + 3, 0x38); store8(b + 4, 0x39); store8(b + 5, 0x61);
    store8(b + 6, 4); store8(b + 7, 0);        # width 4
    store8(b + 8, 4); store8(b + 9, 0);        # height 4
    store8(b + 10, 0);                          # no GCT
    store8(b + 11, 0); store8(b + 12, 0);
    store8(b + 13, 0x3B);                       # trailer
    _greject(b, lo, CHITRA_ERR_GIF_NO_IMAGE, "GIF with no image descriptor");
    return 0;
}

# The LZW minimum code size is 2..8 (spec s22). Anything else is corrupt.
# Locate the image descriptor by SCANNING rather than assuming an offset — the
# fixture carries an extension block before it, and a hardcoded offset silently
# patches the wrong byte and tests nothing.
fn _gif_find_min_code_size(b, lo) {
    var i = 0;
    var at = 0 - 1;
    while (i < lo) {
        if (at < 0) {
            if (load8(b + i) == 0x2C) { at = i; }
        }
        i = i + 1;
    }
    if (at < 0) { return 0 - 1; }
    # image descriptor is 10 bytes; a local color table may follow
    var ipacked = load8(b + at + 9);
    var after = at + 10;
    if ((ipacked & 0x80) != 0) { after = after + 3 * (1 << ((ipacked & 7) + 1)); }
    return after;
}

# The LZW minimum code size is 2..8 (spec § 22). Anything else is corrupt.
fn test_gif_reject_bad_min_code_size() {
    var lo = 0;
    var b = fx_gif_plain(&lo);
    var at = _gif_find_min_code_size(b, lo);
    assert(at > 0, "found the LZW min-code-size byte");
    var orig = load8(b + at);
    assert(orig >= 2, "fixture min code size is spec-legal");
    store8(b + at, 1);
    _greject(b, lo, CHITRA_ERR_GIF_LZW, "min code size 1 rejected");
    store8(b + at, 9);
    _greject(b, lo, CHITRA_ERR_GIF_LZW, "min code size 9 rejected");
    store8(b + at, orig);
    return 0;
}

# The router must now sniff four formats.
fn test_gif_router() {
    var lo = 0;
    var b = fx_gif_plain(&lo);
    var err = 0;
    var img = chitra_image_decode(b, lo, &err);
    assert(img != 0, "chitra_image_decode routes GIF");
    assert_eq(chitra_image_width(img), 4, "router GIF width");
    var px = chitra_image_pixels(img);
    _gpx(px, 0, 255, 0, 0, 255, "router GIF px0");
    return 0;
}

fn test_gif_rgba8_wrapper() {
    var lo = 0;
    var b = fx_gif_plain(&lo);
    var w = 0;
    var h = 0;
    var px = chitra_gif_decode_rgba8(b, lo, &w, &h);
    assert(px != 0, "gif _rgba8 returns pixels");
    assert_eq(w, 4, "gif _rgba8 width");
    assert_eq(h, 4, "gif _rgba8 height");
    var w2 = 0;
    var h2 = 0;
    var buf[8];
    store8(&buf + 0, 0x41);
    assert_eq(chitra_gif_decode_rgba8(&buf, 8, &w2, &h2), 0, "gif _rgba8 rejects garbage");
    assert_eq(w2, 0, "gif _rgba8 leaves w at 0 on failure");
    return 0;
}

