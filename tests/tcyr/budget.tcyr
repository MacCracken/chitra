# tests/tcyr/budget.tcyr — chitra_image_decode_budget (0.6.1).
#
# The budget API's whole value is that a REFUSAL is cheap: a caller bounding
# untrusted input must not pay for the images it turns away, on an allocator
# that never frees. So these cells assert allocation COSTS with real numeric
# bounds, not just return values — a budget test that only checks the error
# code would pass with the exhaustion vector wide open, which is precisely the
# failure ADR 0007 (see CHANGELOG 0.6.1) held this surface back over.
#
# Fixtures are one real file per format, all 8x8 or 24x16, from ImageMagick and
# libjpeg-turbo. See tests/tcyr/jpeg_noninterleaved.tcyr for the corpus recipe.
include "src/lib.cyr"
include "lib/assert.cyr"

# 24x16 baseline 4:2:0 JPEG -> 1536 bytes of RGBA8.
fn fx_bud_jpeg(len_out): i64 {
    var b = alloc(689);
    store64(len_out, 689);
    var i = 0;
    while (i < 689) {
        store8(b + i, 0);
        i = i + 1;
