# Decode under a budget and return the bytes the allocator handed out.
fn _bud_cost(b, lo, budget, out_img): i64 {
    var before = alloc_used();
    var err = 0;
    var img = chitra_image_decode_budget(b, lo, budget, &err);
    var spent = alloc_used() - before;
    store64(out_img, img);
    return spent;
}

fn _bud_refuses(b, lo, budget, limit, name): i64 {
    var img = 0;
    var spent = _bud_cost(b, lo, budget, &img);
    assert(img == 0, name);
    assert_lte(spent, limit, name);
    return 0;
}

fn test_budget_refusal_is_cheap_every_format() {
    # A 1-byte budget refuses everything. What matters is the price of saying
    # no: 16 bytes (the ChitraErr) for PNG, JPEG and GIF, and 144 for BMP,
    # whose dimension read goes through the real header parser. The bounds
    # below are deliberately just above the measured figures — loosen them and
    # the cell stops being able to see a regression.
    var lo = 0;
    _bud_refuses(fx_bud_jpeg(&lo), lo, 1, 64, "jpeg budget refusal costs <= 64 B");
    var l2 = 0;
    _bud_refuses(fx_bud_png(&l2), l2, 1, 64, "png budget refusal costs <= 64 B");
    var l3 = 0;
    _bud_refuses(fx_bud_gif(&l3), l3, 1, 64, "gif budget refusal costs <= 64 B");
    var l4 = 0;
    _bud_refuses(fx_bud_bmp(&l4), l4, 1, 256, "bmp budget refusal costs <= 256 B");
    return 0;
}

fn test_budget_boundary_is_exact() {
    # The 24x16 JPEG decodes to exactly 1536 bytes of RGBA8. One byte under
    # must refuse and one byte over must not — a budget that is off by one in
    # either direction is not a contract.
    var lo = 0;
    var img = 0;
    _bud_cost(fx_bud_jpeg(&lo), lo, 1536, &img);
    assert(img != 0, "budget == output size decodes");
    var l2 = 0;
    var img2 = 0;
    _bud_cost(fx_bud_jpeg(&l2), l2, 1535, &img2);
    assert(img2 == 0, "budget one byte under the output size refuses");
    return 0;
}

fn test_budget_zero_and_negative_refuse() {
    # Zero means zero, not "unlimited" — the reading that turns a typo into an
    # unbounded decode.
    var lo = 0;
    var b = fx_bud_png(&lo);
    var err = 0;
    assert(chitra_image_decode_budget(b, lo, 0, &err) == 0, "budget 0 refuses");
    if (err != 0) { assert_eq(chitra_err_code(err), CHITRA_ERR_BUDGET, "budget 0 -> BUDGET"); }
    var e2 = 0;
    assert(chitra_image_decode_budget(b, lo, 0 - 1, &e2) == 0, "negative budget refuses");
    return 0;
}

fn test_budget_ample_decodes_all_four_formats() {
    # The budget must not change what a decode PRODUCES, only whether it starts.
    var lo = 0;
    var err = 0;
    var a = chitra_image_decode_budget(fx_bud_jpeg(&lo), lo, 100000000, &err);
    assert(a != 0, "ample budget decodes jpeg");
    assert_eq(err, 0, "ample budget jpeg: no error");
    if (a != 0) { assert_eq(chitra_image_width(a) * chitra_image_height(a) * 4, 1536, "jpeg output size"); }
    var l2 = 0;
    var e2 = 0;
    assert(chitra_image_decode_budget(fx_bud_png(&l2), l2, 100000000, &e2) != 0, "ample budget decodes png");
    var l3 = 0;
    var e3 = 0;
    assert(chitra_image_decode_budget(fx_bud_bmp(&l3), l3, 100000000, &e3) != 0, "ample budget decodes bmp");
    var l4 = 0;
    var e4 = 0;
    assert(chitra_image_decode_budget(fx_bud_gif(&l4), l4, 100000000, &e4) != 0, "ample budget decodes gif");
    return 0;
}

fn test_budget_does_not_second_guess_validity() {
    # A file whose header cannot be read must reach the router and come back
    # with the ROUTER's error, not with BUDGET. The budget check may only ever
    # refuse on size — the moment it starts refusing on validity it has become
    # a second opinion that can disagree with the decoder.
    var b = alloc(16);
    var i = 0;
    while (i < 16) {
        store8(b + i, 0x41);
        i = i + 1;
    }
    var err = 0;
    assert(chitra_image_decode_budget(b, 16, 100000000, &err) == 0, "garbage is refused");
    if (err != 0) {
        assert_eq(chitra_err_code(err), CHITRA_ERR_SIGNATURE, "garbage -> SIGNATURE, not BUDGET");
    }
    # And a TRUNCATED png: signature valid, header unreadable. The budget cannot
    # size it, so it must hand off rather than invent a refusal.
    var p = alloc(8);
    store8(p + 0, 137);
    store8(p + 1, 80);
    store8(p + 2, 78);
    store8(p + 3, 71);
    store8(p + 4, 13);
    store8(p + 5, 10);
    store8(p + 6, 26);
    store8(p + 7, 10);
    var e2 = 0;
    assert(chitra_image_decode_budget(p, 8, 100000000, &e2) == 0, "truncated png refused");
    if (e2 != 0) {
        assert_neq(chitra_err_code(e2), CHITRA_ERR_BUDGET, "truncated png -> not BUDGET");
    }
    return 0;
}

fn main(): i64 {
    test_budget_refusal_is_cheap_every_format();
    test_budget_boundary_is_exact();
    test_budget_zero_and_negative_refuse();
    test_budget_ample_decodes_all_four_formats();
    test_budget_does_not_second_guess_validity();
    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
