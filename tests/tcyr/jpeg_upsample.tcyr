# tests/tcyr/jpeg_upsample.tcyr — chroma upsampling (1.4.0): libjpeg-turbo's
# "fancy" triangle filters, held byte-for-byte to `djpeg` (no -nosmooth).
# Standalone CPU suite (own main + assert_summary); fixtures are embedded as hex,
# no file I/O.
#
# WHAT THIS PINS. `_chitra_jpeg_upsample_row` picks a filter per component from
# its ratio to the frame maximum, exactly as libjpeg-turbo's jdsample.c does:
#   2x1 (dsw > 2) -> h2v1_fancy     1x2 -> h1v2_fancy     2x2 (dsw > 2) -> h2v2_fancy
#   anything else, including 2x1 / 2x2 with a real chroma width of 2 or less,
#   and every non-2 ratio -> box (libjpeg's h2v1 / h2v2 / int_upsample).
# The fancy cells differ from box on 150-176 of their 189 colour bytes, so a
# regression to box fails them outright. The narrow and 4x1 cells decode
# IDENTICALLY under fancy and box in djpeg — they pin the selection: a decoder
# that applied the triangle filter where libjpeg does not would move them.
# Two cells reach the h2v1 / h1v2 filters through a non-unit maximum on the
# other axis (Y 2x2 with chroma 1x2 or 2x1), where the row-group arithmetic
# differs from the plain 4:2:2 / 4:4:0 case.
#
# Every fixture is 9x7 or 4x5, so chroma widths 5 / 2 and heights 4 / 3 are
# odd and partial: the right column and bottom row exercise the edge clamps
# (the neighbour of an edge sample is the sample itself).
#
# ⚠ Checked to fail against 1.3.1 (box): every fancy cell, on most bytes.
#
# REGENERATION. Source pixels (w x h, P6):
#   R = (37x + 11y) mod 256, G = (5x^2 + 29y) mod 256, B = (255 - 23x + 7y^2) mod 256
#   cjpeg -quality 90 -sample <S> src.ppm > f.jpg ; djpeg -pnm f.jpg  (RGB -> RGBA, A = 255)
# with <S> as each cell's comment says.

include "src/lib.cyr"
include "lib/assert.cyr"

fn _up_hexval(c): i64 {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    return c - 55;
}

# Decode hex string s into b at off; returns the new offset.
fn _up_hex(b, off, s): i64 {
    var i = 0;
    var n = strlen(s);
    while (i + 1 < n) {
        store8(b + off, _up_hexval(load8(s + i)) * 16 + _up_hexval(load8(s + i + 1)));
        off = off + 1;
        i = i + 2;
    }
    return off;
}

# Decode `jpg` (n bytes) and compare all w*h*4 output bytes against `want`.
fn _up_check(jpg, n, want, w, h, name): i64 {
    var err = 0;
    var img = chitra_jpeg_decode(jpg, n, &err);
    assert(img != 0, name);
    assert_eq(err, 0, name);
    if (img == 0) { return 0; }
    assert_eq(chitra_image_width(img), w, name);
    assert_eq(chitra_image_height(img), h, name);
    assert_eq(chitra_image_seen_iend(img), 1, name);
    var px = chitra_image_pixels(img);
    var bad = 0;
    var maxd = 0;
    var i = 0;
    var d = 0;
    while (i < w * h * 4) {
        d = load8(px + i) - load8(want + i);
        if (d < 0) { d = 0 - d; }
        if (d != 0) { bad = bad + 1; }
        if (d > maxd) { maxd = d; }
        i = i + 1;
    }
    assert_eq(bad, 0, name);
    assert_eq(maxd, 0, name);
    return 0;
}

# cjpeg -sample 2x2, 9x7. djpeg: fancy and box differ on 176 of 189 colour bytes.
fn test_up_h2v2_9x7(): i64 {
    var jpg = alloc(735);
    var o = 0;
    o = _up_hex(jpg, o, "ffd8ffe000104a46494600010100000100010000ffdb004300030202030202030303030403030405");
    o = _up_hex(jpg, o, "0805050404050a07");
    o = _up_hex(jpg, o, "0706080c0a0c0c0b0a0b0b0d0e12100d0e110e0b0b1016101113141515150c0f1718161418121415");
    o = _up_hex(jpg, o, "14ffdb0043010304");
    o = _up_hex(jpg, o, "0405040509050509140d0b0d14141414141414141414141414141414141414141414141414141414");
    o = _up_hex(jpg, o, "1414141414141414");
    o = _up_hex(jpg, o, "1414141414141414141414141414ffc00011080007000903012200021101031101ffc4001f000001");
    o = _up_hex(jpg, o, "0501010101010100");
    o = _up_hex(jpg, o, "000000000000000102030405060708090a0bffc400b5100002010303020403050504040000017d01");
    o = _up_hex(jpg, o, "0203000411051221");
    o = _up_hex(jpg, o, "31410613516107227114328191a1082342b1c11552d1f02433627282090a161718191a2526272829");
    o = _up_hex(jpg, o, "2a3435363738393a");
    o = _up_hex(jpg, o, "434445464748494a535455565758595a636465666768696a737475767778797a838485868788898a");
    o = _up_hex(jpg, o, "9293949596979899");
    o = _up_hex(jpg, o, "9aa2a3a4a5a6a7a8a9aab2b3b4b5b6b7b8b9bac2c3c4c5c6c7c8c9cad2d3d4d5d6d7d8d9dae1e2e3");
    o = _up_hex(jpg, o, "e4e5e6e7e8e9eaf1");
    o = _up_hex(jpg, o, "f2f3f4f5f6f7f8f9faffc4001f010003010101010101010101000000000000010203040506070809");
    o = _up_hex(jpg, o, "0a0bffc400b51100");
    o = _up_hex(jpg, o, "020102040403040705040400010277000102031104052131061241510761711322328108144291a1");
    o = _up_hex(jpg, o, "b1c109233352f015");
    o = _up_hex(jpg, o, "6272d10a162434e125f11718191a262728292a35363738393a434445464748494a53545556575859");
    o = _up_hex(jpg, o, "5a63646566676869");
    o = _up_hex(jpg, o, "6a737475767778797a82838485868788898a92939495969798999aa2a3a4a5a6a7a8a9aab2b3b4b5");
    o = _up_hex(jpg, o, "b6b7b8b9bac2c3c4");
    o = _up_hex(jpg, o, "c5c6c7c8c9cad2d3d4d5d6d7d8d9dae2e3e4e5e6e7e8e9eaf2f3f4f5f6f7f8f9faffda000c030100");
    o = _up_hex(jpg, o, "02110311003f0087");
    o = _up_hex(jpg, o, "c31f0ca5f82bf04758bd4b532ea9a9edd12ceea0902b42f719432960ca55923f31958127784c8c64");
    o = _up_hex(jpg, o, "d687fc327693ff00");
    o = _up_hex(jpg, o, "3d61ff00be4ff851457cef17710e3326c64a292aadca4b9aa5dcad1e5495e2e37b5f7777e67e699e");
    o = _up_hex(jpg, o, "e6189fabe0671959");
    o = _up_hex(jpg, o, "ca9dddbbf3c97dd64b4db7ee7fffd9");
    var want = alloc(252);
    o = 0;
    o = _up_hex(want, o, "0e0fa7ff1b10aaff3e1bb7ff6433b0ff8e5a98ffa58590ffb4bca5ff88aa89ff214835ff060a76ff");
    o = _up_hex(want, o, "3a33a5ff5a3dbdff");
    o = _up_hex(want, o, "734cb7ff9d72aaffb79aacffcecfc7ff0a230eff345d4dff252d44ff2f3157ff635497ff856eb6ff");
    o = _up_hex(want, o, "a68abdffc7afd1ff");
    o = _up_hex(want, o, "f4e7fbff262f34ff487369ff374e3cff425349ff656773ffa296aaffb8a1b5ffe3cbe1ff675c7aff");
    o = _up_hex(want, o, "3e4d64ff588d91ff");
    o = _up_hex(want, o, "417161ff4b7359ff73885dff8e8c5cffd0b089ffffe9d9ff2d3447ff436c8cff63abc3ff4a8d95ff");
    o = _up_hex(want, o, "5b9589ff80a677ff");
    o = _up_hex(want, o, "babe83ffeec291ff765337ff223b3fff2d717cff76d1ccff57a8ddff6db6d7ff94c6c3ffc0c7b5ff");
    o = _up_hex(want, o, "ffd0c4ff9a6c5fff");
    o = _up_hex(want, o, "305d49ff47a67cff6fdc89ff");
    _up_check(jpg, 735, want, 9, 7, "h2v2_9x7: byte-identical to djpeg (2x2)");
    return 0;
}

