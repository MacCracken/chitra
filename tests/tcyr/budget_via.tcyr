# tests/tcyr/budget_via.tcyr — 1.4.0: the budget governs size, and a decode can
# take its memory from the caller.
#
# Two consumer issues, one mechanism (the per-decode context in png_chunks.cyr):
#
#   fixed-16-mp-cap — chitra_image_decode_budget held every decode to the fixed
#     CHITRA_MAX_PIXELS (4096 x 4096) whatever budget the caller passed, so a
#     4100 x 4100 image under a 512 MiB budget was refused as
#     CHITRA_ERR_DIMENSIONS. Each format checks its own pixel cap, so each gets
#     its own cell: a guard per format is a reachability claim per format.
#
#   every-decode-leaks — every decode allocated from the never-freeing global
#     allocator. chitra_image_decode_budget_via takes a stdlib Allocator, frees
#     every working buffer before it returns, and chitra_image_free returns the
#     image and its pixels. The cells here count blocks through a test
#     Allocator: after a decode exactly TWO are live (record + pixels), after
#     chitra_image_free none are, and after a refusal none ever were.
#
# Every large fixture is GENERATED at run time (no file I/O, no 2 MB literals):
# a 1-bit PNG through sankoch's zlib_compress, a 1-bit BMP, a DC-only greyscale
# JPEG, and a GIF whose logical screen is large and whose frame is 1 x 1.
#
# ⚠ Checked to fail against 1.3.1: every "past 16.7 MP" cell (refused as
# CHITRA_ERR_DIMENSIONS), the BMP over-budget cell (DIMENSIONS, not BUDGET),
# and the whole Allocator half (chitra_image_decode_budget_via did not exist).
include "src/lib.cyr"
include "lib/assert.cyr"

var _BV_BIG_W = 4100;
var _BV_BIG_H = 4100;
var _BV_BUDGET = 536870912;          # 512 MiB, selah's Rust MAX_DECODE_ALLOC

fn _bv_put32be(p, v): i64 {
    store8(p + 0, (v >> 24) & 255);
    store8(p + 1, (v >> 16) & 255);
    store8(p + 2, (v >> 8) & 255);
    store8(p + 3, v & 255);
    return 0;
}

fn _bv_put32le(p, v): i64 {
    store8(p + 0, v & 255);
    store8(p + 1, (v >> 8) & 255);
    store8(p + 2, (v >> 16) & 255);
    store8(p + 3, (v >> 24) & 255);
    return 0;
}

fn _bv_put16le(p, v): i64 {
    store8(p + 0, v & 255);
    store8(p + 1, (v >> 8) & 255);
    return 0;
}

# A PNG chunk at p: length, type, data (dlen bytes at data), CRC. Returns bytes.
fn _bv_chunk(p, t0, t1, t2, t3, data, dlen): i64 {
    _bv_put32be(p, dlen);
    store8(p + 4, t0);
    store8(p + 5, t1);
    store8(p + 6, t2);
    store8(p + 7, t3);
    var i = 0;
    while (i < dlen) {
        store8(p + 8 + i, load8(data + i));
        i = i + 1;
    }
    _bv_put32be(p + 8 + dlen, crc32(p + 4, dlen + 4));
    return 12 + dlen;
}

# w x h greyscale depth-1 PNG, 8-row stripes: rows with (y >> 3) even are 0x0F
# per byte (4 black then 4 white), odd rows 0xF0.
fn _bv_png(w, h, len_out): i64 {
    crc32_init_table();
    var rb = (w + 7) / 8;
    var rawn = h * (rb + 1);
    var raw = alloc(rawn);
    var y = 0;
    var x = 0;
    var v = 0;
    while (y < h) {
        store8(raw + y * (rb + 1), 0);
        v = 15;
        if (((y >> 3) & 1) == 1) { v = 240; }
        x = 0;
        while (x < rb) {
            store8(raw + y * (rb + 1) + 1 + x, v);
            x = x + 1;
        }
        y = y + 1;
    }
    var zcap = rawn + rawn / 8 + 4096;
    var z = alloc(zcap);
    var zl = zlib_compress(raw, rawn, z, zcap);
    var b = alloc(zl + 128);
    store8(b + 0, 0x89);
    store8(b + 1, 0x50);
    store8(b + 2, 0x4E);
    store8(b + 3, 0x47);
    store8(b + 4, 0x0D);
    store8(b + 5, 0x0A);
    store8(b + 6, 0x1A);
    store8(b + 7, 0x0A);
    var ihdr[16];
    _bv_put32be(&ihdr, w);
    _bv_put32be(&ihdr + 4, h);
    store8(&ihdr + 8, 1);             # depth 1
    store8(&ihdr + 9, 0);             # greyscale
    store8(&ihdr + 10, 0);
    store8(&ihdr + 11, 0);
    store8(&ihdr + 12, 0);
    var o = 8;
    o = o + _bv_chunk(b + o, 0x49, 0x48, 0x44, 0x52, &ihdr, 13);
    o = o + _bv_chunk(b + o, 0x49, 0x44, 0x41, 0x54, z, zl);
    o = o + _bv_chunk(b + o, 0x49, 0x45, 0x4E, 0x44, z, 0);
    store64(len_out, o);
    return b;
}

# w x h 1-bpp BI_RGB BMP, palette {black, white}, top-down, the same stripes.
fn _bv_bmp(w, h, len_out): i64 {
    var stride = ((w + 31) / 32) * 4;
    var off = 14 + 40 + 8;
    var n = off + stride * h;
    var b = alloc(n);
    store8(b + 0, 66);
    store8(b + 1, 77);
    _bv_put32le(b + 2, n);
    _bv_put32le(b + 10, off);
    _bv_put32le(b + 14, 40);
    _bv_put32le(b + 18, w);
    _bv_put32le(b + 22, 0 - h);        # top-down
    _bv_put16le(b + 26, 1);
    _bv_put16le(b + 28, 1);
    _bv_put32le(b + 46, 2);            # biClrUsed
    _bv_put32le(b + 58, 16777215);     # palette[1] = white (B,G,R,0)
    var y = 0;
    var x = 0;
    var v = 0;
    while (y < h) {
        v = 15;
        if (((y >> 3) & 1) == 1) { v = 240; }
        x = 0;
        while (x < stride) {
            store8(b + off + y * stride + x, v);
            x = x + 1;
        }
        y = y + 1;
    }
    store64(len_out, n);
    return b;
}

# w x h baseline greyscale JPEG whose every block is DC 0, no AC: a flat 128.
# DC table: one 1-bit code for category 0; AC table: one 1-bit code for EOB.
# Each block is "0" "0" — two bits, so the scan is w*h/32 bytes, inside every
# amplification gate.
fn _bv_jpeg(w, h, len_out): i64 {
    var blocks = ((w + 7) / 8) * ((h + 7) / 8);
    var ebytes = (blocks * 2 + 7) / 8;
    var b = alloc(ebytes + 512);
    var o = 0;
    var i = 0;
    store8(b + 0, 255);
    store8(b + 1, 216);
    o = 2;
    # DQT table 0, all 1.
    store8(b + o, 255);
    store8(b + o + 1, 219);
    store8(b + o + 2, 0);
    store8(b + o + 3, 67);
    store8(b + o + 4, 0);
    o = o + 5;
    while (i < 64) {
        store8(b + o + i, 1);
        i = i + 1;
    }
    o = o + 64;
    # SOF0, 1 component, 1x1.
    store8(b + o, 255);
    store8(b + o + 1, 192);
    store8(b + o + 2, 0);
    store8(b + o + 3, 11);
    store8(b + o + 4, 8);
    store8(b + o + 5, (h >> 8) & 255);
    store8(b + o + 6, h & 255);
    store8(b + o + 7, (w >> 8) & 255);
    store8(b + o + 8, w & 255);
    store8(b + o + 9, 1);
    store8(b + o + 10, 1);
    store8(b + o + 11, 17);
    store8(b + o + 12, 0);
    o = o + 13;
    # DHT DC 0 and AC 0: BITS = {1 code of length 1}, HUFFVAL = {0}.
    var t = 0;
    while (t < 2) {
        store8(b + o, 255);
        store8(b + o + 1, 196);
        store8(b + o + 2, 0);
        store8(b + o + 3, 20);
        store8(b + o + 4, t * 16);
        i = 0;
        while (i < 16) {
            store8(b + o + 5 + i, 0);
            i = i + 1;
        }
        store8(b + o + 5, 1);
        store8(b + o + 21, 0);
        o = o + 22;
        t = t + 1;
    }
    # SOS.
    store8(b + o, 255);
    store8(b + o + 1, 218);
    store8(b + o + 2, 0);
    store8(b + o + 3, 8);
    store8(b + o + 4, 1);
    store8(b + o + 5, 1);
    store8(b + o + 6, 0);
    store8(b + o + 7, 0);
    store8(b + o + 8, 63);
    store8(b + o + 9, 0);
    o = o + 10;
    # Every block is the code "0" (DC category 0) then "0" (EOB): all-zero
    # bits, then 1-bit padding to the byte boundary (T.81 § F.1.2.3).
    i = 0;
    while (i < ebytes) {
        store8(b + o + i, 0);
        i = i + 1;
    }
    var used = blocks * 2 - (ebytes - 1) * 8;
    store8(b + o + ebytes - 1, (1 << (8 - used)) - 1);
    o = o + ebytes;
    store8(b + o, 255);
    store8(b + o + 1, 217);
    store64(len_out, o + 2);
    return b;
}

# GIF89a with a w x h logical screen and one 1 x 1 frame of colour 1 (red) at
# (0, 0): the canvas is the decode's size, the frame is one LZW code.
fn _bv_gif(w, h, len_out): i64 {
    var b = alloc(64);
    store8(b + 0, 71);
    store8(b + 1, 73);
    store8(b + 2, 70);
    store8(b + 3, 56);
    store8(b + 4, 57);
    store8(b + 5, 97);
    _bv_put16le(b + 6, w);
    _bv_put16le(b + 8, h);
    store8(b + 10, 0x80);              # global table, 2 entries
    store8(b + 11, 0);
    store8(b + 12, 0);
    store8(b + 13, 0);                 # entry 0: black
    store8(b + 14, 0);
    store8(b + 15, 0);
    store8(b + 16, 255);               # entry 1: red
    store8(b + 17, 0);
    store8(b + 18, 0);
    store8(b + 19, 0x2C);              # image descriptor
    _bv_put16le(b + 20, 0);
    _bv_put16le(b + 22, 0);
    _bv_put16le(b + 24, 1);
    _bv_put16le(b + 26, 1);
    store8(b + 28, 0);
    store8(b + 29, 2);                 # min code size 2: clear 4, end 5, 3-bit codes
    store8(b + 30, 2);                 # one sub-block of 2 bytes
    # codes, LSB-first, 3 bits each: clear(4) pixel(1) end(5)
    # bits: 100 | 001 << 3 | 101 << 6 = 0b101_001_100 = 0x14C
    store8(b + 31, 0x4C);
    store8(b + 32, 0x01);
    store8(b + 33, 0);                 # block terminator
    store8(b + 34, 0x3B);              # trailer
    store64(len_out, 35);
    return b;
}

fn _bv_px(img, x, y, r, g, bl, a, label): i64 {
    var p = chitra_image_pixels(img) + (y * chitra_image_width(img) + x) * 4;
    assert_eq(load8(p + 0), r, label);
    assert_eq(load8(p + 1), g, label);
    assert_eq(load8(p + 2), bl, label);
    assert_eq(load8(p + 3), a, label);
    return 0;
}

fn _bv_code(err): i64 {
    if (err == 0) { return 0 - 1; }
    return chitra_err_code(err);
}

# ================================================================
# The fixed caps are untouched outside a budget.
# ================================================================
fn test_fixed_caps_unchanged_without_budget() {
    var lo = 0;
    var err = 0;
    var b = _bv_png(_BV_BIG_W, _BV_BIG_H, &lo);
    assert(chitra_image_decode(b, lo, &err) == 0, "PNG past 16.7 MP: chitra_image_decode keeps the fixed cap");
    assert_eq(_bv_code(err), CHITRA_ERR_DIMENSIONS, "...as CHITRA_ERR_DIMENSIONS");
    b = _bv_bmp(_BV_BIG_W, _BV_BIG_H, &lo);
    assert(chitra_bmp_decode(b, lo, &err) == 0, "BMP past 16.7 MP: chitra_bmp_decode keeps the fixed cap");
    assert_eq(_bv_code(err), CHITRA_ERR_DIMENSIONS, "...as CHITRA_ERR_DIMENSIONS");
    b = _bv_jpeg(_BV_BIG_W, _BV_BIG_H, &lo);
    assert(chitra_jpeg_decode(b, lo, &err) == 0, "JPEG past 16.7 MP: chitra_jpeg_decode keeps the fixed cap");
    assert_eq(_bv_code(err), CHITRA_ERR_DIMENSIONS, "...as CHITRA_ERR_DIMENSIONS");
    b = _bv_gif(_BV_BIG_W, _BV_BIG_H, &lo);
    assert(chitra_gif_decode(b, lo, &err) == 0, "GIF past 16.7 MP: chitra_gif_decode keeps the fixed cap");
    assert_eq(_bv_code(err), CHITRA_ERR_DIMENSIONS, "...as CHITRA_ERR_DIMENSIONS");
    return 0;
}

# ================================================================
# Under a budget the budget governs: 4100 x 4100 = 16.8 MP, 67.24 MB of RGBA,
# inside 512 MiB. One cell per format, because each checks its own cap.
# ================================================================
fn test_budget_decodes_past_16mp_png() {
    var lo = 0;
    var err = 0;
    var b = _bv_png(_BV_BIG_W, _BV_BIG_H, &lo);
    var img = chitra_image_decode_budget(b, lo, _BV_BUDGET, &err);
    assert(img != 0, "PNG 4100x4100 decodes under a 512 MiB budget");
    assert_eq(err, 0, "PNG 4100x4100: no error");
    if (img != 0) {
        assert_eq(chitra_image_width(img), _BV_BIG_W, "PNG width");
        assert_eq(chitra_image_height(img), _BV_BIG_H, "PNG height");
        _bv_px(img, 0, 0, 0, 0, 0, 255, "PNG (0,0) black");
        _bv_px(img, 4, 0, 255, 255, 255, 255, "PNG (4,0) white");
        _bv_px(img, 0, 8, 255, 255, 255, 255, "PNG (0,8) white");
        _bv_px(img, 4099, 4099, 0, 0, 0, 255, "PNG last pixel (row 4099 even stripe, bit 3 of 0x0F: black)");
    }
    return 0;
}

fn test_budget_decodes_past_16mp_bmp() {
    var lo = 0;
    var err = 0;
    var b = _bv_bmp(_BV_BIG_W, _BV_BIG_H, &lo);
    var img = chitra_image_decode_budget(b, lo, _BV_BUDGET, &err);
    assert(img != 0, "BMP 4100x4100 decodes under a 512 MiB budget");
    if (img != 0) {
        assert_eq(chitra_image_width(img), _BV_BIG_W, "BMP width");
        assert_eq(chitra_image_height(img), _BV_BIG_H, "BMP height");
        _bv_px(img, 0, 0, 0, 0, 0, 255, "BMP (0,0) black");
        _bv_px(img, 4, 0, 255, 255, 255, 255, "BMP (4,0) white");
        _bv_px(img, 0, 8, 255, 255, 255, 255, "BMP (0,8) white");
    }
    return 0;
}

fn test_budget_decodes_past_16mp_jpeg() {
    var lo = 0;
    var err = 0;
    var b = _bv_jpeg(_BV_BIG_W, _BV_BIG_H, &lo);
    var img = chitra_image_decode_budget(b, lo, _BV_BUDGET, &err);
    assert(img != 0, "JPEG 4100x4100 decodes under a 512 MiB budget");
    if (img != 0) {
        assert_eq(chitra_image_width(img), _BV_BIG_W, "JPEG width");
        assert_eq(chitra_image_height(img), _BV_BIG_H, "JPEG height");
        _bv_px(img, 0, 0, 128, 128, 128, 255, "JPEG (0,0) flat 128");
        _bv_px(img, 4099, 4099, 128, 128, 128, 255, "JPEG last pixel flat 128");
        assert_eq(chitra_image_seen_iend(img), 1, "JPEG closed cleanly");
    }
    return 0;
}

fn test_budget_decodes_past_16mp_gif() {
    var lo = 0;
    var err = 0;
    var b = _bv_gif(_BV_BIG_W, _BV_BIG_H, &lo);
    var img = chitra_image_decode_budget(b, lo, _BV_BUDGET, &err);
    assert(img != 0, "GIF 4100x4100 screen decodes under a 512 MiB budget");
    if (img != 0) {
        assert_eq(chitra_image_width(img), _BV_BIG_W, "GIF width");
        assert_eq(chitra_image_height(img), _BV_BIG_H, "GIF height");
        _bv_px(img, 0, 0, 255, 0, 0, 255, "GIF (0,0) the 1x1 frame, red");
        _bv_px(img, 1, 0, 0, 0, 0, 0, "GIF (1,0) canvas, transparent");
    }
    return 0;
}

# Over the budget is CHITRA_ERR_BUDGET for every format, cheaply. 64 MiB is
# under 4100 x 4100 x 4 = 67,240,000. ⚠ BMP read as "unreadable" in the
# budget probe through 1.3.x (its header parse applied the fixed cap), so it
# fell through to the decoder and came back CHITRA_ERR_DIMENSIONS.
fn test_over_budget_is_budget() {
    var lo = 0;
    var err = 0;
    var mb = 67108864;
    var before = 0;
    var b = _bv_png(_BV_BIG_W, _BV_BIG_H, &lo);
    before = alloc_used();
    assert(chitra_image_decode_budget(b, lo, mb, &err) == 0, "PNG over budget refused");
    assert_eq(_bv_code(err), CHITRA_ERR_BUDGET, "PNG over budget: CHITRA_ERR_BUDGET");
    assert_lte(alloc_used() - before, 16, "PNG refusal costs the ChitraErr only");
    b = _bv_bmp(_BV_BIG_W, _BV_BIG_H, &lo);
    before = alloc_used();
    assert(chitra_image_decode_budget(b, lo, mb, &err) == 0, "BMP over budget refused");
    assert_eq(_bv_code(err), CHITRA_ERR_BUDGET, "BMP over budget: CHITRA_ERR_BUDGET, not DIMENSIONS");
    assert_lte(alloc_used() - before, 128, "BMP refusal costs 128 bytes, as ADR 0008 records");
    b = _bv_jpeg(_BV_BIG_W, _BV_BIG_H, &lo);
    before = alloc_used();
    assert(chitra_image_decode_budget(b, lo, mb, &err) == 0, "JPEG over budget refused");
    assert_eq(_bv_code(err), CHITRA_ERR_BUDGET, "JPEG over budget: CHITRA_ERR_BUDGET");
    assert_lte(alloc_used() - before, 16, "JPEG refusal costs the ChitraErr only");
    b = _bv_gif(_BV_BIG_W, _BV_BIG_H, &lo);
    assert(chitra_image_decode_budget(b, lo, mb, &err) == 0, "GIF over budget refused");
    assert_eq(_bv_code(err), CHITRA_ERR_BUDGET, "GIF over budget: CHITRA_ERR_BUDGET");
    return 0;
}

# CHITRA_MAX_DIM still bounds a side under any budget.
fn test_budget_keeps_max_dim() {
    var lo = 0;
    var err = 0;
    var b = _bv_gif(_BV_BIG_W, _BV_BIG_H, &lo);
    _bv_put16le(b + 6, 65535);
    _bv_put16le(b + 8, 2);
    var img = chitra_image_decode_budget(b, lo, 4294967296, &err);
    assert(img != 0, "a 65535-wide screen is inside CHITRA_MAX_DIM");
    var j = _bv_jpeg(8, 8, &lo);
    store8(j + 74 + 5, 0);             # SOF0 height 0 -> DNL deferral, refused
    store8(j + 74 + 6, 0);
    assert(chitra_image_decode_budget(j, lo, 4294967296, &err) == 0, "a budget does not relax header validity");
    return 0;
}

# ================================================================
# The Allocator half. A counting Allocator that hands out DIRTY blocks
# (0xA5) so a decode that relied on zeroed memory shows it, and that records
# every live block so a free of something it never issued is caught.
# State: +0 live count, +8 allocations, +16 frees, +24 bad frees,
#        +32 slot count, +40.. slots (4096 i64).
# ================================================================
fn _ta_alloc(state, size): i64 {
    var p = alloc(size);
    if (p == 0) { return 0; }
    var i = 0;
    while (i < size) {
        store8(p + i, 0xA5);
        i = i + 1;
    }
    var n = load64(state + 32);
    store64(state + 40 + n * 8, p);
    store64(state + 32, n + 1);
    store64(state + 0, load64(state + 0) + 1);
    store64(state + 8, load64(state + 8) + 1);
    return p;
}

fn _ta_realloc(state, old_ptr, old_size, new_size): i64 {
    return 0;
}

fn _ta_free(state, ptr): i64 {
    var n = load64(state + 32);
    var i = 0;
    var found = 0;
    while (i < n) {
        if (load64(state + 40 + i * 8) == ptr) {
            store64(state + 40 + i * 8, 0);
            found = 1;
            i = n;
        }
        i = i + 1;
    }
    if (found == 0) { store64(state + 24, load64(state + 24) + 1); }
    if (found == 1) { store64(state + 0, load64(state + 0) - 1); }
    store64(state + 16, load64(state + 16) + 1);
    return 0;
}

fn _ta_reset(state): i64 { return 0; }

fn _ta_new(): i64 {
    var st = alloc(40 + 4096 * 8);
    store64(st + 0, 0);
    store64(st + 8, 0);
    store64(st + 16, 0);
    store64(st + 24, 0);
    store64(st + 32, 0);
    return allocator_new(&_ta_alloc, &_ta_realloc, &_ta_free, &_ta_reset, st);
}

fn _ta_live(a): i64 { return load64(allocator_state(a) + 0); }
fn _ta_bad(a): i64 { return load64(allocator_state(a) + 24); }

# Decode `b` both ways; the _via result must equal the global one byte for
# byte (the dirty blocks would show otherwise), leave exactly two blocks live,
# and leave none after chitra_image_free.
fn _bv_via_roundtrip(b, lo, label): i64 {
    var err = 0;
    var ref = chitra_image_decode_budget(b, lo, _BV_BUDGET, &err);
    assert(ref != 0, label);
    var a = _ta_new();
    var img = chitra_image_decode_budget_via(a, b, lo, _BV_BUDGET, &err);
    assert(img != 0, label);
    assert_eq(err, 0, label);
    if (img == 0) { return 0; }
    assert(load64(allocator_state(a) + 8) >= 2, label);
    assert_eq(_ta_live(a), 2, label);
    var n = chitra_image_width(img) * chitra_image_height(img) * 4;
    assert_eq(n, chitra_image_width(ref) * chitra_image_height(ref) * 4, label);
    var p = chitra_image_pixels(img);
    var q = chitra_image_pixels(ref);
    var bad = 0;
    var i = 0;
    while (i < n) {
        if (load8(p + i) != load8(q + i)) { bad = bad + 1; }
        i = i + 1;
    }
    assert_eq(bad, 0, label);
    assert_eq(chitra_image_seen_iend(img), chitra_image_seen_iend(ref), label);
    assert_eq(chitra_image_source_color_type(img), chitra_image_source_color_type(ref), label);
    chitra_image_free(img);
    assert_eq(_ta_live(a), 0, label);
    assert_eq(_ta_bad(a), 0, label);
    return 0;
}

fn test_via_frees_every_working_buffer() {
    var lo = 0;
    _bv_via_roundtrip(_bv_png(37, 23, &lo), lo, "via PNG 37x23: two blocks live, then none");
    _bv_via_roundtrip(_bv_bmp(37, 23, &lo), lo, "via BMP 37x23: two blocks live, then none");
    _bv_via_roundtrip(_bv_jpeg(37, 23, &lo), lo, "via JPEG 37x23: two blocks live, then none");
    _bv_via_roundtrip(_bv_gif(37, 23, &lo), lo, "via GIF 37x23: two blocks live, then none");
    _bv_via_roundtrip(_bv_png(_BV_BIG_W, _BV_BIG_H, &lo), lo, "via PNG 4100x4100: two blocks live, then none");
    _bv_via_roundtrip(_bv_jpeg(_BV_BIG_W, _BV_BIG_H, &lo), lo, "via JPEG 4100x4100: two blocks live, then none");
    return 0;
}

# A refusal returns everything — header refusals and failures deep in a decode.
fn test_via_refusal_returns_everything() {
    var lo = 0;
    var err = 0;
    var a = _ta_new();
    var b = _bv_jpeg(64, 64, &lo);
    store8(b + lo - 6, 0xFF);          # an 0xFF data byte with no stuffing -> marker 0x??
    store8(b + lo - 5, 0xC4);          # a DHT inside the scan: the span ends there, scan truncated
    var img = chitra_image_decode_budget_via(a, b, lo, _BV_BUDGET, &err);
    if (img != 0) { chitra_image_free(img); }
    assert_eq(_ta_live(a), 0, "via: a damaged JPEG leaves nothing live either way");
    b = _bv_png(37, 23, &lo);
    store8(b + 40, load8(b + 40) ^ 1);     # IDAT payload byte: the chunk CRC now fails
    img = chitra_image_decode_budget_via(a, b, lo, _BV_BUDGET, &err);
    assert(img == 0, "via: a PNG with a bad CRC is refused");
    assert_eq(_ta_live(a), 0, "via: the PNG refusal returned every block");
    b = _bv_bmp(37, 23, &lo);
    _bv_put32le(b + 10, 100000);       # pixel data past the end
    img = chitra_image_decode_budget_via(a, b, lo, _BV_BUDGET, &err);
    assert(img == 0, "via: a BMP pointing past its end is refused");
    assert_eq(_ta_live(a), 0, "via: the BMP refusal returned every block");
    b = _bv_png(_BV_BIG_W, _BV_BIG_H, &lo);
    img = chitra_image_decode_budget_via(a, b, lo, 1024, &err);
    assert(img == 0, "via: over budget");
    assert_eq(_bv_code(err), CHITRA_ERR_BUDGET, "via: over budget is CHITRA_ERR_BUDGET");
    assert_eq(load64(allocator_state(a) + 8) - load64(allocator_state(a) + 16), 0,
      "via: allocations and frees balance");
    assert_eq(_ta_bad(a), 0, "via: nothing freed that was not issued");
    return 0;
}

# A 0 allocator is the global one: chitra_image_decode_budget exactly, and
# chitra_image_free stays the no-op a 1.3.x consumer may have relied on.
fn test_via_zero_is_global_and_free_is_a_noop_there() {
    var lo = 0;
    var err = 0;
    var b = _bv_png(37, 23, &lo);
    var img = chitra_image_decode_budget_via(0, b, lo, _BV_BUDGET, &err);
    assert(img != 0, "via with a = 0 decodes");
    chitra_image_free(img);
    _bv_px(img, 4, 0, 255, 255, 255, 255, "a global image is still readable after chitra_image_free");
    assert_eq(chitra_image_free(0), 0, "chitra_image_free(0) is safe");
    return 0;
}

# The live-slot bound refuses rather than leaks: a 65th tracked allocation is
# 0. No decode comes near it (~16); this pins the guard itself.
fn test_ctx_slot_bound_refuses() {
    var a = _ta_new();
    var ctx[544];
    _chitra_ctx_init(&ctx, a, CHITRA_MAX_PIXELS, CHITRA_MAX_RAW_BYTES);
    var i = 0;
    var ok = 0;
    while (i < 64) {
        if (_chitra_alloc(&ctx, 8) != 0) { ok = ok + 1; }
        i = i + 1;
    }
    assert_eq(ok, 64, "64 tracked allocations succeed");
    assert(_chitra_alloc(&ctx, 8) == 0, "the 65th is refused, not leaked");
    _chitra_ctx_release(&ctx, 0, 0);
    assert_eq(_ta_live(a), 0, "release returns all 64");
    return 0;
}

fn main(): i64 {
    test_fixed_caps_unchanged_without_budget();
    test_budget_decodes_past_16mp_png();
    test_budget_decodes_past_16mp_bmp();
    test_budget_decodes_past_16mp_jpeg();
    test_budget_decodes_past_16mp_gif();
    test_over_budget_is_budget();
    test_budget_keeps_max_dim();
    test_via_frees_every_working_buffer();
    test_via_refusal_returns_everything();
    test_via_zero_is_global_and_free_is_a_noop_there();
    test_ctx_slot_bound_refuses();
    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
