    store8(b + 177, 0xCB);
    store8(b + 178, 0xED);
    store8(b + 179, 0x7A);
    store8(b + 180, 0xBF);
    store8(b + 181, 0x5C);
    store8(b + 182, 0x84);
    store8(b + 183, 0x78);
    store8(b + 184, 0x4C);
    store8(b + 185, 0x2E);
    store8(b + 186, 0x9B);
    store8(b + 187, 0xCF);
    store8(b + 188, 0xE4);
    store8(b + 190, 0x3B);
    return b;
}

# 8x8 BMP.
fn fx_se_bmp(len_out): i64 {
    var b = alloc(246);
    store64(len_out, 246);
    var i = 0;
    while (i < 246) {
        store8(b + i, 0);
        i = i + 1;
    }
    store8(b + 0, 0x42);
    store8(b + 1, 0x4D);
    store8(b + 2, 0xF6);
    store8(b + 10, 0x36);
    store8(b + 14, 0x28);
    store8(b + 18, 0x08);
    store8(b + 22, 0x08);
    store8(b + 26, 0x01);
    store8(b + 28, 0x18);
    store8(b + 34, 0xC0);
    store8(b + 54, 0xFF);
    store8(b + 57, 0xFF);
    store8(b + 60, 0xFF);
    store8(b + 63, 0xFF);
    store8(b + 66, 0xFF);
    store8(b + 69, 0xFF);
    store8(b + 72, 0xFF);
    store8(b + 75, 0xFF);
    store8(b + 78, 0xDB);
    store8(b + 80, 0x24);
    store8(b + 81, 0xDB);
    store8(b + 83, 0x24);
    store8(b + 84, 0xDB);
    store8(b + 86, 0x24);
    store8(b + 87, 0xDB);
    store8(b + 89, 0x24);
    store8(b + 90, 0xDB);
    store8(b + 92, 0x24);
    store8(b + 93, 0xDB);
    store8(b + 95, 0x24);
    store8(b + 96, 0xDB);
    store8(b + 98, 0x24);
    store8(b + 99, 0xDB);
    store8(b + 101, 0x24);
    store8(b + 102, 0xB6);
    store8(b + 104, 0x49);
    store8(b + 105, 0xB6);
    store8(b + 107, 0x49);
    store8(b + 108, 0xB6);
    store8(b + 110, 0x49);
    store8(b + 111, 0xB6);
    store8(b + 113, 0x49);
    store8(b + 114, 0xB6);
    store8(b + 116, 0x49);
    store8(b + 117, 0xB6);
    store8(b + 119, 0x49);
    store8(b + 120, 0xB6);
    store8(b + 122, 0x49);
    store8(b + 123, 0xB6);
    store8(b + 125, 0x49);
    store8(b + 126, 0x92);
    store8(b + 128, 0x6D);
    store8(b + 129, 0x92);
    store8(b + 131, 0x6D);
    store8(b + 132, 0x92);
    store8(b + 134, 0x6D);
    store8(b + 135, 0x92);
    store8(b + 137, 0x6D);
    store8(b + 138, 0x92);
    store8(b + 140, 0x6D);
    store8(b + 141, 0x92);
    store8(b + 143, 0x6D);
    store8(b + 144, 0x92);
    store8(b + 146, 0x6D);
    store8(b + 147, 0x92);
    store8(b + 149, 0x6D);
    store8(b + 150, 0x6D);
    store8(b + 152, 0x92);
    store8(b + 153, 0x6D);
    store8(b + 155, 0x92);
    store8(b + 156, 0x6D);
    store8(b + 158, 0x92);
    store8(b + 159, 0x6D);
    store8(b + 161, 0x92);
    store8(b + 162, 0x6D);
    store8(b + 164, 0x92);
    store8(b + 165, 0x6D);
    store8(b + 167, 0x92);
    store8(b + 168, 0x6D);
    store8(b + 170, 0x92);
    store8(b + 171, 0x6D);
    store8(b + 173, 0x92);
    store8(b + 174, 0x49);
    store8(b + 176, 0xB6);
    store8(b + 177, 0x49);
    store8(b + 179, 0xB6);
    store8(b + 180, 0x49);
    store8(b + 182, 0xB6);
    store8(b + 183, 0x49);
    store8(b + 185, 0xB6);
    store8(b + 186, 0x49);
    store8(b + 188, 0xB6);
    store8(b + 189, 0x49);
    store8(b + 191, 0xB6);
    store8(b + 192, 0x49);
    store8(b + 194, 0xB6);
    store8(b + 195, 0x49);
    store8(b + 197, 0xB6);
    store8(b + 198, 0x24);
    store8(b + 200, 0xDB);
    store8(b + 201, 0x24);
    store8(b + 203, 0xDB);
    store8(b + 204, 0x24);
    store8(b + 206, 0xDB);
    store8(b + 207, 0x24);
    store8(b + 209, 0xDB);
    store8(b + 210, 0x24);
    store8(b + 212, 0xDB);
    store8(b + 213, 0x24);
    store8(b + 215, 0xDB);
    store8(b + 216, 0x24);
    store8(b + 218, 0xDB);
    store8(b + 219, 0x24);
    store8(b + 221, 0xDB);
    store8(b + 224, 0xFF);
    store8(b + 227, 0xFF);
    store8(b + 230, 0xFF);
    store8(b + 233, 0xFF);
    store8(b + 236, 0xFF);
    store8(b + 239, 0xFF);
    store8(b + 242, 0xFF);
    store8(b + 245, 0xFF);
    return b;
}

fn _se_sum(img): i64 {
    var n = chitra_image_width(img) * chitra_image_height(img) * 4;
    var px = chitra_image_pixels(img);
    var s = 0;
    var i = 0;
    while (i < n) {
        s = s + load8(px + i);
        i = i + 1;
    }
    return s;
}

fn test_jpeg_complete_stream_reports_closed() {
    var lo = 0;
    var b = fx_se_jpeg(&lo);
    var err = 0;
    var img = chitra_jpeg_decode(b, lo, &err);
    assert(img != 0, "complete JPEG decodes");
    if (img != 0) {
        assert_eq(chitra_image_seen_iend(img), 1, "complete JPEG: seen_iend = 1");
        assert_eq(_se_sum(img), 223824, "complete JPEG: correct pixels");
    }
    return 0;
}

fn test_jpeg_missing_eoi_reports_not_closed_but_decodes() {
    # Dropping the two EOI bytes leaves every pixel intact — chitra tolerates an
    # EOI-less JPEG exactly as it tolerates an IEND-less PNG. The pixels are
    # right and the stream did not close, and the field must say the second
    # without implying the first.
    var lo = 0;
    var b = fx_se_jpeg(&lo);
    var err = 0;
    var img = chitra_jpeg_decode(b, lo - 2, &err);
    assert(img != 0, "EOI-stripped JPEG still decodes");
    assert_eq(err, 0, "EOI-stripped JPEG: no error");
    if (img != 0) {
        assert_eq(_se_sum(img), 223824, "EOI-stripped JPEG: pixels still correct");
        assert_eq(chitra_image_seen_iend(img), 0, "EOI-stripped JPEG: seen_iend = 0");
    }
    return 0;
}

fn test_jpeg_truncated_scan_reports_not_closed() {
    # 60 bytes off the end lands inside the entropy data. The decode succeeds
    # with fabricated MCUs — byte sum 143,178 against a correct 223,824 — and
    # before 0.7.0 it reported seen_iend = 1, which was the only thing a caller
    # had to go on.
    var lo = 0;
    var b = fx_se_jpeg(&lo);
    var err = 0;
    var img = chitra_jpeg_decode(b, lo - 60, &err);
    assert(img != 0, "truncated JPEG still decodes");
    if (img != 0) {
        assert_eq(chitra_image_seen_iend(img), 0, "truncated JPEG: seen_iend = 0");
        assert_neq(_se_sum(img), 223824, "truncated JPEG: pixels really are wrong");
    }
    return 0;
}

fn test_gif_complete_frame_reports_closed() {
    var lo = 0;
    var b = fx_se_gif(&lo);
    var err = 0;
    var img = chitra_gif_decode(b, lo, &err);
    assert(img != 0, "complete GIF decodes");
    if (img != 0) {
        assert_eq(chitra_image_seen_iend(img), 1, "complete GIF: seen_iend = 1");
        assert_eq(chitra_image_width(img), 32, "complete GIF: width 32");
    }
    return 0;
}

fn test_gif_short_lzw_reports_not_closed() {
    # A structurally valid GIF whose LZW stream ends before the frame is full.
    # chitra zero-fills the tail and returns the image — the right decode, and
    # one the caller must be able to recognise as partial.
    var lo = 0;
    var b = fx_se_gif_short(&lo);
    var err = 0;
    var img = chitra_gif_decode(b, lo, &err);
    assert(img != 0, "GIF with an early end-of-blocks still decodes");
    assert_eq(err, 0, "early end-of-blocks: no error");
    if (img != 0) {
        assert_eq(chitra_image_seen_iend(img), 0, "short LZW: seen_iend = 0");
    }
    return 0;
}

fn test_bmp_has_no_terminator_and_says_so() {
    # BMP has no stream terminator to have seen. The whole pixel span is
    # validated against the input length before anything is read, so if a decode
    # returns at all the data was entirely present — 1 is the honest answer
    # here, not a leftover placeholder. This cell exists so that stays a
    # deliberate choice rather than an unexamined constant.
    var lo = 0;
    var b = fx_se_bmp(&lo);
    var err = 0;
    var img = chitra_bmp_decode(b, lo, &err);
    assert(img != 0, "BMP decodes");
    if (img != 0) { assert_eq(chitra_image_seen_iend(img), 1, "BMP: seen_iend = 1"); }
    return 0;
}

fn main(): i64 {
    test_jpeg_complete_stream_reports_closed();
    test_jpeg_missing_eoi_reports_not_closed_but_decodes();
    test_jpeg_truncated_scan_reports_not_closed();
    test_gif_complete_frame_reports_closed();
    test_gif_short_lzw_reports_not_closed();
    test_bmp_has_no_terminator_and_says_so();
    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
