# cjpeg -scans s1.scan -sample 2x2 src.ppm, cut after the FIRST scan's entropy
# data. s1.scan = DC for Y, then Cb, then Cr, each alone, then AC. Only Y has
# had its DC scan when the input ends.
fn _pg_fx_nodc(len_out): i64 {
    var b = alloc(217);
    var o = 0;
    o = _pg_hex(b, o, "ffd8ffe000104a46494600010100000100010000ffdb004300080606070605080707070909080a0c");
    o = _pg_hex(b, o, "140d0c0b0b0c1912");
    o = _pg_hex(b, o, "130f141d1a1f1e1d1a1c1c20242e2720222c231c1c2837292c30313434341f27393d38323c2e3334");
    o = _pg_hex(b, o, "32ffdb0043010909");
    o = _pg_hex(b, o, "090c0b0c180d0d1832211c2132323232323232323232323232323232323232323232323232323232");
    o = _pg_hex(b, o, "3232323232323232");
    o = _pg_hex(b, o, "3232323232323232323232323232ffc2001108000b001103012200021101031101ffc40017000003");
    o = _pg_hex(b, o, "0100000000000000");
    o = _pg_hex(b, o, "00000000000002040603ffda0008010100000000cc935a8263");
    store64(len_out, 217);
    return b;
}

# ================================================================
# The progression rules. cjpeg's default 4:2:0 script, scan by scan:
#   1  Y,Cb,Cr  DC   Ah 0 Al 1      6  Y   1-63  Ah 2 Al 1
#   2  Y     1-5     Ah 0 Al 2      7  Y,Cb,Cr DC  Ah 1 Al 0
#   3  Cr    1-63    Ah 0 Al 1      8  Cr  1-63  Ah 1 Al 0
#   4  Cb    1-63    Ah 0 Al 1      9  Cb  1-63  Ah 1 Al 0
#   5  Y     6-63    Ah 0 Al 2     10  Y   1-63  Ah 1 Al 0
# Each cell edits one scan header of a REAL file and must be refused as
# CHITRA_ERR_JPEG_SOS. ⚠ In a real file the rules overlap — a later scan, or
# a table cjpeg only defines for the scan that uses it, refuses the same edit
# with the same code — so these cells are not each a guard's only witness.
# The synthetic cells below are: one scan script per rule, each mutation-
# checked (neuter that one test and its cell decodes).
# ================================================================
fn test_pg_refinement_of_an_uncoded_band() {
    var lo = 0;
    var b = _pg_fx_p420_17x11(&lo);
    store8(b + _pg_spec_at(b, lo, 2) + 2, 0x21);          # scan 2: Ah 2 Al 1 on never-coded 1-5
    _pg_refuses(b, lo, CHITRA_ERR_JPEG_SOS, "a refinement of coefficients no scan has coded is refused");
    return 0;
}

fn test_pg_repeated_first_scan() {
    var lo = 0;
    var b = _pg_fx_p420_17x11(&lo);
    store8(b + _pg_spec_at(b, lo, 6) + 2, 0x02);          # scan 6: Ah 0 Al 2 again over coded 1-63
    _pg_refuses(b, lo, CHITRA_ERR_JPEG_SOS,
      "a first scan repeated over coded coefficients is refused (the work bound)");
    return 0;
}

fn test_pg_dc_refine_before_dc_first() {
    var lo = 0;
    var b = _pg_fx_p420_17x11(&lo);
    store8(b + _pg_spec_at(b, lo, 1) + 2, 0x10);          # scan 1: Ah 1 Al 0 with no DC yet
    _pg_refuses(b, lo, CHITRA_ERR_JPEG_SOS, "a DC refinement before any DC scan is refused");
    return 0;
}

fn test_pg_refinement_must_be_one_bit() {
    var lo = 0;
    var b = _pg_fx_p420_17x11(&lo);
    store8(b + _pg_spec_at(b, lo, 6) + 2, 0x20);          # scan 6: Ah 2 Al 0
    _pg_refuses(b, lo, CHITRA_ERR_JPEG_SOS, "Al != Ah - 1 is refused");
    return 0;
}

fn test_pg_band_order() {
    var lo = 0;
    var b = _pg_fx_p420_17x11(&lo);
    var o = _pg_spec_at(b, lo, 2);
    store8(b + o, 5);                                     # scan 2: Ss 5 Se 1
    store8(b + o + 1, 1);
    _pg_refuses(b, lo, CHITRA_ERR_JPEG_SOS, "Se < Ss is refused");
    return 0;
}

fn test_pg_al_ceiling() {
    var lo = 0;
    var b = _pg_fx_p420_17x11(&lo);
    store8(b + _pg_spec_at(b, lo, 2) + 2, 0x0E);          # scan 2: Al 14
    _pg_refuses(b, lo, CHITRA_ERR_JPEG_SOS, "Al > 13 is refused");
    return 0;
}

fn test_pg_interleaved_ac_scan() {
    var lo = 0;
    var b = _pg_fx_p420_17x11(&lo);
    var o = _pg_spec_at(b, lo, 1);
    store8(b + o, 1);                                     # scan 1 (Y,Cb,Cr): Ss 1 Se 5
    store8(b + o + 1, 5);
    _pg_refuses(b, lo, CHITRA_ERR_JPEG_SOS, "an AC scan naming three components is refused");
    return 0;
}

# Greyscale script: 1 DC Al 1, 2 AC 1-5 Al 2, 3 AC 6-63 Al 2, 4 AC 1-63 Ah 2
# Al 1, 5 DC Ah 1 Al 0, 6 AC 1-63 Ah 1 Al 0.
fn test_pg_ac_before_dc() {
    var lo = 0;
    var b = _pg_fx_pgray_17x11(&lo);
    var o = _pg_spec_at(b, lo, 1);
    store8(b + o, 1);                                     # scan 1 becomes AC 1-5
    store8(b + o + 1, 5);
    _pg_refuses(b, lo, CHITRA_ERR_JPEG_SOS, "an AC scan before its component's DC scan is refused");
    return 0;
}

fn test_pg_dc_scan_with_a_band() {
    var lo = 0;
    var b = _pg_fx_pgray_17x11(&lo);
    store8(b + _pg_spec_at(b, lo, 1) + 1, 5);             # scan 1: Ss 0 Se 5
    _pg_refuses(b, lo, CHITRA_ERR_JPEG_SOS, "a DC scan must be Ss = Se = 0");
    return 0;
}

# ================================================================
# Truncation. Cut before scan 3: every component has its DC (scan 1), so the
# image decodes from what arrived — lower fidelity, seen_iend = 0 — as djpeg
# decodes it ("Premature end of JPEG file"). A cut that leaves a component
# with no DC is refused: zero coefficients are not a partial image.
# ================================================================
fn test_pg_truncated_after_dc_decodes_partially() {
    var lo = 0;
    var b = _pg_fx_p420_17x11(&lo);
    var cut = _pg_sos(b, lo, 3);
    var err = 0;
    var img = chitra_jpeg_decode(b, cut, &err);
    assert(img != 0, "progressive cut after 2 of 10 scans still decodes");
    if (img != 0) {
        assert_eq(chitra_image_width(img), 17, "partial: width");
        assert_eq(chitra_image_seen_iend(img), 0, "partial: seen_iend = 0");
    }
    # Without its EOI but with every scan: complete pixels, still not closed.
    img = chitra_jpeg_decode(b, lo - 2, &err);
    assert(img != 0, "progressive with EOI stripped decodes");
    if (img != 0) {
        assert_eq(chitra_image_seen_iend(img), 0, "EOI-stripped: seen_iend = 0");
        var ref = _pg_ref_p420_17x11();
        var px = chitra_image_pixels(img);
        var bad = 0;
        var i = 0;
        while (i < 748) {
            if (load8(px + i) != load8(ref + i)) { bad = bad + 1; }
            i = i + 1;
        }
        assert_eq(bad, 0, "EOI-stripped: every scan arrived, so the pixels are complete");
    }
    return 0;
}

fn test_pg_component_without_dc_refused() {
    var lo = 0;
    var b = _pg_fx_nodc(&lo);
    _pg_refuses(b, lo, CHITRA_ERR_JPEG_SOS, "a file ending before Cb and Cr have any DC is refused");
    return 0;
}

# Every block of every buffer goes back through a caller's Allocator: the
# progressive path's coefficient buffers and state are working buffers too.
fn _pg_ta_alloc(state, size): i64 {
    var p = alloc(size);
    if (p != 0) { store64(state, load64(state) + 1); }
    return p;
}
fn _pg_ta_realloc(state, o, os, ns): i64 { return 0; }
fn _pg_ta_free(state, ptr): i64 {
    store64(state, load64(state) - 1);
    return 0;
}
fn _pg_ta_reset(state): i64 { return 0; }

fn test_pg_via_returns_everything() {
    var st = alloc(8);
    store64(st, 0);
    var a = allocator_new(&_pg_ta_alloc, &_pg_ta_realloc, &_pg_ta_free, &_pg_ta_reset, st);
    var lo = 0;
    var err = 0;
    var img = chitra_image_decode_budget_via(a, _pg_fx_p420_17x11(&lo), lo, 1048576, &err);
    assert(img != 0, "progressive via an Allocator decodes");
    assert_eq(load64(st), 2, "progressive via: record + pixels live, every working buffer back");
    chitra_image_free(img);
    assert_eq(load64(st), 0, "progressive via: nothing live after chitra_image_free");
    var b = _pg_fx_p420_17x11(&lo);
    store8(b + _pg_spec_at(b, lo, 6) + 2, 0x02);
    img = chitra_image_decode_budget_via(a, b, lo, 1048576, &err);
    assert(img == 0, "progressive via: a refused file");
    assert_eq(load64(st), 0, "progressive via: a refusal mid-file returns every block");
    return 0;
}

# ================================================================
# A synthetic progressive JPEG, so each progression rule has a file only it
# refuses. 16 x 16 unless _pg_synth_size says otherwise, 1x1 sampling (four
# blocks per component at 16), a DC table and
# an AC table whose only code is the 1-bit "0" -> symbol 0, so every block of
# every scan kind is exactly one 0 bit: DC category 0, a refinement bit 0, or
# EOB (r = 0, a run of one block). All coefficients stay zero, so a decode is
# flat 128. `script` is n scans of 5 i64: Ns (1 = component 0 alone, 3 = all
# three), Ss, Se, Ah, Al.
# ================================================================
var _pg_synth_size = 16;                       # square side, a multiple of 8

fn _pg_synth(ncomp, script, nscans, len_out): i64 {
    var side = _pg_synth_size;
    var bpc = (side / 8) * (side / 8);         # blocks per component
    var b = alloc(256 + nscans * (24 + (bpc * 3 + 7) / 8));
    var o = 0;
    var i = 0;
    store8(b + 0, 0xFF);
    store8(b + 1, 0xD8);
    o = 2;
    store8(b + o, 0xFF);                       # DQT 0, all 1
    store8(b + o + 1, 0xDB);
    store8(b + o + 2, 0);
    store8(b + o + 3, 67);
    store8(b + o + 4, 0);
    o = o + 5;
    while (i < 64) {
        store8(b + o + i, 1);
        i = i + 1;
    }
    o = o + 64;
    store8(b + o, 0xFF);                       # SOF2
    store8(b + o + 1, 0xC2);
    store8(b + o + 2, 0);
    store8(b + o + 3, 8 + 3 * ncomp);
    store8(b + o + 4, 8);
    store8(b + o + 5, (side >> 8) & 255);
    store8(b + o + 6, side & 255);
    store8(b + o + 7, (side >> 8) & 255);
    store8(b + o + 8, side & 255);
    store8(b + o + 9, ncomp);
    o = o + 10;
    i = 0;
    while (i < ncomp) {
        store8(b + o, i + 1);
        store8(b + o + 1, 17);
        store8(b + o + 2, 0);
        o = o + 3;
        i = i + 1;
    }
    var t = 0;
    while (t < 2) {                            # DHT DC 0, then AC 0
        store8(b + o, 0xFF);
        store8(b + o + 1, 0xC4);
        store8(b + o + 2, 0);
        store8(b + o + 3, 20);
        store8(b + o + 4, t * 16);
        i = 0;
        while (i < 16) {
            store8(b + o + 5 + i, 0);
            i = i + 1;
        }
        store8(b + o + 5, 1);
        store8(b + o + 21, 0);
        o = o + 22;
        t = t + 1;
    }
    var sc = 0;
    var ns = 0;
    var nb = 0;
    var nbytes = 0;
    var used = 0;
    while (sc < nscans) {
        ns = load64(script + sc * 40);
        store8(b + o, 0xFF);
        store8(b + o + 1, 0xDA);
        store8(b + o + 2, 0);
        store8(b + o + 3, 6 + 2 * ns);
        store8(b + o + 4, ns);
        o = o + 5;
        i = 0;
        while (i < ns) {
            store8(b + o, i + 1);
            store8(b + o + 1, 0);
            o = o + 2;
            i = i + 1;
        }
        store8(b + o, load64(script + sc * 40 + 8));
        store8(b + o + 1, load64(script + sc * 40 + 16));
        store8(b + o + 2, load64(script + sc * 40 + 24) * 16 + load64(script + sc * 40 + 32));
        o = o + 3;
        nb = bpc * ns;                         # one bit per block of every component
        nbytes = (nb + 7) / 8;
        i = 0;
        while (i < nbytes) {
            store8(b + o + i, 0);
            i = i + 1;
        }
        used = nb - (nbytes - 1) * 8;
        if (used < 8) { store8(b + o + nbytes - 1, (1 << (8 - used)) - 1); }
        o = o + nbytes;
        sc = sc + 1;
    }
    store8(b + o, 0xFF);
    store8(b + o + 1, 0xD9);
    store64(len_out, o + 2);
    return b;
}

fn _pg_scan(script, i, ns, ss, se, ah, al): i64 {
    store64(script + i * 40, ns);
    store64(script + i * 40 + 8, ss);
    store64(script + i * 40 + 16, se);
    store64(script + i * 40 + 24, ah);
    store64(script + i * 40 + 32, al);
    return 0;
}

fn _pg_synth_decodes(ncomp, script, n, name): i64 {
    var lo = 0;
    var b = _pg_synth(ncomp, script, n, &lo);
    var err = 0;
    var img = chitra_jpeg_decode(b, lo, &err);
    assert(img != 0, name);
    if (img != 0) {
        assert_eq(chitra_image_seen_iend(img), 1, name);
        assert_eq(load8(chitra_image_pixels(img) + 4 * 77), 128, name);
    }
    return 0;
}

fn _pg_synth_refused(ncomp, script, n, name): i64 {
    var lo = 0;
    var b = _pg_synth(ncomp, script, n, &lo);
    _pg_refuses(b, lo, CHITRA_ERR_JPEG_SOS, name);
    return 0;
}

# The control: a full legal script (DC Al 1, AC 1-63 Al 1, then both refined
# to bit 0) decodes, so each refusal below is the rule and not the generator.
fn test_pg_synth_control() {
    var sc = alloc(400);
    _pg_scan(sc, 0, 3, 0, 0, 0, 1);
    _pg_scan(sc, 1, 1, 1, 63, 0, 1);
    _pg_scan(sc, 2, 3, 0, 0, 1, 0);
    _pg_scan(sc, 3, 1, 1, 63, 1, 0);
    _pg_synth_decodes(3, sc, 4, "synthetic: a legal four-scan script decodes, flat 128");
    _pg_scan(sc, 0, 1, 0, 0, 0, 1);
    _pg_scan(sc, 2, 1, 0, 0, 1, 0);
    _pg_synth_decodes(1, sc, 4, "synthetic: the same script, greyscale");
    return 0;
}

fn test_pg_synth_each_rule() {
    var sc = alloc(400);
    # a first scan repeated over coefficients already coded — the work bound
    _pg_scan(sc, 0, 1, 0, 0, 0, 0);
    _pg_scan(sc, 1, 1, 1, 63, 0, 0);
    _pg_scan(sc, 2, 1, 1, 63, 0, 0);
    _pg_synth_refused(1, sc, 3, "synthetic: AC 1-63 first scan twice");
    # a refinement from a bit position the band is not at
    _pg_scan(sc, 0, 1, 0, 0, 0, 0);
    _pg_scan(sc, 1, 1, 1, 63, 0, 1);
    _pg_scan(sc, 2, 1, 1, 63, 2, 1);
    _pg_synth_refused(1, sc, 3, "synthetic: refining from Ah 2 a band coded to Al 1");
    # an AC scan before its component's DC
    _pg_scan(sc, 0, 1, 1, 63, 0, 0);
    _pg_scan(sc, 1, 1, 0, 0, 0, 0);
    _pg_synth_refused(1, sc, 2, "synthetic: AC before DC");
    # Al != Ah - 1
    _pg_scan(sc, 0, 1, 0, 0, 0, 2);
    _pg_scan(sc, 1, 1, 0, 0, 2, 0);
    _pg_synth_refused(1, sc, 2, "synthetic: a refinement of two bits at once");
    # Se < Ss
    _pg_scan(sc, 0, 1, 0, 0, 0, 0);
    _pg_scan(sc, 1, 1, 5, 1, 0, 0);
    _pg_synth_refused(1, sc, 2, "synthetic: band 5..1");
    # Al > 13
    _pg_scan(sc, 0, 1, 0, 0, 0, 14);
    _pg_synth_refused(1, sc, 1, "synthetic: DC Al 14");
    # a DC scan with a band
    _pg_scan(sc, 0, 1, 0, 5, 0, 0);
    _pg_synth_refused(1, sc, 1, "synthetic: DC scan Ss 0 Se 5");
    # an AC scan naming three components
    _pg_scan(sc, 0, 3, 0, 0, 0, 0);
    _pg_scan(sc, 1, 3, 1, 63, 0, 0);
    _pg_synth_refused(3, sc, 2, "synthetic: interleaved AC scan");
    # a component that never had a DC scan (Cb, Cr)
    _pg_scan(sc, 0, 1, 0, 0, 0, 0);
    _pg_synth_refused(3, sc, 1, "synthetic: Cb and Cr never coded");
    return 0;
}

# The scan ceiling (1.4.0): 256 scans decode, 257 are refused before any
# buffer exists. Every scan here is a LEGAL step of the progression — DC at
# Al 13 refined to 0, each AC coefficient alone at Al 13, then refined one
# bit at a time — so it is the count and not a rule that refuses the 257th.
# ⚠ Mutation-checked: without the pre-pass test the 257-scan file decodes
# (the driver's backstop is equivalent while the two walks agree).
fn _pg_ceiling_script(sc, n): i64 {
    var i = 0;
    var al = 13;
    _pg_scan(sc, 0, 1, 0, 0, 0, 13);
    i = 1;
    while (al > 0) {                            # 13 DC refinements: 14 DC scans
        _pg_scan(sc, i, 1, 0, 0, al, al - 1);
        al = al - 1;
        i = i + 1;
    }
    var k = 1;
    while (k <= 63) {                           # 63 AC first scans at Al 13
        _pg_scan(sc, i, 1, k, k, 0, 13);
        k = k + 1;
        i = i + 1;
    }
    k = 1;
    al = 13;
    while (i < n) {                             # refinements, coefficient by coefficient
        _pg_scan(sc, i, 1, k, k, al, al - 1);
        k = k + 1;
        if (k > 63) {
            k = 1;
            al = al - 1;
        }
        i = i + 1;
    }
    return 0;
}

# At 256 x 256 the coefficient buffer is 1,024 blocks x 128 B = 128 KB and the
# plane 64 KB, so "refused before any buffer" is measurable: what a refusal
# costs is the frame, the tables the header defined (2,048 + 27,904 B) and
# the ChitraErr — under 32 KB.
fn test_pg_scan_ceiling() {
    var sc = alloc(300 * 40);
    _pg_synth_size = 256;
    _pg_ceiling_script(sc, 256);
    _pg_synth_decodes(1, sc, 256, "256 legal progressive scans decode");
    _pg_ceiling_script(sc, 257);
    var lo = 0;
    var b = _pg_synth(1, sc, 257, &lo);
    var before = alloc_used();
    _pg_refuses(b, lo, CHITRA_ERR_DIMENSIONS, "the 257th scan is refused: CHITRA_ERR_DIMENSIONS");
    assert_lte(alloc_used() - before, 32768, "...before the 128 KB coefficient buffer: header tables only");
    _pg_synth_size = 16;
    return 0;
}

# The budget probe reads a SOF2's dimensions (1.4.0: it read only SOF0's, which
# was enough while SOF2 was refused). An over-budget progressive file is
# CHITRA_ERR_BUDGET for the price of the ChitraErr; one within budget decodes
# through the router. ⚠ Checked to fail with 0xC2 removed from
# _chitra_jpeg_declared_dims (the decode runs, over budget).
fn test_pg_budget_reads_sof2() {
    var lo = 0;
    var b = _pg_fx_p420_17x11(&lo);
    var err = 0;
    var before = alloc_used();
    var img = chitra_image_decode_budget(b, lo, 747, &err);
    assert(img == 0, "progressive 17x11 (748 B of RGBA) refused under a 747 B budget");
    if (err != 0) { assert_eq(chitra_err_code(err), CHITRA_ERR_BUDGET, "...as CHITRA_ERR_BUDGET"); }
    assert_lte(alloc_used() - before, 16, "...for the ChitraErr alone");
    img = chitra_image_decode_budget(b, lo, 748, &err);
    assert(img != 0, "...and decodes under a 748 B budget");
    return 0;
}

# A cut INSIDE a later scan header is the same truncation as a cut between
# scans: the image decodes from the scans that arrived, seen_iend = 0, as libjpeg
# decodes it. ⚠ Checked to fail before the fix (refused as CHITRA_ERR_TRUNCATED,
# while a cut one byte earlier — between scans — decoded).
fn test_pg_truncated_inside_a_scan_header() {
    var lo = 0;
    var b = _pg_fx_p420_17x11(&lo);
    var cut = _pg_sos(b, lo, 4) + 6;                 # FF DA, Ls, Ns, then cut
    var err = 0;
    var img = chitra_jpeg_decode(b, cut, &err);
    assert(img != 0, "progressive cut inside scan 4's header decodes from scans 1-3");
    assert_eq(err, 0, "...with no error");
    if (img != 0) { assert_eq(chitra_image_seen_iend(img), 0, "...and seen_iend = 0"); }
    return 0;
}

fn main(): i64 {
    test_pg_p420_17x11();
    test_pg_p444_q1_dqt16_17x11();
    test_pg_p_sa_rst_17x11();
    test_pg_p_bands_420_17x11();
    test_pg_pgray_17x11();
    test_pg_refinement_of_an_uncoded_band();
    test_pg_repeated_first_scan();
    test_pg_dc_refine_before_dc_first();
    test_pg_refinement_must_be_one_bit();
    test_pg_band_order();
    test_pg_al_ceiling();
    test_pg_interleaved_ac_scan();
    test_pg_ac_before_dc();
    test_pg_dc_scan_with_a_band();
    test_pg_truncated_after_dc_decodes_partially();
    test_pg_component_without_dc_refused();
    test_pg_via_returns_everything();
    test_pg_synth_control();
    test_pg_synth_each_rule();
    test_pg_scan_ceiling();
    test_pg_budget_reads_sof2();
    test_pg_truncated_inside_a_scan_header();
    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
