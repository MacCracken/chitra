# tests/tcyr/jpeg_progressive.tcyr — progressive JPEG (SOF2, T.81 Annex G),
# 1.4.0 — ADR 0013. Standalone CPU suite; fixtures embedded as hex.
#
# THE ORACLE is `djpeg` (libjpeg-turbo, default fancy upsampling): every
# fixture below decodes to its RGBA byte for byte, all 748 bytes. Out of tree
# the same holds for a 93-file corpus — cjpeg -progressive at every sampling,
# odd and 1-pixel sizes, restart intervals, quality 1 and 5 (16-bit quant
# tables under SOF2), jpegtran -progressive output, ImageMagick's progressive
# writer, and hand-written scan scripts down to four levels of successive
# approximation.
#
# The cells, in order: the five real fixtures (default 4:2:0 script; 4:4:4 at
# quality 1 with 16-bit DQT; a deep successive-approximation script with a
# restart interval of one MCU; band-split refinements at 4:2:0; greyscale);
# then the progression rules, each refused as CHITRA_ERR_JPEG_SOS — they are
# also what bounds the decode's work (jpeg_prog.cyr header); then truncation:
# a file cut after some scans still decodes (seen_iend = 0) if every
# component had its DC scan, and is refused if one did not.
#
# ⚠ Checked to fail against 1.3.1: every decode cell (SOF2 refused as
# CHITRA_ERR_JPEG_PROGRESSIVE, 19).
#
# REGENERATION. src.ppm is 17 x 11, R = (37x + 11y) mod 256,
# G = (5x^2 + 29y) mod 256, B = (255 - 23x + 7y^2) mod 256 (srcg.pgm: its
# `magick -colorspace gray`). Each cell's comment gives the cjpeg line; the
# scan scripts are in the cell comments too. Reference: djpeg -pnm | RGBA.

include "src/lib.cyr"
include "lib/assert.cyr"

fn _pg_hexval(c): i64 {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    return c - 55;
}

fn _pg_hex(b, off, s): i64 {
    var i = 0;
    var n = strlen(s);
    while (i + 1 < n) {
        store8(b + off, _pg_hexval(load8(s + i)) * 16 + _pg_hexval(load8(s + i + 1)));
        off = off + 1;
        i = i + 2;
    }
    return off;
}

fn _pg_check(jpg, n, want, name): i64 {
    var err = 0;
    var img = chitra_jpeg_decode(jpg, n, &err);
    assert(img != 0, name);
    assert_eq(err, 0, name);
    if (img == 0) { return 0; }
    assert_eq(chitra_image_width(img), 17, name);
    assert_eq(chitra_image_height(img), 11, name);
    assert_eq(chitra_image_seen_iend(img), 1, name);
    var px = chitra_image_pixels(img);
    var bad = 0;
    var i = 0;
    while (i < 748) {
        if (load8(px + i) != load8(want + i)) { bad = bad + 1; }
        i = i + 1;
    }
    assert_eq(bad, 0, name);
    return 0;
}

# Offset of the n-th (1-based) SOS marker's 0xFF, or -1.
fn _pg_sos(b, lo, n): i64 {
    var i = 2;
    var k = 0;
    while (i + 1 < lo) {
        if (load8(b + i) == 0xFF) {
            if (load8(b + i + 1) == 0xDA) {
                k = k + 1;
                if (k == n) { return i; }
            }
        }
        i = i + 1;
    }
    return 0 - 1;
}

# The Ss / Se / AhAl bytes of the n-th scan header.
fn _pg_spec_at(b, lo, n): i64 {
    var o = _pg_sos(b, lo, n);
    var ns = load8(b + o + 4);
    return o + 5 + 2 * ns;
}

fn _pg_refuses(b, lo, code, name): i64 {
    var err = 0;
    var img = chitra_jpeg_decode(b, lo, &err);
    assert(img == 0, name);
    assert(err != 0, name);
    if (err != 0) { assert_eq(chitra_err_code(err), code, name); }
    return 0;
}

