fn test_pg_p420_17x11(): i64 {
    var lo = 0;
    _pg_check(_pg_fx_p420_17x11(&lo), lo, _pg_ref_p420_17x11(), "p420_17x11: byte-identical to djpeg");
    return 0;
}

