fn _ns_decode(bytes, len, name, want_sum): i64 {
    var err = 0;
    var img = chitra_image_decode(bytes, len, &err);
    assert(img != 0, name);
    if (img == 0) { return 0; }
    assert_eq(chitra_image_width(img), 7, "...width 7");
    assert_eq(chitra_image_height(img), 5, "...height 5");
    var p = chitra_image_pixels(img);
    var sum = 0;
    var i = 0;
    while (i < 140) {
        sum = sum + load8(p + i);
        i = i + 1;
    }
    assert_eq(sum, want_sum, "...pixels equal the reference decoder's");
    return 0;
}

fn test_consumer_globals_do_not_reach_the_decoders() {
    var l = 0;
    _ns_decode(fx_ns_png(&l), l, "PNG decodes beside the consumer's globals", 15332);
    _ns_decode(fx_ns_jpg(&l), l, "JPEG (4:2:0, restart interval) decodes beside them", 20483);
    _ns_decode(fx_ns_bmp(&l), l, "BMP (RLE8) decodes beside them", 20849);
    _ns_decode(fx_ns_gif(&l), l, "GIF (interlaced) decodes beside them", 20754);
    return 0;
}

# And the other direction: decoding must not write into the consumer's globals. Through 1.1.1
# `_jpeg_zz_ready` was chitra's lazily-set flag, so a consumer of that name saw chitra flip it.
fn test_decoding_leaves_the_consumer_globals_alone() {
    assert_eq(CUR_POS_OFFSET, 3, "CUR_POS_OFFSET is still the consumer's");
    assert_eq(HT_SIZE, 3, "HT_SIZE is still the consumer's");
    assert_eq(LZ_BIT, 3, "LZ_BIT is still the consumer's");
    assert_eq(BR_POS, 3, "BR_POS is still the consumer's");
    assert_eq(IMAGE_PIXELS_OFFSET, 3, "IMAGE_PIXELS_OFFSET is still the consumer's");
    assert_eq(_jpeg_zz_ready, 3, "_jpeg_zz_ready is still the consumer's");
    return 0;
}

# The consumer's functions must stay the consumer's: a call it makes reaches its own definition, not
# chitra's (and chitra's calls, above, reached chitra's — or the decodes would have failed).
fn test_consumer_functions_stay_the_consumers() {
    assert_eq(_adam7_count(0, 0, 0), 7, "the consumer's own _adam7_count answers the consumer");
    assert_eq(_bmp_decode_rle(0, 0, 0, 0, 0, 0, 0, 0, 0), 7, "the consumer's own _bmp_decode_rle answers the consumer");
    assert_eq(_chunk_is(0, 0, 0, 0, 0), 7, "the consumer's own _chunk_is answers the consumer");
    assert_eq(_cur_can_read(0, 0), 7, "the consumer's own _cur_can_read answers the consumer");
    assert_eq(_gif_br_bits(0, 0), 7, "the consumer's own _gif_br_bits answers the consumer");
    assert_eq(_jpeg_alloc_huff(0), 7, "the consumer's own _jpeg_alloc_huff answers the consumer");
    assert_eq(_png_scale16(0), 7, "the consumer's own _png_scale16 answers the consumer");
    return 0;
}

fn main() {
    test_consumer_globals_do_not_reach_the_decoders();
    test_decoding_leaves_the_consumer_globals_alone();
    test_consumer_functions_stay_the_consumers();
    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
