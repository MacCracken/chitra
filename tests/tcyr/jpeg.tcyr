    store8(b + 143, 3);
    store8(b + 146, 63);
    # 4,100 bytes of zero entropy data are already in place; close with EOI.
    store8(b + 4248, 0xFF);
    store8(b + 4249, 0xD9);
    return b;
}

fn test_jpeg_bomb_refused_before_the_planes_are_paid_for() {
    var lo = 0;
    var b = fx_jpeg_amplification_bomb(&lo);
    var err = 0;
    var before = alloc_used();
    var img = chitra_jpeg_decode(b, lo, &err);
    var spent = alloc_used() - before;
    assert_eq(img, 0, "the JPEG amplification bomb is refused");
    assert_eq(chitra_err_code(err), CHITRA_ERR_DIMENSIONS, "...as CHITRA_ERR_DIMENSIONS");
    # One plane alone is 16,777,216 bytes. Anything at that scale means GATE 0
    # is gone and the planes were allocated before the verdict.
    assert_lt(spent, 1048576,
      "refusing the bomb costs under 1 MiB, not the three 16 MB planes");
    return 0;
}

# ================================================================
# B-2 (1.0.3) — a JFIF file has already declared its colour space.
#
# ⛔ THE AUTHORITY ORDER IS JFIF > Adobe APP14 > component ids > YCbCr, and it
# is libjpeg's (`default_decompress_parms` tests `saw_JFIF_marker` first).
# Through 1.0.2 chitra never parsed APP0 at all, so rule 2 — "'R','G','B'
# component ids name the space outright", correct on its own terms and added by
# 0.6.1 — also applied to files that had already said they were JFIF. Six edited
# bytes then produced a whole-image colour error with NO error code, while
# `source_color_type` returned 0x113 and actively told the consumer the samples
# were RGB. Measured on a 64x64 fixture: every colour byte wrong; djpeg and
# ImageMagick both decode the same bytes correctly.
#
# ⚠ BOTH CELLS ARE REQUIRED. The second is the one that stops the repair being
# "always YCbCr": `cjpeg -rgb` emits NO JFIF APP0 (ADR 0009), so real RGB files
# must still reach rule 2 and report 0x113. Fixing only the first would silently
# undo 0.6.1.
# ================================================================
fn _fx_patch_rgb_ids(src, len): i64 {
    # Rewrite the three SOF0 and three SOS component ids to 'R','G','B'.
    var i = 0;
    var sof = 0 - 1;
    var sos = 0 - 1;
    while (i < len - 1) {
        if (load8(src + i) == 0xFF) {
            if (load8(src + i + 1) == 0xC0) { sof = i; }
            if (load8(src + i + 1) == 0xDA) { sos = i; }
        }
        i = i + 1;
    }
    # SOF0: FFC0 len(2) P(1) Y(2) X(2) Nf(1) then id,HV,Tq per component.
    var base = sof + 2 + 2 + 1 + 2 + 2 + 1;
    store8(src + base + 0, 0x52);
    store8(src + base + 3, 0x47);
    store8(src + base + 6, 0x42);
    # SOS: FFDA len(2) Ns(1) then Cs,TdTa per component.
    var sbase = sos + 2 + 2 + 1;
    store8(src + sbase + 0, 0x52);
    store8(src + sbase + 2, 0x47);
    store8(src + sbase + 4, 0x42);
    return 0;
}

# YCbCr 8x8, component ids rewritten to 'R','G','B', NO JFIF APP0.
# This is the 0.6.1 shape and must still report RGB.
fn fx_jpeg_rgbids_no_jfif(len_out): i64 {
    var lo = 0;
    var b = fx_jpeg_ycc_8x8(&lo);
    store64(len_out, lo);
    _fx_patch_rgb_ids(b, lo);
    return b;
}

# The same file with a minimal JFIF APP0 spliced in after SOI. JFIF says the
# three components are Y/Cb/Cr, so the ids must not be believed.
fn fx_jpeg_rgbids_with_jfif(len_out): i64 {
    var lo = 0;
    var srcb = fx_jpeg_ycc_8x8(&lo);
    var app0 = 18;
    var out = alloc(lo + app0);
    store64(len_out, lo + app0);
    store8(out + 0, 0xFF);
    store8(out + 1, 0xD8);
    store8(out + 2, 0xFF);
    store8(out + 3, 0xE0);
    store8(out + 4, 0x00);
    store8(out + 5, 0x10);
    store8(out + 6, 0x4A);      # 'J'
    store8(out + 7, 0x46);      # 'F'
    store8(out + 8, 0x49);      # 'I'
    store8(out + 9, 0x46);      # 'F'
    store8(out + 10, 0x00);
    store8(out + 11, 0x01);     # version 1.1
    store8(out + 12, 0x01);
    store8(out + 13, 0x00);     # units: none
    store8(out + 14, 0x00);
    store8(out + 15, 0x01);     # x density 1
    store8(out + 16, 0x00);
    store8(out + 17, 0x01);     # y density 1
    store8(out + 18, 0x00);     # no thumbnail
    store8(out + 19, 0x00);
    var i = 2;
    while (i < lo) {
        store8(out + i + app0, load8(srcb + i));
        i = i + 1;
    }
    _fx_patch_rgb_ids(out, lo + app0);
    return out;
}

fn test_jfif_app0_outranks_rgb_component_ids() {
    var lo = 0;
    var b = fx_jpeg_rgbids_with_jfif(&lo);
    var err = 0;
    var img = chitra_jpeg_decode(b, lo, &err);
    assert(img != 0, "the JFIF file with R/G/B ids decodes");
    if (img != 0) {
        assert_eq(chitra_image_source_color_type(img), 0x103,
          "a JFIF file is YCbCr no matter what its component ids say");
    }
    return 0;
}

fn test_rgb_component_ids_still_win_without_jfif() {
    # ⛔ THE OTHER HALF. `cjpeg -rgb` writes no JFIF APP0, so rule 2 must still
    # fire for it — otherwise B-2's repair silently reverts 0.6.1 and every
    # cjpeg -rgb file is hue-rotated again.
    var lo = 0;
    var b = fx_jpeg_rgbids_no_jfif(&lo);
    var err = 0;
    var img = chitra_jpeg_decode(b, lo, &err);
    assert(img != 0, "the JFIF-less file with R/G/B ids decodes");
    if (img != 0) {
        assert_eq(chitra_image_source_color_type(img), 0x113,
          "without a JFIF APP0, R/G/B component ids still name RGB (0.6.1)");
    }
    return 0;
}

# ================================================================
# B-12 (1.0.3) — the four frozen `_rgba8` wrappers had no test that could tell
# width from height.
#
# ⛔ NOT A LIVE DEFECT — A BLIND SPOT IN THE GATE STACK. Every wrapper test in
# the tree used a SQUARE fixture (PNG 2x2, BMP 2x2, GIF 4x4, JPEG 16x16), so
# swapping the two stores in `chitra_png_decode_rgba8` — transposing the
# dimensions a caller gets back — passed all 13 suites, all 3,035 assertions and
# all 10.7 M fuzz assertions with nothing red. Verified by doing exactly that.
# `chitra_png_decode_rgba8` is mabda's primary entry point, and a transposed
# w/h uploads a garbled texture with no ChitraErr to show for it.
#
# ⚠ Only `jpeg_noninterleaved.tcyr`'s 24x16 cell could see it, and only for
# JPEG. These fixtures close the other three, and the assertions below compare
# the wrapper's w/h against the FULL decoder's accessors on the same bytes —
# so the two entry points cannot disagree either.
# ================================================================
