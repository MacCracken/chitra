    store8(b + 70, 1);
    store8(b + 71, 255);
    store8(b + 72, 196);
    store8(b + 74, 20);
    store8(b + 76, 1);
    store8(b + 93, 255);
    store8(b + 94, 196);
    store8(b + 96, 20);
    store8(b + 97, 16);
    store8(b + 98, 1);
    store8(b + 115, 255);
    store8(b + 116, 192);
    store8(b + 118, 17);
    store8(b + 119, 8);
    store8(b + 120, 16);
    store8(b + 122, 16);
    store8(b + 124, 3);
    store8(b + 125, 1);
    store8(b + 126, 17);
    store8(b + 128, 2);
    store8(b + 129, 17);
    store8(b + 131, 3);
