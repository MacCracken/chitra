# tests/tcyr/jpeg.tcyr — JPEG (JFIF baseline): marker framing, SOF0 / DQT / DHT
# parsing, entropy + IDCT, full decode across the chroma-sampling matrix,
# DRI/RSTn restart markers, the Adobe APP14 colour-transform cells (0.6.1), and
# the non-baseline / malformed rejections. The § A.2 scan geometries live in
# jpeg_noninterleaved.tcyr and jpeg_multiscan.tcyr. Self-contained CPU
# suite (own main + assert_summary), standalone like error.tcyr/png.tcyr:
# include the lib chain + the assert harness. Fixtures are tiny hand-built JPEG
# marker streams embedded as byte arrays (no file I/O).
include "src/lib.cyr"
include "lib/assert.cyr"

# ================================================================
# Fixture builders
# ================================================================

# Minimal valid baseline header: SOI + SOF0(8x8, 8-bit, 3 comp, 4:2:0) + SOS.
# No DQT (SOF parse does not require one). The scan stops at SOS.
fn fx_jpeg_baseline(len_out): i64 {
    var b = alloc(23);
    store8(b + 0, 0xFF);    # SOI
    store8(b + 1, 0xD8);
    store8(b + 2, 0xFF);    # SOF0
    store8(b + 3, 0xC0);
    store8(b + 4, 0x00);    # Lf = 17
    store8(b + 5, 0x11);
    store8(b + 6, 0x08);    # P = 8
    store8(b + 7, 0x00);    # Y = 8
    store8(b + 8, 0x08);
    store8(b + 9, 0x00);    # X = 8
    store8(b + 10, 0x08);
    store8(b + 11, 0x03);   # Nf = 3
    store8(b + 12, 0x01);   # comp 1: id=1
    store8(b + 13, 0x22);   #         H=2 V=2
    store8(b + 14, 0x00);   #         Tq=0
    store8(b + 15, 0x02);   # comp 2: id=2
    store8(b + 16, 0x11);   #         H=1 V=1
    store8(b + 17, 0x01);   #         Tq=1
    store8(b + 18, 0x03);   # comp 3: id=3
    store8(b + 19, 0x11);   #         H=1 V=1
    store8(b + 20, 0x01);   #         Tq=1
    store8(b + 21, 0xFF);   # SOS (scan boundary)
    store8(b + 22, 0xDA);
    store64(len_out, 23);
    return b;
}

# Baseline with a leading DQT (table 0, 8-bit, values k+1 for k in 0..63).
fn fx_jpeg_dqt_sof(len_out): i64 {
    var b = alloc(92);
    store8(b + 0, 0xFF);    # SOI
    store8(b + 1, 0xD8);
    store8(b + 2, 0xFF);    # DQT
    store8(b + 3, 0xDB);
    store8(b + 4, 0x00);    # Lq = 67 (2 + 1 + 64)
    store8(b + 5, 0x43);
    store8(b + 6, 0x00);    # Pq=0 Tq=0
    var k = 0;
    while (k < 64) {
        store8(b + 7 + k, k + 1);
        k = k + 1;
    }
    store8(b + 71, 0xFF);   # SOF0
    store8(b + 72, 0xC0);
    store8(b + 73, 0x00);   # Lf = 17
    store8(b + 74, 0x11);
    store8(b + 75, 0x08);   # P = 8
    store8(b + 76, 0x00);   # Y = 8
    store8(b + 77, 0x08);
    store8(b + 78, 0x00);   # X = 8
    store8(b + 79, 0x08);
    store8(b + 80, 0x03);   # Nf = 3
    store8(b + 81, 0x01);   # comp 1: id=1 H=2 V=2 Tq=0
    store8(b + 82, 0x22);
    store8(b + 83, 0x00);
    store8(b + 84, 0x02);   # comp 2: id=2 H=1 V=1 Tq=1
    store8(b + 85, 0x11);
    store8(b + 86, 0x01);
    store8(b + 87, 0x03);   # comp 3: id=3 H=1 V=1 Tq=1
    store8(b + 88, 0x11);
    store8(b + 89, 0x01);
    store8(b + 90, 0xFF);   # SOS
    store8(b + 91, 0xDA);
    store64(len_out, 92);
    return b;
}

# SOI + DHT(standard Annex K.3.3 DC-luminance table) + SOF0 + SOS.
# BITS = 0,1,5,1,1,1,1,1,1,0,... ; HUFFVAL = 0..11 (12 symbols).
fn fx_jpeg_dht_sof(len_out): i64 {
    var b = alloc(56);
    store8(b + 0, 0xFF);    # SOI
    store8(b + 1, 0xD8);
    store8(b + 2, 0xFF);    # DHT
    store8(b + 3, 0xC4);
    store8(b + 4, 0x00);    # Lh = 31 (2 + 1 + 16 + 12)
    store8(b + 5, 0x1F);
    store8(b + 6, 0x00);    # Tc=0 (DC) Th=0
    store8(b + 7, 0x00);    # BITS L1 = 0
    store8(b + 8, 0x01);    # L2 = 1
    store8(b + 9, 0x05);    # L3 = 5
    store8(b + 10, 0x01);   # L4 = 1
    store8(b + 11, 0x01);   # L5 = 1
    store8(b + 12, 0x01);   # L6 = 1
    store8(b + 13, 0x01);   # L7 = 1
    store8(b + 14, 0x01);   # L8 = 1
    store8(b + 15, 0x01);   # L9 = 1
    store8(b + 16, 0x00);   # L10 = 0
    store8(b + 17, 0x00);   # L11
    store8(b + 18, 0x00);   # L12
    store8(b + 19, 0x00);   # L13
    store8(b + 20, 0x00);   # L14
    store8(b + 21, 0x00);   # L15
    store8(b + 22, 0x00);   # L16
    var k = 0;
    while (k < 12) {
        store8(b + 23 + k, k);   # HUFFVAL = 0..11
        k = k + 1;
    }
    store8(b + 35, 0xFF);   # SOF0
    store8(b + 36, 0xC0);
    store8(b + 37, 0x00);   # Lf = 17
    store8(b + 38, 0x11);
    store8(b + 39, 0x08);   # P = 8
    store8(b + 40, 0x00);   # Y = 8
    store8(b + 41, 0x08);
    store8(b + 42, 0x00);   # X = 8
    store8(b + 43, 0x08);
    store8(b + 44, 0x03);   # Nf = 3
    store8(b + 45, 0x01);   # comp 1: id=1 H=2 V=2 Tq=0
    store8(b + 46, 0x22);
    store8(b + 47, 0x00);
    store8(b + 48, 0x02);   # comp 2: id=2 H=1 V=1 Tq=1
    store8(b + 49, 0x11);
    store8(b + 50, 0x01);
    store8(b + 51, 0x03);   # comp 3: id=3 H=1 V=1 Tq=1
    store8(b + 52, 0x11);
    store8(b + 53, 0x01);
    store8(b + 54, 0xFF);   # SOS
    store8(b + 55, 0xDA);
    store64(len_out, 56);
    return b;
}

# SOI + a single DHT table header with the given Tc/Th byte (BITS all zero).
# Lh = 19 so the 17-byte minimum table header is present.
fn fx_jpeg_dht_bad_class(len_out, tcth): i64 {
    var b = alloc(23);
    store8(b + 0, 0xFF);
    store8(b + 1, 0xD8);
    store8(b + 2, 0xFF);
    store8(b + 3, 0xC4);
    store8(b + 4, 0x00);
    store8(b + 5, 0x13);   # Lh = 19
    store8(b + 6, tcth);
    var k = 0;
    while (k < 16) {
        store8(b + 7 + k, 0x00);
        k = k + 1;
    }
    store64(len_out, 23);
    return b;
}

# SOI + DHT with an over-subscribed table: 3 codes of length 1 (impossible).
fn fx_jpeg_dht_oversub(len_out): i64 {
    var b = alloc(26);
    store8(b + 0, 0xFF);
    store8(b + 1, 0xD8);
    store8(b + 2, 0xFF);
    store8(b + 3, 0xC4);
    store8(b + 4, 0x00);
    store8(b + 5, 0x16);   # Lh = 22 (2 + 1 + 16 + 3)
    store8(b + 6, 0x00);   # Tc=0 Th=0
    store8(b + 7, 0x03);   # L1 = 3 codes of length 1 -> over-subscribed
    var k = 0;
    while (k < 15) {
        store8(b + 8 + k, 0x00);
        k = k + 1;
    }
    store8(b + 23, 0x00);  # HUFFVAL 0,1,2
    store8(b + 24, 0x01);
    store8(b + 25, 0x02);
    store64(len_out, 26);
    return b;
}

# A 4-byte SOI + one marker stream, for cases that reject on the marker itself.
fn fx_jpeg4(len_out, b0, b1, b2, b3): i64 {
    var b = alloc(4);
    store8(b + 0, b0);
    store8(b + 1, b1);
    store8(b + 2, b2);
    store8(b + 3, b3);
    store64(len_out, 4);
    return b;
}

# SOI + a single bad DQT table header byte (PqTq), Lq=3, no table body needed.
fn fx_jpeg_dqt_bad(len_out, pqtq): i64 {
    var b = alloc(7);
    store8(b + 0, 0xFF);
    store8(b + 1, 0xD8);
    store8(b + 2, 0xFF);
    store8(b + 3, 0xDB);
    store8(b + 4, 0x00);
    store8(b + 5, 0x03);
    store8(b + 6, pqtq);
    store64(len_out, 7);
    return b;
}

# ================================================================
# _cur_u16_be (added to png_chunks.cyr for JPEG segment lengths)
# ================================================================
fn test_cur_u16_be() {
    var buf[2];
    store8(&buf + 0, 0x12);
    store8(&buf + 1, 0x34);
    var cur[24];
    _cur_init(&cur, &buf, 2);
    assert_eq(_cur_u16_be(&cur), 4660, "u16_be = 0x1234");
    assert_eq(_cur_pos(&cur), 2, "pos advanced 2");
    return 0;
}

# ================================================================
# Signature (SOI 0xFFD8)
# ================================================================
fn test_signature() {
    var lo = 0;
    var b = fx_jpeg_baseline(&lo);
    assert_eq(chitra_jpeg_check_signature(b, lo), 1, "valid SOI signature");
    store8(b + 1, 0xD9);
    assert_eq(chitra_jpeg_check_signature(b, lo), 0, "bad SOI rejected");
    var one = 1;
    assert_eq(chitra_jpeg_check_signature(b, one), 0, "len<2 rejected");
    return 0;
}

# ================================================================
# Baseline header scan fills frame header + component sampling factors
# ================================================================
fn test_scan_baseline() {
    var lo = 0;
    var b = fx_jpeg_baseline(&lo);
    var err = 0;
    var f = chitra_jpeg_scan_markers(b, lo, &err);
    assert(f != 0, "baseline scan returns a frame");
    assert_eq(err, 0, "no error on baseline");
    assert_eq(chitra_jpeg_frame_width(f), 8, "width 8");
    assert_eq(chitra_jpeg_frame_height(f), 8, "height 8");
    assert_eq(chitra_jpeg_frame_precision(f), 8, "precision 8");
    assert_eq(chitra_jpeg_frame_num_components(f), 3, "3 components");
    assert_eq(chitra_jpeg_frame_seen_sof(f), 1, "seen sof");
    # component sampling factors (4:2:0 — comp 0 is 2x2, chroma 1x1)
    assert_eq(chitra_jpeg_frame_max_h(f), 2, "max_h 2");
    assert_eq(chitra_jpeg_frame_max_v(f), 2, "max_v 2");
    assert_eq(chitra_jpeg_frame_comp_id(f, 0), 1, "comp0 id 1");
    assert_eq(chitra_jpeg_frame_comp_h(f, 0), 2, "comp0 H 2");
    assert_eq(chitra_jpeg_frame_comp_v(f, 0), 2, "comp0 V 2");
    assert_eq(chitra_jpeg_frame_comp_tq(f, 0), 0, "comp0 Tq 0");
    assert_eq(chitra_jpeg_frame_comp_id(f, 1), 2, "comp1 id 2");
    assert_eq(chitra_jpeg_frame_comp_h(f, 1), 1, "comp1 H 1");
    assert_eq(chitra_jpeg_frame_comp_tq(f, 1), 1, "comp1 Tq 1");
    assert_eq(chitra_jpeg_frame_comp_id(f, 2), 3, "comp2 id 3");
    return 0;
}

# ================================================================
# DQT parse: quant table present + values stored in spec (zig-zag) order
# ================================================================
fn test_scan_dqt() {
    var lo = 0;
    var b = fx_jpeg_dqt_sof(&lo);
    var err = 0;
    var f = chitra_jpeg_scan_markers(b, lo, &err);
    assert(f != 0, "dqt+sof scan returns a frame");
    assert_eq(err, 0, "no error");
    # Guard the table reads on the frame AND on the presence bit. assert_eq is
    # print-and-continue (lib/assert.cyr:22), not a branch — so without this,
    # a regression that stopped parsing the DQT would take the whole suite down
    # with a SIGSEGV instead of printing the FAIL line that names it. Under the
    # lazy table allocation added in 0.6.1 the store pointer is 0 until a DQT
    # defines something, which makes the unguarded form a null dereference
    # rather than a wrong answer.
    if (f != 0) {
        assert_eq(chitra_jpeg_frame_quant_present(f), 1, "quant table 0 present (bit 0)");
        if (chitra_jpeg_frame_quant_present(f) != 0) {
            assert_eq(chitra_jpeg_frame_quant(f, 0, 0), 1, "quant[0][0] = 1");
            assert_eq(chitra_jpeg_frame_quant(f, 0, 63), 64, "quant[0][63] = 64");
        }
    }
    # SOF still parsed after the DQT
    assert_eq(chitra_jpeg_frame_width(f), 8, "width 8 after dqt");
    assert_eq(chitra_jpeg_frame_max_h(f), 2, "max_h 2 after dqt");
    return 0;
}

# ================================================================
# Non-baseline modes are rejected with distinct codes
# ================================================================
fn test_reject_progressive() {
    var lo = 0;
    var b = fx_jpeg4(&lo, 0xFF, 0xD8, 0xFF, 0xC2);   # SOF2
    var err = 0;
    var f = chitra_jpeg_scan_markers(b, lo, &err);
    assert_eq(f, 0, "progressive rejected (null frame)");
    assert_eq(chitra_err_code(err), CHITRA_ERR_JPEG_PROGRESSIVE, "progressive err code");
    return 0;
}

fn test_reject_arithmetic() {
    var lo = 0;
    var b = fx_jpeg4(&lo, 0xFF, 0xD8, 0xFF, 0xCA);   # SOF10 arithmetic
    var err = 0;
    var f = chitra_jpeg_scan_markers(b, lo, &err);
    assert_eq(f, 0, "arithmetic rejected");
    assert_eq(chitra_err_code(err), CHITRA_ERR_JPEG_ARITHMETIC, "arithmetic err code");
    return 0;
}

fn test_reject_mode() {
    var lo = 0;
