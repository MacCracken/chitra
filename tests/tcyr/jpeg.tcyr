fn test_jpeg_bomb_padding_does_not_buy_allowance() {
    var lo = 0;
    var b = fx_jpeg_bomb_padded(&lo);
    var err = 0;
    var img = chitra_jpeg_decode(b, lo, &err);
    assert(img == 0, "APPn-padded geometry bomb rejected");
    assert(err != 0, "APPn-padded bomb sets err_out");
    if (err != 0) {
        assert_eq(chitra_err_code(err), CHITRA_ERR_DIMENSIONS,
          "APPn-padded bomb -> DIMENSIONS");
    }
    return 0;
}

fn test_jpeg_bare_bomb_still_rejected() {
    var lo = 0;
    var b = fx_jpeg_bomb_bare(&lo);
    var err = 0;
    assert(chitra_jpeg_decode(b, lo, &err) == 0, "bare geometry bomb rejected");
    return 0;
}

fn test_jpeg_entropy_span_denominator_allows_real_files() {
    # The cap must not reject real images now that its denominator is smaller.
    # A 372-byte grayscale file has ~50 bytes of entropy data against a
    # 24x16 output — the ratio has orders of magnitude of headroom, and this
    # cell is what would catch a denominator tightened too far.
    var lo = 0;
    var err = 0;
    assert(chitra_jpeg_decode(fx_jpeg_real_gradient(&lo), lo, &err) != 0,
      "entropy-span denominator still allows the real gradient");
    assert_eq(err, 0, "real gradient: no error");
    return 0;
}

fn test_jpeg_refusal_allocation_is_bounded() {
    # 0.6.1 lazy table allocation. A 15-byte JPEG whose SOF0 declares 12-bit
    # precision is refused, correctly and permanently — and through 0.6.0 it
    # still cost 22,160 bytes that the bump allocator never reclaims, on EVERY
    # call, because chitra_jpeg_scan_markers allocated the quantization store
    # and all eight Huffman records before any check could refuse the file.
    # That is the path a consumer under attack takes most often.
    var b = alloc(15);
    store8(b + 0, 0xFF);
    store8(b + 1, 0xD8);
    store8(b + 2, 0xFF);
    store8(b + 3, 0xC0);
    store8(b + 4, 0x00);
    store8(b + 5, 0x0B);
    store8(b + 6, 0x0C);        # precision 12 -> JPEG_PRECISION
    store8(b + 7, 0x00);
    store8(b + 8, 0x08);
    store8(b + 9, 0x00);
    store8(b + 10, 0x08);
    store8(b + 11, 0x01);
    store8(b + 12, 0x01);
    store8(b + 13, 0x11);
    store8(b + 14, 0x00);
    var before = alloc_used();
    var err = 0;
    var img = chitra_jpeg_decode(b, 15, &err);
    var spent = alloc_used() - before;
    assert(img == 0, "15-byte precision-12 JPEG refused");
    if (err != 0) {
        assert_eq(chitra_err_code(err), CHITRA_ERR_JPEG_PRECISION, "refused with JPEG_PRECISION");
    }
    # Measured at 400 bytes (frame 384 + ChitraErr 16). The bound is set just
    # above that: loosen it past ~2 KB and the cell can no longer tell lazy
    # allocation from eager.
    assert_lte(spent, 1024, "refusing a table-less JPEG costs <= 1024 B");
    # And it must stay cheap on repeat — the eager version was unmemoized, so a
    # flood of refusals accumulated 22 KB apiece.
    var before2 = alloc_used();
    var err2 = 0;
    chitra_jpeg_decode(b, 15, &err2);
    assert_lte(alloc_used() - before2, 1024, "the second refusal is just as cheap");
    return 0;
}

fn test_dht_table_storage_allocated_at_most_once() {
    # A single DHT segment may carry up to 3,854 table definitions, and
    # _chitra_jpeg_huff_build accepts an all-zero BITS table, so every one of them is
    # a real definition. Allocating a 2,464-byte record per DEFINITION rather
    # than one block per FRAME would trade a flat refusal cost for one that
    # SCALES with file size — 384 + 64 + 3854 * 2464 = 9,496,704 bytes from a
    # 64 KB file. The `== 0` test in _chitra_jpeg_parse_dht is what makes that
    # unreachable by construction rather than by a bound.
    var n = 3854;
    var total = 4 + n * 17 + 2 + 2;
    var b = alloc(total);
    store8(b + 0, 0xFF);
    store8(b + 1, 0xD8);
    store8(b + 2, 0xFF);
    store8(b + 3, 0xC4);
    var seglen = 2 + n * 17;
    store8(b + 4, (seglen >> 8) & 255);
    store8(b + 5, seglen & 255);
    var i = 0;
    var base = 0;
    var k = 0;
    while (i < n) {
        base = 6 + i * 17;
        store8(b + base, 0x00);          # Tc = 0, Th = 0 — the SAME slot each time
        k = 0;
        while (k < 16) {
            store8(b + base + 1 + k, 0); # 16 zero BITS counts, 0 symbols
            k = k + 1;
        }
        i = i + 1;
    }
    var end = 6 + n * 17;
    store8(b + end, 0xFF);
    store8(b + end + 1, 0xD9);
    var before = alloc_used();
    var err = 0;
    chitra_jpeg_decode(b, end + 2, &err);
    var spent = alloc_used() - before;
    # One quant-free frame plus ONE 19,712-byte Huffman block. Anything above
    # ~64 KB means a record was allocated per definition.
    assert_lte(spent, 65536, "3854 DHT definitions allocate one table block, not 3854");
    return 0;
}

# ================================================================
# B-3 (1.0.3) — GATE 2 refused the file, but only after every plane was
# allocated.
#
# 4,250 bytes: SOF0 declaring 4096x4096 Nf=3 (three 1x1 components, so three
# 16,777,216-byte planes) over 4,100 bytes of entropy data. The per-scan GATE 1
# passes — 4100*4096 = 16,793,600 is 16,384 MORE than one plane — so all three
# planes are allocated; only then does GATE 2 find w*h*4 = 67,108,864 against
# 4,100 bytes and refuse. Cost through 1.0.2: **50,354,832 bytes** to return
# CHITRA_ERR_DIMENSIONS, on an allocator that never frees. ~40 such files
# exhaust the stdlib's 2 GiB ALLOC_MAX.
#
# ⚠ MUTATION-CHECKED (1.0.3): with GATE 0 deleted the verdict and the error
# code were unchanged and ONLY the byte count moved, 22,160 -> 50,354,832. The
# cost assertion is therefore the whole test; asserting the refusal alone would
# pass against both versions.
# ⚠ 1.1.1 (jpeg-7): GATE 2 now also runs ahead of the planes, on the structural
# span sum, and refuses this file at the same 22,160 bytes — so deleting GATE 0
# ALONE no longer moves the count. Deleting both does (50,354,832). The padded
# cells further down are the ones GATE 0 cannot see.
#
# ⚠ The residual 22,160 bytes is the per-FRAME DQT/DHT table allocation from
# `chitra_jpeg_scan_markers` — 0.6.1's lazy-allocation cost, which is expected
# and is why the bound below is not tighter.
# ================================================================
fn fx_jpeg_amplification_bomb(len_out): i64 {
    var b = alloc(4250);
    store64(len_out, 4250);
    var i = 0;
    while (i < 4250) {
        store8(b + i, 0);
        i = i + 1;
    }
