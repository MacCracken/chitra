# ---- 0.3.3 hardening regressions -------------------------------------

# T.81 Table B.1: SOI, the 0x00 stuffing byte and the reserved 0x02-0xBF range
# are NOT length-bearing segments. Classifying them as such made the walk read
# the next two stream bytes as a segment length and skip that far.
fn _expect_jpeg_marker_reject(b0, b1, b2, b3, label) {
    var lo = 0;
    var b = fx_jpeg4(&lo, b0, b1, b2, b3);
    var err = 0;
    var f = chitra_jpeg_scan_markers(b, lo, &err);
    assert(f == 0, label);
    assert(err != 0, label);
    if (err != 0) { assert_eq(chitra_err_code(err), CHITRA_ERR_JPEG_MARKER, label); }
    return 0;
}

fn test_reject_nonsegment_markers() {
    _expect_jpeg_marker_reject(0xFF, 0xD8, 0xFF, 0xD8, "second SOI rejected as non-segment");
    _expect_jpeg_marker_reject(0xFF, 0xD8, 0xFF, 0x00, "FF00 stuffing rejected in header walk");
    _expect_jpeg_marker_reject(0xFF, 0xD8, 0xFF, 0x50, "reserved marker 0x50 rejected");
    _expect_jpeg_marker_reject(0xFF, 0xD8, 0xFF, 0x02, "reserved marker 0x02 (range low) rejected");
    _expect_jpeg_marker_reject(0xFF, 0xD8, 0xFF, 0xBF, "reserved marker 0xBF (range high) rejected");
    return 0;
}

# Both fixtures patch the known-good 8x8 grayscale JPEG in place rather than
# duplicating it: SOF0 sits at byte 71, so height is at b+76,77, width at
# b+78,79 and the component's packed H/V nibble at b+82.

# T.81 § A.2: a single-component scan is NON-interleaved. chitra implements
# only the interleaved geometry, which diverges as soon as the lone component
# has H>1 or V>1 (at w=24,H=2 it decodes 4 blocks where T.81 wants 3, so the
# entropy stream desyncs). It must reject, not mis-render.
# The 8x8 fixture widened to 24 and re-declared H=2,V=1 on its only component.
# Before 0.6.0 this was the § A.2 rejection cell; it now decodes (see the
# effective-geometry collapse in src/jpeg.cyr). Note its entropy stream still
# encodes ONE block while the corrected grid asks for ceil(24/8) = 3, so the
# bit-reader zero-pads and blocks 2-3 come out flat — this is a bounds and
# no-crash cell, NOT a conformance one. The conformance weight for § A.2 lives
# in tests/tcyr/jpeg_noninterleaved.tcyr, on real libjpeg-encoded files with an
# external reference decode.
fn fx_jpeg_gray_h2(len_out): i64 {
    var b = fx_jpeg_gray_8x8(len_out);
    store8(b + 78, 0x00);
    store8(b + 79, 24);        # width 24
    store8(b + 82, 0x21);      # H=2, V=1 on the only component
    return b;
}

# A ~150-byte file declaring 4096x4096. The entropy bit-reader zero-pads past
# end-of-data, so no real scan payload is needed: without the amplification
# cap this allocates ~67 MB of RGBA (plus planes) that the bump allocator
# never reclaims, from a file that fits in a packet.
fn fx_jpeg_bomb_dims(len_out): i64 {
    var b = fx_jpeg_gray_8x8(len_out);
    store8(b + 76, 0x10);
    store8(b + 77, 0x00);      # height 4096
    store8(b + 78, 0x10);
    store8(b + 79, 0x00);      # width 4096
    return b;
}

# 0.6.0 REVERSES the 0.3.3 rejection this cell used to pin. The old assertion
# (CHITRA_ERR_UNSUPPORTED) is now wrong: a one-component frame is
# non-interleaved by definition (T.81 § A.2.2) and its sampling factors are
# inert, so H=2 decodes. What survives here is the bounds check — a
# short-entropy stream on the corrected 3-block grid must zero-pad and finish,
# not walk off the plane.
fn test_decode_single_component_noninterleaved_bounds() {
    var lo = 0;
    var b = fx_jpeg_gray_h2(&lo);
    var err = 0;
    var img = chitra_jpeg_decode(b, lo, &err);
    assert(img != 0, "1-comp H=2 scan now decodes (T.81 § A.2 non-interleaved)");
    assert_eq(err, 0, "1-comp H=2: no error");
    if (img != 0) {
        assert_eq(chitra_image_width(img), 24, "1-comp H=2: width 24");
        assert_eq(chitra_image_height(img), 8, "1-comp H=2: height 8");
        assert_eq(chitra_image_source_color_type(img), 257, "1-comp H=2: src ctype 0x101");
        # Block 1 carries the fixture's flat DC=8 level; blocks 2-3 have no
        # entropy data behind them and zero-pad to the level-shifted midpoint.
        assert_eq(load8(chitra_image_pixels(img) + 0), 129, "1-comp H=2: px(0,0) = 129");
        assert_eq(load8(chitra_image_pixels(img) + 23 * 4 + 3), 255, "1-comp H=2: px(23,0) alpha = 255");
    }
    return 0;
}

fn test_reject_jpeg_amplification_bomb() {
    var lo = 0;
    var b = fx_jpeg_bomb_dims(&lo);
    var err = 0;
    var img = chitra_jpeg_decode(b, lo, &err);
    assert(img == 0, "geometry-only JPEG bomb rejected");
    assert(err != 0, "JPEG bomb sets err_out");
    # guard the deref: if the cap ever regresses, err is 0 and this must
    # report a clean FAIL rather than null-deref the whole suite away.
    if (err != 0) { assert_eq(chitra_err_code(err), CHITRA_ERR_DIMENSIONS, "JPEG bomb -> DIMENSIONS"); }
    return 0;
}

# The cap must not reject legitimate images: the unmodified 8x8 fixture and
# the real 16x16 ImageMagick gradient both stay decodable.
fn test_amplification_cap_allows_real_images() {
    var lo = 0;
    var b = fx_jpeg_gray_8x8(&lo);
    var err = 0;
    assert(chitra_jpeg_decode(b, lo, &err) != 0, "cap allows the 8x8 gray fixture");
    var glo = 0;
    var gb = fx_jpeg_real_gradient(&glo);
    var gerr = 0;
    assert(chitra_jpeg_decode(gb, glo, &gerr) != 0, "cap allows the real 16x16 gradient");
    return 0;
}

fn test_decode_real_gradient() {
    var lo = 0;
    var b = fx_jpeg_real_gradient(&lo);
    var err = 0;
    var img = chitra_jpeg_decode(b, lo, &err);
    assert(img != 0, "real gradient JPEG decodes");
    assert_eq(err, 0, "no error");
    assert_eq(chitra_image_width(img), 16, "width 16");
    assert_eq(chitra_image_height(img), 16, "height 16");
    assert_eq(chitra_image_source_color_type(img), 257, "grayscale JPEG -> 0x101");
    var px = chitra_image_pixels(img);
    # row 0 matches the ImageMagick reference decode byte-for-byte
    assert_eq(load8(px + 0 * 4), 255, "row0[0] = 0xff");
    assert_eq(load8(px + 1 * 4), 240, "row0[1] = 0xf0");
    assert_eq(load8(px + 2 * 4), 220, "row0[2] = 0xdc");
    assert_eq(load8(px + 3 * 4), 203, "row0[3] = 0xcb");
    assert_eq(load8(px + 4 * 4), 188, "row0[4] = 0xbc");
    assert_eq(load8(px + 7 * 4), 136, "row0[7] = 0x88");
    assert_eq(load8(px + 15 * 4), 0, "row0[15] = 0x00");
    # horizontal gradient: row 8 equals row 0
    assert_eq(load8(px + (8 * 16 + 0) * 4), 255, "row8[0] = 0xff");
    assert_eq(load8(px + (8 * 16 + 15) * 4), 0, "row8[15] = 0x00");
    return 0;
}

fn test_jpeg_decode_rgba8() {
    var lo = 0;
    var b = fx_jpeg_real_gradient(&lo);
    var w = 0;
    var hh = 0;
    var px = chitra_jpeg_decode_rgba8(b, lo, &w, &hh);
    assert(px != 0, "decode_rgba8 returns pixels");
    assert_eq(w, 16, "rgba8 width 16");
    assert_eq(hh, 16, "rgba8 height 16");
    assert_eq(load8(px + 0), 255, "rgba8 pixel0 R = 255");
    return 0;
}

fn test_image_decode_dispatch() {
    var lo = 0;
    var jb = fx_jpeg_real_gradient(&lo);
    var err = 0;
    var img = chitra_image_decode(jb, lo, &err);
    assert(img != 0, "image_decode routes JPEG");
    assert_eq(chitra_image_width(img), 16, "dispatched JPEG width 16");
    var bad[8];
    store8(&bad + 0, 0x00);
    store8(&bad + 1, 0x01);
    store8(&bad + 2, 0x02);
    store8(&bad + 3, 0x03);
    err = 0;
    var img2 = chitra_image_decode(&bad, 8, &err);
    assert_eq(img2, 0, "unknown format rejected");
    assert_eq(chitra_err_code(err), CHITRA_ERR_SIGNATURE, "unknown -> SIGNATURE");
    var pm[8];
    store8(&pm + 0, 0x89);
    store8(&pm + 1, 0x50);
    store8(&pm + 2, 0x4E);
    store8(&pm + 3, 0x47);
    store8(&pm + 4, 0x0D);
    store8(&pm + 5, 0x0A);
    store8(&pm + 6, 0x1A);
    store8(&pm + 7, 0x0A);
    err = 0;
    var img3 = chitra_image_decode(&pm, 8, &err);
    assert_eq(img3, 0, "incomplete PNG fails");
    assert(chitra_err_code(err) != CHITRA_ERR_SIGNATURE, "PNG magic routed to PNG decoder");
    return 0;
}

# ---- bite 9: hardening (DC/AC category bounds, duplicate Cs) ----

# DC table whose single symbol is category 12 (out of 8-bit baseline range 0..11).
fn fx_dc_table_cat12(): i64 {
    var t = alloc(HT_SIZE);
    var bits[136];
    var i = 0;
    while (i <= 16) { store64(&bits + i * 8, 0); i = i + 1; }
    store64(&bits + 1 * 8, 1);
    store64(t + HT_COUNT, 1);
    store64(t + HT_HUFFVAL + 0 * 8, 12);
    _jpeg_huff_build(t, &bits);
    return t;
}

# DC table with a single size-0 symbol (code "0").
fn fx_dc_table_size0(): i64 {
    var t = alloc(HT_SIZE);
    var bits[136];
    var i = 0;
    while (i <= 16) { store64(&bits + i * 8, 0); i = i + 1; }
    store64(&bits + 1 * 8, 1);
    store64(t + HT_COUNT, 1);
    store64(t + HT_HUFFVAL + 0 * 8, 0);
    _jpeg_huff_build(t, &bits);
    return t;
}

# AC table whose single symbol is 0x0B (run 0, size 11 — out of baseline range).
fn fx_ac_table_s11(): i64 {
    var t = alloc(HT_SIZE);
    var bits[136];
    var i = 0;
    while (i <= 16) { store64(&bits + i * 8, 0); i = i + 1; }
    store64(&bits + 1 * 8, 1);
    store64(t + HT_COUNT, 1);
    store64(t + HT_HUFFVAL + 0 * 8, 0x0B);
    _jpeg_huff_build(t, &bits);
    return t;
}

fn test_reject_dc_oversize() {
    var dct = fx_dc_table_cat12();
    var act = fx_ac_table();
    var buf[2];
    store8(&buf + 0, 0x00);
    var rdr[56];   # BR_SIZE
    _jpeg_br_init(&rdr, &buf, 2);
    var zz = alloc(512);
    var err = 0;
    var dc = _jpeg_decode_block(&rdr, dct, act, 0, zz, &err);
    assert_eq(chitra_err_code(err), CHITRA_ERR_JPEG_ENTROPY, "DC category 12 rejected");
    return 0;
}

fn test_reject_ac_oversize() {
    var dct = fx_dc_table_size0();
    var act = fx_ac_table_s11();
    var buf[2];
    store8(&buf + 0, 0x00);
    var rdr[56];   # BR_SIZE
    _jpeg_br_init(&rdr, &buf, 2);
    var zz = alloc(512);
    var err = 0;
    var dc = _jpeg_decode_block(&rdr, dct, act, 0, zz, &err);
    assert_eq(chitra_err_code(err), CHITRA_ERR_JPEG_ENTROPY, "AC size 11 rejected");
    return 0;
}

fn test_reject_dup_cs() {
    var lo = 0;
    var b = fx_jpeg_ycc_8x8(&lo);
    store8(b + 149, 0x01);   # SOS Cs2 = 1, duplicating Cs1
    var err = 0;
    var img = chitra_jpeg_decode(b, lo, &err);
    assert_eq(img, 0, "duplicate SOS Cs rejected");
    assert_eq(chitra_err_code(err), CHITRA_ERR_JPEG_SOS, "dup Cs -> SOS error");
    return 0;
}

# ================================================================
# 0.6.1 — APP14 Adobe colour transform (T.81 has no opinion; Adobe TN 5116)
#
# A real `cjpeg -rgb -quality 90` file: baseline SOF0, three components whose
# ids are 'R','G','B' (0x52/0x47/0x42), an Adobe APP14 declaring transform = 0
# (RGB), and NO JFIF APP0. libjpeg-turbo 3.2.0 writes it on request and djpeg
# reads it back. Through 0.6.0 chitra skipped every APPn and decoded all three
# components as YCbCr, so this file came back hue-rotated with NO error at all:
# 1149 of 1536 bytes wrong, max delta 235, a blue pixel returned dark red.
#
# Regenerate:
#   cjpeg -rgb -quality 90 -outfile rgbjpeg.jpg r2.ppm
# (r2.ppm is the 24x16 two-axis source in the header recipe of
# tests/tcyr/jpeg_noninterleaved.tcyr.) Expected pixels are `djpeg -nosmooth`
# output, which ImageMagick agrees with byte-for-byte — this fixture is 4:4:4,
# so both oracles are valid for it.
#
# Byte map the tests below patch: the 'Adobe' tag at offset 6..10, and the
# transform byte at offset 17.
# ================================================================
fn fx_jpeg_adobe_rgb(len_out): i64 {
    var b = alloc(437);
    store64(len_out, 437);
    store8(b + 0, 0xFF);
    store8(b + 1, 0xD8);
    store8(b + 2, 0xFF);
    store8(b + 3, 0xEE);
