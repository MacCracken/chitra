# Assert one RGB triple of the 24-wide colour fixture.
fn _cs_px(img, x, y, r, g, b, name): i64 {
    var p = chitra_image_pixels(img) + (y * 24 + x) * 4;
    assert_eq(load8(p + 0), r, name);
    assert_eq(load8(p + 1), g, name);
    assert_eq(load8(p + 2), b, name);
    return 0;
}

fn test_app14_rgb_decodes_without_the_ycbcr_transform() {
    var lo = 0;
    var b = fx_jpeg_adobe_rgb(&lo);
    assert_eq(load8(b + 6), 0x41, "fixture: Adobe APP14 tag sits at offset 6");
    assert_eq(load8(b + 17), 0x00, "fixture: transform byte sits at offset 17 and is 0 (RGB)");
    var err = 0;
    var img = chitra_jpeg_decode(b, lo, &err);
    assert(img != 0, "cjpeg -rgb file decodes");
    assert_eq(err, 0, "cjpeg -rgb: no error");
    if (img != 0) {
        assert_eq(chitra_image_width(img), 24, "cjpeg -rgb: width 24");
        assert_eq(chitra_image_height(img), 16, "cjpeg -rgb: height 16");
        # djpeg -nosmooth values. Before the repair px(0,0) came back
        # (121, 6, 0) — dark red for a blue pixel.
        _cs_px(img, 0, 0, 20, 20, 200, "adobe RGB px(0,0) = (20,20,200)");
        _cs_px(img, 8, 0, 100, 20, 140, "adobe RGB px(8,0)");
        _cs_px(img, 16, 0, 180, 20, 80, "adobe RGB px(16,0)");
        _cs_px(img, 0, 8, 20, 110, 170, "adobe RGB px(0,8)");
        _cs_px(img, 8, 8, 100, 110, 110, "adobe RGB px(8,8)");
        _cs_px(img, 16, 8, 180, 110, 50, "adobe RGB px(16,8)");
        _cs_px(img, 23, 15, 222, 145, 50, "adobe RGB px(23,15)");
        # 0x113 = 0x100 | 3 components | the RGB bit. A consumer that sees
        # 0x103 has been told "YCbCr", which for this file would be false.
        assert_eq(chitra_image_source_color_type(img), 0x113,
          "adobe RGB reports src_ctype 0x113, not 0x103");
    }
    return 0;
}

fn test_app14_transform1_still_applies_ycbcr() {
    # Same bytes, transform patched to 1 (YCbCr). The result is nonsense — the
    # samples really are RGB — but that is the point: the decoder must follow
    # the DECLARED transform rather than the component ids, or the Adobe flag is
    # decoration. So px(0,0) must be the BT.601 answer, not the RGB one.
    var lo = 0;
    var b = fx_jpeg_adobe_rgb(&lo);
    store8(b + 17, 0x01);
    var err = 0;
    var img = chitra_jpeg_decode(b, lo, &err);
    assert(img != 0, "transform=1 decodes");
    assert_eq(err, 0, "transform=1: no error");
    if (img != 0) {
        _cs_px(img, 0, 0, 121, 6, 0, "transform=1 px(0,0) = BT.601 output");
        assert_eq(chitra_image_source_color_type(img), 0x103,
          "transform=1 reports src_ctype 0x103 (YCbCr)");
    }
    return 0;
}

fn test_rgb_component_ids_without_an_adobe_marker() {
    # Metadata strippers drop APP segments. With the Adobe tag corrupted the
    # segment is skipped as a non-Adobe APP14, and the SOF0 component ids
    # 'R','G','B' are what is left to name the colour space — the same fallback
    # libjpeg uses.
    var lo = 0;
    var b = fx_jpeg_adobe_rgb(&lo);
    store8(b + 6, 0x58);        # 'A' -> 'X': no longer the Adobe tag
    var err = 0;
    var img = chitra_jpeg_decode(b, lo, &err);
    assert(img != 0, "RGB component ids without APP14 decode");
    assert_eq(err, 0, "RGB ids without APP14: no error");
    if (img != 0) { _cs_px(img, 0, 0, 20, 20, 200, "RGB-by-component-id px(0,0)"); }
    return 0;
}

fn test_app14_undefined_transform_rejected() {
    # Adobe defines 0, 1 and 2 only. chitra implements 0 and 1; 2 is YCCK, which
    # occurs only on the 4-component frames it already refuses. An undefined
    # value is DECLINED rather than assumed to be YCbCr — assuming YCbCr is
    # precisely the guess that produced the defect this parser exists to fix.
    var lo = 0;
    var b = fx_jpeg_adobe_rgb(&lo);
    store8(b + 17, 0x03);
    var err = 0;
    var img = chitra_jpeg_decode(b, lo, &err);
    assert(img == 0, "APP14 transform=3 rejected");
    assert(err != 0, "APP14 transform=3 sets err_out");
    if (err != 0) {
        assert_eq(chitra_err_code(err), CHITRA_ERR_UNSUPPORTED, "APP14 transform=3 -> UNSUPPORTED");
    }
    var lo2 = 0;
    var b2 = fx_jpeg_adobe_rgb(&lo2);
    store8(b2 + 17, 0x02);
    var err2 = 0;
    assert(chitra_jpeg_decode(b2, lo2, &err2) == 0, "APP14 transform=2 (YCCK) rejected");
    return 0;
}

# ================================================================
# 0.6.1 — the JPEG amplification cap's denominator
#
# A geometry-only bomb: SOF0 declares 4096x4096x3 (exactly CHITRA_MAX_PIXELS),
# the scan supplies two bytes, and the entropy reader zero-pads the rest — so
# the declared geometry alone drives ~117 MB of allocation that the bump
# allocator never reclaims.
#
# What makes this the regression cell rather than just another bomb is the
# PADDING: 16,404 of these 16,556 bytes are APPn segments the marker walk skips
# without decoding a single byte of. Through 0.6.0 CHITRA_MAX_JPEG_RATIO divided
# by the whole file length, so those skipped bytes BOUGHT ALLOWANCE — the same
# wrong-denominator defect the 0.5.3 BMP-RLE cap had. Measured before the
# repair: DECODED 4096x4096, 117,463,728 bytes spent. After: rejected, 22,160.
#
# The bare 152-byte version was always rejected; it is the control that proves
# the padding is what defeated the cap, not the geometry.
# ================================================================
fn fx_jpeg_bomb_padded(len_out): i64 {
    var b = alloc(16556);
    store64(len_out, 16556);
    var i = 0;
    while (i < 16556) {
        store8(b + i, 0);
        i = i + 1;
    }
    store8(b + 0, 0xFF);
    store8(b + 1, 0xD8);
    store8(b + 2, 0xFF);
    store8(b + 3, 0xDB);
    store8(b + 5, 0x43);
    store8(b + 7, 0x10);
    store8(b + 8, 0x10);
    store8(b + 9, 0x10);
    store8(b + 10, 0x10);
    store8(b + 11, 0x10);
    store8(b + 12, 0x10);
    store8(b + 13, 0x10);
    store8(b + 14, 0x10);
    store8(b + 15, 0x10);
    store8(b + 16, 0x10);
    store8(b + 17, 0x10);
    store8(b + 18, 0x10);
    store8(b + 19, 0x10);
    store8(b + 20, 0x10);
    store8(b + 21, 0x10);
    store8(b + 22, 0x10);
    store8(b + 23, 0x10);
    store8(b + 24, 0x10);
