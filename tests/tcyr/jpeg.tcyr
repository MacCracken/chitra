    store8(b + 42, 1);
    store8(b + 43, 1);
    store8(b + 44, 1);
    store8(b + 45, 1);
    store8(b + 46, 1);
    store8(b + 47, 1);
    store8(b + 48, 1);
    store8(b + 49, 1);
    store8(b + 50, 1);
    store8(b + 51, 1);
    store8(b + 52, 1);
    store8(b + 53, 1);
