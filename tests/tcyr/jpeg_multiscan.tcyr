    store8(b + 697, 0x43);
    store8(b + 698, 0x35);
    store8(b + 699, 0xF7);
    store8(b + 700, 0x36);
    store8(b + 701, 0x3F);
    store8(b + 702, 0xFF);
    store8(b + 703, 0xD9);
    return b;
}

fn _ms_sum(img): i64 {
    var n = chitra_image_width(img) * chitra_image_height(img) * 4;
    var px = chitra_image_pixels(img);
    var s = 0;
    var i = 0;
    while (i < n) {
        s = s + load8(px + i);
        i = i + 1;
    }
    return s;
}

fn _ms_decodes_to(b, lo, want, name): i64 {
    var err = 0;
    var img = chitra_jpeg_decode(b, lo, &err);
    assert(img != 0, name);
    assert_eq(err, 0, name);
    if (img != 0) {
        assert_eq(chitra_image_width(img), 24, name);
        assert_eq(chitra_image_height(img), 16, name);
        assert_eq(_ms_sum(img), want, name);
        assert_eq(chitra_image_seen_iend(img), 1, name);
    }
    return 0;
}

fn _ms_rejects(b, lo, code, name): i64 {
    var err = 0;
    var img = chitra_jpeg_decode(b, lo, &err);
    assert(img == 0, name);
    assert(err != 0, name);
    if (err != 0) { assert_eq(chitra_err_code(err), code, name); }
    return 0;
}

fn test_ms_420_all_three_encodings_agree() {
    # 4:2:0 is the discriminating ratio: the components have different sampling
    # factors, so a non-interleaved scan walks a grid derived from that
    # component's OWN sample dimensions (§ A.1.1) rather than from the frame MCU
    # grid. Getting the stride right but the grid wrong — or the reverse —
    # produces a plausible wrong image, not a crash.
    var lo = 0;
    _ms_decodes_to(fx_ms_il_420(&lo), lo, 223824, "4:2:0 interleaved (control)");
    var l2 = 0;
    _ms_decodes_to(fx_ms_seq_420(&l2), l2, 223824, "4:2:0 three Ns=1 scans");
    var l3 = 0;
    _ms_decodes_to(fx_ms_part_420(&l3), l3, 223824, "4:2:0 partially interleaved");
    return 0;
}

fn test_ms_422_all_three_encodings_agree() {
    var lo = 0;
    _ms_decodes_to(fx_ms_il_422(&lo), lo, 223818, "4:2:2 interleaved (control)");
    var l2 = 0;
    _ms_decodes_to(fx_ms_seq_422(&l2), l2, 223818, "4:2:2 three Ns=1 scans");
    var l3 = 0;
    _ms_decodes_to(fx_ms_part_422(&l3), l3, 223818, "4:2:2 partially interleaved");
    return 0;
}

fn test_ms_444_all_three_encodings_agree() {
    var lo = 0;
    _ms_decodes_to(fx_ms_il_444(&lo), lo, 223967, "4:4:4 interleaved (control)");
    var l2 = 0;
    _ms_decodes_to(fx_ms_seq_444(&l2), l2, 223967, "4:4:4 three Ns=1 scans");
    var l3 = 0;
    _ms_decodes_to(fx_ms_part_444(&l3), l3, 223967, "4:4:4 partially interleaved");
    return 0;
}

fn test_ms_sigma_hv_18_is_legal_when_no_scan_interleaves_it() {
    # SigmaHi*Vi = 18 frame-wide. T.81 § B.2.3 bounds it at 10 for a SCAN with
    # Ns > 1, not for the frame — and libjpeg proves the reading in both
    # directions: `cjpeg -sample 4x4,1x1,1x1 -scans <script>` writes these
    # files, while the same factors interleaved are refused by cjpeg itself
    # ("Sampling factors too large for interleaved scan"). Through 0.7.3 chitra
    # rejected both with CHITRA_ERR_JPEG_SOF. Both are byte-identical to
    # djpeg -nosmooth.
    var lo = 0;
    _ms_decodes_to(fx_ms_hv18_seq(&lo), lo, 223856, "SigmaHV=18, three Ns=1 scans");
    var l2 = 0;
    _ms_decodes_to(fx_ms_hv18_part(&l2), l2, 223856, "SigmaHV=18, partially interleaved");
    return 0;
}

fn test_ms_component_decoded_twice_rejected() {
    # Two scans naming the same component are a contradiction about the same
    # samples. djpeg decodes this file; chitra refuses it. Coverage-once is also
    # what BOUNDS THE DRIVER: every scan must set a new bit, so at most Nf
    # scans can succeed and the loop needs no counter.
    var lo = 0;
    _ms_rejects(fx_ms_dup_component(&lo), lo, CHITRA_ERR_JPEG_SOS,
      "a component decoded twice is rejected");
    return 0;
}

fn test_ms_component_never_decoded_rejected() {
    # The file ends with a component still undecoded. This one matters more than
    # it looks: an omitted component is NOT neutral, because Y = Cb = Cr = 0
    # through the BT.601 constants is RGB(0, 135, 0) — solid green, which
    # decodes cleanly and looks like a real picture. djpeg returns an image
    # here; chitra refuses rather than invent two thirds of one.
    var lo = 0;
    _ms_rejects(fx_ms_missing_component(&lo), lo, CHITRA_ERR_JPEG_SOS,
      "a component never decoded is rejected");
    return 0;
}

fn test_ms_scan_with_zero_components_rejected() {
    var lo = 0;
    _ms_rejects(fx_ms_ns_zero(&lo), lo, CHITRA_ERR_JPEG_SOS, "Ns = 0 rejected");
    return 0;
}

fn main(): i64 {
    test_ms_420_all_three_encodings_agree();
    test_ms_422_all_three_encodings_agree();
    test_ms_444_all_three_encodings_agree();
    test_ms_sigma_hv_18_is_legal_when_no_scan_interleaves_it();
    test_ms_component_decoded_twice_rejected();
    test_ms_component_never_decoded_rejected();
    test_ms_scan_with_zero_components_rejected();
    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
