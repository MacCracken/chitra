# tests/tcyr/jpeg_multiscan.tcyr — T.81 § A.2 multi-scan (0.8.0).
include "src/lib.cyr"
include "lib/assert.cyr"

# ================================================================
# 0.8.0 — T.81 § A.2 multi-scan and partially-interleaved scans
#
# THE ORACLE. At each sampling ratio the SAME image is encoded three ways:
# interleaved (one scan, all components), fully non-interleaved (three Ns=1
# scans), and partially interleaved (Ns=1 then Ns=2). `djpeg -nosmooth` decodes
# all three to identical bytes, and chitra already decoded the interleaved one
# correctly — so the multi-scan variants are held to the interleaved twin's
# exact byte sum. That is an external encoder and an external decoder agreeing,
# not chitra agreeing with itself.
#
# Regenerate (r2.ppm is the 24x16 two-axis source from the header recipe of
# this file's sibling suite):
#   printf '0: 0 63 0 0;\n1: 0 63 0 0;\n2: 0 63 0 0;\n' > seq.scan
#   printf '0: 0 63 0 0;\n1,2: 0 63 0 0;\n'             > part.scan
#   for s in 2x2,1x1,1x1 2x1,1x1,1x1 1x1,1x1,1x1; do
#     cjpeg -quality 80 -sample $s                  -outfile il.jpg   r2.ppm
#     cjpeg -quality 80 -sample $s -scans seq.scan  -outfile seq.jpg  r2.ppm
#     cjpeg -quality 80 -sample $s -scans part.scan -outfile part.jpg r2.ppm
#   done
#   cjpeg -quality 80 -sample 4x4,1x1,1x1 -scans seq.scan -outfile hv18_seq.jpg r2.ppm
# ================================================================
# 4:2:0 interleaved — the control. Byte sum 223,824.
