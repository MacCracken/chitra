# ms_seq_420 with the first scan header declaring Ns = 0.
fn fx_ms_ns_zero(len_out): i64 {
    var b = alloc(704);
    store64(len_out, 704);
    var i = 0;
    while (i < 704) {
        store8(b + i, 0);
        i = i + 1;
    }
    store8(b + 0, 0xFF);
    store8(b + 1, 0xD8);
    store8(b + 2, 0xFF);
    store8(b + 3, 0xE0);
    store8(b + 5, 0x10);
