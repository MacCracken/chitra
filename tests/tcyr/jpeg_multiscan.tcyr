    store8(b + 638, 0xE9);
    store8(b + 639, 0xEA);
    store8(b + 640, 0xF2);
    store8(b + 641, 0xF3);
    store8(b + 642, 0xF4);
    store8(b + 643, 0xF5);
    store8(b + 644, 0xF6);
    store8(b + 645, 0xF7);
    store8(b + 646, 0xF8);
    store8(b + 647, 0xF9);
    store8(b + 648, 0xFA);
    store8(b + 649, 0xFF);
    store8(b + 650, 0xDA);
    store8(b + 652, 0x08);
    store8(b + 653, 0x01);
    store8(b + 654, 0x02);
    store8(b + 655, 0x11);
    store8(b + 657, 0x3F);
    store8(b + 659, 0xFA);
    store8(b + 660, 0xAC);
    store8(b + 661, 0xE3);
    store8(b + 662, 0x39);
    store8(b + 663, 0xF8);
    store8(b + 664, 0x7D);
    store8(b + 665, 0xDE);
    store8(b + 666, 0xFD);
    store8(b + 667, 0x7D);
    store8(b + 668, 0x3C);
    store8(b + 669, 0x8F);
    store8(b + 670, 0xCC);
    store8(b + 671, 0xA5);
    store8(b + 672, 0x9C);
    store8(b + 673, 0xEB);
    store8(b + 674, 0xF0);
    store8(b + 675, 0xFE);
    store8(b + 676, 0x3F);
    store8(b + 677, 0xF0);
    store8(b + 678, 0x0F);
    store8(b + 679, 0xFF);
    store8(b + 680, 0xDA);
    store8(b + 682, 0x08);
    store8(b + 683, 0x01);
    store8(b + 684, 0x03);
    store8(b + 685, 0x11);
    store8(b + 687, 0x3F);
