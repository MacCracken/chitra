# PARTIALLY interleaved: scan 1 carries component 0, scan 2 carries components
# 1 and 2 (T.81 § A.2.3). Same deferral, same code — it is the same missing
# capability (a resumable marker walk), not a second one.
fn fx_jpeg_ni_partial(len_out): i64 {
    var b = alloc(695);
    store64(len_out, 695);
