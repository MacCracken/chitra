# ================================================================
# Helpers
# ================================================================

# Whole-image byte sum — a cheap fingerprint, used alongside the pixel asserts
# rather than instead of them (a sum alone cannot see a transposition).
fn _ni_sum(img): i64 {
    var n = chitra_image_width(img) * chitra_image_height(img) * 4;
    var px = chitra_image_pixels(img);
    var s = 0;
    var i = 0;
    while (i < n) {
        s = s + load8(px + i);
        i = i + 1;
    }
    return s;
}

# Bytes that differ between two decodes of the same geometry. This is what makes
# "the H>1 file decodes to its H=1 twin" a byte-for-byte claim.
fn _ni_diff_bytes(a, b): i64 {
    var n = chitra_image_width(a) * chitra_image_height(a) * 4;
    var pa = chitra_image_pixels(a);
    var pb = chitra_image_pixels(b);
    var d = 0;
    var i = 0;
    while (i < n) {
        if (load8(pa + i) != load8(pb + i)) { d = d + 1; }
        i = i + 1;
    }
    return d;
}

# Assert one RGBA pixel of a 24-wide image against the reference decode.
fn _ni_px(img, x, y, r, g, b, name): i64 {
    var p = chitra_image_pixels(img) + (y * 24 + x) * 4;
    assert_eq(load8(p + 0), r, name);
    assert_eq(load8(p + 1), g, name);
    assert_eq(load8(p + 2), b, name);
    assert_eq(load8(p + 3), 255, name);
    return 0;
}

# Decode a fixture that must be REJECTED, and assert the code. The err deref is
# guarded: if a guard ever regresses to "return 0 with no error", this reports a
# clean FAIL instead of null-dereferencing the whole suite away.
fn _ni_expect_reject(b, lo, code, name): i64 {
    var err = 0;
    var img = chitra_jpeg_decode(b, lo, &err);
    assert(img == 0, name);
    assert(err != 0, name);
    if (err != 0) { assert_eq(chitra_err_code(err), code, name); }
    return 0;
}

# ================================================================
# The control: sampling 1x1, decoded by every chitra since 0.3.0
# ================================================================
fn test_ni_gray_control() {
    var lo = 0;
    var b = fx_jpeg_ni_gray(&lo);
    var err = 0;
    var img = chitra_jpeg_decode(b, lo, &err);
    assert(img != 0, "1x1 grayscale control decodes");
    assert_eq(err, 0, "1x1 control: no error");
    if (img != 0) {
        assert_eq(chitra_image_width(img), 24, "1x1 control: width 24");
        assert_eq(chitra_image_height(img), 16, "1x1 control: height 16");
        assert_eq(chitra_image_channels(img), 4, "1x1 control: 4 channels");
        assert_eq(chitra_image_source_color_type(img), 257, "1x1 control: src ctype 0x101");
        # The six 8x8 block corners, read out of `djpeg -nosmooth`. They are
        # pairwise DISTINCT (31 / 100 / 171 / 76 / 145 / 216), so a block written
        # into the wrong grid cell — in EITHER axis — moves at least one of them.
        _ni_px(img, 0, 0, 31, 31, 31, "control px(0,0) = 31");
        _ni_px(img, 8, 0, 100, 100, 100, "control px(8,0) = 100");
        _ni_px(img, 16, 0, 171, 171, 171, "control px(16,0) = 171");
        _ni_px(img, 0, 8, 76, 76, 76, "control px(0,8) = 76");
        _ni_px(img, 8, 8, 145, 145, 145, "control px(8,8) = 145");
        _ni_px(img, 16, 8, 216, 216, 216, "control px(16,8) = 216");
        _ni_px(img, 7, 7, 99, 99, 99, "control px(7,7) = 99 (intra-block texture)");
        _ni_px(img, 23, 15, 255, 255, 255, "control px(23,15) = 255 (last pixel)");
        assert_eq(_ni_sum(img), 278325, "control: whole-image byte sum");
    }
    return 0;
}

# ================================================================
# T.81 § A.2 — the sampling factors are INERT for a one-component frame
# ================================================================

# Decode the H/V variant `hv` and assert it is byte-for-byte the control's
# decode. Not "the same sum" — the same 1536 bytes.
fn _ni_check_hv(hv, name): i64 {
    var lo = 0;
    var c = fx_jpeg_ni_gray(&lo);
    var e0 = 0;
    var ctl = chitra_jpeg_decode(c, lo, &e0);
    assert(ctl != 0, "sweep: control decodes");
    var lo2 = 0;
    var b = fx_jpeg_ni_gray_hv(&lo2, hv);
    var err = 0;
    var img = chitra_jpeg_decode(b, lo2, &err);
    assert(img != 0, name);
    assert_eq(err, 0, name);
    # Guard the deref. Without this a regression that reinstates the rejection
    # null-dereferences and takes the whole suite down with it, where what is
    # wanted is a clean FAIL naming the cell.
    if (img != 0) {
        assert_eq(chitra_image_width(img), 24, name);
        assert_eq(chitra_image_height(img), 16, name);
        if (ctl != 0) { assert_eq(_ni_diff_bytes(ctl, img), 0, name); }
    }
    return 0;
}

fn test_ni_gray_h2v1() {
    # `cjpeg -grayscale -sample 2x1`. Rejected with CHITRA_ERR_UNSUPPORTED
    # before 0.6.0: the interleaved grid walks ceil(24/16) = 2 MCUs of 2 blocks
    # where § A.2.2 wants ceil(24/8) = 3 blocks in a row.
    _ni_check_hv(0x21, "sampling 2x1 decodes to the 1x1 control, byte for byte");
    return 0;
}

fn test_ni_gray_h2v2() {
    _ni_check_hv(0x22, "sampling 2x2 decodes to the 1x1 control, byte for byte");
    return 0;
}

fn test_ni_gray_h4v4() {
    # The load-bearing geometry cell. At 24x16 the non-interleaved grid is
    # 3x2 = 6 blocks where the interleaved reading is 1x1 MCUs of 4x4 = 16 —
    # the only fixture here that discriminates in BOTH axes at once. It also
    # carries H*V = 16 > 10, so it additionally proves the SigmaHj*Vj cap is
    # conditioned on Ns > 1 (T.81 § B.2.3); before 0.6.0 it was rejected at the
    # SOF0 parse with CHITRA_ERR_JPEG_SOF, before the § A.2 path was reached.
    _ni_check_hv(0x44, "sampling 4x4 decodes to the 1x1 control, byte for byte");
    return 0;
}

fn test_ni_hv_sweep() {
    # Exhaustive over the legal range (T.81 § B.2.2: Hi, Vi in 1..4). For Nf = 1
    # the § A.1.1 derivation gives x1 = X and y1 = Y for every pair, so all 16
    # must produce the identical image. A spot check would not prove that.
    var hh = 1;
    var vv = 1;
    while (hh <= 4) {
        vv = 1;
        while (vv <= 4) {
            _ni_check_hv(hh * 16 + vv, "H/V sweep: every legal factor pair decodes identically");
            vv = vv + 1;
        }
        hh = hh + 1;
    }
    return 0;
}

fn test_ni_gray_restart() {
    # Sampling 2x1 with DRI = 1. Ri counts MCUs (T.81 § B.2.4.4) and the collapse
    # redefines what an MCU IS here — one data unit, not max_h x max_v of them —
    # so a restart interval still counted in interleaved MCUs would resync at the
    # wrong byte and desync the entropy stream.
    var lo = 0;
    var b = fx_jpeg_ni_gray_rst(&lo);
    var err = 0;
    var img = chitra_jpeg_decode(b, lo, &err);
    assert(img != 0, "2x1 + restart interval decodes");
    assert_eq(err, 0, "2x1 + restart: no error");
    if (img != 0) {
        assert_eq(chitra_image_width(img), 24, "2x1 + restart: width 24");
        assert_eq(chitra_image_height(img), 16, "2x1 + restart: height 16");
        _ni_px(img, 0, 0, 31, 31, 31, "2x1 + restart px(0,0) = 31");
        _ni_px(img, 16, 8, 216, 216, 216, "2x1 + restart px(16,8) = 216");
        assert_eq(_ni_sum(img), 278325, "2x1 + restart: same sum as the control");
    }
    return 0;
}

fn test_ni_rgba8_wrapper() {
    # The convenience wrapper must reach the new path too.
    var lo = 0;
    var b = fx_jpeg_ni_gray_hv(&lo, 0x21);
    var w = 0;
    var h = 0;
    var px = chitra_jpeg_decode_rgba8(b, lo, &w, &h);
    assert(px != 0, "_rgba8 wrapper decodes a 2x1 grayscale JPEG");
    assert_eq(w, 24, "_rgba8 wrapper: width 24");
    assert_eq(h, 16, "_rgba8 wrapper: height 16");
    if (px != 0) { assert_eq(load8(px + 0), 31, "_rgba8 wrapper: px(0,0) = 31"); }
    return 0;
}

fn test_ni_router_dispatch() {
    # chitra_image_decode sniffs the SOI and must route the new class as well.
    var lo = 0;
    var b = fx_jpeg_ni_gray_hv(&lo, 0x44);
    var err = 0;
    var img = chitra_image_decode(b, lo, &err);
    assert(img != 0, "router decodes a 4x4 grayscale JPEG");
    assert_eq(err, 0, "router: no error");
    if (img != 0) {
        assert_eq(_ni_sum(img), 278325, "router: same sum as the control");
    }
    return 0;
}

# ================================================================
# The interleaved path must not move
# ================================================================
fn test_ni_interleaved_control() {
    # 3-component 4:2:0 in ONE scan — the layout 0.6.0 does not touch. Expected
    # values from `djpeg -nosmooth` (NOT ImageMagick: see the header note on
    # fancy vs box chroma upsampling).
    var lo = 0;
    var b = fx_jpeg_ni_il3(&lo);
    var err = 0;
    var img = chitra_jpeg_decode(b, lo, &err);
    assert(img != 0, "interleaved 4:2:0 control decodes");
    assert_eq(err, 0, "interleaved control: no error");
    if (img != 0) {
        assert_eq(chitra_image_width(img), 24, "interleaved control: width 24");
        assert_eq(chitra_image_height(img), 16, "interleaved control: height 16");
        assert_eq(chitra_image_source_color_type(img), 259, "interleaved control: src ctype 0x103");
        _ni_px(img, 0, 0, 13, 23, 199, "interleaved px(0,0)");
        _ni_px(img, 8, 0, 98, 22, 131, "interleaved px(8,0)");
        _ni_px(img, 16, 8, 188, 110, 38, "interleaved px(16,8)");
        _ni_px(img, 23, 15, 221, 144, 52, "interleaved px(23,15)");
        assert_eq(_ni_sum(img), 223824, "interleaved control: whole-image byte sum");
    }
    return 0;
}

fn test_ni_interleaved_blocks_over_10_rejected() {
    # The reachability half of the § B.2.3 conditioning. The cap now fires only
    # for Nf > 1 — so it had better still fire there. cjpeg REFUSES to write this
    # file ("Sampling factors too large for interleaved scan"), which is itself
    # the spec confirmation, so the fixture is the interleaved control with its
    # three SOF0 sampling bytes patched to 4x4, 2x2, 2x2 (SigmaHj*Vj = 24).
    var lo = 0;
    var b = fx_jpeg_ni_il3(&lo);
    assert_eq(load8(b + 169), 0x22, "fixture: il3 comp0 sampling sits at offset 169");
    assert_eq(load8(b + 172), 0x11, "fixture: il3 comp1 sampling sits at offset 172");
    assert_eq(load8(b + 175), 0x11, "fixture: il3 comp2 sampling sits at offset 175");
    store8(b + 169, 0x44);
    store8(b + 172, 0x22);
    store8(b + 175, 0x22);
    _ni_expect_reject(b, lo, CHITRA_ERR_JPEG_SOF,
      "interleaved SigmaHj*Vj = 24 still rejected -> JPEG_SOF");
    return 0;
}

# ================================================================
# Deferred, not malformed — see ADR 0006
# ================================================================
fn test_ni_multiscan_deferred() {
    # Three consecutive Ns=1 scans. djpeg decodes this identically to the
    # interleaved control, so it is a real conformance gap, not a broken file —
    # which is exactly why the code is UNSUPPORTED ("chitra declines") and no
    # longer JPEG_SOS ("your file is malformed").
    var lo = 0;
    var b = fx_jpeg_ni_multiscan(&lo);
    _ni_expect_reject(b, lo, CHITRA_ERR_UNSUPPORTED,
      "non-interleaved multi-scan deferred -> UNSUPPORTED");
    return 0;
}

fn test_ni_partial_scan_deferred() {
    var lo = 0;
    var b = fx_jpeg_ni_partial(&lo);
    _ni_expect_reject(b, lo, CHITRA_ERR_UNSUPPORTED,
      "partially interleaved scan deferred -> UNSUPPORTED");
    return 0;
}

# ================================================================
# Ns validity — still malformed, and still says so
# ================================================================
fn test_ni_sos_ns_zero_rejected() {
    # Ns = 0 violates T.81 § B.2.3 (1 <= Ns <= 4). It must NOT be reported as a
    # deferral: neuter the ns < 1 guard and this file comes back as code 4,
    # chitra claiming it declines a file that is simply broken.
    var lo = 0;
    var b = fx_jpeg_ni_gray(&lo);
    assert_eq(load8(b + 320), 0x00, "fixture: SOS length high byte at 320");
    assert_eq(load8(b + 321), 0x08, "fixture: SOS length low byte at 321");
    assert_eq(load8(b + 322), 0x01, "fixture: SOS Ns at 322");
    store8(b + 321, 0x06);
    store8(b + 322, 0x00);
    _ni_expect_reject(b, lo, CHITRA_ERR_JPEG_SOS, "SOS Ns = 0 -> JPEG_SOS");
    return 0;
}

fn test_ni_sos_ns_over_nf_rejected() {
    # Ns = 3 against a 1-component frame: malformed by pigeonhole, since each Csj
    # must name a distinct frame component.
    var lo = 0;
    var b = fx_jpeg_ni_gray(&lo);
    store8(b + 321, 0x0C);
    store8(b + 322, 0x03);
    _ni_expect_reject(b, lo, CHITRA_ERR_JPEG_SOS, "SOS Ns > Nf -> JPEG_SOS");
    return 0;
}

fn main(): i64 {
    test_ni_gray_control();
    test_ni_gray_h2v1();
    test_ni_gray_h2v2();
    test_ni_gray_h4v4();
    test_ni_hv_sweep();
    test_ni_gray_restart();
    test_ni_rgba8_wrapper();
    test_ni_router_dispatch();
    test_ni_interleaved_control();
    test_ni_interleaved_blocks_over_10_rejected();
    test_ni_multiscan_deferred();
    test_ni_partial_scan_deferred();
    test_ni_sos_ns_zero_rejected();
    test_ni_sos_ns_over_nf_rejected();
    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
