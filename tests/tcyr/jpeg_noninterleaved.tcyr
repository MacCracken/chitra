# The H>1 / V>1 variants, derived by patching the ONE byte that differs. The
# assert is the point: if a regenerated corpus ever moves the SOF0 sampling
# nibble off offset 100, this fails loudly instead of silently patching a
# quantization value and "proving" something about a corrupt file.
fn fx_jpeg_ni_gray_hv(len_out, hv): i64 {
    var b = fx_jpeg_ni_gray(len_out);
    assert_eq(load8(b + 100), 0x11, "fixture: SOF0 sampling nibble sits at offset 100");
    store8(b + 100, hv);
    return b;
}

# Same image at sampling 2x1 with a restart interval of 1 MCU (`-restart 1B`).
# The collapse redefines what an MCU IS for a one-component frame, and DRI/RSTn
# counts MCUs (T.81 § B.2.4.4) — so this is the cell that would catch a restart
# interval still being counted in interleaved MCUs.
