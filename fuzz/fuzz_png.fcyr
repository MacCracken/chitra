# chitra — PNG decode fuzz harness (`cyrius fuzz`).
#
# chitra's threat model is a HOSTILE ENCODED IMAGE: untrusted (src, len)
# bytes reach a public entry point. This harness drives the PNG path with
# adversarial input and asserts the two invariants every decode must hold,
# no matter how malformed the input:
#
#   1. SURVIVAL   — the decoder returns. It must not fault, corrupt memory,
#                   or loop forever on any byte sequence.
#   2. CONTRACT   — the documented result shape holds on every path:
#                   failure => returns 0 AND *err_out is a non-zero ChitraErr;
#                   success => non-zero image, err_out untouched (0), and
#                   width/height/pixels all sane.
#
# Invariant 2 is the one a crash-only fuzzer misses: a decoder that returns
# 0 without setting *err_out hands the caller a stale or zero error, and
# mabda maps ChitraErr straight onto GpuErr.
#
# Stack-array pointer note: `var buf[N]` reserves N bytes, but `buf` as an
# rvalue yields the first 8 bytes, not the address — pass `&buf`.

include "src/lib.cyr"
include "lib/assert.cyr"

# ================================================================
# Deterministic PRNG (LCG) — seeded per case so every failure reproduces.
# ================================================================
var _fuzz_state = 0;

fn _fuzz_seed(s): i64 {
    _fuzz_state = s;
    return 0;
}

fn _fuzz_next(): i64 {
    _fuzz_state = _fuzz_state * 6364136223846793005 + 1442695040888963407;
    return (_fuzz_state >> 33) & 255;
}

fn _fuzz_fill(buf, len): i64 {
    var i = 0;
    while (i < len) {
        store8(buf + i, _fuzz_next());
        i = i + 1;
    }
    return 0;
}

fn fx_rgba8_2x2(len_out): i64 {
    var b = alloc(77);
    store64(len_out, 77);
    store8(b + 0, 137);
    store8(b + 1, 80);
    store8(b + 2, 78);
    store8(b + 3, 71);
    store8(b + 4, 13);
    store8(b + 5, 10);
    store8(b + 6, 26);
    store8(b + 7, 10);
    store8(b + 8, 0);
    store8(b + 9, 0);
    store8(b + 10, 0);
    store8(b + 11, 13);
    store8(b + 12, 73);
    store8(b + 13, 72);
    store8(b + 14, 68);
    store8(b + 15, 82);
    store8(b + 16, 0);
    store8(b + 17, 0);
    store8(b + 18, 0);
    store8(b + 19, 2);
    store8(b + 20, 0);
    store8(b + 21, 0);
    store8(b + 22, 0);
    store8(b + 23, 2);
    store8(b + 24, 8);
    store8(b + 25, 6);
    store8(b + 26, 0);
    store8(b + 27, 0);
    store8(b + 28, 0);
    store8(b + 29, 114);
    store8(b + 30, 182);
    store8(b + 31, 13);
    store8(b + 32, 36);
    store8(b + 33, 0);
    store8(b + 34, 0);
    store8(b + 35, 0);
    store8(b + 36, 20);
    store8(b + 37, 73);
    store8(b + 38, 68);
    store8(b + 39, 65);
    store8(b + 40, 84);
    store8(b + 41, 120);
    store8(b + 42, 218);
    store8(b + 43, 99);
    store8(b + 44, 248);
    store8(b + 45, 207);
    store8(b + 46, 192);
    store8(b + 47, 240);
    store8(b + 48, 31);
    store8(b + 49, 12);
    store8(b + 50, 129);
    store8(b + 51, 52);
    store8(b + 52, 16);
    store8(b + 53, 48);
    store8(b + 54, 52);
    store8(b + 55, 0);
    store8(b + 56, 0);
    store8(b + 57, 71);
    store8(b + 58, 75);
    store8(b + 59, 8);
    store8(b + 60, 121);
    store8(b + 61, 195);
    store8(b + 62, 37);
    store8(b + 63, 135);
    store8(b + 64, 235);
    store8(b + 65, 0);
    store8(b + 66, 0);
    store8(b + 67, 0);
    store8(b + 68, 0);
    store8(b + 69, 73);
    store8(b + 70, 69);
    store8(b + 71, 78);
    store8(b + 72, 68);
    store8(b + 73, 174);
    store8(b + 74, 66);
    store8(b + 75, 96);
    store8(b + 76, 130);
    return b;
}

# ================================================================
# The contract gate. Every fuzz case funnels through here: whatever the
# input, the decoder must return, and its result shape must match the
# documented contract exactly.
# ================================================================
fn _png_contract(buf, n, label): i64 {
    var err = 0;
    var img = chitra_png_decode(buf, n, &err);
    if (img == 0) {
        # Failure path: *err_out MUST hold a real ChitraErr.
        assert(err != 0, label);
        if (err != 0) {
            assert(chitra_err_code(err) != CHITRA_OK, label);
            # every code must have a printable name (no null deref downstream)
            assert(chitra_err_name(chitra_err_code(err)) != 0, label);
        }
    }
    if (img != 0) {
        # Success path: err_out stays 0 and the image is coherent.
        assert(err == 0, label);
        assert(chitra_image_width(img) > 0, label);
        assert(chitra_image_height(img) > 0, label);
        assert(chitra_image_pixels(img) != 0, label);
        assert(chitra_image_channels(img) == 4, label);
    }
    return 0;
}

# Same gate for the format-sniffing router (jpeg.cyr:424).
fn _router_contract(buf, n, label): i64 {
    var err = 0;
    var img = chitra_image_decode(buf, n, &err);
    if (img == 0) { assert(err != 0, label); }
    if (img != 0) {
        assert(err == 0, label);
        assert(chitra_image_pixels(img) != 0, label);
        assert(chitra_image_channels(img) == 4, label);
    }
    return 0;
}

# The four public _rgba8 wrappers were entirely unfuzzed through 0.7.2 — they
# are public, about to be frozen, and they write through CALLER-OWNED slots
# before the decode runs. That ordering is the contract worth pinning: on any
# failure both slots must be left 0 rather than holding a stale or partial
# value the caller might act on.
fn _rgba8_contract(buf, n, label): i64 {
    var w = 0 - 1;
    var h = 0 - 1;
    var px = chitra_png_decode_rgba8(buf, n, &w, &h);
    if (px == 0) {
        assert(w == 0, label);
        assert(h == 0, label);
    }
    if (px != 0) {
        assert(w > 0, label);
        assert(h > 0, label);
    }
    return 0;
}

# ---- Harness self-check ----------------------------------------------
# A fuzz harness that silently no-ops is worse than none. fuzz_png was the only
# one of the four without this gate: if fx_rgba8_2x2 ever stopped decoding,
# every mode below would still report hundreds of thousands of cases
# "survived" while exercising nothing past the signature check.
fn fuzz_png_selfcheck(): i64 {
    var lo = 0;
    var b = fx_rgba8_2x2(&lo);
    var err = 0;
    var img = chitra_png_decode(b, lo, &err);
    assert(img != 0, "selfcheck: png fixture decodes clean");
    assert(err == 0, "selfcheck: png fixture sets no error");
    if (img != 0) {
        assert(chitra_image_width(img) == 2, "selfcheck: png fixture is 2 wide");
        assert(chitra_image_height(img) == 2, "selfcheck: png fixture is 2 tall");
        assert(chitra_image_channels(img) == 4, "selfcheck: png fixture is RGBA8");
    }
    # ...and the IDAT locator must actually find one, or the mutation mode
    # below would silently degrade into "return 0" on every case.
    var type_off = 0;
    var clen = 0;
    assert(_find_idat(b, lo, &type_off, &clen) == 1, "selfcheck: IDAT located");
    assert(clen > 0, "selfcheck: IDAT payload is non-empty");
    # Repairing the CRC of an UNMUTATED chunk must leave the file decodable —
    # if _repair_crc were wrong, every mutated case would reject at the CRC
    # gate and this whole mode would test nothing.
    _repair_crc(b, type_off, clen);
    var err2 = 0;
    assert(chitra_png_decode(b, lo, &err2) != 0, "selfcheck: CRC repair is correct");
    return 0;
}

# ---- 1. Pure random bytes -------------------------------------------
# Mostly rejected at the signature gate; proves no read happens first.
fn fuzz_png_random(seed, n): i64 {
    _fuzz_seed(seed);
    var buf[512];
    var capped = n;
    if (capped > 512) { capped = 512; }
    if (capped < 0) { capped = 0; }
    _fuzz_fill(&buf, capped);
    _png_contract(&buf, capped, "png random bytes");
    _router_contract(&buf, capped, "router random bytes");
    return 0;
}

# ---- 2. Valid signature + random tail --------------------------------
# The high-value case: past the signature gate, the chunk walk itself is
# fed garbage — hostile lengths, unknown types, bad CRCs, lying IHDRs.
fn fuzz_png_sigprefix(seed, n): i64 {
    _fuzz_seed(seed);
    var buf[512];
    var capped = n;
    if (capped > 504) { capped = 504; }
    if (capped < 0) { capped = 0; }
    store8(&buf + 0, 137);
    store8(&buf + 1, 80);
    store8(&buf + 2, 78);
    store8(&buf + 3, 71);
    store8(&buf + 4, 13);
    store8(&buf + 5, 10);
    store8(&buf + 6, 26);
    store8(&buf + 7, 10);
    _fuzz_fill(&buf + 8, capped);
    _png_contract(&buf, capped + 8, "png sig + random chunks");
    return 0;
}

# ---- 3. Bit-flipped valid fixture ------------------------------------
# Starts from a genuinely valid 2x2 RGBA8 PNG and corrupts `nmut` bytes.
# Most land on a CRC-covered field, so the CRC gate must reject cleanly
# rather than decode corrupt geometry.
fn fuzz_png_mutate(seed, nmut): i64 {
    _fuzz_seed(seed);
    var lo = 0;
    var b = fx_rgba8_2x2(&lo);
    var m = 0;
    var pos = 0;
    while (m < nmut) {
        pos = (_fuzz_next() * 256 + _fuzz_next()) % lo;
        store8(b + pos, _fuzz_next());
        m = m + 1;
    }
    _png_contract(b, lo, "png mutated fixture");
    _rgba8_contract(b, lo, "png mutated fixture (_rgba8 wrapper)");
    return 0;
}

# ---- 4. Truncation sweep ---------------------------------------------
# Every prefix of a valid PNG. Each must reject as TRUNCATED (or decode,
# for the full length) — never read past the buffer.
fn fuzz_png_truncate(): i64 {
    var lo = 0;
    var b = fx_rgba8_2x2(&lo);
    var cut = 0;
    while (cut <= lo) {
        _png_contract(b, cut, "png truncated prefix");
        cut = cut + 1;
    }
    return 0;
}

# ---- IDAT-stream mutation (0.7.3, the priority target) ---------------
# PNG's per-chunk CRC-32 is why this mode has to exist. A random byte flip
# inside IDAT makes the chunk CRC disagree, so `chitra_png_parse_raw` rejects
# with CHITRA_ERR_CRC before sankoch's inflate — and therefore before the five
# § 9 unfilter predictors, the Adam7 deinterlace and the tRNS/palette colour
# pass — ever runs. Every one of those was effectively unfuzzed: modes 1-3
# below drive the chunk walk and the signature gate, and stop at the CRC.
#
# So this mode mutates the IDAT payload and then REPAIRS THE CRC, producing a
# structurally valid PNG carrying hostile compressed data. That is the direct
# analogue of fuzz_jpeg's entropy-segment mutation (0.3.3), which is why the
# JPEG entropy path is well covered and this one was not.

# Locate the first IDAT chunk. Writes the offset of its 4-byte TYPE field
# (which is what the CRC is computed over, together with the data) and its
# data length. Returns 1 on success, 0 if there is no IDAT.
fn _find_idat(b, n, type_off_out, len_out): i64 {
    store64(type_off_out, 0);
    store64(len_out, 0);
    var pos = 8;                       # past the signature
    var clen = 0;
    var found = 0;
    var scanning = 1;
    while (scanning == 1) {
        if (pos + 8 > n) { scanning = 0; }
        if (scanning == 1) {
            clen = load8(b + pos) * 16777216 + load8(b + pos + 1) * 65536
            + load8(b + pos + 2) * 256 + load8(b + pos + 3);
            if (clen < 0) { scanning = 0; }
        }
        if (scanning == 1) {
            if (pos + 12 + clen > n) { scanning = 0; }
        }
        if (scanning == 1) {
            if (load8(b + pos + 4) == 73) {
                if (load8(b + pos + 5) == 68) {
                    if (load8(b + pos + 6) == 65) {
                        if (load8(b + pos + 7) == 84) {
                            store64(type_off_out, pos + 4);
                            store64(len_out, clen);
                            found = 1;
                            scanning = 0;
                        }
                    }
                }
            }
        }
        if (scanning == 1) { pos = pos + 12 + clen; }
    }
    return found;
}

fn _put_be32(p, v): i64 {
    store8(p + 0, (v >> 24) & 255);
    store8(p + 1, (v >> 16) & 255);
    store8(p + 2, (v >> 8) & 255);
    store8(p + 3, v & 255);
    return 0;
}

# Recompute a chunk's trailing CRC-32 over (type + data), so a mutated payload
# still presents as a well-formed chunk. Without this the decoder never gets
# past the CRC gate and the mutation is wasted.
fn _repair_crc(b, type_off, clen): i64 {
    var c = crc32(b + type_off, 4 + clen);
    var crc_at = type_off + 4 + clen;
    store8(b + crc_at + 0, (c >> 24) & 255);
    store8(b + crc_at + 1, (c >> 16) & 255);
    store8(b + crc_at + 2, (c >> 8) & 255);
    store8(b + crc_at + 3, c & 255);
    return 0;
}

# ---- Scanline-level mutation (0.7.3) --------------------------------
# The IDAT-stream mode above repairs the CRC, so hostile bytes reach sankoch —
# but they are hostile COMPRESSED bytes, and ~99% of them fail inflate. Only
# ~0.6% survive to the part this release is actually about: the five § 9
# unfilter predictors, the Adam7 deinterlace and the colour pass.
#
# So this mode mutates the raw scanlines BEFORE compressing them. Every case
# therefore inflates cleanly and lands squarely in `_chitra_unfilter_row`, with
# an attacker-chosen filter byte per row — including values outside {0..4},
# which is the one thing the predictors must reject rather than index on.
fn fuzz_png_scanlines(seed, w, h): i64 {
    _fuzz_seed(seed);
    var row_bytes = w * 4;                   # RGBA8, colour type 6
    var raw_len = h * (row_bytes + 1);
    var raw = alloc(raw_len);
    if (raw == 0) { return 0; }
    var y = 0;
    var x = 0;
    var off = 0;
    while (y < h) {
        # The filter byte. Mostly legal so the predictors actually run, but
        # 1-in-8 out of range so the § 9 allow-list is exercised too.
        if ((_fuzz_next() & 7) == 0) {
            store8(raw + off, _fuzz_next() & 255);
        } else {
            store8(raw + off, _fuzz_next() % 5);
        }
        off = off + 1;
        x = 0;
        while (x < row_bytes) {
            store8(raw + off, _fuzz_next() & 255);
            off = off + 1;
            x = x + 1;
        }
        y = y + 1;
    }
    var zcap = raw_len * 2 + 128;
    var z = alloc(zcap);
    if (z == 0) { return 0; }
    var zlen = zlib_compress(raw, raw_len, z, zcap);
    if (zlen <= 0) { return 0; }

    # Assemble: signature + IHDR + IDAT(z) + IEND, every CRC correct.
    var total = 8 + 25 + (12 + zlen) + 12;
    var b = alloc(total);
    if (b == 0) { return 0; }
    store8(b + 0, 137);
    store8(b + 1, 80);
    store8(b + 2, 78);
    store8(b + 3, 71);
    store8(b + 4, 13);
    store8(b + 5, 10);
    store8(b + 6, 26);
    store8(b + 7, 10);
    _put_be32(b + 8, 13);
    store8(b + 12, 73);
    store8(b + 13, 72);
    store8(b + 14, 68);
    store8(b + 15, 82);
    _put_be32(b + 16, w);
    _put_be32(b + 20, h);
    store8(b + 24, 8);                       # bit depth
    store8(b + 25, 6);                       # colour type 6 (RGBA)
    store8(b + 26, 0);
    store8(b + 27, 0);
    store8(b + 28, 0);                       # interlace: none
    _repair_crc(b, 12, 13);
    var idat = 8 + 25;
    _put_be32(b + idat, zlen);
    store8(b + idat + 4, 73);
    store8(b + idat + 5, 68);
    store8(b + idat + 6, 65);
    store8(b + idat + 7, 84);
    var i = 0;
    while (i < zlen) {
        store8(b + idat + 8 + i, load8(z + i));
        i = i + 1;
    }
    _repair_crc(b, idat + 4, zlen);
    var iend = idat + 12 + zlen;
    _put_be32(b + iend, 0);
    store8(b + iend + 4, 73);
    store8(b + iend + 5, 69);
    store8(b + iend + 6, 78);
    store8(b + iend + 7, 68);
    _repair_crc(b, iend + 4, 0);

    _png_contract(b, total, "png scanline mutation");
    _rgba8_contract(b, total, "png scanline mutation (_rgba8 wrapper)");
    return 0;
}

fn fuzz_png_idat(seed, nmut): i64 {
    var lo = 0;
    var b = fx_rgba8_2x2(&lo);
    var type_off = 0;
    var clen = 0;
    if (_find_idat(b, lo, &type_off, &clen) == 0) { return 0; }
    if (clen <= 0) { return 0; }
    _fuzz_seed(seed);
    var data_off = type_off + 4;
    var i = 0;
    var off = 0;
    while (i < nmut) {
        off = data_off + (_fuzz_next() % clen);
        store8(b + off, _fuzz_next() & 255);
        i = i + 1;
    }
    _repair_crc(b, type_off, clen);
    _png_contract(b, lo, "png IDAT-stream mutation");
    return 0;
}

# ---- 5. Degenerate lengths -------------------------------------------
# A caller handing over a zero or negative length must be rejected, not
# trusted into a read.
fn fuzz_png_degenerate(): i64 {
    var lo = 0;
    var b = fx_rgba8_2x2(&lo);
    _png_contract(b, 0, "png len 0");
    _png_contract(b, 1, "png len 1");
    _png_contract(b, 0 - 1, "png negative len");
    _png_contract(b, 0 - 1000000, "png large negative len");
    return 0;
}

fn main(): i64 {
    var seed = 1;

    # crc32() has no lazy init — the table must be built before _repair_crc
    # calls it. chitra does this itself inside the decode path, but this
    # harness calls crc32 directly.
    crc32_init_table();

    fuzz_png_selfcheck();
    println("fuzz_png: harness self-check passed (fixture valid, IDAT reachable, CRC repair correct)");

    # 1. random bytes across a spread of lengths
    seed = 1;
    while (seed <= 100000) {
        fuzz_png_random(seed * 2654435761, (seed * 7) % 512);
        seed = seed + 1;
    }
    println("fuzz_png: 100000 random-byte cases survived");

    # 2. signature-prefixed garbage — drives the chunk walk
    seed = 1;
    while (seed <= 150000) {
        fuzz_png_sigprefix(seed * 40503, (seed * 11) % 504);
        seed = seed + 1;
    }
    println("fuzz_png: 150000 signature-prefixed chunk-walk cases survived");

    # 3. bit-flipped valid fixtures, 1..4 mutations each
    seed = 1;
    while (seed <= 250000) {
        fuzz_png_mutate(seed * 97, (seed % 4) + 1);
        seed = seed + 1;
    }
    println("fuzz_png: 250000 mutated-fixture cases survived");

    # 4. every truncation of a valid PNG
    fuzz_png_truncate();
    println("fuzz_png: truncation sweep survived");

    # 5. degenerate lengths
    # 6. hostile bytes BEHIND a repaired CRC — inflate, the five unfilter
    #    predictors, Adam7 and the colour pass
    seed = 1;
    while (seed <= 150000) {
        fuzz_png_idat(seed * 2246822519, (seed % 5) + 1);
        seed = seed + 1;
    }
    println("fuzz_png: 150000 IDAT-stream mutation cases survived");

    # 7. hostile SCANLINES behind a valid deflate stream — the five § 9
    #    predictors, with an attacker-chosen filter byte per row
    seed = 1;
    while (seed <= 60000) {
        fuzz_png_scanlines(seed * 1103515245, (seed % 7) + 1, (seed % 5) + 1);
        seed = seed + 1;
    }
    println("fuzz_png: 60000 scanline-mutation cases survived");

    fuzz_png_degenerate();
    println("fuzz_png: degenerate-length cases survived");

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
