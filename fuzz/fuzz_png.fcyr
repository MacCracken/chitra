# chitra — PNG decode fuzz harness (`cyrius fuzz`).
#
# chitra's threat model is a HOSTILE ENCODED IMAGE: untrusted (src, len)
# bytes reach a public entry point. This harness drives the PNG path with
# adversarial input and asserts the two invariants every decode must hold,
# no matter how malformed the input:
#
#   1. SURVIVAL   — the decoder returns. It must not fault, corrupt memory,
#                   or loop forever on any byte sequence.
#   2. CONTRACT   — the documented result shape holds on every path:
#                   failure => returns 0 AND *err_out is a non-zero ChitraErr;
#                   success => non-zero image, err_out untouched (0), and
#                   width/height/pixels all sane.
#
# Invariant 2 is the one a crash-only fuzzer misses: a decoder that returns
# 0 without setting *err_out hands the caller a stale or zero error, and
# mabda maps ChitraErr straight onto GpuErr.
#
# FIXTURES (1.1.1, gate-3). Through 1.1.0 every mode mutated ONE shape — a 2x2
# RGBA8 non-interlaced PNG — so the Adam7 deinterlace, both palette paths,
# sub-byte gray, gray+alpha, 16-bit and every tRNS key never executed under
# fuzzing, while the mode comments said they did. The harness now carries
# eleven fixtures (fx_rgba8_2x2 + the ten _png_shape builds below); every mode
# that starts from a fixture rotates across all of them, the self-check decodes
# each one, and the scanline mode draws its shape from the same table. Run
# under `cyrius fuzz --poison` (make fuzz / CI), which also catches a silent
# overwrite into the next allocation, not just a crash.
#
# Stack-array pointer note: `var buf[N]` reserves N bytes, but `buf` as an
# rvalue yields the first 8 bytes, not the address — pass `&buf`.

include "src/lib.cyr"
include "lib/assert.cyr"

# ================================================================
# Deterministic PRNG (LCG) — seeded per case so every failure reproduces.
# ================================================================
var _fuzz_state = 0;

fn _fuzz_seed(s): i64 {
    _fuzz_state = s;
    return 0;
}

fn _fuzz_next(): i64 {
    _fuzz_state = _fuzz_state * 6364136223846793005 + 1442695040888963407;
    return (_fuzz_state >> 33) & 255;
}

fn _fuzz_fill(buf, len): i64 {
    var i = 0;
    while (i < len) {
        store8(buf + i, _fuzz_next());
        i = i + 1;
    }
    return 0;
}

fn fx_rgba8_2x2(len_out): i64 {
    var b = alloc(77);
    store64(len_out, 77);
    store8(b + 0, 137);
    store8(b + 1, 80);
    store8(b + 2, 78);
    store8(b + 3, 71);
    store8(b + 4, 13);
    store8(b + 5, 10);
    store8(b + 6, 26);
    store8(b + 7, 10);
    store8(b + 8, 0);
    store8(b + 9, 0);
    store8(b + 10, 0);
    store8(b + 11, 13);
    store8(b + 12, 73);
    store8(b + 13, 72);
    store8(b + 14, 68);
    store8(b + 15, 82);
    store8(b + 16, 0);
    store8(b + 17, 0);
    store8(b + 18, 0);
    store8(b + 19, 2);
    store8(b + 20, 0);
    store8(b + 21, 0);
    store8(b + 22, 0);
    store8(b + 23, 2);
    store8(b + 24, 8);
    store8(b + 25, 6);
    store8(b + 26, 0);
    store8(b + 27, 0);
    store8(b + 28, 0);
    store8(b + 29, 114);
    store8(b + 30, 182);
    store8(b + 31, 13);
    store8(b + 32, 36);
    store8(b + 33, 0);
    store8(b + 34, 0);
    store8(b + 35, 0);
    store8(b + 36, 20);
    store8(b + 37, 73);
    store8(b + 38, 68);
    store8(b + 39, 65);
    store8(b + 40, 84);
    store8(b + 41, 120);
    store8(b + 42, 218);
    store8(b + 43, 99);
    store8(b + 44, 248);
    store8(b + 45, 207);
    store8(b + 46, 192);
    store8(b + 47, 240);
    store8(b + 48, 31);
    store8(b + 49, 12);
    store8(b + 50, 129);
    store8(b + 51, 52);
    store8(b + 52, 16);
    store8(b + 53, 48);
    store8(b + 54, 52);
    store8(b + 55, 0);
    store8(b + 56, 0);
    store8(b + 57, 71);
    store8(b + 58, 75);
    store8(b + 59, 8);
    store8(b + 60, 121);
    store8(b + 61, 195);
    store8(b + 62, 37);
    store8(b + 63, 135);
    store8(b + 64, 235);
    store8(b + 65, 0);
    store8(b + 66, 0);
    store8(b + 67, 0);
    store8(b + 68, 0);
    store8(b + 69, 73);
    store8(b + 70, 69);
    store8(b + 71, 78);
    store8(b + 72, 68);
    store8(b + 73, 174);
    store8(b + 74, 66);
    store8(b + 75, 96);
    store8(b + 76, 130);
    return b;
}

# ================================================================
# The contract gate. Every fuzz case funnels through here: whatever the
# input, the decoder must return, and its result shape must match the
# documented contract exactly.
# ================================================================
fn _png_contract(buf, n, label): i64 {
    var err = 0;
    var img = chitra_png_decode(buf, n, &err);
    if (img == 0) {
        # Failure path: *err_out MUST hold a real ChitraErr.
        assert(err != 0, label);
        if (err != 0) {
            assert(chitra_err_code(err) != CHITRA_OK, label);
            # Every code must have a name of its own. chitra_err_name never
            # returns 0 — an unnamed code gets the fallback — so `!= 0` could not
            # fail (gate-13, 1.1.1); the fallback string is what to compare with.
            assert(streq(chitra_err_name(chitra_err_code(err)), "unknown error") == 0, label);
        }
    }
    if (img != 0) {
        # Success path: err_out stays 0 and the image is coherent.
        assert(err == 0, label);
        assert(chitra_image_width(img) > 0, label);
        assert(chitra_image_height(img) > 0, label);
        assert(chitra_image_pixels(img) != 0, label);
        assert(chitra_image_channels(img) == 4, label);
    }
    return 0;
}

# Same gate for the format-sniffing router (jpeg.cyr:424).
fn _router_contract(buf, n, label): i64 {
    var err = 0;
    var img = chitra_image_decode(buf, n, &err);
    if (img == 0) { assert(err != 0, label); }
    if (img != 0) {
        assert(err == 0, label);
        assert(chitra_image_pixels(img) != 0, label);
        assert(chitra_image_channels(img) == 4, label);
    }
    return 0;
}

# The four public _rgba8 wrappers were entirely unfuzzed through 0.7.2 — they
# are public, about to be frozen, and they write through CALLER-OWNED slots
# before the decode runs. That ordering is the contract worth pinning: on any
# failure both slots must be left 0 rather than holding a stale or partial
# value the caller might act on.
fn _rgba8_contract(buf, n, label): i64 {
    var w = 0 - 1;
    var h = 0 - 1;
    var px = chitra_png_decode_rgba8(buf, n, &w, &h);
    if (px == 0) {
        assert(w == 0, label);
        assert(h == 0, label);
    }
    if (px != 0) {
        assert(w > 0, label);
        assert(h > 0, label);
    }
    return 0;
}

# ---- Harness self-check ----------------------------------------------
# A fuzz harness that silently no-ops is worse than none. fuzz_png was the only
# one of the four without this gate: if fx_rgba8_2x2 ever stopped decoding,
# every mode below would still report hundreds of thousands of cases
# "survived" while exercising nothing past the signature check. 1.1.1: EVERY
# fixture must decode, at the size its shape says, or a fixture that rots would
# silently turn its share of every mode into a rejection test.
fn fuzz_png_selfcheck(): i64 {
    var k = 0;
    var lo = 0;
    var b = 0;
    var err = 0;
    var img = 0;
    var type_off = 0;
    var clen = 0;
    var s = 0;
    while (k < PNG_FIXTURES) {
        lo = 0;
        b = _png_fixture(k, &lo);
        assert(b != 0, "selfcheck: png fixture builds");
        if (b != 0) {
            err = 0;
            img = chitra_png_decode(b, lo, &err);
            assert(img != 0, "selfcheck: png fixture decodes clean");
            assert(err == 0, "selfcheck: png fixture sets no error");
            if (img != 0) {
                s = _png_fixture_shape(k);
                assert(chitra_image_width(img) == _h_field(s, 0), "selfcheck: png fixture width");
                assert(chitra_image_height(img) == _h_field(s, 1), "selfcheck: png fixture height");
                assert(chitra_image_source_depth(img) == _h_field(s, 2), "selfcheck: png fixture depth");
                assert(chitra_image_source_color_type(img) == _h_field(s, 3), "selfcheck: png fixture ct");
                assert(chitra_image_channels(img) == 4, "selfcheck: png fixture is RGBA8");
            }
            # ...and the IDAT locator must actually find one, or the mutation
            # mode below would silently degrade into "return 0" on every case.
            assert(_find_idat(b, lo, &type_off, &clen) == 1, "selfcheck: IDAT located");
            assert(clen > 0, "selfcheck: IDAT payload is non-empty");
            # Repairing the CRC of an UNMUTATED chunk must leave the file
            # decodable — if _repair_crc were wrong, every mutated case would
            # reject at the CRC gate and this whole mode would test nothing.
            _repair_crc(b, type_off, clen);
            err = 0;
            assert(chitra_png_decode(b, lo, &err) != 0, "selfcheck: CRC repair is correct");
        }
        k = k + 1;
    }
    _png_selfcheck_114();
    return 0;
}

# ---- 1. Pure random bytes -------------------------------------------
# Mostly rejected at the signature gate; proves no read happens first.
fn fuzz_png_random(seed, n): i64 {
    _fuzz_seed(seed);
    var buf[512];
    var capped = n;
    if (capped > 512) { capped = 512; }
    if (capped < 0) { capped = 0; }
    _fuzz_fill(&buf, capped);
    _png_contract(&buf, capped, "png random bytes");
    _router_contract(&buf, capped, "router random bytes");
    return 0;
}

# ---- 2. Valid signature + random tail --------------------------------
# The high-value case: past the signature gate, the chunk walk itself is
# fed garbage — hostile lengths, unknown types, bad CRCs, lying IHDRs.
fn fuzz_png_sigprefix(seed, n): i64 {
    _fuzz_seed(seed);
    var buf[512];
    var capped = n;
    if (capped > 504) { capped = 504; }
    if (capped < 0) { capped = 0; }
    store8(&buf + 0, 137);
    store8(&buf + 1, 80);
    store8(&buf + 2, 78);
    store8(&buf + 3, 71);
    store8(&buf + 4, 13);
    store8(&buf + 5, 10);
    store8(&buf + 6, 26);
    store8(&buf + 7, 10);
    _fuzz_fill(&buf + 8, capped);
    _png_contract(&buf, capped + 8, "png sig + random chunks");
    return 0;
}

# ---- 3. Bit-flipped valid fixture ------------------------------------
# Starts from a genuinely valid PNG — each of the eleven fixtures in turn — and
# corrupts `nmut` bytes. Most land on a CRC-covered field, so the CRC gate must
# reject cleanly rather than decode corrupt geometry.
fn fuzz_png_mutate(seed, nmut): i64 {
    _fuzz_seed(seed);
    var lo = 0;
    var b = _png_fixture(seed % PNG_FIXTURES, &lo);
    var m = 0;
    var pos = 0;
    while (m < nmut) {
        pos = (_fuzz_next() * 256 + _fuzz_next()) % lo;
        store8(b + pos, _fuzz_next());
        m = m + 1;
    }
    _png_contract(b, lo, "png mutated fixture");
    _rgba8_contract(b, lo, "png mutated fixture (_rgba8 wrapper)");
    return 0;
}

# ---- 4. Truncation sweep ---------------------------------------------
# Every prefix of every fixture. Each must reject (or decode, for the full
# length) — never read past the buffer.
fn fuzz_png_truncate(): i64 {
    var k = 0;
    var lo = 0;
    var b = 0;
    var cut = 0;
    while (k < PNG_FIXTURES) {
        b = _png_fixture(k, &lo);
        cut = 0;
        while (cut <= lo) {
            _png_contract(b, cut, "png truncated prefix");
            cut = cut + 1;
        }
        k = k + 1;
    }
    return 0;
}

# ---- 6. IDAT-stream mutation (0.7.3) ---------------------------------
# PNG's per-chunk CRC-32 is why this mode has to exist. A random byte flip
# inside IDAT makes the chunk CRC disagree, so `_chitra_png_parse_raw` rejects
# with CHITRA_ERR_CRC before sankoch's inflate ever runs: modes 1-3 drive the
# chunk walk and the signature gate, and stop at the CRC.
#
# So this mode mutates the IDAT payload and then REPAIRS THE CRC, producing a
# structurally valid PNG carrying hostile COMPRESSED data. What it reaches is
# sankoch's inflate and the size checks after it: ~99% of cases fail inflate.
# The unfilter predictors, the deinterlace and the colour pass are mode 7's
# job, which mutates BEFORE compressing. It rotates over every fixture, so the
# streams it corrupts are Adam7, palette, sub-byte and 16-bit ones too.

# Locate the first IDAT chunk. Writes the offset of its 4-byte TYPE field
# (which is what the CRC is computed over, together with the data) and its
# data length. Returns 1 on success, 0 if there is no IDAT.
fn _find_idat(b, n, type_off_out, len_out): i64 {
    store64(type_off_out, 0);
    store64(len_out, 0);
    var pos = 8;                       # past the signature
    var clen = 0;
    var found = 0;
    var scanning = 1;
    while (scanning == 1) {
        if (pos + 8 > n) { scanning = 0; }
        if (scanning == 1) {
            clen = load8(b + pos) * 16777216 + load8(b + pos + 1) * 65536
            + load8(b + pos + 2) * 256 + load8(b + pos + 3);
            if (clen < 0) { scanning = 0; }
        }
        if (scanning == 1) {
            if (pos + 12 + clen > n) { scanning = 0; }
        }
        if (scanning == 1) {
            if (load8(b + pos + 4) == 73) {
                if (load8(b + pos + 5) == 68) {
                    if (load8(b + pos + 6) == 65) {
                        if (load8(b + pos + 7) == 84) {
                            store64(type_off_out, pos + 4);
                            store64(len_out, clen);
                            found = 1;
                            scanning = 0;
                        }
                    }
                }
            }
        }
        if (scanning == 1) { pos = pos + 12 + clen; }
    }
    return found;
}

fn _put_be32(p, v): i64 {
    store8(p + 0, (v >> 24) & 255);
    store8(p + 1, (v >> 16) & 255);
    store8(p + 2, (v >> 8) & 255);
    store8(p + 3, v & 255);
    return 0;
}

# Recompute a chunk's trailing CRC-32 over (type + data), so a mutated payload
# still presents as a well-formed chunk. Without this the decoder never gets
# past the CRC gate and the mutation is wasted.
fn _repair_crc(b, type_off, clen): i64 {
    var c = crc32(b + type_off, 4 + clen);
    var crc_at = type_off + 4 + clen;
    store8(b + crc_at + 0, (c >> 24) & 255);
    store8(b + crc_at + 1, (c >> 16) & 255);
    store8(b + crc_at + 2, (c >> 8) & 255);
    store8(b + crc_at + 3, c & 255);
    return 0;
}

# ---- 7. Scanline-level mutation (0.7.3; every shape 1.1.1) ----------
# Mode 6 repairs the CRC, so hostile bytes reach sankoch — but they are hostile
# COMPRESSED bytes, and ~99% of them fail inflate. Only a sliver survives to the
# part after it: the five § 9 unfilter predictors, the Adam7 deinterlace and
# the colour pass.
#
# So this mode generates the raw scanlines and compresses them, and every case
# inflates cleanly. Through 1.1.0 it built only 8-bit RGBA non-interlaced
# files, so of that list it reached the predictors and nothing else. It now
# takes its depth / colour type / interlace / tRNS from the _png_shape table in
# rotation, with a random size (1..12 x 1..9 — small enough that Adam7's empty
# passes occur) and, for palette shapes, a random PLTE size, so out-of-range
# indices are as live as in-range ones. One row in eight carries an arbitrary
# filter byte, which the § 9 allow-list must reject rather than index on.
# `k` is the case number: the shape is taken from it, not from the seed, so the
# rotation is exact (a seed multiplier sharing a factor with PNG_SHAPES would
# otherwise visit only some shapes — 1103515245 is a multiple of 5).
fn fuzz_png_scanlines(seed, k): i64 {
    _fuzz_seed(seed);
    var shape = _png_shape(k % PNG_SHAPES);
    var w = 1 + (_fuzz_next() % 12);
    var h = 1 + (_fuzz_next() % 9);
    var depth = _h_field(shape, 2);
    var plte_n = 1 + (_fuzz_next() % _h_full_plte(depth));
    var trns = _h_field(shape, 5);
    if ((_fuzz_next() & 3) == 0) { trns = 1 - trns; }
    if (_h_field(shape, 3) == 4) { trns = 0; }       # tRNS is illegal for ct 4/6:
    if (_h_field(shape, 3) == 6) { trns = 0; }       # mode 3 already covers that
    var total = 0;
    var b = _png_build(w, h, depth, _h_field(shape, 3), _h_field(shape, 4), plte_n, trns, 1, &total);
    if (b == 0) { return 0; }
    _png_contract(b, total, "png scanline mutation");
    _rgba8_contract(b, total, "png scanline mutation (_rgba8 wrapper)");
    return 0;
}

fn fuzz_png_idat(seed, nmut): i64 {
    var lo = 0;
    var b = _png_fixture(seed % PNG_FIXTURES, &lo);
    var type_off = 0;
    var clen = 0;
    if (_find_idat(b, lo, &type_off, &clen) == 0) { return 0; }
    if (clen <= 0) { return 0; }
    _fuzz_seed(seed);
    var data_off = type_off + 4;
    var i = 0;
    var off = 0;
    while (i < nmut) {
        off = data_off + (_fuzz_next() % clen);
        store8(b + off, _fuzz_next() & 255);
        i = i + 1;
    }
    _repair_crc(b, type_off, clen);
    _png_contract(b, lo, "png IDAT-stream mutation");
    return 0;
}

# ---- PNG fixture builder (1.1.1, gate-3) ------------------------------
# One 2x2 RGBA8 fixture drove every mode through 1.1.0, so the Adam7
# deinterlace, both palette paths, sub-byte gray, gray+alpha, 16-bit and every
# tRNS key were never executed under fuzzing — while the mode comments said they
# were. This builds a structurally valid PNG for ANY (w, h, depth, colour type,
# interlace, PLTE size, tRNS) from random scanlines, every CRC correct, so each
# shape can be both a fixed fixture and a per-case random target.
#
# The Adam7 pass geometry is computed HERE from the § 8.2 table, not borrowed
# from src/: a harness that sized its streams with the decoder's own helper
# would agree with the decoder by construction.

fn _h_channels(ct): i64 {
    if (ct == 2) { return 3; }
    if (ct == 4) { return 2; }
    if (ct == 6) { return 4; }
    return 1;                              # 0 gray, 3 palette
}

fn _h_row_bytes(pw, ct, depth): i64 {
    return (pw * _h_channels(ct) * depth + 7) / 8;
}

# Adam7 pass p: x0 y0 dx dy, PNG § 8.2.
fn _h_a7(p, k): i64 {
    var x0 = 0;
    var y0 = 0;
    var dx = 8;
    var dy = 8;
    if (p == 1) { x0 = 4; }
    if (p == 2) { y0 = 4; dx = 4; }
    if (p == 3) { x0 = 2; dx = 4; dy = 4; }
    if (p == 4) { y0 = 2; dx = 2; dy = 4; }
    if (p == 5) { x0 = 1; dx = 2; dy = 2; }
    if (p == 6) { y0 = 1; dx = 1; dy = 2; }
    if (k == 0) { return x0; }
    if (k == 1) { return y0; }
    if (k == 2) { return dx; }
    return dy;
}

fn _h_a7_count(dim, start, step): i64 {
    if (dim <= start) { return 0; }
    return (dim - start + step - 1) / step;
}

# Append `rows` scanlines of `rb` data bytes at raw+off: a filter byte, then
# random bytes. With badfilt, 1 row in 8 gets an arbitrary filter byte so the
# § 9 allow-list is exercised too. Returns the new offset.
fn _h_fill_rows(raw, off, rows, rb, badfilt): i64 {
    var y = 0;
    var x = 0;
    while (y < rows) {
        if (badfilt == 1 && (_fuzz_next() & 7) == 0) {
            store8(raw + off, _fuzz_next());
        } else {
            store8(raw + off, _fuzz_next() % 5);
        }
        off = off + 1;
        x = 0;
        while (x < rb) {
            store8(raw + off, _fuzz_next());
            off = off + 1;
            x = x + 1;
        }
        y = y + 1;
    }
    return off;
}

# Write one chunk (length, type, data, CRC) at b+at; returns the offset past it.
fn _h_chunk(b, at, t0, t1, t2, t3, data, dlen): i64 {
    _put_be32(b + at, dlen);
    store8(b + at + 4, t0);
    store8(b + at + 5, t1);
    store8(b + at + 6, t2);
    store8(b + at + 7, t3);
    var i = 0;
    while (i < dlen) {
        store8(b + at + 8 + i, load8(data + i));
        i = i + 1;
    }
    _repair_crc(b, at + 4, dlen);
    return at + 12 + dlen;
}

# plte_n: PLTE entries for colour type 3 (ignored otherwise). trns: 1 = emit a
# tRNS of the right shape for the colour type (gray/RGB key at full sample
# width, or a per-entry alpha array no longer than PLTE). The caller seeds the
# PRNG; everything random here comes from it.
fn _png_build(w, h, depth, ct, ilace, plte_n, trns, badfilt, len_out): i64 {
    store64(len_out, 0);
    var raw_len = 0;
    var p = 0;
    var pw = 0;
    var ph = 0;
    if (ilace == 1) {
        while (p < 7) {
            pw = _h_a7_count(w, _h_a7(p, 0), _h_a7(p, 2));
            ph = _h_a7_count(h, _h_a7(p, 1), _h_a7(p, 3));
            if (pw > 0 && ph > 0) { raw_len = raw_len + ph * (1 + _h_row_bytes(pw, ct, depth)); }
            p = p + 1;
        }
    } else {
        raw_len = h * (1 + _h_row_bytes(w, ct, depth));
    }
    var raw = alloc(raw_len + 1);
    if (raw == 0) { return 0; }
    var off = 0;
    if (ilace == 1) {
        p = 0;
        while (p < 7) {
            pw = _h_a7_count(w, _h_a7(p, 0), _h_a7(p, 2));
            ph = _h_a7_count(h, _h_a7(p, 1), _h_a7(p, 3));
            if (pw > 0 && ph > 0) { off = _h_fill_rows(raw, off, ph, _h_row_bytes(pw, ct, depth), badfilt); }
            p = p + 1;
        }
    } else {
        off = _h_fill_rows(raw, 0, h, _h_row_bytes(w, ct, depth), badfilt);
    }
    var zcap = raw_len * 2 + 128;
    var z = alloc(zcap);
    if (z == 0) { return 0; }
    var zlen = zlib_compress(raw, raw_len, z, zcap);
    if (zlen <= 0) { return 0; }

    var ihdr[16];
    _put_be32(&ihdr, w);
    _put_be32(&ihdr + 4, h);
    store8(&ihdr + 8, depth);
    store8(&ihdr + 9, ct);
    store8(&ihdr + 10, 0);
    store8(&ihdr + 11, 0);
    store8(&ihdr + 12, ilace);

    var plte_len = 0;
    if (ct == 3) { plte_len = plte_n * 3; }
    var trns_len = 0;
    if (trns == 1) {
        if (ct == 0) { trns_len = 2; }
        if (ct == 2) { trns_len = 6; }
        if (ct == 3) { trns_len = 1 + (_fuzz_next() % plte_n); }
    }
    var aux = alloc(plte_len + trns_len + 8);
    if (aux == 0) { return 0; }
    _fuzz_fill(aux, plte_len + trns_len);
    if (trns_len == 2 && depth < 16) {
        # A gray key has to be a value the samples can take (§ 11.3.2.1).
        store8(aux + plte_len, 0);
        store8(aux + plte_len + 1, _fuzz_next() & ((1 << depth) - 1));
    }
    if (trns_len == 6 && depth < 16) {
        store8(aux + plte_len, 0);
        store8(aux + plte_len + 2, 0);
        store8(aux + plte_len + 4, 0);
    }

    var total = 8 + 25 + 12 + zlen + 12;
    if (plte_len > 0) { total = total + 12 + plte_len; }
    if (trns_len > 0) { total = total + 12 + trns_len; }
    var b = alloc(total);
    if (b == 0) { return 0; }
    store8(b + 0, 137);
    store8(b + 1, 80);
    store8(b + 2, 78);
    store8(b + 3, 71);
    store8(b + 4, 13);
    store8(b + 5, 10);
    store8(b + 6, 26);
    store8(b + 7, 10);
    var at = _h_chunk(b, 8, 73, 72, 68, 82, &ihdr, 13);                       # IHDR
    if (plte_len > 0) { at = _h_chunk(b, at, 80, 76, 84, 69, aux, plte_len); }  # PLTE
    if (trns_len > 0) { at = _h_chunk(b, at, 116, 82, 78, 83, aux + plte_len, trns_len); }  # tRNS
    at = _h_chunk(b, at, 73, 68, 65, 84, z, zlen);                             # IDAT
    at = _h_chunk(b, at, 73, 69, 78, 68, z, 0);                                # IEND
    store64(len_out, at);
    return b;
}

# The fixed shapes. Each names a decode path that NO mode reached before 1.1.1
# (the probe it trips is in brackets — tools/run_probes.py in the 1.1.1 sweep):
#   0  9x7   d8  ct2 Adam7          [PR-adam7]  deinterlace + RGB
#   1  7x5   d8  ct3      + tRNS    [PR-pal8b]  8-bit palette, per-entry alpha
#   2  9x5   d2  ct3      + tRNS    [PR-subpal] sub-byte palette
#   3  11x3  d4  ct0      + tRNS    [PR-subgray] sub-byte gray + key
#   4  5x4   d8  ct4                [PR-ga]     gray + alpha
#   5  4x3   d16 ct2      + tRNS    [PR-rgb16]  16-bit RGB + 16-bit key
#   6  6x4   d8  ct0      + tRNS    [PR-graykey] 8-bit gray key
#   7  10x9  d1  ct0 Adam7          Adam7 at a sub-byte depth
#   8  5x6   d16 ct6 Adam7          Adam7 at 16 bits, RGBA
#   9  3x5   d8  ct6                the original RGBA8 shape
enum PngFuzzShapes {
    PNG_SHAPES = 10;      # _png_shape(0..9)
    PNG_FIXTURES = 11;    # fx_rgba8_2x2 + the ten shapes
}

fn _h_pack(w, h, depth, ct, ilace, trns): i64 {
    return w + (h << 8) + (depth << 16) + (ct << 24) + (ilace << 32) + (trns << 40);
}

# Field f of a packed shape: 0 w, 1 h, 2 depth, 3 colour type, 4 interlace, 5 tRNS.
fn _h_field(shape, f): i64 {
    return (shape >> (f * 8)) & 255;
}

fn _png_shape(k): i64 {
    if (k == 0) { return _h_pack(9, 7, 8, 2, 1, 0); }
    if (k == 1) { return _h_pack(7, 5, 8, 3, 0, 1); }
    if (k == 2) { return _h_pack(9, 5, 2, 3, 0, 1); }
    if (k == 3) { return _h_pack(11, 3, 4, 0, 0, 1); }
    if (k == 4) { return _h_pack(5, 4, 8, 4, 0, 0); }
    if (k == 5) { return _h_pack(4, 3, 16, 2, 0, 1); }
    if (k == 6) { return _h_pack(6, 4, 8, 0, 0, 1); }
    if (k == 7) { return _h_pack(10, 9, 1, 0, 1, 0); }
    if (k == 8) { return _h_pack(5, 6, 16, 6, 1, 0); }
    return _h_pack(3, 5, 8, 6, 0, 0);
}

# A full palette for the depth, so every index a random scanline can hold is
# in range and the fixture decodes.
fn _h_full_plte(depth): i64 {
    if (depth >= 8) { return 256; }
    return 1 << depth;
}

var _png_fx_cache[80];
var _png_fx_len[80];

# Fixed fixture k (0..PNG_SHAPES-1): built once from a fixed seed, then a fresh
# COPY per call, because every mode mutates its copy in place.
fn fx_png_shape(k, len_out): i64 {
    var slot = &_png_fx_cache + k * 8;
    if (load64(slot) == 0) {
        var s = _png_shape(k);
        var saved = _fuzz_state;
        _fuzz_seed(7919 * (k + 1));
        var n = 0;
        var b = _png_build(_h_field(s, 0), _h_field(s, 1), _h_field(s, 2), _h_field(s, 3),
          _h_field(s, 4), _h_full_plte(_h_field(s, 2)), _h_field(s, 5), 0, &n);
        _fuzz_state = saved;
        if (b == 0) { return 0; }
        store64(slot, b);
        store64(&_png_fx_len + k * 8, n);
    }
    var len = load64(&_png_fx_len + k * 8);
    store64(len_out, len);
    var c = alloc(len);
    var i = 0;
    while (i < len) {
        store8(c + i, load8(load64(slot) + i));
        i = i + 1;
    }
    return c;
}

# Fixture k of PNG_FIXTURES: 0 is the original hand-built 2x2 RGBA8 file, and
# 1..PNG_SHAPES are the _png_shape builds.

fn _png_fixture(k, len_out): i64 {
    if (k == 0) { return fx_rgba8_2x2(len_out); }
    return fx_png_shape(k - 1, len_out);
}

fn _png_fixture_shape(k): i64 {
    if (k == 0) { return _h_pack(2, 2, 8, 6, 0, 0); }
    return _png_shape(k - 1);
}

# ---- 8. decode_budget (1.1.1, cc-11) ----------------------------------
# chitra_image_decode_budget is frozen, and it reads the attacker's bytes
# TWICE: its own header walker (_chitra_declared_rgba_bytes) decides whether to
# refuse, then the router decodes. No harness called it through 1.1.0. Its one
# promise is that no image it returns exceeds max_bytes of RGBA8; its failure
# shape is the same (0, *err_out set) as every other entry point. A budget of
# exactly the output must decode — a refusal there is the walker disagreeing
# with the decoder — and one byte under it must refuse as CHITRA_ERR_BUDGET.
fn _budget_one(buf, n, max, code_out, label): i64 {
    var err = 0;
    store64(code_out, 0);
    var img = chitra_image_decode_budget(buf, n, max, &err);
    if (img == 0) {
        assert(err != 0, label);
        if (err != 0) {
            store64(code_out, chitra_err_code(err));
            assert(chitra_err_code(err) != CHITRA_OK, label);
        }
    }
    if (img != 0) {
        assert(err == 0, label);
        assert(chitra_image_width(img) * chitra_image_height(img) * 4 <= max, label);
    }
    return img;
}

fn _budget_contract(buf, n, label): i64 {
    var err = 0;
    var code = 0;
    var ref = chitra_image_decode(buf, n, &err);
    if (ref != 0) {
        var out = chitra_image_width(ref) * chitra_image_height(ref) * 4;
        assert(_budget_one(buf, n, out - 1, &code, label) == 0, label);
        assert(code == CHITRA_ERR_BUDGET, label);
        assert(_budget_one(buf, n, out, &code, label) != 0, label);
    }
    if (ref == 0) {
        # An input that does not decode: an arbitrary budget, 0 to ~16 MB on a
        # log scale, must still refuse with *err_out set. (At most two decodes a
        # case — every one is heap the bump allocator never gives back.)
        var r = (_fuzz_next() << 16) | (_fuzz_next() << 8) | _fuzz_next();
        _budget_one(buf, n, r >> (_fuzz_next() % 24), &code, label);
    }
    return 0;
}

# Untouched, IHDR-mutated behind a repaired CRC (which moves the size the walker
# reads), or flipped anywhere — over every fixture.
fn fuzz_png_budget(seed): i64 {
    _fuzz_seed(seed);
    var lo = 0;
    var b = _png_fixture(seed % PNG_FIXTURES, &lo);
    var kind = (seed / PNG_FIXTURES) % 3;
    var m = 0;
    if (kind == 1) {
        m = 1 + (_fuzz_next() & 1);
        while (m > 0) {
            store8(b + 16 + (_fuzz_next() % 13), _fuzz_next());
            m = m - 1;
        }
        _repair_crc(b, 12, 13);
    }
    if (kind == 2) {
        store8(b + ((_fuzz_next() * 256 + _fuzz_next()) % lo), _fuzz_next());
    }
    _budget_contract(b, lo, "png decode_budget");
    return 0;
}

# ---- 9. Chunk-type rewrite / insert (1.1.4) ----------------------------
# § 5.4: bit 5 of a chunk type's first byte is the ANCILLARY bit. An unknown
# critical chunk (bit clear) changes how the image is to be read, so chitra
# must abort with CHITRA_ERR_UNSUPPORTED; an unknown ancillary one is skipped.
# Through 1.1.3 no harness reached the abort at all: a random flip in a type
# byte fails the chunk CRC first, and nothing repaired it. This mode rewrites a
# chunk's TYPE (or inserts a whole new chunk) and repairs the CRC, alternating
# critical and ancillary — the ancillary half is the control that keeps the
# "unknown ancillary is skipped" side of § 5.4 exercised too.

# The start offset (the length field) of each well-formed chunk, up to `max`.
# Returns how many there are.
fn _png_chunk_offsets(b, n, offs, max): i64 {
    var pos = 8;
    var cnt = 0;
    var clen = 0;
    var going = 1;
    while (going == 1) {
        if (pos + 12 > n) { going = 0; }
        if (going == 1) {
            clen = load8(b + pos) * 16777216 + load8(b + pos + 1) * 65536
            + load8(b + pos + 2) * 256 + load8(b + pos + 3);
            if (pos + 12 + clen > n) { going = 0; }
        }
        if (going == 1) {
            if (cnt < max) { store64(offs + cnt * 8, pos); }
            cnt = cnt + 1;
            pos = pos + 12 + clen;
        }
    }
    if (cnt > max) { cnt = max; }
    return cnt;
}

fn _png_be32(p): i64 {
    return load8(p) * 16777216 + load8(p + 1) * 65536 + load8(p + 2) * 256 + load8(p + 3);
}

# Four type bytes at dst. Half the time a fresh random name; otherwise the
# chunk's own type `orig` with case bits flipped — "iDAT", "IDaT", "IENd": the
# spoof that names a known chunk without being it. One case in eight takes a
# non-letter byte as well. Then byte 0's bit 5 is FORCED: critical = 1 clears
# it (§ 5.4), critical = 0 sets it.
fn _h_rand_type(dst, orig, critical): i64 {
    var t[8];
    var i = 0;
    var spoof = _fuzz_next() & 1;
    while (i < 4) {
        if (spoof == 1) {
            store8(&t + i, load8(orig + i));
            if ((_fuzz_next() & 3) == 0) { store8(&t + i, load8(&t + i) ^ 0x20); }
        } else {
            store8(&t + i, 65 + (_fuzz_next() % 26) + (_fuzz_next() & 0x20));
        }
        i = i + 1;
    }
    if ((_fuzz_next() & 7) == 0) { store8(&t + 1 + (_fuzz_next() % 3), _fuzz_next()); }
    if (critical == 1) {
        store8(&t, load8(&t) & 0xDF);
    } else {
        store8(&t, load8(&t) | 0x20);
    }
    i = 0;
    while (i < 4) {
        store8(dst + i, load8(&t + i));
        i = i + 1;
    }
    return 0;
}

# A copy of b with a new chunk (type t0..t3, dlen random data bytes, CRC
# repaired) inserted at offset `at`, which must be a chunk boundary.
fn _png_insert_chunk(b, n, at, t0, t1, t2, t3, dlen, len_out): i64 {
    var nb = alloc(n + 12 + dlen);
    if (nb == 0) { return 0; }
    var i = 0;
    while (i < at) {
        store8(nb + i, load8(b + i));
        i = i + 1;
    }
    _put_be32(nb + at, dlen);
    store8(nb + at + 4, t0);
    store8(nb + at + 5, t1);
    store8(nb + at + 6, t2);
    store8(nb + at + 7, t3);
    _fuzz_fill(nb + at + 8, dlen);
    _repair_crc(nb, at + 4, dlen);
    i = at;
    while (i < n) {
        store8(nb + i + 12 + dlen, load8(b + i));
        i = i + 1;
    }
    store64(len_out, n + 12 + dlen);
    return nb;
}

# `k` is the case number. It picks the fixture (all eleven), critical or
# ancillary (alternating), and rewrite or insert. The chunk picked is never
# IHDR — a non-IHDR first chunk is a different refusal (BAD_CHUNK), mode 3's.
fn fuzz_png_chunktype(seed, k): i64 {
    _fuzz_seed(seed);
    var lo = 0;
    var b = _png_fixture(k % PNG_FIXTURES, &lo);
    var offs[128];
    var cnt = _png_chunk_offsets(b, lo, &offs, 16);
    if (cnt < 2) { return 0; }
    var critical = (k / PNG_FIXTURES) & 1;
    var at = load64(&offs + (1 + (_fuzz_next() % (cnt - 1))) * 8);
    if (((k / (PNG_FIXTURES * 2)) & 1) == 0) {
        _h_rand_type(b + at + 4, b + at + 4, critical);
        _repair_crc(b, at + 4, _png_be32(b + at));
        _png_contract(b, lo, "png chunk-type rewrite");
        _router_contract(b, lo, "png chunk-type rewrite (router)");
        return 0;
    }
    var t[8];
    _h_rand_type(&t, b + at + 4, critical);
    var nl = 0;
    var nb = _png_insert_chunk(b, lo, at, load8(&t), load8(&t + 1), load8(&t + 2), load8(&t + 3),
      _fuzz_next() % 17, &nl);
    if (nb == 0) { return 0; }
    _png_contract(nb, nl, "png chunk insert");
    _router_contract(nb, nl, "png chunk insert (router)");
    return 0;
}

# ---- 10. IHDR geometry across the size gates (1.1.4) -------------------
# After the chunk walk, chitra decides three things from IHDR alone, in order:
#   bomb    inflated / IDAT bytes > CHITRA_MAX_INFLATE_RATIO -> DIMENSIONS
#   limit   inflated > sankoch's DECOMPRESS_MAX_OUTPUT (16 MiB)
#           -> CHITRA_ERR_INFLATE_LIMIT (a VALID file this build cannot emit)
#   else    allocate, inflate, and compare: a lying IHDR is a size MISMATCH.
# Through 1.1.3 no harness reached `limit`: it needs > 16 MiB of declared
# output AND an IDAT big enough (>= 15.3 KB) not to be a bomb first, and every
# fixture was a few hundred bytes. This mode writes IHDR geometry against two
# real zlib payloads — a 16.4 KB one (16 KiB of random bytes, incompressible)
# and a ~40-byte one (16 KiB of zeros) — and aims h at the boundaries between
# the three outcomes, so all three occur, from either side. The refusals are
# made from the header, so the big geometries cost nothing; the mismatch side
# is the only one that allocates, and only rarely at a large size.

var _png_geo_big = 0;
var _png_geo_big_len = 0;
var _png_geo_small = 0;
var _png_geo_small_len = 0;

# zlib(16 KiB) — random bytes when big == 1, zeros otherwise. Built once per
# heap epoch with the PRNG state saved, so it never perturbs a case's stream.
fn _png_geo_payload(big, len_out): i64 {
    var raw = 0;
    var z = 0;
    var zl = 0;
    var saved = _fuzz_state;
    if (big == 1) {
        if (_png_geo_big == 0) {
            raw = alloc(16384);
            _fuzz_seed(424242);
            _fuzz_fill(raw, 16384);
            z = alloc(16384 * 2 + 128);
            zl = zlib_compress(raw, 16384, z, 16384 * 2 + 128);
            if (zl > 0) {
                _png_geo_big = z;
                _png_geo_big_len = zl;
            }
        }
        _fuzz_state = saved;
        store64(len_out, _png_geo_big_len);
        return _png_geo_big;
    }
    if (_png_geo_small == 0) {
        raw = alloc(16384);
        z = alloc(16384 * 2 + 128);
        zl = zlib_compress(raw, 16384, z, 16384 * 2 + 128);
        if (zl > 0) {
            _png_geo_small = z;
            _png_geo_small_len = zl;
        }
    }
    _fuzz_state = saved;
    store64(len_out, _png_geo_small_len);
    return _png_geo_small;
}

# The inflated size an IHDR implies: one filter byte per scanline, summed over
# the seven Adam7 passes when interlaced. Computed from the § 8.2 table here,
# independently of the decoder's own helper.
fn _h_inflated(w, h, ct, depth, ilace): i64 {
    if (ilace == 0) { return h * (1 + _h_row_bytes(w, ct, depth)); }
    var total = 0;
    var p = 0;
    var pw = 0;
    var ph = 0;
    while (p < 7) {
        pw = _h_a7_count(w, _h_a7(p, 0), _h_a7(p, 2));
        ph = _h_a7_count(h, _h_a7(p, 1), _h_a7(p, 3));
        if (pw > 0 && ph > 0) { total = total + ph * (1 + _h_row_bytes(pw, ct, depth)); }
        p = p + 1;
    }
    return total;
}

# Smallest h in 1..65535 whose inflated size exceeds `target`, or 65536 if
# none does (inflated size never decreases as h grows).
fn _h_first_h_above(w, ct, depth, ilace, target): i64 {
    var lo = 1;
    var hi = 65536;
    var mid = 0;
    while (lo < hi) {
        mid = (lo + hi) / 2;
        if (_h_inflated(w, mid, ct, depth, ilace) > target) {
            hi = mid;
        } else {
            lo = mid + 1;
        }
    }
    return lo;
}

# Signature + IHDR(w, h, depth, ct, ilace) + [PLTE, 256 entries, for ct 3] +
# IDAT(payload) + IEND, every CRC correct.
fn _png_geo_build(w, h, depth, ct, ilace, big, len_out): i64 {
    store64(len_out, 0);
    var pl = 0;
    var payload = _png_geo_payload(big, &pl);
    if (payload == 0) { return 0; }
    var plte = 0;
    if (ct == 3) { plte = 768; }
    var total = 8 + 25 + 12 + pl + 12;
    if (plte > 0) { total = total + 12 + plte; }
    var b = alloc(total);
    if (b == 0) { return 0; }
    store8(b + 0, 137);
    store8(b + 1, 80);
    store8(b + 2, 78);
    store8(b + 3, 71);
    store8(b + 4, 13);
    store8(b + 5, 10);
    store8(b + 6, 26);
    store8(b + 7, 10);
    var ihdr[16];
    _put_be32(&ihdr, w);
    _put_be32(&ihdr + 4, h);
    store8(&ihdr + 8, depth);
    store8(&ihdr + 9, ct);
    store8(&ihdr + 10, 0);
    store8(&ihdr + 11, 0);
    store8(&ihdr + 12, ilace);
    var at = _h_chunk(b, 8, 73, 72, 68, 82, &ihdr, 13);
    if (plte > 0) {
        var pal = alloc(plte);
        if (pal == 0) { return 0; }
        at = _h_chunk(b, at, 80, 76, 84, 69, pal, plte);
    }
    at = _h_chunk(b, at, 73, 68, 65, 84, payload, pl);
    at = _h_chunk(b, at, 73, 69, 78, 68, payload, 0);
    store64(len_out, at);
    return b;
}

# Every spec-legal (colour type, depth) cell, § 11.2.2 Table 11.1.
fn _h_cell(c, f): i64 {
    var ct = 0;
    var d = 8;
    if (c == 0) { d = 1; }
    if (c == 1) { d = 2; }
    if (c == 2) { d = 4; }
    if (c == 4) { d = 16; }
    if (c == 5) { ct = 2; }
    if (c == 6) { ct = 2; d = 16; }
    if (c == 7) { ct = 3; d = 1; }
    if (c == 8) { ct = 3; d = 2; }
    if (c == 9) { ct = 3; d = 4; }
    if (c == 10) { ct = 3; }
    if (c == 11) { ct = 4; }
    if (c == 12) { ct = 4; d = 16; }
    if (c == 13) { ct = 6; }
    if (c == 14) { ct = 6; d = 16; }
    if (f == 0) { return ct; }
    return d;
}

# `k` is the case number: it picks the cell (15), interlace, and which boundary
# to aim at. LIMIT is the window 16 MiB < inflated <= 1100 * IDAT bytes.
fn fuzz_png_geometry(seed, k): i64 {
    _fuzz_seed(seed);
    var ct = _h_cell(k % 15, 0);
    var depth = _h_cell(k % 15, 1);
    var ilace = (k / 15) & 1;
    var kind = (k / 30) % 8;
    var big = 1;
    if (kind >= 4) { big = 0; }
    if (kind == 7) { big = 1; }
    var pl = 0;
    _png_geo_payload(big, &pl);
    # Kinds 0-3 and 7 aim at the 16 MiB line, so w >= 2048: a row of >= 256
    # bytes guarantees some h <= 65535 crosses it, and the window between it and
    # the bomb line (~1.28 MB of inflated size) is wider than any row, so those
    # kinds never fall into the allocating MISMATCH side by accident.
    var w = 1 + (_fuzz_next() * 256 + _fuzz_next()) % 8192;
    if (big == 1) { w = 2048 + (_fuzz_next() * 256 + _fuzz_next()) % 6144; }
    var h = 1;
    var lim = DECOMPRESS_MAX_OUTPUT;
    var bomb = (CHITRA_MAX_INFLATE_RATIO + 1) * pl - 1;        # inflated / pl > ratio above this
    var h_lim = _h_first_h_above(w, ct, depth, ilace, lim);     # first LIMIT h
    var h_bomb = _h_first_h_above(w, ct, depth, ilace, bomb);   # first BOMB h
    if (kind <= 2) {
        # inside the LIMIT window (when it is not empty for this w)
        h = h_lim;
        if (h_bomb > h_lim) { h = h_lim + (_fuzz_next() * 256 + _fuzz_next()) % (h_bomb - h_lim); }
    }
    if (kind == 3) { h = h_bomb - (_fuzz_next() & 1); }        # LIMIT | BOMB edge
    if (kind == 4) { h = h_bomb - 1 + (_fuzz_next() % 3); }    # small payload: MISMATCH | BOMB edge
    if (kind == 5) { h = 1 + (_fuzz_next() % 64); }            # small, under-declared: MISMATCH
    if (kind == 6) {                                            # anywhere — incl. the pixel caps
        w = 1 + (_fuzz_next() * 256 + _fuzz_next());
        h = 1 + (_fuzz_next() * 256 + _fuzz_next());
    }
    if (kind == 7) {
        # The 16 MiB edge from BELOW is the one geometry here that allocates
        # (up to 16 MiB, then inflates 16 KiB into it): one case in 960, so a
        # heap epoch never holds more than two of them.
        h = h_lim;
        if ((k % 960) == 210) { h = h_lim - 1; }
    }
    if (h < 1) { h = 1; }
    if (h > 65535) { h = 65535; }
    var n = 0;
    var b = _png_geo_build(w, h, depth, ct, ilace, big, &n);
    if (b == 0) { return 0; }
    _png_contract(b, n, "png IHDR geometry");
    _router_contract(b, n, "png IHDR geometry (router)");
    return 0;
}

# The self-check for modes 9 and 10: each path must be REACHED, with the code
# that names it, or the mode would be fuzzing something else.
fn _png_selfcheck_114(): i64 {
    var lo = 0;
    var b = fx_rgba8_2x2(&lo);
    var nl = 0;
    var err = 0;
    # 9: an unknown CRITICAL chunk after IHDR aborts; the same name with the
    # ancillary bit set is skipped and the file decodes.
    var nb = _png_insert_chunk(b, lo, 33, 90, 90, 90, 90, 4, &nl);
    assert(chitra_png_decode(nb, nl, &err) == 0, "selfcheck: unknown critical chunk aborts");
    if (err != 0) {
        assert(chitra_err_code(err) == CHITRA_ERR_UNSUPPORTED, "selfcheck: ... as UNSUPPORTED");
    }
    nb = _png_insert_chunk(b, lo, 33, 122, 90, 90, 90, 4, &nl);
    err = 0;
    assert(chitra_png_decode(nb, nl, &err) != 0, "selfcheck: unknown ancillary chunk is skipped");
    # 10: 4096 x 4096 gray8 declares 16,781,312 inflated bytes — 4,096 over
    # 16 MiB. Against the 16 KB payload that is ~1023:1, under the ratio cap:
    # INFLATE_LIMIT. Against the ~40-byte payload it is a bomb: DIMENSIONS.
    var pl = 0;
    _png_geo_payload(1, &pl);
    assert(_h_inflated(4096, 4096, 0, 8, 0) > DECOMPRESS_MAX_OUTPUT, "selfcheck: geometry is over 16 MiB");
    assert(_h_inflated(4096, 4096, 0, 8, 0) / pl <= CHITRA_MAX_INFLATE_RATIO, "selfcheck: ...not a bomb");
    var n = 0;
    var g = _png_geo_build(4096, 4096, 8, 0, 0, 1, &n);
    err = 0;
    assert(chitra_png_decode(g, n, &err) == 0, "selfcheck: over-16-MiB PNG is refused");
    if (err != 0) {
        assert(chitra_err_code(err) == CHITRA_ERR_INFLATE_LIMIT, "selfcheck: ... as INFLATE_LIMIT");
    }
    g = _png_geo_build(4096, 4096, 8, 0, 0, 0, &n);
    err = 0;
    assert(chitra_png_decode(g, n, &err) == 0, "selfcheck: the same geometry on a tiny IDAT");
    if (err != 0) {
        assert(chitra_err_code(err) == CHITRA_ERR_DIMENSIONS, "selfcheck: ... is a bomb (DIMENSIONS)");
    }
    # ...and an IHDR that under-declares the stream reaches the inflate and
    # fails the size comparison (16 KiB inflate vs 129 x 128 = 16,512 declared).
    g = _png_geo_build(127, 129, 8, 0, 0, 1, &n);
    err = 0;
    assert(chitra_png_decode(g, n, &err) == 0, "selfcheck: a lying IHDR is refused");
    if (err != 0) {
        assert(chitra_err_code(err) == CHITRA_ERR_INFLATE, "selfcheck: ... at the inflate (size mismatch)");
    }
    # The zeros payload at a matching geometry (128 rows of 1 + 127) decodes.
    g = _png_geo_build(127, 128, 8, 0, 0, 0, &n);
    err = 0;
    assert(chitra_png_decode(g, n, &err) != 0, "selfcheck: a truthful IHDR on the zeros payload decodes");
    return 0;
}

# ---- 5. Degenerate lengths -------------------------------------------
# A caller handing over a zero or negative length must be rejected, not
# trusted into a read.
fn fuzz_png_degenerate(): i64 {
    var lo = 0;
    var b = fx_rgba8_2x2(&lo);
    _png_contract(b, 0, "png len 0");
    _png_contract(b, 1, "png len 1");
    _png_contract(b, 0 - 1, "png negative len");
    _png_contract(b, 0 - 1000000, "png large negative len");
    return 0;
}

# ---- Heap epochs (1.1.1) ----------------------------------------------
# cyrius's bump allocator never frees, so every case's decode used to stay on
# the heap until exit: before this, fuzz_jpeg peaked at ~16 GB RSS and fuzz_gif
# at ~9 GB, against a 16 GB CI runner. main() now calls _fuzz_epoch(case) after
# every case and _fuzz_reclaim() after every mode; every FUZZ_EPOCH cases that
#   1. under --poison, SWEEPS every live block first. alloc_reset() makes the
#      poison layer forget its blocks, so without this an overwrite made since
#      the last periodic sweep would never be checked — the gate-2 class;
#   2. alloc_reset()s the heap back to its first 256 MB chunk (an epoch must
#      fit in it: a spill maps a new chunk that a reset abandons, still
#      resident — which is why the epoch is a case count, kept small);
#   3. drops every heap pointer this harness memoizes, so nothing survives the
#      reset as a dangling pointer. The caches below rebuild lazily.
# Call it only BETWEEN cases: nothing a case allocated may be live after it.
# chitra itself memoizes nothing on the heap (its tables are BSS); the stdlib
# assert counters are plain globals.
enum FuzzEpoch {
    FUZZ_EPOCH = 1024;
}

fn _fuzz_reclaim(): i64 {
    #ifdef CYRIUS_POISON
    var pz = poison_sweep();
    if (pz > 0) { assert_eq(pz, 0, "poison_sweep() before alloc_reset: changed redzones"); }
    #endif
    alloc_reset();
    # sankoch memoizes its CRC table on the heap and detects a reset with an arena
    # canary — exactly what tests/tcyr/alloc_reset.tcyr pins, which is why
    # resetting between PNG decodes is safe. But crc32() itself does not check
    # the canary ("call crc32_init_table() first"), and _repair_crc calls it
    # directly, so re-arm here: crc32_init_table() sees the canary gone, drops
    # sankoch's memoized pointers and rebuilds the table.
    crc32_init_table();
    var k = 0;
    while (k < PNG_SHAPES) {
        store64(&_png_fx_cache + k * 8, 0);
        store64(&_png_fx_len + k * 8, 0);
        k = k + 1;
    }
    _png_geo_big = 0;
    _png_geo_big_len = 0;
    _png_geo_small = 0;
    _png_geo_small_len = 0;
    return 0;
}

fn _fuzz_epoch(n): i64 {
    if ((n % FUZZ_EPOCH) == 0) { _fuzz_reclaim(); }
    return 0;
}

fn main(): i64 {
    var seed = 1;

    # crc32() has no lazy init — the table must be built before _repair_crc
    # calls it. chitra does this itself inside the decode path, but this
    # harness calls crc32 directly.
    crc32_init_table();

    fuzz_png_selfcheck();
    _fuzz_reclaim();
    println("fuzz_png: harness self-check passed (11 fixtures, CRC repair, § 5.4 abort, INFLATE_LIMIT)");

    # 1. random bytes across a spread of lengths
    seed = 1;
    while (seed <= 100000) {
        fuzz_png_random(seed * 2654435761, (seed * 7) % 512);
        _fuzz_epoch(seed);
        seed = seed + 1;
    }
    _fuzz_reclaim();
    println("fuzz_png: 100000 random-byte cases survived");

    # 2. signature-prefixed garbage — drives the chunk walk
    seed = 1;
    while (seed <= 150000) {
        fuzz_png_sigprefix(seed * 40503, (seed * 11) % 504);
        _fuzz_epoch(seed);
        seed = seed + 1;
    }
    _fuzz_reclaim();
    println("fuzz_png: 150000 signature-prefixed chunk-walk cases survived");

    # 3. bit-flipped valid fixtures (all eleven), 1..4 mutations each
    seed = 1;
    while (seed <= 250000) {
        fuzz_png_mutate(seed * 97, (seed % 4) + 1);
        _fuzz_epoch(seed);
        seed = seed + 1;
    }
    _fuzz_reclaim();
    println("fuzz_png: 250000 mutated-fixture cases survived");

    # 4. every truncation of every fixture
    fuzz_png_truncate();
    _fuzz_reclaim();
    println("fuzz_png: truncation sweep survived");

    # 6. hostile COMPRESSED bytes behind a repaired CRC, every fixture —
    #    inflate and the size checks after it
    seed = 1;
    while (seed <= 150000) {
        fuzz_png_idat(seed * 2246822519, (seed % 5) + 1);
        _fuzz_epoch(seed);
        seed = seed + 1;
    }
    _fuzz_reclaim();
    println("fuzz_png: 150000 IDAT-stream mutation cases survived");

    # 7. hostile SCANLINES behind a valid deflate stream, every shape — the
    #    five § 9 predictors, Adam7, and every colour-type x depth x tRNS path
    seed = 1;
    while (seed <= 60000) {
        fuzz_png_scanlines(seed * 1103515245, seed);
        _fuzz_epoch(seed);
        seed = seed + 1;
    }
    _fuzz_reclaim();
    println("fuzz_png: 60000 scanline-mutation cases survived (10 shapes)");

    # 8. chitra_image_decode_budget, budgets around the exact output size
    seed = 1;
    while (seed <= 30000) {
        fuzz_png_budget(seed * 2654435761);
        _fuzz_epoch(seed);
        seed = seed + 1;
    }
    _fuzz_reclaim();
    println("fuzz_png: 30000 decode_budget cases survived");

    # 9. chunk TYPES rewritten / inserted behind a repaired CRC, critical and
    #    ancillary alternating — the § 5.4 abort and its skip-it control
    seed = 1;
    while (seed <= 44000) {
        fuzz_png_chunktype(seed * 2246822519, seed);
        _fuzz_epoch(seed);
        seed = seed + 1;
    }
    _fuzz_reclaim();
    println("fuzz_png: 44000 chunk-type rewrite/insert cases survived (critical + ancillary)");

    # 10. IHDR geometry aimed at the bomb / INFLATE_LIMIT / mismatch boundaries
    seed = 1;
    while (seed <= 19200) {
        fuzz_png_geometry(seed * 40503, seed);
        _fuzz_epoch(seed);
        seed = seed + 1;
    }
    _fuzz_reclaim();
    println("fuzz_png: 19200 IHDR-geometry cases survived (bomb / limit / mismatch)");

    # 5. degenerate lengths
    fuzz_png_degenerate();
    _fuzz_reclaim();
    println("fuzz_png: degenerate-length cases survived");

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
