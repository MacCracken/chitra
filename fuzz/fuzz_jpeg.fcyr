    o = _fx_hex(b, o, "cf6fe49cffd08844");
    o = _fx_hex(b, o, "926a769dbf4e90cc02da9a35f08aefd7ebefffc4001e110100020104030000000000000000000001");
    o = _fx_hex(b, o, "001131102161f0b1");
    o = _fx_hex(b, o, "d1f1ffda0008010301013f21052e25029bbf7ce8ff00ffd0251617d46afbd54e34ffc4001f110100");
    o = _fx_hex(b, o, "0103040300000000");
    o = _fx_hex(b, o, "00000000000001110021413151619181f0f1ffda0008010301013f10c4a221b4cda346778c834c8c");
    o = _fx_hex(b, o, "d4e1df24e2056da1");
    o = _fx_hex(b, o, "98a96e57ffd0304178044e8c4617d0a205b42f940bd0eb96be715fffd9");
    store64(len_out, 1085);
    return b;
}
var _fx_jpeg_prog_cache = 0;
var _fx_jpeg_prog_len = 0;
var _fx_jpeg_progsa_cache = 0;
var _fx_jpeg_progsa_len = 0;

# A fresh, mutable copy of progressive fixture k (0 or 1).
fn fx_jpeg_prog(k, len_out): i64 {
    if (k == 1) {
        if (_fx_jpeg_progsa_cache == 0) { _fx_jpeg_progsa_cache = _fx_jpeg_progsa_bytes(&_fx_jpeg_progsa_len); }
        store64(len_out, _fx_jpeg_progsa_len);
        return _fx_copy(_fx_jpeg_progsa_cache, _fx_jpeg_progsa_len);
    }
    if (_fx_jpeg_prog_cache == 0) { _fx_jpeg_prog_cache = _fx_jpeg_prog420_bytes(&_fx_jpeg_prog_len); }
    store64(len_out, _fx_jpeg_prog_len);
    return _fx_copy(_fx_jpeg_prog_cache, _fx_jpeg_prog_len);
}

# Counting Allocator: +0 live, +8 bad frees, +16 slot count, +24.. 128 slots.
fn _fz_ta_alloc(state, size): i64 {
    var p = alloc(size);
    if (p == 0) { return 0; }
    var n = load64(state + 16);
    if (n < 128) {
        store64(state + 24 + n * 8, p);
        store64(state + 16, n + 1);
    }
    store64(state, load64(state) + 1);
    return p;
}

fn _fz_ta_realloc(state, o, os, ns): i64 { return 0; }

fn _fz_ta_free(state, ptr): i64 {
    var n = load64(state + 16);
    var i = 0;
    var found = 0;
    while (i < n) {
        if (load64(state + 24 + i * 8) == ptr) {
            store64(state + 24 + i * 8, 0);
            found = 1;
            i = n;
        }
        i = i + 1;
    }
    if (found == 0) { store64(state + 8, load64(state + 8) + 1); }
    store64(state, load64(state) - 1);
    return 0;
}

fn _fz_ta_reset(state): i64 { return 0; }

# The _via contract on hostile bytes: every block back on a refusal; exactly
# two live on success, none after chitra_image_free; nothing freed twice or
# freed that was never issued.
fn _jpeg_via_contract(buf, n, label): i64 {
    var st = alloc(24 + 128 * 8);
    store64(st, 0);
    store64(st + 8, 0);
    store64(st + 16, 0);
    var a = allocator_new(&_fz_ta_alloc, &_fz_ta_realloc, &_fz_ta_free, &_fz_ta_reset, st);
    var err = 0;
    var img = chitra_image_decode_budget_via(a, buf, n, 1048576, &err);
    if (img == 0) {
        assert(err != 0, label);
        assert_eq(load64(st), 0, label);
    }
    if (img != 0) {
        assert_eq(load64(st), 2, label);
        chitra_image_free(img);
        assert_eq(load64(st), 0, label);
    }
    assert_eq(load64(st + 8), 0, label);
    return 0;
}

# Mutate fixture (seed % 2) from its first SOS on; returns the outcome code
# (0 = decoded, else the ChitraErrCode) for the reach count.
fn fuzz_jpeg_progressive(seed, nmut): i64 {
    _fuzz_seed(seed);
    var lo = 0;
    var b = fx_jpeg_prog(seed % 2, &lo);
    var first = 0 - 1;
    var i = 0;
    while (i + 1 < lo) {
        if (first < 0) {
            if (load8(b + i) == 0xFF) {
                if (load8(b + i + 1) == 0xDA) { first = i; }
            }
        }
        i = i + 1;
    }
    if (first < 0) { return 0 - 1; }
    var m = 0;
    while (m < nmut) {
        store8(b + first + ((_fuzz_next() * 256 + _fuzz_next()) % (lo - first)), _fuzz_next());
        m = m + 1;
    }
    _jpeg_contract(b, lo, "jpeg progressive mutation");
    _jpeg_via_contract(b, lo, "jpeg progressive mutation (via a counting Allocator)");
    var err = 0;
    var img = chitra_jpeg_decode(b, lo, &err);
    if (img != 0) { return 0; }
    return chitra_err_code(err);
}

fn fuzz_jpeg_progressive_reach(): i64 {
    var seed = 1;
    var dec = 0;
    var sos = 0;
    var ent = 0;
    var oc = 0;
    while (seed <= 4000) {
        oc = fuzz_jpeg_progressive(seed * 2654435761, (seed % 3) + 1);
        if (oc == 0) { dec = dec + 1; }
        if (oc == CHITRA_ERR_JPEG_SOS) { sos = sos + 1; }
        if (oc == CHITRA_ERR_JPEG_ENTROPY) { ent = ent + 1; }
        _fuzz_epoch(seed);
        seed = seed + 1;
    }
    print("fuzz_jpeg: progressive reach over 4000: decoded ", 48);
    print_num(dec);
    print(", JPEG_SOS ", 11);
    print_num(sos);
    print(", JPEG_ENTROPY ", 15);
    print_num(ent);
    println("");
    assert(dec >= 400, "progressive mode decodes at least 10% of its cases (reaches the scan decoders)");
    assert(sos >= 40, "progressive mode reaches the progression / scan-header refusals");
    assert(ent >= 40, "progressive mode reaches the entropy refusals");
    return 0;
}

