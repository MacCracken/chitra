# chitra — JPEG decode fuzz harness (`cyrius fuzz`).
#
# chitra's threat model is a HOSTILE ENCODED IMAGE: untrusted (src, len)
# bytes reach a public entry point. This harness drives the baseline JPEG path with
# adversarial input and asserts the two invariants every decode must hold,
# no matter how malformed the input:
#
#   1. SURVIVAL   — the decoder returns. It must not fault, corrupt memory,
#                   or loop forever on any byte sequence.
#   2. CONTRACT   — the documented result shape holds on every path:
#                   failure => returns 0 AND *err_out is a non-zero ChitraErr;
#                   success => non-zero image, err_out untouched (0), and
#                   width/height/pixels all sane.
#
# Invariant 2 is the one a crash-only fuzzer misses: a decoder that returns
# 0 without setting *err_out hands the caller a stale or zero error, and
# mabda maps ChitraErr straight onto GpuErr.
#
# The JPEG path is the priority fuzz target: unlike the PNG decoder (a fork
# of kii's fuzz-hardened code) the marker walk, Huffman entropy decoder and
# IDCT are original code, and JPEG carries NO checksum — every byte of a
# scan is attacker-chosen with nothing to reject it but chitra's own bounds.
# Case 5 below mutates ONLY the post-SOS entropy segment, so the marker
# parse succeeds and hostile bits reach the bit-reader / DECODE directly.
#
# Stack-array pointer note: `var buf[N]` reserves N bytes, but `buf` as an
# rvalue yields the first 8 bytes, not the address — pass `&buf`.

include "src/lib.cyr"
include "lib/assert.cyr"

# ================================================================
# Deterministic PRNG (LCG) — seeded per case so every failure reproduces.
# ================================================================
var _fuzz_state = 0;

fn _fuzz_seed(s): i64 {
    _fuzz_state = s;
    return 0;
}

fn _fuzz_next(): i64 {
    _fuzz_state = _fuzz_state * 6364136223846793005 + 1442695040888963407;
    return (_fuzz_state >> 33) & 255;
}

fn _fuzz_fill(buf, len): i64 {
    var i = 0;
    while (i < len) {
        store8(buf + i, _fuzz_next());
        i = i + 1;
    }
    return 0;
}

fn fx_jpeg_gray_8x8(len_out): i64 {
    var b = alloc(150);
    var i = 0;
    # SOI
    store8(b + 0, 0xFF);
    store8(b + 1, 0xD8);
    # DQT: table 0, 64 ones
    store8(b + 2, 0xFF);
    store8(b + 3, 0xDB);
    store8(b + 4, 0x00);
    store8(b + 5, 0x43);
    store8(b + 6, 0x00);
    i = 0;
    while (i < 64) { store8(b + 7 + i, 1); i = i + 1; }
    # SOF0: 8x8, 1 component (id 1, H/V 1, Tq 0)
    store8(b + 71, 0xFF);
    store8(b + 72, 0xC0);
    store8(b + 73, 0x00);
    store8(b + 74, 0x0B);
    store8(b + 75, 0x08);
    store8(b + 76, 0x00);
    store8(b + 77, 0x08);
    store8(b + 78, 0x00);
    store8(b + 79, 0x08);
    store8(b + 80, 0x01);
    store8(b + 81, 0x01);
    store8(b + 82, 0x11);
    store8(b + 83, 0x00);
    # DHT: DC table 0 (Annex K) + AC table 0 (2 symbols)
    store8(b + 84, 0xFF);
    store8(b + 85, 0xC4);
    store8(b + 86, 0x00);
    store8(b + 87, 0x32);
    store8(b + 88, 0x00);                # DC Tc/Th
    store8(b + 89, 0x00);                # DC BITS L1..L16
    store8(b + 90, 0x01);
    store8(b + 91, 0x05);
    store8(b + 92, 0x01);
    store8(b + 93, 0x01);
    store8(b + 94, 0x01);
    store8(b + 95, 0x01);
    store8(b + 96, 0x01);
    store8(b + 97, 0x01);
    store8(b + 98, 0x00);
    store8(b + 99, 0x00);
    store8(b + 100, 0x00);
    store8(b + 101, 0x00);
    store8(b + 102, 0x00);
    store8(b + 103, 0x00);
    store8(b + 104, 0x00);
    i = 0;
    while (i < 12) { store8(b + 105 + i, i); i = i + 1; }   # DC huffval 0..11
    store8(b + 117, 0x10);               # AC Tc/Th = 0x10
    store8(b + 118, 0x00);               # AC BITS: L2 = 2, rest 0
    store8(b + 119, 0x02);
    i = 0;
    while (i < 14) { store8(b + 120 + i, 0); i = i + 1; }
    store8(b + 134, 0x00);               # AC huffval 0x00 (EOB), 0x01
    store8(b + 135, 0x01);
    # SOS: 1 component (Cs 1, Td/Ta 0), Ss 0 Se 63 Ah/Al 0
    store8(b + 136, 0xFF);
    store8(b + 137, 0xDA);
    store8(b + 138, 0x00);
    store8(b + 139, 0x08);
    store8(b + 140, 0x01);
    store8(b + 141, 0x01);
    store8(b + 142, 0x00);
    store8(b + 143, 0x00);
    store8(b + 144, 0x3F);
    store8(b + 145, 0x00);
    # entropy: "101"(DC size 4) + "1000"(=8) + "00"(EOB) -> 0xB0 0x00
    store8(b + 146, 0xB0);
    store8(b + 147, 0x00);
    # EOI
    store8(b + 148, 0xFF);
    store8(b + 149, 0xD9);
    store64(len_out, 150);
    return b;
}

