    return b;
}

fn _jpeg_contract(buf, n, label): i64 {
    var err = 0;
    var img = chitra_jpeg_decode(buf, n, &err);
    if (img == 0) {
        assert(err != 0, label);
        if (err != 0) {
            assert(chitra_err_code(err) != CHITRA_OK, label);
            assert(chitra_err_name(chitra_err_code(err)) != 0, label);
        }
    }
    if (img != 0) {
        assert(err == 0, label);
        assert(chitra_image_width(img) > 0, label);
        assert(chitra_image_height(img) > 0, label);
        assert(chitra_image_pixels(img) != 0, label);
        assert(chitra_image_channels(img) == 4, label);
        # JPEG sentinel: src_ctype is 0x100 | ncomp -> 0x101 gray, 0x103 YCbCr
        assert(chitra_image_source_color_type(img) > 256, label);
    }
    return 0;
}

# The public _rgba8 wrapper. Unfuzzed through 0.7.2 on every format, and it is
# about to be frozen. Its contract is an ordering one: it zeroes the
# CALLER-OWNED w_out/h_out slots BEFORE attempting the decode, so a failure
# leaves the caller with 0/0 rather than a stale or half-written size it might
# act on. That is the property worth pinning adversarially.
fn _jpeg_rgba8_contract(buf, n, label): i64 {
    var w = 0 - 1;
    var h = 0 - 1;
    var px = chitra_jpeg_decode_rgba8(buf, n, &w, &h);
    if (px == 0) {
        assert(w == 0, label);
        assert(h == 0, label);
    }
    if (px != 0) {
        assert(w > 0, label);
        assert(h > 0, label);
    }
    return 0;
}

fn _jrouter_contract(buf, n, label): i64 {
    var err = 0;
    var img = chitra_image_decode(buf, n, &err);
    if (img == 0) { assert(err != 0, label); }
    if (img != 0) {
        assert(err == 0, label);
        assert(chitra_image_pixels(img) != 0, label);
    }
    return 0;
}

# Locate the SOS marker (FF DA) and return the offset of the first entropy
# byte after its segment header, or -1. Used to target the entropy segment.
fn _find_entropy_start(b, n): i64 {
    var i = 0;
    var hit = 0 - 1;
    while (i + 1 < n) {
        if (hit < 0) {
            if (load8(b + i) == 0xFF) {
                if (load8(b + i + 1) == 0xDA) {
                    # FF DA, then a 2-byte segment length covering the header
                    if (i + 3 < n) {
                        hit = i + 2 + (load8(b + i + 2) * 256 + load8(b + i + 3));
                    }
                }
            }
        }
        i = i + 1;
    }
    if (hit >= n) { hit = 0 - 1; }
    return hit;
}

# ---- 1. Pure random bytes -------------------------------------------
fn fuzz_jpeg_random(seed, n): i64 {
    _fuzz_seed(seed);
    var buf[512];
    var capped = n;
    if (capped > 512) { capped = 512; }
    if (capped < 0) { capped = 0; }
    _fuzz_fill(&buf, capped);
    _jpeg_contract(&buf, capped, "jpeg random bytes");
    _jrouter_contract(&buf, capped, "router random bytes");
    return 0;
}

# ---- 2. SOI prefix + random tail -------------------------------------
# Past the signature gate: the marker walk gets hostile segment lengths,
# unknown markers, non-baseline SOFs and truncated segments.
fn fuzz_jpeg_soiprefix(seed, n): i64 {
    _fuzz_seed(seed);
    var buf[512];
    var capped = n;
    if (capped > 510) { capped = 510; }
    if (capped < 0) { capped = 0; }
    store8(&buf + 0, 0xFF);
    store8(&buf + 1, 0xD8);
    _fuzz_fill(&buf + 2, capped);
    _jpeg_contract(&buf, capped + 2, "jpeg SOI + random markers");
    return 0;
}

# ---- 3. Bit-flipped valid fixture ------------------------------------
fn fuzz_jpeg_mutate(seed, nmut): i64 {
    _fuzz_seed(seed);
    var lo = 0;
    var b = fx_jpeg_gray_8x8(&lo);
    var m = 0;
    var pos = 0;
    while (m < nmut) {
        pos = (_fuzz_next() * 256 + _fuzz_next()) % lo;
        store8(b + pos, _fuzz_next());
        m = m + 1;
    }
    _jpeg_contract(b, lo, "jpeg mutated fixture");
    _jpeg_rgba8_contract(b, lo, "jpeg mutated fixture (_rgba8 wrapper)");
    return 0;
}

# ---- 4. Truncation sweep ---------------------------------------------
fn fuzz_jpeg_truncate(): i64 {
    var lo = 0;
    var b = fx_jpeg_gray_8x8(&lo);
    var cut = 0;
    while (cut <= lo) {
        _jpeg_contract(b, cut, "jpeg truncated prefix");
        cut = cut + 1;
    }
    return 0;
}

# ---- 5. Entropy-segment mutation (the priority target) ----------------
# Header stays intact so the marker walk SUCCEEDS; only post-SOS entropy
# bytes are corrupted. This is the path with no checksum and the newest
# code: bit-reader, DECODE, RECEIVE/EXTEND, restart resync, IDCT.
fn fuzz_jpeg_entropy(seed, nmut): i64 {
    _fuzz_seed(seed);
    var lo = 0;
    var b = fx_jpeg_gray_8x8(&lo);
    var es = _find_entropy_start(b, lo);
    if (es < 0) { return 0; }
    var span = lo - es;
    if (span <= 0) { return 0; }
    var m = 0;
    var pos = 0;
    while (m < nmut) {
        pos = es + ((_fuzz_next() * 256 + _fuzz_next()) % span);
        store8(b + pos, _fuzz_next());
        m = m + 1;
    }
    _jpeg_contract(b, lo, "jpeg entropy-segment mutation");
    return 0;
}

# ---- 5b. Entropy mutation against the REAL ImageMagick fixture --------
# fx_jpeg_gray_8x8 is a hand-built minimum: its entropy segment is only a
# few bytes, so it barely exercises DECODE. The 16x16 gradient carries real
# Annex K Huffman tables and genuine AC content, giving the bit-reader a
# substantially wider hostile surface.
fn fuzz_jpeg_entropy_real(seed, nmut): i64 {
    _fuzz_seed(seed);
    var lo = 0;
    var b = fx_jpeg_real_gradient(&lo);
    var es = _find_entropy_start(b, lo);
    if (es < 0) { return 0; }
    var span = lo - es;
    if (span <= 0) { return 0; }
    var m = 0;
    var pos = 0;
    while (m < nmut) {
        pos = es + ((_fuzz_next() * 256 + _fuzz_next()) % span);
        store8(b + pos, _fuzz_next());
        m = m + 1;
    }
    _jpeg_contract(b, lo, "jpeg real-fixture entropy mutation");
    return 0;
}

# ---- Harness self-check ----------------------------------------------
# A fuzz harness that silently no-ops is worse than none. Assert that both
# fixtures are valid, that SOS is actually located, and that the entropy
# span is wide enough for mutation to mean something.
fn fuzz_jpeg_selfcheck(): i64 {
    var lo = 0;
    var b = fx_jpeg_gray_8x8(&lo);
    var err = 0;
    assert(chitra_jpeg_decode(b, lo, &err) != 0, "selfcheck: gray_8x8 fixture decodes clean");
    assert(_find_entropy_start(b, lo) > 0, "selfcheck: gray_8x8 SOS located");

    var glo = 0;
    var gb = fx_jpeg_real_gradient(&glo);
    var gerr = 0;
    var gimg = chitra_jpeg_decode(gb, glo, &gerr);
    assert(gimg != 0, "selfcheck: real gradient fixture decodes clean");
    assert(chitra_image_width(gimg) == 16, "selfcheck: real gradient is 16 wide");
    var ges = _find_entropy_start(gb, glo);
    assert(ges > 0, "selfcheck: real gradient SOS located");
    assert(glo - ges >= 8, "selfcheck: real gradient entropy span is fuzzable");

    # 0.6.0: the non-interleaved fixture must DECODE before anything mutates it,
    # and its sampling nibble must sit where the sweep patches it. A harness that
    # silently exercises a rejecting fixture proves nothing about the new path.
    var nlo = 0;
    var nb = fx_jpeg_ni_gray(&nlo);
    var nerr = 0;
    var nimg = chitra_jpeg_decode(nb, nlo, &nerr);
    assert(nimg != 0, "selfcheck: non-interleaved base fixture decodes clean");
    assert(load8(nb + 100) == 0x11, "selfcheck: SOF0 sampling nibble sits at offset 100");
    var nes = _find_entropy_start(nb, nlo);
    assert(nes > 0, "selfcheck: non-interleaved fixture SOS located");
    assert(nlo - nes >= 8, "selfcheck: non-interleaved entropy span is fuzzable");
    # And it must still decode with H=2 declared — otherwise case 8 would be
    # fuzzing a rejection path rather than the collapsed geometry.
    store8(nb + 100, 0x21);
    nerr = 0;
    assert(chitra_jpeg_decode(nb, nlo, &nerr) != 0, "selfcheck: H=2 reaches the collapsed geometry");
    return 0;
}

# ---- 7. Sampling-nibble sweep (0.6.0, T.81 § A.2) ---------------------
# The SOF0 sampling byte of a ONE-component frame drives geometry that is now
# collapsed rather than rejected, so every value of that byte is a live input.
# This walks all 256, not a spot check: 1..4 x 1..4 must decode (the factors are
# inert for Nf = 1), and 0 or >4 in either nibble must reject — either way the
# documented contract holds.
fn fuzz_jpeg_hv_sweep(): i64 {
    var lo = 0;
    var b = 0;
    var hv = 0;
    while (hv < 256) {
        b = fx_jpeg_ni_gray(&lo);
        store8(b + 100, hv);
        _jpeg_contract(b, lo, "jpeg SOF0 sampling-nibble sweep");
        _jrouter_contract(b, lo, "jpeg SOF0 sampling-nibble sweep (router)");
        hv = hv + 1;
    }
    return 0;
}

# ---- 8. Entropy mutation behind a NON-INTERLEAVED header --------------
# Before 0.6.0 an H>1 one-component header REJECTED, so no entropy byte behind
# one ever reached the bit-reader: this shape is entirely new attack surface,
# not a widened one. The collapsed grid walks ceil(24/8) * ceil(16/8) = 6 data
# units for every legal (H,V) — fewer than the 8 or 16 an interleaved reading of
# the same header would have walked, which is why the change cannot increase
# per-file work. Mutates the H/V byte AND the entropy span together, which is
# the combination the new code owns.
fn fuzz_jpeg_ni_entropy(seed, nmut): i64 {
    var lo = 0;
    var b = fx_jpeg_ni_gray(&lo);
    _fuzz_seed(seed);
    var hh = (_fuzz_next() % 4) + 1;
    var vv = (_fuzz_next() % 4) + 1;
    store8(b + 100, hh * 16 + vv);
    var es = _find_entropy_start(b, lo);
    var span = lo - es;
    var i = 0;
    var off = 0;
    if (es > 0) {
        if (span > 0) {
            while (i < nmut) {
                off = es + (_fuzz_next() % span);
                store8(b + off, _fuzz_next() & 255);
                i = i + 1;
            }
        }
    }
    _jpeg_contract(b, lo, "jpeg non-interleaved entropy mutation");
    return 0;
}

# ---- 6. Degenerate lengths -------------------------------------------
fn fuzz_jpeg_degenerate(): i64 {
    var lo = 0;
    var b = fx_jpeg_gray_8x8(&lo);
    _jpeg_contract(b, 0, "jpeg len 0");
    _jpeg_contract(b, 1, "jpeg len 1");
    _jpeg_contract(b, 2, "jpeg len 2 (SOI only)");
    _jpeg_contract(b, 0 - 1, "jpeg negative len");
    _jpeg_contract(b, 0 - 1000000, "jpeg large negative len");
    return 0;
}

fn main(): i64 {
    var seed = 1;

    fuzz_jpeg_selfcheck();
    println("fuzz_jpeg: harness self-check passed (fixtures valid, entropy reachable)");

    seed = 1;
    while (seed <= 100000) {
        fuzz_jpeg_random(seed * 2654435761, (seed * 7) % 512);
        seed = seed + 1;
    }
    println("fuzz_jpeg: 100000 random-byte cases survived");

    seed = 1;
    while (seed <= 150000) {
        fuzz_jpeg_soiprefix(seed * 40503, (seed * 11) % 510);
        seed = seed + 1;
    }
    println("fuzz_jpeg: 150000 SOI-prefixed marker-walk cases survived");

    seed = 1;
    while (seed <= 100000) {
        fuzz_jpeg_mutate(seed * 97, (seed % 4) + 1);
        seed = seed + 1;
    }
    println("fuzz_jpeg: 100000 mutated-fixture cases survived");

    fuzz_jpeg_truncate();
    println("fuzz_jpeg: truncation sweep survived");

    # The priority target — hostile entropy bits behind a valid header.
    seed = 1;
    while (seed <= 75000) {
        fuzz_jpeg_entropy(seed * 131, (seed % 6) + 1);
        seed = seed + 1;
    }
    println("fuzz_jpeg: 75000 entropy-segment mutation cases survived");

    seed = 1;
    while (seed <= 75000) {
        fuzz_jpeg_entropy_real(seed * 277, (seed % 6) + 1);
        seed = seed + 1;
    }
    println("fuzz_jpeg: 75000 real-fixture entropy mutation cases survived");

    fuzz_jpeg_hv_sweep();
    println("fuzz_jpeg: 256-case SOF0 sampling-nibble sweep survived");

    seed = 1;
    while (seed <= 100000) {
        fuzz_jpeg_ni_entropy(seed * 2246822519, (seed % 6) + 1);
        seed = seed + 1;
    }
    println("fuzz_jpeg: 100000 non-interleaved entropy cases survived");

    fuzz_jpeg_degenerate();
    println("fuzz_jpeg: degenerate-length cases survived");

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
