var _fx_jpeg_cmyk_cache = 0;
var _fx_jpeg_cmyk_len = 0;

fn fuzz_jpeg_cmyk(seed, nmut): i64 {
    _fuzz_seed(seed);
    if (_fx_jpeg_cmyk_cache == 0) { _fx_jpeg_cmyk_cache = _fx_jpeg_cmyk_bytes(&_fx_jpeg_cmyk_len); }
    var lo = _fx_jpeg_cmyk_len;
    var b = _fx_copy(_fx_jpeg_cmyk_cache, lo);
    var m = 0;
    while (m < nmut) {
        store8(b + 2 + ((_fuzz_next() * 256 + _fuzz_next()) % (lo - 2)), _fuzz_next());
        m = m + 1;
    }
    var st = alloc(24 + 128 * 8);
    store64(st, 0);
    store64(st + 8, 0);
    store64(st + 16, 0);
    var a = allocator_new(&_fz_ta_alloc, &_fz_ta_realloc, &_fz_ta_free, &_fz_ta_reset, st);
    var err = 0;
    var img = chitra_jpeg_decode_cmyk(a, b, lo, 1048576, &err);
    var oc = 0;
    if (img == 0) {
        assert(err != 0, "jpeg cmyk mutation: refusal sets err");
        assert_eq(load64(st), 0, "jpeg cmyk mutation: a refusal returns every block");
        if (err != 0) { oc = chitra_err_code(err); }
    }
    if (img != 0) {
        assert(err == 0, "jpeg cmyk mutation: success leaves err 0");
        assert(chitra_image_width(img) > 0, "jpeg cmyk mutation: width");
        assert_eq(chitra_image_source_color_type(img) & 0x10F, 0x104, "jpeg cmyk mutation: CMYK sentinel");
        assert_eq(load64(st), 2, "jpeg cmyk mutation: record + pixels live");
        chitra_image_free(img);
        assert_eq(load64(st), 0, "jpeg cmyk mutation: none after chitra_image_free");
    }
    assert_eq(load64(st + 8), 0, "jpeg cmyk mutation: nothing freed that was not issued");
    return oc;
}

fn fuzz_jpeg_cmyk_reach(): i64 {
    var seed = 1;
    var dec = 0;
    var ref = 0;
    while (seed <= 3000) {
        if (fuzz_jpeg_cmyk(seed * 2246822519, (seed % 3) + 1) == 0) { dec = dec + 1; } else { ref = ref + 1; }
        _fuzz_epoch(seed);
        seed = seed + 1;
    }
    assert(dec >= 300, "cmyk mode decodes at least 10% of its cases");
    assert(ref >= 300, "cmyk mode refuses at least 10% of its cases");
    return 0;
}

fn _fuzz_reclaim(): i64 {
    #ifdef CYRIUS_POISON
    var pz = poison_sweep();
    if (pz > 0) { assert_eq(pz, 0, "poison_sweep() before alloc_reset: changed redzones"); }
    #endif
    alloc_reset();
    _fx_jpeg_dri_cache = 0;
    _fx_jpeg_rgb_cache = 0;
    _fx_jpeg_prog_cache = 0;
    _fx_jpeg_progsa_cache = 0;
    _fx_jpeg_cmyk_cache = 0;
    return 0;
}

fn _fuzz_epoch(n): i64 {
    if ((n % FUZZ_EPOCH) == 0) { _fuzz_reclaim(); }
    return 0;
}

fn main(): i64 {
    var seed = 1;

    fuzz_jpeg_selfcheck();
    _fuzz_reclaim();
    println("fuzz_jpeg: harness self-check passed (6 fixtures valid, entropy + RSTn reachable)");

    seed = 1;
    while (seed <= 100000) {
        fuzz_jpeg_random(seed * 2654435761, (seed * 7) % 512);
        _fuzz_epoch(seed);
        seed = seed + 1;
    }
    _fuzz_reclaim();
    println("fuzz_jpeg: 100000 random-byte cases survived");

    seed = 1;
    while (seed <= 150000) {
        fuzz_jpeg_soiprefix(seed * 40503, (seed * 11) % 510);
        _fuzz_epoch(seed);
        seed = seed + 1;
    }
    _fuzz_reclaim();
    println("fuzz_jpeg: 150000 SOI-prefixed marker-walk cases survived");

    seed = 1;
    while (seed <= 100000) {
        fuzz_jpeg_mutate(seed * 97, (seed % 4) + 1);
        _fuzz_epoch(seed);
        seed = seed + 1;
    }
    _fuzz_reclaim();
    println("fuzz_jpeg: 100000 mutated-fixture cases survived (gray + 3 x 6250)");

    fuzz_jpeg_truncate();
    _fuzz_reclaim();
    println("fuzz_jpeg: truncation sweep survived");

    # The priority target — hostile entropy bits behind a valid header,
    # including the DRI fixture's restart intervals.
    seed = 1;
    while (seed <= 75000) {
        fuzz_jpeg_entropy(seed * 131, (seed % 6) + 1);
        _fuzz_epoch(seed);
        seed = seed + 1;
    }
    _fuzz_reclaim();
    println("fuzz_jpeg: 75000 entropy-segment mutation cases survived (gray / DRI / RGB)");

    seed = 1;
    while (seed <= 75000) {
        fuzz_jpeg_entropy_real(seed * 277, (seed % 6) + 1);
        _fuzz_epoch(seed);
        seed = seed + 1;
    }
    _fuzz_reclaim();
    println("fuzz_jpeg: 75000 real-fixture entropy mutation cases survived");

    fuzz_jpeg_hv_sweep();
    _fuzz_reclaim();
    println("fuzz_jpeg: 256-case SOF0 sampling-nibble sweep survived");

    seed = 1;
    while (seed <= 100000) {
        fuzz_jpeg_ni_entropy(seed * 2246822519, (seed % 6) + 1);
        _fuzz_epoch(seed);
        seed = seed + 1;
    }
    _fuzz_reclaim();
    println("fuzz_jpeg: 100000 non-interleaved entropy cases survived");

    seed = 1;
    while (seed <= 120000) {
        fuzz_jpeg_multiscan(seed * 40503, (seed % 6) + 1);
        _fuzz_epoch(seed);
        seed = seed + 1;
    }
    _fuzz_reclaim();
    println("fuzz_jpeg: 120000 multi-scan structure cases survived");

    # 10. chitra_image_decode_budget, budgets around the exact output size
    seed = 1;
    while (seed <= 6000) {
        fuzz_jpeg_budget(seed * 2654435761);
        _fuzz_epoch(seed);
        seed = seed + 1;
    }
    _fuzz_reclaim();
    println("fuzz_jpeg: 6000 decode_budget cases survived (6 fixtures)");

    fuzz_jpeg_degenerate();
    _fuzz_reclaim();
    println("fuzz_jpeg: degenerate-length cases survived");

    # 12. Progressive (1.4.0): the reach proof, then the bulk of the mode.
    fuzz_jpeg_progressive_reach();
    _fuzz_reclaim();
    seed = 4001;
    while (seed <= 60000) {
        fuzz_jpeg_progressive(seed * 2654435761, (seed % 3) + 1);
        _fuzz_epoch(seed);
        seed = seed + 1;
    }
    _fuzz_reclaim();
    println("fuzz_jpeg: 60000 progressive mutation cases survived (contract + counting Allocator)");

    # 13. chitra_jpeg_decode_cmyk (1.4.0)
    fuzz_jpeg_cmyk_reach();
    _fuzz_reclaim();
    seed = 3001;
    while (seed <= 30000) {
        fuzz_jpeg_cmyk(seed * 2246822519, (seed % 3) + 1);
        _fuzz_epoch(seed);
        seed = seed + 1;
    }
    _fuzz_reclaim();
    println("fuzz_jpeg: 30000 CMYK-entry mutation cases survived (contract + counting Allocator)");

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
