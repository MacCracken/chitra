# chitra — JPEG decode fuzz harness (`cyrius fuzz`).
#
# chitra's threat model is a HOSTILE ENCODED IMAGE: untrusted (src, len)
# bytes reach a public entry point. This harness drives the baseline JPEG path with
# adversarial input and asserts the two invariants every decode must hold,
# no matter how malformed the input:
#
#   1. SURVIVAL   — the decoder returns. It must not fault, corrupt memory,
#                   or loop forever on any byte sequence.
#   2. CONTRACT   — the documented result shape holds on every path:
#                   failure => returns 0 AND *err_out is a non-zero ChitraErr;
#                   success => non-zero image, err_out untouched (0), and
#                   width/height/pixels all sane.
#
# Invariant 2 is the one a crash-only fuzzer misses: a decoder that returns
# 0 without setting *err_out hands the caller a stale or zero error, and
# mabda maps ChitraErr straight onto GpuErr.
#
# The JPEG path is the priority fuzz target: unlike the PNG decoder (a fork
# of kii's fuzz-hardened code) the marker walk, Huffman entropy decoder and
# IDCT are original code, and JPEG carries NO checksum — every byte of a
# scan is attacker-chosen with nothing to reject it but chitra's own bounds.
# Case 5 below mutates ONLY the post-SOS entropy segment, so the marker
# parse succeeds and hostile bits reach the bit-reader / DECODE directly.
#
# FIXTURES (1.1.1, gate-3). Mode 5 said it drove "restart resync" and none of
# its fixtures carried a DRI, so _chitra_jpeg_br_restart never ran under fuzzing; no
# fixture was RGB either, so the APP14-transform-0 output path never ran. Two
# real cjpeg files now join the rotation — fx_jpeg_dri (`cjpeg -restart 1B`,
# 32x32 4:2:0, three RSTn) and fx_jpeg_rgb (`cjpeg -rgb`, Adobe transform 0, no
# JFIF) — both byte-identical to `djpeg -nosmooth` when decoded. The self-check
# decodes every fixture, and modes 3, 4, 5 and 10 rotate across them. Run under
# `cyrius fuzz --poison` (make fuzz / CI).
#
# Stack-array pointer note: `var buf[N]` reserves N bytes, but `buf` as an
# rvalue yields the first 8 bytes, not the address — pass `&buf`.

include "src/lib.cyr"
include "lib/assert.cyr"

# ================================================================
# Deterministic PRNG (LCG) — seeded per case so every failure reproduces.
# ================================================================
var _fuzz_state = 0;

fn _fuzz_seed(s): i64 {
    _fuzz_state = s;
    return 0;
}

fn _fuzz_next(): i64 {
    _fuzz_state = _fuzz_state * 6364136223846793005 + 1442695040888963407;
    return (_fuzz_state >> 33) & 255;
}

fn _fuzz_fill(buf, len): i64 {
    var i = 0;
    while (i < len) {
        store8(buf + i, _fuzz_next());
        i = i + 1;
    }
    return 0;
}

# Hex-literal fixture support (1.1.1): decode once, copy per call.
fn _fx_hexval(c): i64 {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    return c - 55;
}

fn _fx_hex(b, off, s): i64 {
    var i = 0;
    var n = strlen(s);
    while (i + 1 < n) {
        store8(b + off, _fx_hexval(load8(s + i)) * 16 + _fx_hexval(load8(s + i + 1)));
        off = off + 1;
        i = i + 2;
    }
    return off;
}

fn _fx_copy(src, n): i64 {
    var b = alloc(n);
    var i = 0;
    while (i < n) {
        store8(b + i, load8(src + i));
        i = i + 1;
    }
    return b;
}

# `cjpeg -restart 1B -optimize -quality 75` of a 32x32 plasma: JFIF, 4:2:0, a
# restart interval of ONE MCU (DRI at 303), so the four MCUs are separated by
# RST0..RST2 (at 377, 431, 479). The only fixture here that reaches
# _chitra_jpeg_br_restart.
var _fx_jpeg_dri_cache = 0;

fn fx_jpeg_dri(len_out): i64 {
    if (_fx_jpeg_dri_cache == 0) {
        var c = alloc(531);
        var o = 0;
        o = _fx_hex(c, o, "ffd8ffe000104a46494600010100000100010000ffdb004300080606070605080707070909080a0c");
        o = _fx_hex(c, o, "140d0c0b0b0c1912130f141d1a1f1e1d1a1c1c20242e2720222c231c1c2837292c30313434341f27");
        o = _fx_hex(c, o, "393d38323c2e333432ffdb0043010909090c0b0c180d0d1832211c21323232323232323232323232");
        o = _fx_hex(c, o, "3232323232323232323232323232323232323232323232323232323232323232323232323232ffc0");
        o = _fx_hex(c, o, "0011080020002003012200021101031101ffc4001900000300030000000000000000000000000304");
        o = _fx_hex(c, o, "06020507ffc400261000020202020004070000000000000000010203110021041213314151051422");
        o = _fx_hex(c, o, "234281a1ffc400190100010500000000000000000000000000070203040506ffc4001e1100010402");
        o = _fx_hex(c, o, "0301000000000000000000000100020511032104123141ffdd00040001ffda000c03010002110311");
        o = _fx_hex(c, o, "003f0093e3731597a4a496fc77bc6a580940ea4aeb6a777921f34caddbb119b287e2ab24291ab752");
        o = _fx_hex(c, o, "a6c027431a6469aea56f9b2192fab5e28affd09175658fee200c4ddde628de27d00511bdfae1630f");
        o = _fx_hex(c, o, "22b3486e85d815fac4e77109340d13ab3b0712619c0dfa89fc795071d38ec2ffd1e46cc185922cff");
        o = _fx_hex(c, o, "00719e300c56c0d1c4e0424f5f307dfd30eac61b5a35e62b08d9224ec01bf8a6f1f9c3b073bc5fff");
        o = _fx_hex(c, o, "d284e0c8d04a365a33a23d313e639139ad0bbaf6c5a1e7f4adf91bc04bcbf1652c491784d645b9ad");
        o = _fx_hex(c, o, "d856b92471136c356bffd9");
        if (o != 531) { return 0; }
        _fx_jpeg_dri_cache = c;
    }
    store64(len_out, 531);
    return _fx_copy(_fx_jpeg_dri_cache, 531);
}

# `cjpeg -rgb -optimize -quality 80` of a 16x16 plasma: three components with
# ids 'R','G','B', an Adobe APP14 with transform 0 and NO JFIF APP0 — the file
# CLAUDE.md JPEG rule 14 is about. Decodes with source_color_type 0x113.
var _fx_jpeg_rgb_cache = 0;

fn fx_jpeg_rgb(len_out): i64 {
    if (_fx_jpeg_rgb_cache == 0) {
        var c = alloc(419);
        var o = 0;
        o = _fx_hex(c, o, "ffd8ffee000e41646f626500640000000000ffdb00430006040506050406060506070706080a100a");
        o = _fx_hex(c, o, "0a09090a140e0f0c1017141818171416161a1d251f1a1b231c1616202c20232627292a29191f2d30");
        o = _fx_hex(c, o, "2d283025282928ffc00011080010001003521100471100421100ffc4001b00000104030000000000");
        o = _fx_hex(c, o, "000000000000000401020608030507ffc4002b100002010204040505010000000000000001020304");
        o = _fx_hex(c, o, "110005213112134161060722519114157181f0b1ffda000c03520047004200003f00e2b51e5e5493");
        o = _fx_hex(c, o, "22404ac886c6e0ff007fbbfc4cfc4fe125e6cf2e5a3990caa071c5b7527f0012715a3ee6ef4ef0ca");
        o = _fx_hex(c, o, "4924150585cf6b9f9c1f57e0e9eaf2460b10faea752ac8c7d446f71aebfdd71ba34626c851441285");
        o = _fx_hex(c, o, "58c0660743b0e16beffbefae3038e6502b850a236b5fdce98b6b55e5faf345434464720282a35522");
        o = _fx_hex(c, o, "db81b8d3132cce9e9f33ca92954726606dcb1a31f707bdbdf0d5a69e3e1a892063086b9257d26c76");
        o = _fx_hex(c, o, "3f182a3f2fa969b3086510a4b0b8b3f0ad88d3beb6fddf0af92ccb2031c564d8f5e2d0ea469afe70");
        o = _fx_hex(c, o, "5e495cb4b50f0d50b412fa5ba709e87e71ffd9");
        if (o != 419) { return 0; }
        _fx_jpeg_rgb_cache = c;
    }
    store64(len_out, 419);
    return _fx_copy(_fx_jpeg_rgb_cache, 419);
}

fn fx_jpeg_gray_8x8(len_out): i64 {
    var b = alloc(150);
    var i = 0;
    # SOI
    store8(b + 0, 0xFF);
    store8(b + 1, 0xD8);
    # DQT: table 0, 64 ones
    store8(b + 2, 0xFF);
    store8(b + 3, 0xDB);
    store8(b + 4, 0x00);
    store8(b + 5, 0x43);
    store8(b + 6, 0x00);
    i = 0;
    while (i < 64) { store8(b + 7 + i, 1); i = i + 1; }
    # SOF0: 8x8, 1 component (id 1, H/V 1, Tq 0)
    store8(b + 71, 0xFF);
    store8(b + 72, 0xC0);
    store8(b + 73, 0x00);
    store8(b + 74, 0x0B);
    store8(b + 75, 0x08);
    store8(b + 76, 0x00);
    store8(b + 77, 0x08);
    store8(b + 78, 0x00);
    store8(b + 79, 0x08);
    store8(b + 80, 0x01);
    store8(b + 81, 0x01);
    store8(b + 82, 0x11);
    store8(b + 83, 0x00);
    # DHT: DC table 0 (Annex K) + AC table 0 (2 symbols)
    store8(b + 84, 0xFF);
    store8(b + 85, 0xC4);
    store8(b + 86, 0x00);
    store8(b + 87, 0x32);
    store8(b + 88, 0x00);                # DC Tc/Th
    store8(b + 89, 0x00);                # DC BITS L1..L16
    store8(b + 90, 0x01);
    store8(b + 91, 0x05);
    store8(b + 92, 0x01);
    store8(b + 93, 0x01);
    store8(b + 94, 0x01);
    store8(b + 95, 0x01);
    store8(b + 96, 0x01);
    store8(b + 97, 0x01);
    store8(b + 98, 0x00);
    store8(b + 99, 0x00);
    store8(b + 100, 0x00);
    store8(b + 101, 0x00);
    store8(b + 102, 0x00);
    store8(b + 103, 0x00);
    store8(b + 104, 0x00);
    i = 0;
    while (i < 12) { store8(b + 105 + i, i); i = i + 1; }   # DC huffval 0..11
    store8(b + 117, 0x10);               # AC Tc/Th = 0x10
    store8(b + 118, 0x00);               # AC BITS: L2 = 2, rest 0
    store8(b + 119, 0x02);
    i = 0;
    while (i < 14) { store8(b + 120 + i, 0); i = i + 1; }
    store8(b + 134, 0x00);               # AC huffval 0x00 (EOB), 0x01
    store8(b + 135, 0x01);
    # SOS: 1 component (Cs 1, Td/Ta 0), Ss 0 Se 63 Ah/Al 0
    store8(b + 136, 0xFF);
    store8(b + 137, 0xDA);
    store8(b + 138, 0x00);
    store8(b + 139, 0x08);
    store8(b + 140, 0x01);
    store8(b + 141, 0x01);
    store8(b + 142, 0x00);
    store8(b + 143, 0x00);
    store8(b + 144, 0x3F);
    store8(b + 145, 0x00);
    # entropy: "101"(DC size 4) + "1000"(=8) + "00"(EOB) -> 0xB0 0x00
    store8(b + 146, 0xB0);
    store8(b + 147, 0x00);
    # EOI
    store8(b + 148, 0xFF);
    store8(b + 149, 0xD9);
    store64(len_out, 150);
    return b;
}

