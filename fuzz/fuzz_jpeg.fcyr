# ---- 9. Multi-scan structure mutation (0.8.0) -------------------------
# Mutates the bytes AROUND the scans — the SOS headers, the inter-scan DHT/DRI
# segments, the component selectors — rather than the entropy data, because the
# new code is the WALK, not the decoder. Drives _chitra_jpeg_resume_to_next_scan, the
# coverage bitmask, per-scan table re-resolution, and the per-scan geometry.
fn fuzz_jpeg_multiscan(seed, nmut): i64 {
    var lo = 0;
    var b = fx_jpeg_multiscan(&lo);
    var es = _find_entropy_start(b, lo);
    if (es <= 0) { return 0; }
    _fuzz_seed(seed);
    var i = 0;
    var off = 0;
    while (i < nmut) {
        # Anywhere from the first SOS onward: scan headers, the segments
        # between scans, and the entropy streams themselves.
        off = es + (_fuzz_next() % (lo - es));
        store8(b + off, _fuzz_next() & 255);
        i = i + 1;
    }
    _jpeg_contract(b, lo, "jpeg multi-scan structure mutation");
    _jpeg_rgba8_contract(b, lo, "jpeg multi-scan structure mutation (_rgba8)");
    return 0;
}

# ---- 10. decode_budget (1.1.1, cc-11) ---------------------------------
# chitra_image_decode_budget is frozen, and for JPEG it reads the attacker's
# bytes with a SECOND segment walker (_chitra_jpeg_declared_dims) before the real one
# runs. No harness called it through 1.1.0. If the two walkers ever disagree on
# which SOF0 counts, the budget is either void (the walker returns 0 and the
# decode proceeds unbudgeted) or wrong. Its one promise is that no image it
# returns exceeds max_bytes of RGBA8; its failure shape is (0, *err_out set). A
# budget of exactly the output must decode — a refusal there is the walker
# disagreeing with the decoder — and one byte under must refuse as BUDGET.
fn _budget_one(buf, n, max, code_out, label): i64 {
    var err = 0;
    store64(code_out, 0);
    var img = chitra_image_decode_budget(buf, n, max, &err);
    if (img == 0) {
        assert(err != 0, label);
        if (err != 0) {
            store64(code_out, chitra_err_code(err));
            assert(chitra_err_code(err) != CHITRA_OK, label);
        }
    }
    if (img != 0) {
        assert(err == 0, label);
        assert(chitra_image_width(img) * chitra_image_height(img) * 4 <= max, label);
    }
    return img;
}

fn _budget_contract(buf, n, label): i64 {
    var err = 0;
    var code = 0;
    var ref = chitra_image_decode(buf, n, &err);
    if (ref != 0) {
        var out = chitra_image_width(ref) * chitra_image_height(ref) * 4;
        assert(_budget_one(buf, n, out - 1, &code, label) == 0, label);
        assert(code == CHITRA_ERR_BUDGET, label);
        assert(_budget_one(buf, n, out, &code, label) != 0, label);
    }
    if (ref == 0) {
        # An input that does not decode: an arbitrary budget, 0 to ~16 MB on a
        # log scale, must still refuse with *err_out set. (At most two decodes a
        # case — every one is heap the bump allocator never gives back.)
        var r = (_fuzz_next() << 16) | (_fuzz_next() << 8) | _fuzz_next();
        _budget_one(buf, n, r >> (_fuzz_next() % 24), &code, label);
    }
    return 0;
}

# All six fixtures: untouched, flipped in the header (before the first SOS —
# where the two walkers read), or flipped in the entropy data.
fn fuzz_jpeg_budget(seed): i64 {
    _fuzz_seed(seed);
    var lo = 0;
    var b = _jpeg_any_fixture(seed % 6, &lo);
    var kind = (seed / 6) % 3;
    var es = _find_entropy_start(b, lo);
    if (es <= 0) { es = lo; }
    if (kind == 1) {
        store8(b + 2 + (_fuzz_next() * 256 + _fuzz_next()) % (es - 2), _fuzz_next());
    }
    if (kind == 2) {
        if (es < lo) { store8(b + es + (_fuzz_next() * 256 + _fuzz_next()) % (lo - es), _fuzz_next()); }
    }
    _budget_contract(b, lo, "jpeg decode_budget");
    return 0;
}

# ---- 6. Degenerate lengths -------------------------------------------
fn fuzz_jpeg_degenerate(): i64 {
    var lo = 0;
    var b = fx_jpeg_gray_8x8(&lo);
    _jpeg_contract(b, 0, "jpeg len 0");
    _jpeg_contract(b, 1, "jpeg len 1");
    _jpeg_contract(b, 2, "jpeg len 2 (SOI only)");
    _jpeg_contract(b, 0 - 1, "jpeg negative len");
    _jpeg_contract(b, 0 - 1000000, "jpeg large negative len");
    return 0;
}

# ---- Heap epochs (1.1.1) ----------------------------------------------
# cyrius's bump allocator never frees, so every case's decode used to stay on
# the heap until exit: before this, fuzz_jpeg peaked at ~16 GB RSS and fuzz_gif
# at ~9 GB, against a 16 GB CI runner. main() now calls _fuzz_epoch(case) after
# every case and _fuzz_reclaim() after every mode; every FUZZ_EPOCH cases that
#   1. under --poison, SWEEPS every live block first. alloc_reset() makes the
#      poison layer forget its blocks, so without this an overwrite made since
#      the last periodic sweep would never be checked — the gate-2 class;
#   2. alloc_reset()s the heap back to its first 256 MB chunk (an epoch must
#      fit in it: a spill maps a new chunk that a reset abandons, still
#      resident — which is why the epoch is a case count, kept small);
#   3. drops every heap pointer this harness memoizes, so nothing survives the
#      reset as a dangling pointer. The caches below rebuild lazily.
# Call it only BETWEEN cases: nothing a case allocated may be live after it.
# chitra itself memoizes nothing on the heap (its tables are BSS); the stdlib
# assert counters are plain globals.
enum FuzzEpoch {
    FUZZ_EPOCH = 1024;
}

# ================================================================
# 12. Progressive JPEG (SOF2, 1.4.0). Two real progressive files, mutated
# anywhere from the FIRST scan header on — so the hostile bytes land in scan
# headers (Ss / Se / Ah / Al, the progression rules), the DHT segments between
# scans, and the entropy of all four scan kinds — and every case also decodes
# through a counting Allocator (chitra_image_decode_budget_via), so a refusal
# deep in a progressive decode must still return every block, and a success
# must leave exactly the record and its pixels live.
#   fixture 0: `cjpeg -progressive -quality 85` of the 17x11 two-axis source:
#              4:2:0, cjpeg's default 10-scan script, DHT before every scan.
#   fixture 1: `cjpeg -scans s2.scan -sample 1x1 -restart 1`: four levels of
#              DC successive approximation, AC refinements to Al 4, RSTn in
#              every scan — the restart + EOBRUN + refinement paths together.
# Both decode byte-identically to djpeg (tests/tcyr/jpeg_progressive.tcyr).
# ⚠ NO-OP PROOF (fuzz_jpeg_progressive_reach): over the first 4,000 cases the
# outcomes are counted, and the mode must both DECODE a share of its cases and
# REFUSE others as a progression error and as an entropy error — a mode whose
# mutations all die at the marker walk would pass every contract and test
# nothing.
# ================================================================
