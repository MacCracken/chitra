# chitra — BMP decode fuzz harness (`cyrius fuzz`).
#
# chitra's threat model is a HOSTILE ENCODED IMAGE: untrusted (src, len)
# bytes reach a public entry point. This harness drives the BMP path with
# adversarial input and asserts the two invariants every decode must hold,
# no matter how malformed the input:
#
#   1. SURVIVAL   — the decoder returns. It must not fault, corrupt memory,
#                   or loop forever on any byte sequence.
#   2. CONTRACT   — the documented result shape holds on every path:
#                   failure => returns 0 AND *err_out is a non-zero ChitraErr;
#                   success => non-zero image, err_out untouched (0), and
#                   width/height/pixels all sane.
#
# Invariant 2 is the one a crash-only fuzzer misses: a decoder that returns
# 0 without setting *err_out hands the caller a stale or zero error, and
# mabda maps ChitraErr straight onto GpuErr.
#
# Stack-array pointer note: `var buf[N]` reserves N bytes, but `buf` as an
# rvalue yields the first 8 bytes, not the address — pass `&buf`.

include "src/lib.cyr"
include "lib/assert.cyr"

# ================================================================
# Deterministic PRNG (LCG) — seeded per case so every failure reproduces.
# ================================================================
var _fuzz_state = 0;

fn _fuzz_seed(s): i64 {
    _fuzz_state = s;
    return 0;
}

fn _fuzz_next(): i64 {
    _fuzz_state = _fuzz_state * 6364136223846793005 + 1442695040888963407;
    return (_fuzz_state >> 33) & 255;
}

fn _fuzz_fill(buf, len): i64 {
    var i = 0;
    while (i < len) {
        store8(buf + i, _fuzz_next());
        i = i + 1;
    }
    return 0;
}

fn fx_bmp24_2x2(len_out): i64 {
    var b = alloc(70);
    store64(len_out, 70);
    store8(b + 0, 66);
    store8(b + 1, 77);
    store8(b + 2, 70);
    store8(b + 3, 0);
    store8(b + 4, 0);
    store8(b + 5, 0);
    store8(b + 6, 0);
    store8(b + 7, 0);
    store8(b + 8, 0);
    store8(b + 9, 0);
    store8(b + 10, 54);
    store8(b + 11, 0);
    store8(b + 12, 0);
    store8(b + 13, 0);
    store8(b + 14, 40);
    store8(b + 15, 0);
    store8(b + 16, 0);
    store8(b + 17, 0);
    store8(b + 18, 2);
    store8(b + 19, 0);
    store8(b + 20, 0);
    store8(b + 21, 0);
    store8(b + 22, 2);
    store8(b + 23, 0);
    store8(b + 24, 0);
    store8(b + 25, 0);
    store8(b + 26, 1);
    store8(b + 27, 0);
    store8(b + 28, 24);
    store8(b + 29, 0);
    store8(b + 30, 0);
    store8(b + 31, 0);
    store8(b + 32, 0);
    store8(b + 33, 0);
    store8(b + 34, 0);
    store8(b + 35, 0);
    store8(b + 36, 0);
    store8(b + 37, 0);
    store8(b + 38, 0);
    store8(b + 39, 0);
    store8(b + 40, 0);
    store8(b + 41, 0);
    store8(b + 42, 0);
    store8(b + 43, 0);
    store8(b + 44, 0);
    store8(b + 45, 0);
    store8(b + 46, 0);
    store8(b + 47, 0);
    store8(b + 48, 0);
    store8(b + 49, 0);
    store8(b + 50, 0);
    store8(b + 51, 0);
    store8(b + 52, 0);
    store8(b + 53, 0);
    store8(b + 54, 90);
    store8(b + 55, 80);
    store8(b + 56, 70);
    store8(b + 57, 120);
    store8(b + 58, 110);
    store8(b + 59, 100);
    store8(b + 60, 0);
    store8(b + 61, 0);
    store8(b + 62, 30);
    store8(b + 63, 20);
    store8(b + 64, 10);
    store8(b + 65, 60);
    store8(b + 66, 50);
    store8(b + 67, 40);
    store8(b + 68, 0);
    store8(b + 69, 0);
    return b;
}

# ================================================================
# The contract gate — the same two invariants the PNG/JPEG harnesses assert.
# ================================================================
fn _bmp_contract(buf, n, label): i64 {
    var err = 0;
    var img = chitra_bmp_decode(buf, n, &err);
    if (img == 0) {
        assert(err != 0, label);
        if (err != 0) {
            assert(chitra_err_code(err) != CHITRA_OK, label);
            assert(chitra_err_name(chitra_err_code(err)) != 0, label);
        }
    }
    if (img != 0) {
        assert(err == 0, label);
        assert(chitra_image_width(img) > 0, label);
        assert(chitra_image_height(img) > 0, label);
        assert(chitra_image_pixels(img) != 0, label);
        assert(chitra_image_channels(img) == 4, label);
        # BMP sentinel: src_ctype is 0x200 | bpp
        assert(chitra_image_source_color_type(img) > 512, label);
    }
    return 0;
}

fn _bmp_router_contract(buf, n, label): i64 {
    var err = 0;
    var img = chitra_image_decode(buf, n, &err);
    if (img == 0) { assert(err != 0, label); }
    if (img != 0) {
        assert(err == 0, label);
        assert(chitra_image_pixels(img) != 0, label);
    }
    return 0;
}

# ---- 1. Pure random bytes -------------------------------------------
fn fuzz_bmp_random(seed, n): i64 {
    _fuzz_seed(seed);
    var buf[512];
    var capped = n;
    if (capped > 512) { capped = 512; }
    if (capped < 0) { capped = 0; }
    _fuzz_fill(&buf, capped);
    _bmp_contract(&buf, capped, "bmp random bytes");
    _bmp_router_contract(&buf, capped, "router random bytes");
    return 0;
}

# ---- 2. 'BM' prefix + random tail -----------------------------------
# The high-value case: past the signature gate, the header parser is fed
# hostile dimensions, bpp values, compression ids, palette counts and — most
# importantly — a hostile pixel-data OFFSET, which is the one field that can
# point anywhere in (or past) the buffer.
fn fuzz_bmp_header(seed, n): i64 {
    _fuzz_seed(seed);
    var buf[512];
    var capped = n;
    if (capped > 510) { capped = 510; }
    if (capped < 0) { capped = 0; }
    store8(&buf + 0, 0x42);
    store8(&buf + 1, 0x4D);
    _fuzz_fill(&buf + 2, capped);
    _bmp_contract(&buf, capped + 2, "bmp BM + random header");
    return 0;
}

# ---- 3. Bit-flipped valid fixture ------------------------------------
# BMP has no checksum of any kind, so unlike PNG every mutation reaches the
# parser — nothing turns a corrupt file away before interpretation.
fn fuzz_bmp_mutate(seed, nmut): i64 {
    _fuzz_seed(seed);
    var lo = 0;
    var b = fx_bmp24_2x2(&lo);
    var m = 0;
    var pos = 0;
    while (m < nmut) {
        pos = (_fuzz_next() * 256 + _fuzz_next()) % lo;
        store8(b + pos, _fuzz_next());
        m = m + 1;
    }
    _bmp_contract(b, lo, "bmp mutated fixture");
    return 0;
}

# ---- 4. Header-only mutation ------------------------------------------
# Confine mutations to the 54-byte header span so the parser is always
# exercised on a plausible file rather than rejected at the magic.
fn fuzz_bmp_header_only(seed, nmut): i64 {
    _fuzz_seed(seed);
    var lo = 0;
    var b = fx_bmp24_2x2(&lo);
    var m = 0;
    var pos = 0;
    while (m < nmut) {
        pos = 2 + ((_fuzz_next() * 256 + _fuzz_next()) % 52);
        store8(b + pos, _fuzz_next());
        m = m + 1;
    }
    _bmp_contract(b, lo, "bmp header-only mutation");
    return 0;
}

# ---- 5. Truncation sweep + degenerate lengths -------------------------
fn fuzz_bmp_truncate(): i64 {
    var lo = 0;
    var b = fx_bmp24_2x2(&lo);
    var cut = 0;
    while (cut <= lo) {
        _bmp_contract(b, cut, "bmp truncated prefix");
        cut = cut + 1;
    }
    return 0;
}

fn fuzz_bmp_degenerate(): i64 {
    var lo = 0;
    var b = fx_bmp24_2x2(&lo);
    _bmp_contract(b, 0, "bmp len 0");
    _bmp_contract(b, 1, "bmp len 1");
    _bmp_contract(b, 2, "bmp len 2 (magic only)");
    _bmp_contract(b, 0 - 1, "bmp negative len");
    _bmp_contract(b, 0 - 1000000, "bmp large negative len");
    return 0;
}

# ---- Harness self-check ----------------------------------------------
fn fuzz_bmp_selfcheck(): i64 {
    var lo = 0;
    var b = fx_bmp24_2x2(&lo);
    var err = 0;
    var img = chitra_bmp_decode(b, lo, &err);
    assert(img != 0, "selfcheck: bmp fixture decodes clean");
    if (img != 0) {
        assert(chitra_image_width(img) == 2, "selfcheck: bmp fixture is 2 wide");
        assert(load8(chitra_image_pixels(img)) == 10, "selfcheck: bmp px0 red is 10");
    }
    assert(lo > 54, "selfcheck: fixture is larger than a bare header");
    return 0;
}

fn main(): i64 {
    var seed = 1;

    fuzz_bmp_selfcheck();
    println("fuzz_bmp: harness self-check passed (fixture valid, parser reachable)");

    seed = 1;
    while (seed <= 100000) {
        fuzz_bmp_random(seed * 2654435761, (seed * 7) % 512);
        seed = seed + 1;
    }
    println("fuzz_bmp: 100000 random-byte cases survived");

    seed = 1;
    while (seed <= 150000) {
        fuzz_bmp_header(seed * 40503, (seed * 11) % 510);
        seed = seed + 1;
    }
    println("fuzz_bmp: 150000 BM-prefixed header cases survived");

    seed = 1;
    while (seed <= 125000) {
        fuzz_bmp_mutate(seed * 97, (seed % 4) + 1);
        seed = seed + 1;
    }
    println("fuzz_bmp: 125000 mutated-fixture cases survived");

    seed = 1;
    while (seed <= 125000) {
        fuzz_bmp_header_only(seed * 313, (seed % 5) + 1);
        seed = seed + 1;
    }
    println("fuzz_bmp: 125000 header-only mutation cases survived");

    fuzz_bmp_truncate();
    println("fuzz_bmp: truncation sweep survived");

    fuzz_bmp_degenerate();
    println("fuzz_bmp: degenerate-length cases survived");

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
