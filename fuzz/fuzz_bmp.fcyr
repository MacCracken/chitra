# ================================================================
# The contract gate — the same two invariants the PNG/JPEG harnesses assert.
# ================================================================
fn _bmp_contract(buf, n, label): i64 {
    var err = 0;
    var img = chitra_bmp_decode(buf, n, &err);
    if (img == 0) {
        assert(err != 0, label);
        if (err != 0) {
            assert(chitra_err_code(err) != CHITRA_OK, label);
            assert(chitra_err_name(chitra_err_code(err)) != 0, label);
        }
    }
    if (img != 0) {
        assert(err == 0, label);
        assert(chitra_image_width(img) > 0, label);
        assert(chitra_image_height(img) > 0, label);
        assert(chitra_image_pixels(img) != 0, label);
        assert(chitra_image_channels(img) == 4, label);
        # BMP sentinel: src_ctype is 0x200 | bpp
        assert(chitra_image_source_color_type(img) > 512, label);
    }
    return 0;
}

fn _bmp_router_contract(buf, n, label): i64 {
    var err = 0;
    var img = chitra_image_decode(buf, n, &err);
    if (img == 0) { assert(err != 0, label); }
    if (img != 0) {
        assert(err == 0, label);
        assert(chitra_image_pixels(img) != 0, label);
    }
    return 0;
}

# ---- 1. Pure random bytes -------------------------------------------
fn fuzz_bmp_random(seed, n): i64 {
    _fuzz_seed(seed);
    var buf[512];
    var capped = n;
    if (capped > 512) { capped = 512; }
    if (capped < 0) { capped = 0; }
    _fuzz_fill(&buf, capped);
    _bmp_contract(&buf, capped, "bmp random bytes");
    _bmp_router_contract(&buf, capped, "router random bytes");
    return 0;
}

# ---- 2. 'BM' prefix + random tail -----------------------------------
# The high-value case: past the signature gate, the header parser is fed
# hostile dimensions, bpp values, compression ids, palette counts and — most
# importantly — a hostile pixel-data OFFSET, which is the one field that can
# point anywhere in (or past) the buffer.
fn fuzz_bmp_header(seed, n): i64 {
    _fuzz_seed(seed);
    var buf[512];
    var capped = n;
    if (capped > 510) { capped = 510; }
    if (capped < 0) { capped = 0; }
    store8(&buf + 0, 0x42);
    store8(&buf + 1, 0x4D);
    _fuzz_fill(&buf + 2, capped);
    _bmp_contract(&buf, capped + 2, "bmp BM + random header");
    return 0;
}

# ---- 3. Bit-flipped valid fixture ------------------------------------
# BMP has no checksum of any kind, so unlike PNG every mutation reaches the
# parser — nothing turns a corrupt file away before interpretation.
fn fuzz_bmp_mutate(seed, nmut): i64 {
    _fuzz_seed(seed);
    var lo = 0;
    var b = fx_bmp24_2x2(&lo);
    var m = 0;
    var pos = 0;
    while (m < nmut) {
        pos = (_fuzz_next() * 256 + _fuzz_next()) % lo;
        store8(b + pos, _fuzz_next());
        m = m + 1;
    }
    _bmp_contract(b, lo, "bmp mutated fixture");
    return 0;
}

# ---- 4. Header-only mutation ------------------------------------------
# Confine mutations to the 54-byte header span so the parser is always
# exercised on a plausible file rather than rejected at the magic.
fn fuzz_bmp_header_only(seed, nmut): i64 {
    _fuzz_seed(seed);
    var lo = 0;
    var b = fx_bmp24_2x2(&lo);
    var m = 0;
    var pos = 0;
    while (m < nmut) {
        pos = 2 + ((_fuzz_next() * 256 + _fuzz_next()) % 52);
        store8(b + pos, _fuzz_next());
        m = m + 1;
    }
    _bmp_contract(b, lo, "bmp header-only mutation");
    return 0;
}

# ---- RLE-stream-only mutation (0.5.1) --------------------------------
# The header is left intact so the mutation lands squarely in the run-length
# decode loop: hostile run counts, absolute lengths, and above all DELTA
# offsets, which move the write cursor by attacker-chosen (dx, dy) with no
# relation to what has been written. The loop's termination is structural —
# every opcode consumes at least two bytes — so what this exercises is whether
# the per-write and per-jump bounds checks actually hold.
fn fuzz_bmp_rle(seed, nmut): i64 {
    _fuzz_seed(seed);
    var lo = 0;
    var b = fx_bmp_rle8_real(&lo);
    # the RLE stream starts at the pixel-data offset (little-endian u32 at +10)
    var start = load8(b + 10) | (load8(b + 11) << 8) | (load8(b + 12) << 16);
    if (start <= 0) { return 0; }
    if (start >= lo) { return 0; }
    var span = lo - start;
    var m = 0;
    var pos = 0;
    while (m < nmut) {
        pos = start + ((_fuzz_next() * 256 + _fuzz_next()) % span);
        store8(b + pos, _fuzz_next());
        m = m + 1;
    }
    _bmp_contract(b, lo, "bmp RLE-stream mutation");
    return 0;
}

# Deltas are the sharpest opcode, so drive them deliberately rather than hoping
# random mutation produces one: splice an escape-2 (delta) with random dx/dy
# into the stream and require the decoder to either reject or stay in bounds.
fn fuzz_bmp_rle_delta(seed): i64 {
    _fuzz_seed(seed);
    var lo = 0;
    var b = fx_bmp_rle8_real(&lo);
    var start = load8(b + 10) | (load8(b + 11) << 8) | (load8(b + 12) << 16);
    if (start <= 0) { return 0; }
    if (start + 8 >= lo) { return 0; }
    var at = start + ((_fuzz_next() * 256 + _fuzz_next()) % (lo - start - 4));
    store8(b + at + 0, 0);
    store8(b + at + 1, 2);
    store8(b + at + 2, _fuzz_next());
    store8(b + at + 3, _fuzz_next());
    _bmp_contract(b, lo, "bmp RLE delta splice");
    return 0;
}

# ---- 5. Truncation sweep + degenerate lengths -------------------------
fn fuzz_bmp_truncate(): i64 {
    var lo = 0;
    var b = fx_bmp24_2x2(&lo);
    var cut = 0;
    while (cut <= lo) {
        _bmp_contract(b, cut, "bmp truncated prefix");
        cut = cut + 1;
    }
    return 0;
}

fn fuzz_bmp_degenerate(): i64 {
    var lo = 0;
    var b = fx_bmp24_2x2(&lo);
    _bmp_contract(b, 0, "bmp len 0");
    _bmp_contract(b, 1, "bmp len 1");
    _bmp_contract(b, 2, "bmp len 2 (magic only)");
    _bmp_contract(b, 0 - 1, "bmp negative len");
    _bmp_contract(b, 0 - 1000000, "bmp large negative len");
    return 0;
}

# ---- Harness self-check ----------------------------------------------
fn fuzz_bmp_selfcheck(): i64 {
    var lo = 0;
    var b = fx_bmp24_2x2(&lo);
    var err = 0;
    var img = chitra_bmp_decode(b, lo, &err);
    assert(img != 0, "selfcheck: bmp fixture decodes clean");
    if (img != 0) {
        assert(chitra_image_width(img) == 2, "selfcheck: bmp fixture is 2 wide");
        assert(load8(chitra_image_pixels(img)) == 10, "selfcheck: bmp px0 red is 10");
    }
    assert(lo > 54, "selfcheck: fixture is larger than a bare header");
    var rlo = 0;
    var rb = fx_bmp_rle8_real(&rlo);
    var rerr = 0;
    assert(chitra_bmp_decode(rb, rlo, &rerr) != 0, "selfcheck: RLE8 fixture decodes clean");
    return 0;
}

fn main(): i64 {
    var seed = 1;

    fuzz_bmp_selfcheck();
    println("fuzz_bmp: harness self-check passed (fixture valid, parser reachable)");

    seed = 1;
    while (seed <= 100000) {
        fuzz_bmp_random(seed * 2654435761, (seed * 7) % 512);
        seed = seed + 1;
    }
    println("fuzz_bmp: 100000 random-byte cases survived");

    seed = 1;
    while (seed <= 150000) {
        fuzz_bmp_header(seed * 40503, (seed * 11) % 510);
        seed = seed + 1;
    }
    println("fuzz_bmp: 150000 BM-prefixed header cases survived");

    seed = 1;
    while (seed <= 125000) {
        fuzz_bmp_mutate(seed * 97, (seed % 4) + 1);
        seed = seed + 1;
    }
    println("fuzz_bmp: 125000 mutated-fixture cases survived");

    seed = 1;
    while (seed <= 125000) {
        fuzz_bmp_header_only(seed * 313, (seed % 5) + 1);
        seed = seed + 1;
    }
    println("fuzz_bmp: 125000 header-only mutation cases survived");

    seed = 1;
    while (seed <= 100000) {
        fuzz_bmp_rle(seed * 733, (seed % 5) + 1);
        seed = seed + 1;
    }
    println("fuzz_bmp: 100000 RLE-stream mutation cases survived");

    seed = 1;
    while (seed <= 100000) {
        fuzz_bmp_rle_delta(seed * 911);
        seed = seed + 1;
    }
    println("fuzz_bmp: 100000 RLE delta-splice cases survived");

    fuzz_bmp_truncate();
    println("fuzz_bmp: truncation sweep survived");

    fuzz_bmp_degenerate();
    println("fuzz_bmp: degenerate-length cases survived");

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
