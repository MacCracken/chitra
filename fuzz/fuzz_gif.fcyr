    store8(b + 1120, 0);
    store8(b + 1121, 59);
    return b;
}

# ================================================================
# The contract gate — the same two invariants the other harnesses assert.
# ================================================================
fn _gif_contract(buf, n, label): i64 {
    var err = 0;
    var img = chitra_gif_decode(buf, n, &err);
    if (img == 0) {
        assert(err != 0, label);
        if (err != 0) {
            assert(chitra_err_code(err) != CHITRA_OK, label);
            # Not `!= 0`: chitra_err_name never returns 0, so that could not
            # fail (gate-13, 1.1.1). An unnamed code prints the fallback.
            assert(streq(chitra_err_name(chitra_err_code(err)), "unknown error") == 0, label);
        }
    }
    if (img != 0) {
        assert(err == 0, label);
        assert(chitra_image_width(img) > 0, label);
        assert(chitra_image_height(img) > 0, label);
        assert(chitra_image_pixels(img) != 0, label);
        assert(chitra_image_channels(img) == 4, label);
        assert(chitra_image_source_color_type(img) > 768, label);
    }
    return 0;
}

# The public _rgba8 wrapper. Unfuzzed through 0.7.2 on every format, and it is
# about to be frozen. Its contract is an ordering one: it zeroes the
# CALLER-OWNED w_out/h_out slots BEFORE attempting the decode, so a failure
# leaves the caller with 0/0 rather than a stale or half-written size it might
# act on. That is the property worth pinning adversarially.
fn _gif_rgba8_contract(buf, n, label): i64 {
    var w = 0 - 1;
    var h = 0 - 1;
    var px = chitra_gif_decode_rgba8(buf, n, &w, &h);
    if (px == 0) {
        assert(w == 0, label);
        assert(h == 0, label);
    }
    if (px != 0) {
        assert(w > 0, label);
        assert(h > 0, label);
    }
    return 0;
}

fn _gif_router_contract(buf, n, label): i64 {
    var err = 0;
    var img = chitra_image_decode(buf, n, &err);
    if (img == 0) { assert(err != 0, label); }
    if (img != 0) {
        assert(err == 0, label);
        assert(chitra_image_pixels(img) != 0, label);
    }
    return 0;
}

# Locate the LZW min-code-size byte by scanning for the image descriptor, so
# the entropy-targeting cases below cannot silently drift onto the wrong byte.
fn _gif_lzw_start(b, lo): i64 {
    var i = 0;
    var at = 0 - 1;
    while (i < lo) {
        if (at < 0) {
            if (load8(b + i) == 0x2C) { at = i; }
        }
        i = i + 1;
    }
    if (at < 0) { return 0 - 1; }
    var ipacked = load8(b + at + 9);
    var after = at + 10;
    if ((ipacked & 0x80) != 0) { after = after + 3 * (1 << ((ipacked & 7) + 1)); }
    return after;
}

# The fixtures: 0 big (48 wide, the workhorse), 1 plain, 2 long.
fn _gif_fixture(k, len_out): i64 {
    if (k == 1) { return fx_gif_plain(len_out); }
    if (k == 2) { return fx_gif_long(len_out); }
    return fx_gif_big(len_out);
}

# ---- 1. Pure random bytes -------------------------------------------
fn fuzz_gif_random(seed, n): i64 {
    _fuzz_seed(seed);
    var buf[512];
    var capped = n;
    if (capped > 512) { capped = 512; }
    if (capped < 0) { capped = 0; }
    _fuzz_fill(&buf, capped);
    _gif_contract(&buf, capped, "gif random bytes");
    _gif_router_contract(&buf, capped, "router random bytes");
    return 0;
}

# ---- 2. "GIF89a" prefix + random tail --------------------------------
# Past the signature gate: the screen descriptor, the color-table sizing, the
# block walk and the sub-block chains all get hostile input. The block walk is
# the interesting part — a chain that never terminates, or one whose length
# bytes march off the end, must not loop or overread.
fn fuzz_gif_header(seed, n): i64 {
    _fuzz_seed(seed);
    var buf[512];
    var capped = n;
    if (capped > 506) { capped = 506; }
    if (capped < 0) { capped = 0; }
    store8(&buf + 0, 0x47);
    store8(&buf + 1, 0x49);
    store8(&buf + 2, 0x46);
    store8(&buf + 3, 0x38);
    store8(&buf + 4, 0x39);
    store8(&buf + 5, 0x61);
    _fuzz_fill(&buf + 6, capped);
    _gif_contract(&buf, capped + 6, "gif GIF89a + random");
    return 0;
}

# ---- 3. Bit-flipped valid fixture ------------------------------------
# GIF, like BMP and JPEG, carries no checksum — every mutation reaches the
# parser. `k` is the case number: one case in 32 takes the long fixture, one in
# 32 the plain one, the rest the big one.
fn fuzz_gif_mutate(seed, k, nmut): i64 {
    _fuzz_seed(seed);
    var lo = 0;
    var f = 0;
    if ((k % 32) == 30) { f = 1; }
    if ((k % 32) == 31) { f = 2; }
    var b = _gif_fixture(f, &lo);
    var m = 0;
    var pos = 0;
    while (m < nmut) {
        pos = (_fuzz_next() * 256 + _fuzz_next()) % lo;
        store8(b + pos, _fuzz_next());
        m = m + 1;
    }
    _gif_contract(b, lo, "gif mutated fixture");
    _gif_rgba8_contract(b, lo, "gif mutated fixture (_rgba8 wrapper)");
    return 0;
}

# ---- 4. LZW-STREAM-ONLY mutation (the priority target) ----------------
# The header is left intact so the block walk succeeds and hostile bits land
# squarely in the decompressor: bad codes, codes past next_code, dictionary
# chains that could cycle, and expansions that would run past the frame. LZW
# is the one decompressor chitra implements itself — sankoch supplies DEFLATE,
# not LZW — so this is the case this harness exists for. 1.1.1: one case in 16
# (`k` is the case number) mutates the long fixture, so a flip can land after
# the dictionary is full — a code past 4095, a stray Clear, an early End.
fn fuzz_gif_lzw(seed, k, nmut): i64 {
    _fuzz_seed(seed);
    var lo = 0;
    var f = 0;
    if ((k % 16) == 15) { f = 2; }
    var b = _gif_fixture(f, &lo);
    var start = _gif_lzw_start(b, lo);
    if (start < 0) { return 0; }
    var span = lo - start;
    if (span <= 0) { return 0; }
    var m = 0;
    var pos = 0;
    while (m < nmut) {
        pos = start + ((_fuzz_next() * 256 + _fuzz_next()) % span);
        store8(b + pos, _fuzz_next());
        m = m + 1;
    }
    _gif_contract(b, lo, "gif LZW-stream mutation");
    return 0;
}

# ---- 6. decode_budget (1.1.1, cc-11) ----------------------------------
# chitra_image_decode_budget is frozen, and it reads the GIF logical screen
# itself (_chitra_declared_rgba_bytes) before the router decodes. No harness
# called it through 1.1.0. Its one promise is that no image it returns exceeds
# max_bytes of RGBA8; its failure shape is (0, *err_out set). A budget of
# exactly the output must decode — a refusal there is the walker disagreeing
# with the decoder — and one byte under must refuse as CHITRA_ERR_BUDGET.
fn _budget_one(buf, n, max, code_out, label): i64 {
    var err = 0;
    store64(code_out, 0);
    var img = chitra_image_decode_budget(buf, n, max, &err);
    if (img == 0) {
        assert(err != 0, label);
        if (err != 0) {
            store64(code_out, chitra_err_code(err));
            assert(chitra_err_code(err) != CHITRA_OK, label);
        }
    }
    if (img != 0) {
        assert(err == 0, label);
        assert(chitra_image_width(img) * chitra_image_height(img) * 4 <= max, label);
    }
    return img;
}

fn _budget_contract(buf, n, label): i64 {
    var err = 0;
    var code = 0;
    var ref = chitra_image_decode(buf, n, &err);
    if (ref != 0) {
        var out = chitra_image_width(ref) * chitra_image_height(ref) * 4;
        assert(_budget_one(buf, n, out - 1, &code, label) == 0, label);
        assert(code == CHITRA_ERR_BUDGET, label);
        assert(_budget_one(buf, n, out, &code, label) != 0, label);
    }
    if (ref == 0) {
        # An input that does not decode: an arbitrary budget, 0 to ~16 MB on a
        # log scale, must still refuse with *err_out set. (At most two decodes a
        # case — every one is heap the bump allocator never gives back.)
        var r = (_fuzz_next() << 16) | (_fuzz_next() << 8) | _fuzz_next();
        _budget_one(buf, n, r >> (_fuzz_next() % 24), &code, label);
    }
    return 0;
}

# Untouched, flipped in the screen descriptor (which is what the walker reads),
# or flipped anywhere. `k` is the case number: one case in 16 takes the long
# fixture, three the plain one, the rest the big one.
fn fuzz_gif_budget(seed, k): i64 {
    _fuzz_seed(seed);
    var lo = 0;
    var f = 0;
    if ((k % 16) >= 12) { f = 1; }
    if ((k % 16) == 15) { f = 2; }
    var b = _gif_fixture(f, &lo);
    var kind = (k / 16) % 3;
    var at = 6 + (_fuzz_next() % 7);
    # Not the HIGH bytes of the screen size: those declare a canvas of up to
    # 4 G pixels, every one of which this mode would then decode four times.
    # Mode 3 flips them; here the low bytes move the walker's answer enough.
    if (at == 7 || at == 9) { at = at - 1; }
    if (kind == 1) { store8(b + at, _fuzz_next()); }
    if (kind == 2) { store8(b + ((_fuzz_next() * 256 + _fuzz_next()) % lo), _fuzz_next()); }
    _budget_contract(b, lo, "gif decode_budget");
    return 0;
}

# ---- 5. Truncation + degenerate lengths ------------------------------
fn fuzz_gif_truncate(): i64 {
    var lo = 0;
    var b = fx_gif_plain(&lo);
    var cut = 0;
    while (cut <= lo) {
        _gif_contract(b, cut, "gif truncated prefix");
        cut = cut + 1;
    }
    # 1.1.1: the long fixture too — every 7th prefix, plus the last 64 (a cut
    # inside the table-full codes, the End code, the terminator, the trailer).
    b = fx_gif_long(&lo);
    cut = 0;
    while (cut <= lo) {
        if ((cut % 7) == 0 || cut + 64 >= lo) {
            _gif_contract(b, cut, "gif truncated prefix (long)");
        }
        cut = cut + 1;
    }
    return 0;
}

fn fuzz_gif_degenerate(): i64 {
    var lo = 0;
    var b = fx_gif_plain(&lo);
    _gif_contract(b, 0, "gif len 0");
    _gif_contract(b, 6, "gif len 6 (signature only)");
    _gif_contract(b, 13, "gif len 13 (screen descriptor only)");
    _gif_contract(b, 0 - 1, "gif negative len");
    _gif_contract(b, 0 - 1000000, "gif large negative len");
    return 0;
}

# ---- Harness self-check ----------------------------------------------
fn fuzz_gif_selfcheck(): i64 {
    var lo = 0;
    var b = fx_gif_plain(&lo);
    var err = 0;
    assert(chitra_gif_decode(b, lo, &err) != 0, "selfcheck: plain fixture decodes");

    var blo = 0;
    var bb = fx_gif_big(&blo);
    var berr = 0;
    var bimg = chitra_gif_decode(bb, blo, &berr);
    assert(bimg != 0, "selfcheck: big fixture decodes");
    if (bimg != 0) {
        assert(chitra_image_width(bimg) == 48, "selfcheck: big fixture is 48 wide");
    }
    var start = _gif_lzw_start(bb, blo);
    assert(start > 0, "selfcheck: LZW stream located");
    assert(blo - start > 256, "selfcheck: LZW span is wide enough to fuzz");
    # 1.1.1: the long fixture must decode, at 64x65, and its stream must be long
    # enough to fill the dictionary — 4,160 literal codes of >= 3 bits each — or
    # the table-full state would silently stop being reached.
    var llo = 0;
    var lb = fx_gif_long(&llo);
    assert(lb != 0, "selfcheck: long fixture builds");
    var lerr = 0;
    var limg = chitra_gif_decode(lb, llo, &lerr);
    assert(limg != 0, "selfcheck: long fixture decodes");
    if (limg != 0) {
        assert(chitra_image_width(limg) == 64, "selfcheck: long fixture is 64 wide");
        assert(chitra_image_height(limg) == 65, "selfcheck: long fixture is 65 tall");
    }
    assert(llo - _gif_lzw_start(lb, llo) > 5600, "selfcheck: long stream fills the dictionary");
    return 0;
}

# ---- Heap epochs (1.1.1) ----------------------------------------------
# cyrius's bump allocator never frees, so every case's decode used to stay on
# the heap until exit: before this, fuzz_jpeg peaked at ~16 GB RSS and fuzz_gif
# at ~9 GB, against a 16 GB CI runner. main() now calls _fuzz_epoch(case) after
# every case and _fuzz_reclaim() after every mode; every FUZZ_EPOCH cases that
#   1. under --poison, SWEEPS every live block first. alloc_reset() makes the
#      poison layer forget its blocks, so without this an overwrite made since
#      the last periodic sweep would never be checked — the gate-2 class;
#   2. alloc_reset()s the heap back to its first 256 MB chunk (an epoch must
#      fit in it: a spill maps a new chunk that a reset abandons, still
#      resident — which is why the epoch is a case count, kept small);
#   3. drops every heap pointer this harness memoizes, so nothing survives the
#      reset as a dangling pointer. The caches below rebuild lazily.
# Call it only BETWEEN cases: nothing a case allocated may be live after it.
# chitra itself memoizes nothing on the heap (its tables are BSS); the stdlib
# assert counters are plain globals.
enum FuzzEpoch {
    FUZZ_EPOCH = 1024;
}

fn _fuzz_reclaim(): i64 {
    #ifdef CYRIUS_POISON
    var pz = poison_sweep();
    if (pz > 0) { assert_eq(pz, 0, "poison_sweep() before alloc_reset: changed redzones"); }
    #endif
    alloc_reset();
    _fx_gif_long_cache = 0;
    _fx_gif_long_len = 0;
    return 0;
}

fn _fuzz_epoch(n): i64 {
    if ((n % FUZZ_EPOCH) == 0) { _fuzz_reclaim(); }
    return 0;
}

fn main(): i64 {
    var seed = 1;

    fuzz_gif_selfcheck();
    _fuzz_reclaim();
    println("fuzz_gif: harness self-check passed (3 fixtures valid, LZW reachable, table fills)");

    seed = 1;
    while (seed <= 100000) {
        fuzz_gif_random(seed * 2654435761, (seed * 7) % 512);
        _fuzz_epoch(seed);
        seed = seed + 1;
    }
    _fuzz_reclaim();
    println("fuzz_gif: 100000 random-byte cases survived");

    seed = 1;
    while (seed <= 150000) {
        fuzz_gif_header(seed * 40503, (seed * 11) % 506);
        _fuzz_epoch(seed);
        seed = seed + 1;
    }
    _fuzz_reclaim();
    println("fuzz_gif: 150000 GIF89a-prefixed header/block-walk cases survived");

    seed = 1;
    while (seed <= 60000) {
        fuzz_gif_mutate(seed * 97, seed, (seed % 4) + 1);
        _fuzz_epoch(seed);
        seed = seed + 1;
    }
    _fuzz_reclaim();
    println("fuzz_gif: 60000 mutated-fixture cases survived (3 fixtures)");

    seed = 1;
    while (seed <= 60000) {
        fuzz_gif_lzw(seed * 313, seed, (seed % 6) + 1);
        _fuzz_epoch(seed);
        seed = seed + 1;
    }
    _fuzz_reclaim();
    println("fuzz_gif: 60000 LZW-stream mutation cases survived (3750 past a full table)");

    seed = 1;
    while (seed <= 6000) {
        fuzz_gif_budget(seed * 2654435761, seed);
        _fuzz_epoch(seed);
        seed = seed + 1;
    }
    _fuzz_reclaim();
    println("fuzz_gif: 6000 decode_budget cases survived (3 fixtures)");

    fuzz_gif_truncate();
    _fuzz_reclaim();
    println("fuzz_gif: truncation sweep survived (plain + long)");

    fuzz_gif_degenerate();
    _fuzz_reclaim();
    println("fuzz_gif: degenerate-length cases survived");

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
