# chitra — GIF decode fuzz harness (`cyrius fuzz`).
#
# chitra's threat model is a HOSTILE ENCODED IMAGE: untrusted (src, len)
# bytes reach a public entry point. This harness drives the GIF path with
# adversarial input and asserts the two invariants every decode must hold,
# no matter how malformed the input:
#
#   1. SURVIVAL   — the decoder returns. It must not fault, corrupt memory,
#                   or loop forever on any byte sequence.
#   2. CONTRACT   — the documented result shape holds on every path:
#                   failure => returns 0 AND *err_out is a non-zero ChitraErr;
#                   success => non-zero image, err_out untouched (0), and
#                   width/height/pixels all sane.
#
# Invariant 2 is the one a crash-only fuzzer misses: a decoder that returns
# 0 without setting *err_out hands the caller a stale or zero error, and
# mabda maps ChitraErr straight onto GpuErr.
#
# FIXTURES (1.1.1, gate-3). Neither fixture's stream is long enough to fill the
# LZW dictionary, so the table-full state — next_code at 4096, the 12-bit width
# cap, and every code after it adding nothing — never executed under fuzzing.
# fx_gif_long (generated below) fills it. The self-check decodes all three
# fixtures, and the bit-flip, LZW-stream, truncation and decode_budget modes
# rotate across them. The long fixture costs ~95 KB a decode (a full 4096-entry
# dictionary) on an allocator that never frees, so it takes a SMALL share of
# each mode rather than an equal one. Run under `cyrius fuzz --poison`.
#
# Stack-array pointer note: `var buf[N]` reserves N bytes, but `buf` as an
# rvalue yields the first 8 bytes, not the address — pass `&buf`.

include "src/lib.cyr"
include "lib/assert.cyr"

# ================================================================
# Deterministic PRNG (LCG) — seeded per case so every failure reproduces.
# ================================================================
var _fuzz_state = 0;

fn _fuzz_seed(s): i64 {
    _fuzz_state = s;
    return 0;
}

fn _fuzz_next(): i64 {
    _fuzz_state = _fuzz_state * 6364136223846793005 + 1442695040888963407;
    return (_fuzz_state >> 33) & 255;
}

fn _fuzz_fill(buf, len): i64 {
    var i = 0;
    while (i < len) {
        store8(buf + i, _fuzz_next());
        i = i + 1;
    }
    return 0;
}

fn fx_gif_plain(len_out): i64 {
    var b = alloc(54);
    store64(len_out, 54);
    store8(b + 0, 71);
    store8(b + 1, 73);
    store8(b + 2, 70);
    store8(b + 3, 56);
    store8(b + 4, 57);
    store8(b + 5, 97);
