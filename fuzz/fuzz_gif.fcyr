    store8(b + 10, 241);
    store8(b + 11, 0);
    store8(b + 12, 0);
    store8(b + 13, 255);
    store8(b + 14, 0);
    store8(b + 15, 0);
    store8(b + 16, 0);
    store8(b + 17, 255);
    store8(b + 18, 0);
    store8(b + 19, 255);
    store8(b + 20, 255);
    store8(b + 21, 0);
    store8(b + 22, 0);
    store8(b + 23, 0);
    store8(b + 24, 255);
    store8(b + 25, 33);
    store8(b + 26, 249);
    store8(b + 27, 4);
    store8(b + 28, 0);
    store8(b + 29, 0);
    store8(b + 30, 0);
    store8(b + 31, 0);
    store8(b + 32, 0);
    store8(b + 33, 44);
    store8(b + 34, 0);
    store8(b + 35, 0);
    store8(b + 36, 0);
    store8(b + 37, 0);
    store8(b + 38, 4);
    store8(b + 39, 0);
    store8(b + 40, 4);
    store8(b + 41, 0);
    store8(b + 42, 0);
    store8(b + 43, 2);
    store8(b + 44, 7);
    store8(b + 45, 68);
    store8(b + 46, 38);
    store8(b + 47, 39);
    store8(b + 48, 128);
    store8(b + 49, 182);
    store8(b + 50, 87);
    store8(b + 51, 0);
    store8(b + 52, 0);
    store8(b + 53, 59);
    return b;
}

fn _fx_copy(src, n): i64 {
    var b = alloc(n);
    var i = 0;
    while (i < n) {
        store8(b + i, load8(src + i));
        i = i + 1;
    }
    return b;
}

# ---- The long-stream fixture (1.1.1, gate-3) ---------------------------
# fx_gif_plain / fx_gif_big are small enough that the LZW dictionary never
# fills, so the TABLE-FULL state — next_code at 4096, the 12-bit width cap, and
# every code after that adding nothing — was never executed under fuzzing. This
# GENERATES a 64x65 4-colour GIF whose stream is literal-only (one code per
# pixel, and no Clear when the table fills: GIF89a lets an encoder skip it, and
# the decoder then just stops adding entries). 4,090 codes fill the dictionary
# and the last 69 run in the table-full state. ImageMagick
# decodes these exact bytes to the intended pixels (checked at 1.1.1).
var _fx_gif_long_cache = 0;
var _fx_gif_long_len = 0;

# LSB-first bit packer: st+0 buffer, +8 byte position, +16 accumulator, +24 bit count.
fn _lzw_emit(st, code, w): i64 {
    var buf = load64(st);
    var pos = load64(st + 8);
    var nacc = load64(st + 24);
    var acc = load64(st + 16) | (code << nacc);
    nacc = nacc + w;
    while (nacc >= 8) {
        store8(buf + pos, acc & 255);
        pos = pos + 1;
        acc = acc >> 8;
        nacc = nacc - 8;
    }
    store64(st + 8, pos);
    store64(st + 16, acc);
    store64(st + 24, nacc);
    return 0;
}

fn _fx_gif_long_build(): i64 {
    var w = 64;
    var h = 65;
    var npx = w * h;
    var lzw = alloc(npx * 2 + 16);
    if (lzw == 0) { return 0; }
    var st[32];
    store64(&st, lzw);
    store64(&st + 8, 0);
    store64(&st + 16, 0);
    store64(&st + 24, 0);
    # The decoder's width schedule, mirrored: an entry is added for every code
    # after the first, and the width grows when next_code reaches 1 << width.
    var width = 3;
    var next = 6;
    var first = 1;
    var s = 12345;
    var i = 0;
    _lzw_emit(&st, 4, width);                 # Clear
    while (i < npx) {
        s = (s * 1103515245 + 12345) & 0x7FFFFFFF;
        _lzw_emit(&st, (s >> 16) & 3, width);
        if (first == 0) {
            if (next < 4096) {
                next = next + 1;
                if (next == (1 << width)) {
                    if (width < 12) { width = width + 1; }
                }
            }
        }
        first = 0;
        i = i + 1;
    }
    _lzw_emit(&st, 5, width);                 # End
    var zl = load64(&st + 8);
    if (load64(&st + 24) > 0) {
        store8(lzw + zl, load64(&st + 16) & 255);
        zl = zl + 1;
    }
    var nblk = (zl + 254) / 255;
    var total = 13 + 12 + 11 + nblk + zl + 2;
    var g = alloc(total);
    if (g == 0) { return 0; }
    store8(g + 0, 0x47);                      # GIF89a
    store8(g + 1, 0x49);
    store8(g + 2, 0x46);
    store8(g + 3, 0x38);
    store8(g + 4, 0x39);
    store8(g + 5, 0x61);
    store8(g + 6, w);                         # logical screen 64 x 65
    store8(g + 7, 0);
    store8(g + 8, h);
    store8(g + 9, 0);
    store8(g + 10, 0x81);                     # global table, 4 entries
    store8(g + 11, 0);
    store8(g + 12, 0);
    i = 0;
    while (i < 12) {                          # black, red, green, blue
        store8(g + 13 + i, 0);
        i = i + 1;
    }
    store8(g + 16, 255);
    store8(g + 20, 255);
    store8(g + 24, 255);
    store8(g + 25, 0x2C);                     # image descriptor, full screen
    i = 0;
    while (i < 4) {
        store8(g + 26 + i, 0);
        i = i + 1;
    }
    store8(g + 30, w);
    store8(g + 31, 0);
    store8(g + 32, h);
    store8(g + 33, 0);
    store8(g + 34, 0);
    store8(g + 35, 2);                        # LZW minimum code size
    var at = 36;
    var done = 0;
    var take = 0;
    while (done < zl) {
        take = zl - done;
        if (take > 255) { take = 255; }
        store8(g + at, take);
        at = at + 1;
        i = 0;
        while (i < take) {
            store8(g + at + i, load8(lzw + done + i));
            i = i + 1;
        }
        at = at + take;
        done = done + take;
    }
    store8(g + at, 0);                        # block terminator
    store8(g + at + 1, 0x3B);                 # trailer
    _fx_gif_long_len = at + 2;
    return g;
}

fn fx_gif_long(len_out): i64 {
    if (_fx_gif_long_cache == 0) { _fx_gif_long_cache = _fx_gif_long_build(); }
    store64(len_out, _fx_gif_long_len);
    if (_fx_gif_long_cache == 0) { return 0; }
    return _fx_copy(_fx_gif_long_cache, _fx_gif_long_len);
}

