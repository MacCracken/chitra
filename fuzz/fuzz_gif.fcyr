    store8(b + 1081, 36);
    store8(b + 1082, 6);
    store8(b + 1083, 157);
    store8(b + 1084, 102);
    store8(b + 1085, 69);
    store8(b + 1086, 141);
    store8(b + 1087, 185);
    store8(b + 1088, 65);
