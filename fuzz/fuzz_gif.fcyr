# ================================================================
# The contract gate — the same two invariants the other harnesses assert.
# ================================================================
fn _gif_contract(buf, n, label): i64 {
    var err = 0;
    var img = chitra_gif_decode(buf, n, &err);
    if (img == 0) {
        assert(err != 0, label);
        if (err != 0) {
            assert(chitra_err_code(err) != CHITRA_OK, label);
            assert(chitra_err_name(chitra_err_code(err)) != 0, label);
        }
    }
    if (img != 0) {
        assert(err == 0, label);
        assert(chitra_image_width(img) > 0, label);
        assert(chitra_image_height(img) > 0, label);
        assert(chitra_image_pixels(img) != 0, label);
        assert(chitra_image_channels(img) == 4, label);
        assert(chitra_image_source_color_type(img) > 768, label);
    }
    return 0;
}

# The public _rgba8 wrapper. Unfuzzed through 0.7.2 on every format, and it is
# about to be frozen. Its contract is an ordering one: it zeroes the
# CALLER-OWNED w_out/h_out slots BEFORE attempting the decode, so a failure
# leaves the caller with 0/0 rather than a stale or half-written size it might
# act on. That is the property worth pinning adversarially.
fn _gif_rgba8_contract(buf, n, label): i64 {
    var w = 0 - 1;
    var h = 0 - 1;
    var px = chitra_gif_decode_rgba8(buf, n, &w, &h);
    if (px == 0) {
        assert(w == 0, label);
        assert(h == 0, label);
    }
    if (px != 0) {
        assert(w > 0, label);
        assert(h > 0, label);
    }
    return 0;
}

fn _gif_router_contract(buf, n, label): i64 {
    var err = 0;
    var img = chitra_image_decode(buf, n, &err);
    if (img == 0) { assert(err != 0, label); }
    if (img != 0) {
        assert(err == 0, label);
        assert(chitra_image_pixels(img) != 0, label);
    }
    return 0;
}

# Locate the LZW min-code-size byte by scanning for the image descriptor, so
# the entropy-targeting cases below cannot silently drift onto the wrong byte.
fn _gif_lzw_start(b, lo): i64 {
    var i = 0;
    var at = 0 - 1;
    while (i < lo) {
        if (at < 0) {
            if (load8(b + i) == 0x2C) { at = i; }
        }
        i = i + 1;
    }
    if (at < 0) { return 0 - 1; }
    var ipacked = load8(b + at + 9);
    var after = at + 10;
    if ((ipacked & 0x80) != 0) { after = after + 3 * (1 << ((ipacked & 7) + 1)); }
    return after;
}

# ---- 1. Pure random bytes -------------------------------------------
fn fuzz_gif_random(seed, n): i64 {
    _fuzz_seed(seed);
    var buf[512];
    var capped = n;
    if (capped > 512) { capped = 512; }
    if (capped < 0) { capped = 0; }
    _fuzz_fill(&buf, capped);
    _gif_contract(&buf, capped, "gif random bytes");
    _gif_router_contract(&buf, capped, "router random bytes");
    return 0;
}

# ---- 2. "GIF89a" prefix + random tail --------------------------------
# Past the signature gate: the screen descriptor, the color-table sizing, the
# block walk and the sub-block chains all get hostile input. The block walk is
# the interesting part — a chain that never terminates, or one whose length
# bytes march off the end, must not loop or overread.
fn fuzz_gif_header(seed, n): i64 {
    _fuzz_seed(seed);
    var buf[512];
    var capped = n;
    if (capped > 506) { capped = 506; }
    if (capped < 0) { capped = 0; }
    store8(&buf + 0, 0x47);
    store8(&buf + 1, 0x49);
    store8(&buf + 2, 0x46);
    store8(&buf + 3, 0x38);
    store8(&buf + 4, 0x39);
    store8(&buf + 5, 0x61);
    _fuzz_fill(&buf + 6, capped);
    _gif_contract(&buf, capped + 6, "gif GIF89a + random");
    return 0;
}

# ---- 3. Bit-flipped valid fixture ------------------------------------
# GIF, like BMP and JPEG, carries no checksum — every mutation reaches the
# parser.
fn fuzz_gif_mutate(seed, nmut): i64 {
    _fuzz_seed(seed);
    var lo = 0;
    var b = fx_gif_big(&lo);
    var m = 0;
    var pos = 0;
    while (m < nmut) {
        pos = (_fuzz_next() * 256 + _fuzz_next()) % lo;
        store8(b + pos, _fuzz_next());
        m = m + 1;
    }
    _gif_contract(b, lo, "gif mutated fixture");
    _gif_rgba8_contract(b, lo, "gif mutated fixture (_rgba8 wrapper)");
    return 0;
}

# ---- 4. LZW-STREAM-ONLY mutation (the priority target) ----------------
# The header is left intact so the block walk succeeds and hostile bits land
# squarely in the decompressor: bad codes, codes past next_code, dictionary
# chains that could cycle, and expansions that would run past the frame. LZW
# is the one decompressor chitra implements itself — sankoch supplies DEFLATE,
# not LZW — so this is the case this harness exists for.
fn fuzz_gif_lzw(seed, nmut): i64 {
    _fuzz_seed(seed);
    var lo = 0;
    var b = fx_gif_big(&lo);
    var start = _gif_lzw_start(b, lo);
    if (start < 0) { return 0; }
    var span = lo - start;
    if (span <= 0) { return 0; }
    var m = 0;
    var pos = 0;
    while (m < nmut) {
        pos = start + ((_fuzz_next() * 256 + _fuzz_next()) % span);
        store8(b + pos, _fuzz_next());
        m = m + 1;
    }
    _gif_contract(b, lo, "gif LZW-stream mutation");
    return 0;
}

# ---- 5. Truncation + degenerate lengths ------------------------------
fn fuzz_gif_truncate(): i64 {
    var lo = 0;
    var b = fx_gif_plain(&lo);
    var cut = 0;
    while (cut <= lo) {
        _gif_contract(b, cut, "gif truncated prefix");
        cut = cut + 1;
    }
    return 0;
}

fn fuzz_gif_degenerate(): i64 {
    var lo = 0;
    var b = fx_gif_plain(&lo);
    _gif_contract(b, 0, "gif len 0");
    _gif_contract(b, 6, "gif len 6 (signature only)");
    _gif_contract(b, 13, "gif len 13 (screen descriptor only)");
    _gif_contract(b, 0 - 1, "gif negative len");
    _gif_contract(b, 0 - 1000000, "gif large negative len");
    return 0;
}

# ---- Harness self-check ----------------------------------------------
fn fuzz_gif_selfcheck(): i64 {
    var lo = 0;
    var b = fx_gif_plain(&lo);
    var err = 0;
    assert(chitra_gif_decode(b, lo, &err) != 0, "selfcheck: plain fixture decodes");

    var blo = 0;
    var bb = fx_gif_big(&blo);
    var berr = 0;
    var bimg = chitra_gif_decode(bb, blo, &berr);
    assert(bimg != 0, "selfcheck: big fixture decodes");
    if (bimg != 0) {
        assert(chitra_image_width(bimg) == 48, "selfcheck: big fixture is 48 wide");
    }
    var start = _gif_lzw_start(bb, blo);
    assert(start > 0, "selfcheck: LZW stream located");
    assert(blo - start > 256, "selfcheck: LZW span is wide enough to fuzz");
    return 0;
}

fn main(): i64 {
    var seed = 1;

    fuzz_gif_selfcheck();
    println("fuzz_gif: harness self-check passed (fixtures valid, LZW reachable)");

    seed = 1;
    while (seed <= 100000) {
        fuzz_gif_random(seed * 2654435761, (seed * 7) % 512);
        seed = seed + 1;
    }
    println("fuzz_gif: 100000 random-byte cases survived");

    seed = 1;
    while (seed <= 150000) {
        fuzz_gif_header(seed * 40503, (seed * 11) % 506);
        seed = seed + 1;
    }
    println("fuzz_gif: 150000 GIF89a-prefixed header/block-walk cases survived");

    seed = 1;
    while (seed <= 60000) {
        fuzz_gif_mutate(seed * 97, (seed % 4) + 1);
        seed = seed + 1;
    }
    println("fuzz_gif: 60000 mutated-fixture cases survived");

    seed = 1;
    while (seed <= 60000) {
        fuzz_gif_lzw(seed * 313, (seed % 6) + 1);
        seed = seed + 1;
    }
    println("fuzz_gif: 60000 LZW-stream mutation cases survived");

    fuzz_gif_truncate();
    println("fuzz_gif: truncation sweep survived");

    fuzz_gif_degenerate();
    println("fuzz_gif: degenerate-length cases survived");

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
