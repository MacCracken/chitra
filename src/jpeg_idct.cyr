# @internal — JPEG dequantization + zig-zag + inverse DCT (0.3.0, bite 5).
# jpeg_idct.cyr — turn a block of 64 zig-zag-order DCT coefficients (from
# jpeg_huffman's _chitra_jpeg_decode_block) plus its quantization table into 64
# natural-order 8-bit samples. Frame-independent: operates on caller buffers.
#
# IDCT: the libjpeg `jpeg_idct_islow` integer fixed-point separable algorithm
# (Loeffler-Ligtenberg-Moschytz factorization), committed in
# docs/adr/0004-jpeg-decode-model.md; constants per ITU-T T.81 + libjpeg jidctint.c.
#   Source: Loeffler, C., Ligtenberg, A., Moschytz, G. (1989), "Practical fast
#   1-D DCT algorithms with 11 multiplications," IEEE ICASSP, pp. 988-991.
#   Implementation reference: libjpeg jidctint.c (jpeg_idct_islow). See docs/sources.md.
#
# CONST_BITS = 13 (fixed-point scale of the FIX_* constants). PASS1_BITS = 2.
# Pass 1 (columns) descales by CONST_BITS - PASS1_BITS = 11; pass 2 (rows) by
# CONST_BITS + PASS1_BITS + 3 = 18, where +3 is the IDCT 1/8 normalization.
#
# NOTE (Cyrius): `>>` is a LOGICAL shift here, so it is wrong for the negative
# intermediates the IDCT produces. DESCALE therefore biases the value positive
# before shifting (see _chitra_jpeg_descale), which gives libjpeg's arithmetic-
# shift rounding exactly. The even-part CONST_BITS scaling uses `* 8192`
# (= 1<<13) rather than a left shift so negative coefficients scale correctly.

# The FIX_* constants (round(x * 2^13)) appear as literals in
# _chitra_jpeg_idct_to, each commented with its name — 1.4.0 inlined them
# with the rest of the transform:
#   FIX_0_298631336 = 2446    FIX_0_390180644 = 3196    FIX_0_541196100 = 4433
#   FIX_0_765366865 = 6270    FIX_0_899976223 = 7373    FIX_1_175875602 = 9633
#   FIX_1_501321110 = 12299   FIX_1_847759065 = 15137   FIX_1_961570560 = 16069
#   FIX_2_053119869 = 16819   FIX_2_562915447 = 20995   FIX_3_072711026 = 25172

# ================================================================
# Zig-zag → natural (row-major 8x8) index map (T.81 figure A.6). Lazily built
# once into a 64-i64 table. Coefficients and quant tables arrive in zig-zag
# order; dequant scatters them into natural order via this map.
# ================================================================
# The zig-zag map is constant data, so it lives in BSS rather than the heap:
# the previous alloc(512) was unchecked, and on failure it stored 64 values
# through a NULL pointer. Const data has no business owning a failure mode.
var _chitra_jpeg_zz_tbl[512];        # 64 i64 — BSS, no alloc dep
var _chitra_jpeg_zz_ready = 0;
fn _chitra_jpeg_zigzag_table(): i64 {
    if (_chitra_jpeg_zz_ready != 0) { return &_chitra_jpeg_zz_tbl; }
    var t = &_chitra_jpeg_zz_tbl;
    store64(t + 0 * 8, 0);
    store64(t + 1 * 8, 1);
    store64(t + 2 * 8, 8);
    store64(t + 3 * 8, 16);
    store64(t + 4 * 8, 9);
    store64(t + 5 * 8, 2);
    store64(t + 6 * 8, 3);
    store64(t + 7 * 8, 10);
    store64(t + 8 * 8, 17);
    store64(t + 9 * 8, 24);
    store64(t + 10 * 8, 32);
    store64(t + 11 * 8, 25);
    store64(t + 12 * 8, 18);
    store64(t + 13 * 8, 11);
    store64(t + 14 * 8, 4);
    store64(t + 15 * 8, 5);
    store64(t + 16 * 8, 12);
    store64(t + 17 * 8, 19);
    store64(t + 18 * 8, 26);
    store64(t + 19 * 8, 33);
    store64(t + 20 * 8, 40);
    store64(t + 21 * 8, 48);
    store64(t + 22 * 8, 41);
    store64(t + 23 * 8, 34);
    store64(t + 24 * 8, 27);
    store64(t + 25 * 8, 20);
    store64(t + 26 * 8, 13);
    store64(t + 27 * 8, 6);
    store64(t + 28 * 8, 7);
    store64(t + 29 * 8, 14);
    store64(t + 30 * 8, 21);
    store64(t + 31 * 8, 28);
    store64(t + 32 * 8, 35);
    store64(t + 33 * 8, 42);
    store64(t + 34 * 8, 49);
    store64(t + 35 * 8, 56);
    store64(t + 36 * 8, 57);
    store64(t + 37 * 8, 50);
    store64(t + 38 * 8, 43);
    store64(t + 39 * 8, 36);
    store64(t + 40 * 8, 29);
    store64(t + 41 * 8, 22);
    store64(t + 42 * 8, 15);
    store64(t + 43 * 8, 23);
    store64(t + 44 * 8, 30);
    store64(t + 45 * 8, 37);
    store64(t + 46 * 8, 44);
    store64(t + 47 * 8, 51);
    store64(t + 48 * 8, 58);
    store64(t + 49 * 8, 59);
    store64(t + 50 * 8, 52);
    store64(t + 51 * 8, 45);
    store64(t + 52 * 8, 38);
    store64(t + 53 * 8, 31);
    store64(t + 54 * 8, 39);
    store64(t + 55 * 8, 46);
    store64(t + 56 * 8, 53);
    store64(t + 57 * 8, 60);
    store64(t + 58 * 8, 61);
    store64(t + 59 * 8, 54);
    store64(t + 60 * 8, 47);
    store64(t + 61 * 8, 55);
    store64(t + 62 * 8, 62);
    store64(t + 63 * 8, 63);
    _chitra_jpeg_zz_ready = 1;
    return t;
}

# DESCALE: x / 2^n rounded to nearest, ties UP — libjpeg's
# RIGHT_SHIFT(x + (1 << (n-1)), n), whose shift is arithmetic (floor). n >= 1.
#
# 1.4.0 (decode-throughput issue): through 1.3.x this rounded ties AWAY FROM
# ZERO, which is a valid IEEE 1180 rounding but not libjpeg's, so chitra could
# differ from djpeg by 1 LSB on any file where a negative intermediate landed
# exactly on .5 — 13 of a 180-file corpus did. Rounding ties up makes the
# IDCT, and the colour conversion that shares this function, bit-exact with
# libjpeg-turbo's jidctint.c / jdcolor.c on that corpus.
#
# Cyrius `>>` is LOGICAL, so the value is biased positive first: 2^58 is a
# multiple of every 2^n used and exceeds every intermediate the IDCT forms
# (coefficients are bounded to 16 bits and quant values to 16 bits, so no
# product reaches 2^52). The shift of a positive value is then floor, and
# the bias comes back out exactly. `>>>` (arithmetic) is newer than the
# toolchains chitra's consumers compile it with, so it is not used.
fn _chitra_jpeg_descale(x, n): i64 {
    return ((x + (1 << (n - 1)) + 288230376151711744) >> n) - (288230376151711744 >> n);
}

# ================================================================
# _chitra_jpeg_idct_nat — the 2-D islow IDCT of `coef` (64 i64, NATURAL order,
# already dequantized — _chitra_jpeg_decode_coefs writes it that way), writing
# the 64 level-shifted, clamped samples as BYTES at dst + row*stride + col.
# `coef` is left ALL-ZERO, which is the invariant _chitra_jpeg_decode_coefs
# relies on: it writes only the non-zero coefficients of the next block.
#
# 1.4.0: one function, no per-sample calls. Through 1.3.x every output went
# through two calls (_chitra_jpeg_idct_out, then _chitra_jpeg_descale) and a
# signed division, 256 calls per block; the block was de-zig-zagged by a
# 64-step loop and landed in a 64-i64 buffer that the caller then copied into
# the plane a byte at a time — 60 % of a 4:4:4 decode. The arithmetic is
# libjpeg-turbo's jidctint.c exactly, including both of its "AC terms all
# zero" shortcuts, which are pure optimisations: a column whose AC terms are
# zero gives in0 << PASS1_BITS, and a row whose AC terms are zero gives
# DESCALE(w0, PASS1_BITS + 3), the same values the full butterfly produces.
# ================================================================
var _CHITRA_IDCT_BIAS = 288230376151711744;     # 2^58, see _chitra_jpeg_descale
fn _chitra_jpeg_idct_nat(coef, dst, stride): i64 {
    var ws[512];     # 64 i64, pass-1 workspace
    var bias = _CHITRA_IDCT_BIAS;
    var b11 = bias >> 11;
    var b18 = bias >> 18;
    var p = 0;
    var s0 = 0;
    var s1 = 0;
    var s2 = 0;
    var s3 = 0;
    var s4 = 0;
    var s5 = 0;
    var s6 = 0;
    var s7 = 0;
    var z1 = 0;
    var z2 = 0;
    var z3 = 0;
    var z4 = 0;
    var z5 = 0;
    var t0 = 0;
    var t1 = 0;
    var t2 = 0;
    var t3 = 0;
    var t10 = 0;
    var t11 = 0;
    var t12 = 0;
    var t13 = 0;
    var dc = 0;
    var v = 0;
    var c = 0;
    # Pass 1: columns, coef -> ws, scaled by 2^PASS1_BITS (descale 11).
    while (c < 8) {
        p = coef + c * 8;
        s0 = load64(p);
        s1 = load64(p + 64);
        s2 = load64(p + 128);
        s3 = load64(p + 192);
        s4 = load64(p + 256);
        s5 = load64(p + 320);
        s6 = load64(p + 384);
        s7 = load64(p + 448);
        store64(p, 0);
        if ((s1 | s2 | s3 | s4 | s5 | s6 | s7) != 0) {
            store64(p + 64, 0);
            store64(p + 128, 0);
            store64(p + 192, 0);
            store64(p + 256, 0);
            store64(p + 320, 0);
            store64(p + 384, 0);
            store64(p + 448, 0);
        }
        p = &ws + c * 8;
        if ((s1 | s2 | s3 | s4 | s5 | s6 | s7) == 0) {
            dc = s0 * 4;
            store64(p, dc);
            store64(p + 64, dc);
            store64(p + 128, dc);
            store64(p + 192, dc);
            store64(p + 256, dc);
            store64(p + 320, dc);
            store64(p + 384, dc);
            store64(p + 448, dc);
        } else {
            z1 = (s2 + s6) * 4433;                   # FIX_0_541196100
            t2 = z1 - s6 * 15137;                    # FIX_1_847759065
            t3 = z1 + s2 * 6270;                     # FIX_0_765366865
            t0 = (s0 + s4) * 8192;
            t1 = (s0 - s4) * 8192;
            t10 = t0 + t3;
            t13 = t0 - t3;
            t11 = t1 + t2;
            t12 = t1 - t2;
            z1 = s7 + s1;
            z2 = s5 + s3;
            z3 = s7 + s3;
            z4 = s5 + s1;
            z5 = (z3 + z4) * 9633;                   # FIX_1_175875602
            t0 = s7 * 2446;                          # FIX_0_298631336
            t1 = s5 * 16819;                         # FIX_2_053119869
            t2 = s3 * 25172;                         # FIX_3_072711026
            t3 = s1 * 12299;                         # FIX_1_501321110
            z1 = 0 - z1 * 7373;                      # FIX_0_899976223
            z2 = 0 - z2 * 20995;                     # FIX_2_562915447
            z3 = z5 - z3 * 16069;                    # FIX_1_961570560
            z4 = z5 - z4 * 3196;                     # FIX_0_390180644
            t0 = t0 + z1 + z3;
            t1 = t1 + z2 + z4;
            t2 = t2 + z2 + z3;
            t3 = t3 + z1 + z4;
            store64(p,       ((t10 + t3 + 1024 + bias) >> 11) - b11);
            store64(p + 448, ((t10 - t3 + 1024 + bias) >> 11) - b11);
            store64(p + 64,  ((t11 + t2 + 1024 + bias) >> 11) - b11);
            store64(p + 384, ((t11 - t2 + 1024 + bias) >> 11) - b11);
            store64(p + 128, ((t12 + t1 + 1024 + bias) >> 11) - b11);
            store64(p + 320, ((t12 - t1 + 1024 + bias) >> 11) - b11);
            store64(p + 192, ((t13 + t0 + 1024 + bias) >> 11) - b11);
            store64(p + 256, ((t13 - t0 + 1024 + bias) >> 11) - b11);
        }
        c = c + 1;
    }
    # Pass 2: rows, ws -> samples (descale 18 = CONST_BITS + PASS1_BITS + 3).
    var r = 0;
    var o = 0;
    while (r < 8) {
        p = &ws + r * 64;
        o = dst + r * stride;
        s0 = load64(p);
        s1 = load64(p + 8);
        s2 = load64(p + 16);
        s3 = load64(p + 24);
        s4 = load64(p + 32);
        s5 = load64(p + 40);
        s6 = load64(p + 48);
        s7 = load64(p + 56);
        if ((s1 | s2 | s3 | s4 | s5 | s6 | s7) == 0) {
            dc = ((s0 + 16 + bias) >> 5) - (bias >> 5) + 128;
            if (dc < 0) { dc = 0; }
            if (dc > 255) { dc = 255; }
            store8(o, dc);
            store8(o + 1, dc);
            store8(o + 2, dc);
            store8(o + 3, dc);
            store8(o + 4, dc);
            store8(o + 5, dc);
            store8(o + 6, dc);
            store8(o + 7, dc);
        } else {
            z1 = (s2 + s6) * 4433;
            t2 = z1 - s6 * 15137;
            t3 = z1 + s2 * 6270;
            t0 = (s0 + s4) * 8192;
            t1 = (s0 - s4) * 8192;
            t10 = t0 + t3;
            t13 = t0 - t3;
            t11 = t1 + t2;
            t12 = t1 - t2;
            z1 = s7 + s1;
            z2 = s5 + s3;
            z3 = s7 + s3;
            z4 = s5 + s1;
            z5 = (z3 + z4) * 9633;
            t0 = s7 * 2446;
            t1 = s5 * 16819;
            t2 = s3 * 25172;
            t3 = s1 * 12299;
            z1 = 0 - z1 * 7373;
            z2 = 0 - z2 * 20995;
            z3 = z5 - z3 * 16069;
            z4 = z5 - z4 * 3196;
            t0 = t0 + z1 + z3;
            t1 = t1 + z2 + z4;
            t2 = t2 + z2 + z3;
            t3 = t3 + z1 + z4;
            v = ((t10 + t3 + 131072 + bias) >> 18) - b18 + 128;
            if (v < 0) { v = 0; }
            if (v > 255) { v = 255; }
            store8(o, v);
            v = ((t10 - t3 + 131072 + bias) >> 18) - b18 + 128;
            if (v < 0) { v = 0; }
            if (v > 255) { v = 255; }
            store8(o + 7, v);
            v = ((t11 + t2 + 131072 + bias) >> 18) - b18 + 128;
            if (v < 0) { v = 0; }
            if (v > 255) { v = 255; }
            store8(o + 1, v);
            v = ((t11 - t2 + 131072 + bias) >> 18) - b18 + 128;
            if (v < 0) { v = 0; }
            if (v > 255) { v = 255; }
            store8(o + 6, v);
            v = ((t12 + t1 + 131072 + bias) >> 18) - b18 + 128;
            if (v < 0) { v = 0; }
            if (v > 255) { v = 255; }
            store8(o + 2, v);
            v = ((t12 - t1 + 131072 + bias) >> 18) - b18 + 128;
            if (v < 0) { v = 0; }
            if (v > 255) { v = 255; }
            store8(o + 5, v);
            v = ((t13 + t0 + 131072 + bias) >> 18) - b18 + 128;
            if (v < 0) { v = 0; }
            if (v > 255) { v = 255; }
            store8(o + 3, v);
            v = ((t13 - t0 + 131072 + bias) >> 18) - b18 + 128;
            if (v < 0) { v = 0; }
            if (v > 255) { v = 255; }
            store8(o + 4, v);
        }
        r = r + 1;
    }
    return 0;
}

# ================================================================
# _chitra_jpeg_dc_fill — the 2-D IDCT of a block whose AC coefficients are all
# zero, without the transform (1.4.1). Every column then takes libjpeg's pass-1
# shortcut (in0 << PASS1_BITS) and every row its pass-2 shortcut, so all 64
# samples are DESCALE(4 * coef[0], PASS1_BITS + 3) + 128, clamped — the value
# _chitra_jpeg_idct_nat computes for such a block, bit for bit. Written as eight
# 8-byte stores, and coef[0] is re-zeroed (the all-zero invariant).
# ================================================================
fn _chitra_jpeg_dc_fill(coef, dst, stride): i64 {
    var v = ((load64(coef) * 4 + 16 + _CHITRA_IDCT_BIAS) >> 5) - (_CHITRA_IDCT_BIAS >> 5) + 128;
    if (v < 0) { v = 0; }
    if (v > 255) { v = 255; }
    v = v * 72340172838076673;                   # the byte in all 8 lanes (0x0101..01)
    store64(coef, 0);
    store64(dst, v);
    store64(dst + stride, v);
    store64(dst + stride * 2, v);
    store64(dst + stride * 3, v);
    store64(dst + stride * 4, v);
    store64(dst + stride * 5, v);
    store64(dst + stride * 6, v);
    store64(dst + stride * 7, v);
    return 0;
}

# ================================================================
# _chitra_jpeg_idct_to — dequantize + de-zig-zag `zz` (64 i64, zig-zag order)
# with `quant` (64 i64, zig-zag order), then _chitra_jpeg_idct_nat into bytes
# at dst + row*stride + col. The unit-level entry; the decoder dequantizes
# while it entropy-decodes and calls _chitra_jpeg_idct_nat directly.
# ================================================================
fn _chitra_jpeg_idct_to(zz, quant, dst, stride): i64 {
    var zztab = _chitra_jpeg_zigzag_table();
    var coef[512];   # 64 i64, natural order, dequantized
    var k = 0;
    while (k < 64) {
        store64(&coef + load64(zztab + k * 8) * 8, load64(zz + k * 8) * load64(quant + k * 8));
        k = k + 1;
    }
    _chitra_jpeg_idct_nat(&coef, dst, stride);
    return 0;
}

# ================================================================
# _chitra_jpeg_idct_block — the same transform into 64 i64 at `out`
# (row-major). Kept for the unit cells that inspect a block in isolation.
# ================================================================
fn _chitra_jpeg_idct_block(zz, quant, out): i64 {
    var tmp[64];
    _chitra_jpeg_idct_to(zz, quant, &tmp, 8);
    var i = 0;
    while (i < 64) {
        store64(out + i * 8, load8(&tmp + i));
        i = i + 1;
    }
    return 0;
}
