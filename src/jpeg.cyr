# @public — chitra JPEG decoder: JPEG bytes -> canonical RGBA8 (0.3.0).
# jpeg.cyr — the public decode entry. Wires the marker scan (jpeg_markers),
# the SOS scan header, the entropy/IDCT block pipeline (jpeg_huffman + jpeg_idct),
# and the color pass into a ChitraImage (the same 56-byte result PNG produces).
#
# Scope: baseline JFIF — grayscale (1 component), YCbCr (3), and RGB (3, via
# the Adobe APP14 transform or 'R','G','B' component ids — 0.6.1, ADR 0009);
# arbitrary chroma subsampling (4:4:4 / 4:2:2 / 4:2:0 / general Hi,Vi) with box
# upsampling; DRI/RSTn restart markers; and the complete T.81 § A.2 scan model
# — interleaved, non-interleaved, partially interleaved, single- and multi-scan
# (0.6.0 for Nf = 1, 0.8.0 for the rest) — every baseline scan geometry decodes.
#
# The result is the shared ChitraImage (offsets from png.cyr); source_color_type
# carries a JPEG sentinel — 0x100 | ncomp, plus bit 4 when the components are
# RGB rather than YCbCr, so 0x101 gray / 0x103 YCbCr / 0x113 RGB — and a
# consumer's PNG 0/2/3/4/6 switch never aliases it (ADR 0003 / review).

# ================================================================
# YCbCr -> RGB color conversion (JFIF full-range, ITU-R BT.601). Fixed-point
# with SCALEBITS=16, the libjpeg jdcolor constants:
#   R = Y                         + 1.40200*(Cr-128)
#   G = Y - 0.34414*(Cb-128)      - 0.71414*(Cr-128)
#   B = Y + 1.77200*(Cb-128)
# Source: libjpeg jdcolor.c; ITU-R BT.601. See docs/sources.md.
#
# 1.4.0: exactly jdcolor.c's table arithmetic, computed inline (x = sample - 128):
#   R = Y + RIGHT_SHIFT(FIX(1.40200) * x_cr + ONE_HALF, 16)
#   G = Y + RIGHT_SHIFT(-FIX(0.34414) * x_cb - FIX(0.71414) * x_cr + ONE_HALF, 16)
#   B = Y + RIGHT_SHIFT(FIX(1.77200) * x_cb + ONE_HALF, 16)
# RIGHT_SHIFT is a floor (arithmetic) shift, done here by biasing positive as
# _chitra_jpeg_descale does. Through 1.3.x the green term was computed as
# Y - round(0.34414 * x_cb + 0.71414 * x_cr) with ties away from zero, which
# differs from libjpeg's floor(-... + 1/2) on an exact tie. No call per pixel,
# and no lookup table: a global table here would cost every consumer 64 KB of
# binary for what three multiplies already compute.
# ================================================================
fn _chitra_jpeg_clamp8(v): i64 {
    if (v < 0) { return 0; }
    if (v > 255) { return 255; }
    return v;
}

# Convert one YCbCr triple to RGB, writing 3 bytes (R, G, B) at dst. The
# decoder's colour loop inlines the same three lines.
fn _chitra_jpeg_ycc_to_rgb(y, cb, cr, dst): i64 {
    var xb = cb - 128;
    var xr = cr - 128;
    store8(dst + 0, _chitra_jpeg_clamp8(y + _chitra_jpeg_descale(91881 * xr, 16)));
    store8(dst + 1, _chitra_jpeg_clamp8(y + _chitra_jpeg_descale(0 - 22554 * xb - 46802 * xr, 16)));
    store8(dst + 2, _chitra_jpeg_clamp8(y + _chitra_jpeg_descale(116130 * xb, 16)));
    return 0;
}

# ================================================================
# Parse the SOS scan header (T.81 § B.2.3) at frame.sos_offset (the 2-byte Ls
# field). Validates the scan against the frame, records each component's DC/AC
# Huffman selectors (Td/Ta), and enforces the baseline spectral selection
# (Ss=0, Se=63, Ah=Al=0). Returns the byte offset where the entropy-coded data
# begins, or 0 with *err_out set.
# ================================================================
fn _chitra_jpeg_parse_sos(frame, src, len, sos_off, err_out): i64 {
    store64(err_out, 0);
    var cur[24];
    _chitra_cur_init(&cur, src, len);
    # The caller names the offset. With multi-scan there is no single "the" SOS
    # position on the frame to read, and passing it removes the need for a
    # resume-position field entirely.
    _chitra_cur_skip(&cur, sos_off);
    if (_chitra_cur_can_read(&cur, 3) == 0) { store64(err_out, chitra_err(CHITRA_ERR_TRUNCATED)); return 0; }
    var ls = _chitra_cur_u16_be(&cur);
    var ns = _chitra_cur_u8(&cur);
    var ncomp = _chitra_jpeg_frame_num_components(frame);
    # T.81 § B.2.3 bounds Ns as 1 <= Ns <= 4 and requires each Csj to name a
    # DISTINCT component of the frame, so Ns > Nf is malformed by pigeonhole.
    # Both are VALIDITY failures and keep CHITRA_ERR_JPEG_SOS. (Ns < Nf, which
    # through 0.7.3 was a deferral, decodes since 0.8.0.)
    #
    # Ns < 1 — gate-6 (1.1.1) CORRECTED what this said. It claimed that without
    # the guard an Ns = 0 scan "falls into the Ns < Nf branch and is reported as
    # a DEFERRAL (code 4)"; that branch was deleted in 0.8.0, and neutering the
    # guard left both Ns = 0 cells green because their fixtures also carry bad
    # Ss/Se bytes. What it actually stops: a WELL-FORMED Ns = 0 scan (Ls = 6,
    # Ss 0, Se 63) names no component, decodes nothing, covers nothing — and
    # the driver walks on to the next scan, so a file that hides one in front
    # of a real scan DECODES. libjpeg refuses it (Ns must be 1..4). Pinned by
    # test_ms_empty_scan_before_a_real_one_rejected.
    #
    # Ns > Nf changes no error code today: with it removed, such a scan reaches
    # the selector loop below, where the frame-order rule (or the coverage
    # check) rejects the inevitable repeat with the same 17 — only Nf distinct
    # ids exist. Keep it anyway: it is what bounds the loop to ncomp entries
    # directly, rather than through "distinct SOF ids run out", which is a proxy
    # for the index. The write index into _CHITRA_JF_SCAN is ALSO bounded directly, by
    # `i >= CHITRA_MAX_COMPONENTS` inside the loop.
    if (ns < 1) { store64(err_out, chitra_err(CHITRA_ERR_JPEG_SOS)); return 0; }
    if (ns > ncomp) { store64(err_out, chitra_err(CHITRA_ERR_JPEG_SOS)); return 0; }
    # Ns < Nf is no longer refused: 0.8.0 decodes it. The bound that replaces
    # the gate is the coverage bitmask — a component may be decoded exactly
    # once, so a file gets at most Nf scans and every one must name something
    # new. See ADR 0006 (amended) and the driver below.
    if (ls != 6 + 2 * ns) { store64(err_out, chitra_err(CHITRA_ERR_JPEG_SOS)); return 0; }
    if (_chitra_cur_can_read(&cur, 2 * ns + 3) == 0) { store64(err_out, chitra_err(CHITRA_ERR_TRUNCATED)); return 0; }

    # Clear the scan list before filling it. A frame outlives its scans, and
    # entries past this scan's `ns` would otherwise be whatever the PREVIOUS
    # scan left — the same "state that is only ever set, never cleared" shape as
    # the 0.5.3 GIF transparent-index defect, one module over.
    store64(frame + _CHITRA_JF_SCAN_NS, 0);
    var z = 0;
    while (z < CHITRA_MAX_COMPONENTS) {
        store64(frame + _CHITRA_JF_SCAN + z * _CHITRA_JF_SCAN_STRIDE + _CHITRA_JF_SCAN_COMP, 0 - 1);
        store64(frame + _CHITRA_JF_SCAN + z * _CHITRA_JF_SCAN_STRIDE + _CHITRA_JF_SCAN_TD, 0);
        store64(frame + _CHITRA_JF_SCAN + z * _CHITRA_JF_SCAN_STRIDE + _CHITRA_JF_SCAN_TA, 0);
        z = z + 1;
    }

    var rc = 0;
    var done = 0;
    var i = 0;
    var cs = 0;
    var tdta = 0;
    var td = 0;
    var ta = 0;
    var j = 0;
    var found = 0;
    while (done == 0) {
        if (i >= ns) { done = 1; }
        if (done == 0) {
            cs = _chitra_cur_u8(&cur);
            tdta = _chitra_cur_u8(&cur);
            td = (tdta >> 4) & 15;
            ta = tdta & 15;
            # Bound the WRITE INDEX directly rather than through the two-hop
            # proxy (ns <= ncomp, and ncomp in {1,3}) the old code relied on.
            if (i >= CHITRA_MAX_COMPONENTS) { rc = CHITRA_ERR_JPEG_SOS; done = 1; }
            if (done == 0) {
                if (td >= CHITRA_MAX_HUFF_TABLES) { rc = CHITRA_ERR_JPEG_SOS; done = 1; }
            }
            if (done == 0) {
                # Equivalent (gate-4, 1.1.1): Ta >= 4 selects presence bit
                # 4 + Ta >= 8, which no DHT can set, so the table-presence test
                # in _chitra_jpeg_decode_one_scan refuses with the same code. Td is NOT
                # covered that way — Td 4..7 would select an AC table — and has
                # its own cell.
                if (ta >= CHITRA_MAX_HUFF_TABLES) { rc = CHITRA_ERR_JPEG_SOS; done = 1; }
            }
            if (done == 0) {
                # Resolve Cs to a FRAME COMPONENT INDEX, and record the scan
                # entry in scan order. The old code computed this index and
                # threw it away.
                found = 0 - 1;
                j = 0;
                while (j < ncomp) {
                    if (_chitra_jpeg_frame_comp_id(frame, j) == cs) { found = j; }
                    j = j + 1;
                }
                if (found < 0) { rc = CHITRA_ERR_JPEG_SOS; done = 1; }
                if (done == 0) {
                    # ⛔ jpeg-12 (1.1.1) — T.81 § B.2.3: "the ordering in the
                    # scan header shall follow the ordering in the frame
                    # header". So each resolved frame index must EXCEED the one
                    # before it. libjpeg refuses any other order ("Invalid
                    # component ID 1 in SOS"), cjpeg refuses to write one
                    # ("Invalid scan script"), and so does ImageMagick; chitra
                    # accepted all five permutations of a 4:4:4 scan. Strictly
                    # increasing also means distinct, so this replaces the
                    # duplicate-Cs loop that stood here — which the coverage
                    # check below already subsumed (a component named twice in
                    # one scan finds its own bit set). What the rule does NOT
                    # touch is the order of SCANS: `cjpeg -scans` writes Cb's
                    # scan before Y's on request, and that still decodes.
                    if (i > 0) {
                        if (found <= _chitra_jpeg_scan_comp(frame, i - 1)) {
                            rc = CHITRA_ERR_JPEG_SOS;
                            done = 1;
                        }
                    }
                }
                if (done == 0) {
                    # COVERAGE. A component may be decoded exactly once across
                    # the whole file: twice is a contradiction about the same
                    # samples, and it is also what bounds the driver's loop.
                    # Coverage-once is BASELINE's rule (0.8.0): a sequential
                    # component is coded by exactly one scan. A progressive one
                    # is coded by many — its bound is the per-coefficient
                    # progression the progressive driver checks (1.4.0).
                    if (_chitra_jpeg_frame_prog(frame) == 0) {
                        if ((load64(frame + _CHITRA_JF_COVERED) & (1 << found)) != 0) {
                            rc = CHITRA_ERR_JPEG_SOS;
                            done = 1;
                        }
                    }
                }
                if (done == 0) {
                    store64(frame + _CHITRA_JF_COVERED, load64(frame + _CHITRA_JF_COVERED) | (1 << found));
                    store64(frame + _CHITRA_JF_SCAN + i * _CHITRA_JF_SCAN_STRIDE + _CHITRA_JF_SCAN_COMP, found);
                    store64(frame + _CHITRA_JF_SCAN + i * _CHITRA_JF_SCAN_STRIDE + _CHITRA_JF_SCAN_TD, td);
                    store64(frame + _CHITRA_JF_SCAN + i * _CHITRA_JF_SCAN_STRIDE + _CHITRA_JF_SCAN_TA, ta);
                }
            }
            if (done == 0) { i = i + 1; }
        }
    }
    if (rc != 0) { store64(err_out, chitra_err(rc)); return 0; }

    var ss = _chitra_cur_u8(&cur);
    var se = _chitra_cur_u8(&cur);
    var ahal = _chitra_cur_u8(&cur);
    # T.81 § B.2.3: "If Ns > 1, ... sum(Hj * Vj) <= 10" over THIS SCAN's
    # components. A one-component scan has no interleaved MCU to bound, which is
    # exactly why a frame whose factors sum to 18 is legal when every scan is
    # non-interleaved. This precedes every allocation: planes are allocated by
    # _chitra_jpeg_decode_one_scan, which runs after this returns.
    if (ns > 1) {
        var blocks = 0;
        var bi = 0;
        while (bi < ns) {
            blocks = blocks + _chitra_jpeg_frame_comp_h(frame, _chitra_jpeg_scan_comp(frame, bi))
            * _chitra_jpeg_frame_comp_v(frame, _chitra_jpeg_scan_comp(frame, bi));
            bi = bi + 1;
        }
        if (blocks > CHITRA_MAX_BLOCKS_PER_MCU) {
            store64(err_out, chitra_err(CHITRA_ERR_JPEG_SOF));
            return 0;
        }
    }
    store64(frame + _CHITRA_JF_SCAN_NS, ns);
    if (_chitra_jpeg_frame_prog(frame) == 1) {
        # Progressive scan parameters (T.81 § G.1.1.1.1; libjpeg's
        # start_pass_phuff_decoder, whose refusals are fatal there too):
        #   - a DC scan is exactly Ss = Se = 0, and may interleave;
        #   - an AC scan is 1 <= Ss <= Se <= 63 and names ONE component;
        #   - Ah and Al are at most 13, and a refinement (Ah > 0) refines by
        #     exactly one bit, Al = Ah - 1.
        # Whether THIS component's coefficients are at the bit position Ah
        # says is the per-coefficient progression check in the driver.
        var ah = (ahal >> 4) & 15;
        var al = ahal & 15;
        var pbad = 0;
        if (ss == 0) {
            if (se != 0) { pbad = 1; }
        } else {
            if (ns != 1) { pbad = 1; }
            if (se < ss) { pbad = 1; }
            if (se > 63) { pbad = 1; }
        }
        if (ah > 13) { pbad = 1; }
        if (al > 13) { pbad = 1; }
        if (ah != 0) {
            if (al != ah - 1) { pbad = 1; }
        }
        if (pbad == 1) { store64(err_out, chitra_err(CHITRA_ERR_JPEG_SOS)); return 0; }
        store64(frame + _CHITRA_JF_SPEC, ss | (se << 8) | (ah << 16) | (al << 24));
        return _chitra_cur_pos(&cur);
    }
    if (ss != 0) { store64(err_out, chitra_err(CHITRA_ERR_JPEG_SOS)); return 0; }
    if (se != 63) { store64(err_out, chitra_err(CHITRA_ERR_JPEG_SOS)); return 0; }
    if (ahal != 0) { store64(err_out, chitra_err(CHITRA_ERR_JPEG_SOS)); return 0; }
    return _chitra_cur_pos(&cur);
}

# ================================================================
# _chitra_jpeg_entropy_span — how many bytes of ENTROPY-CODED DATA the scan actually
# carries, starting at `start`.
#
# This exists to be the denominator of the amplification cap below, and the
# reason it has to be computed rather than taken as `len` is a measured defect:
# through 0.6.0 the cap divided by the WHOLE FILE LENGTH, so an attacker bought
# allowance with bytes the decoder never decodes. A 16,556-byte file whose
# padding was 16,404 bytes of APPn segments — skipped wholesale by the marker
# walk — declared 4096x4096x3 and allocated **117,463,728 bytes**, none of which
# the bump allocator reclaims. That is the wrong-denominator defect the 0.5.3
# BMP-RLE cap had, in the JPEG path: padding is free, so measuring the file
# lets the attacker raise their own allowance. Padding AFTER the scan would
# have worked just as well, which is why this walks to the end of the entropy
# data rather than simply subtracting the header.
#
# *marker_out receives the marker code that ENDED the scan, or 0 if the input
# ran out first. 0.7.0 uses that to tell a stream that closed with EOI from
# one that simply stopped.
#
# The walk is the same rule the entropy bit-reader uses (T.81 § B.1.1.2 and
# § F.1.2.3): inside entropy-coded data a 0xFF is always followed by 0x00
# (byte stuffing) or by an RSTn marker; any other marker ENDS the scan. Fill
# bytes (runs of 0xFF) are collapsed, exactly as the reader collapses them.
# Reads only — nothing is decoded, and every access is bounded by `len`.
# ================================================================
fn _chitra_jpeg_entropy_span(src, len, start, marker_out): i64 {
    store64(marker_out, 0);
    var i = start;
    var j = 0;
    var b2 = 0;
    var done = 0;
    var scanning = 0;
    while (done == 0) {
        if (i >= len) { done = 1; }
        if (done == 0) {
            if (load8(src + i) != 0xFF) {
                i = i + 1;
                continue;
            }
            # Collapse a run of 0xFF fill bytes (T.81 § B.1.1.2) to find the
            # marker code they precede.
            # ONE bounds-checked read per iteration. The first draft of this
            # loop tested load8(src + j) again after advancing j, which reads at
            # j == len on a file ending in 0xFF — an out-of-bounds read inside
            # the guard being added to prevent one.
            j = i + 1;
            scanning = 1;
            while (scanning == 1) {
                scanning = 0;
                if (j < len) {
                    if (load8(src + j) == 0xFF) {
                        j = j + 1;
                        scanning = 1;
                    }
                }
            }
            if (j >= len) { done = 1; }
            if (done == 0) {
                b2 = load8(src + j);
                if (b2 == 0x00) {
                    i = j + 1;          # 0xFF00 is stuffed entropy data
                    continue;
                }
                if (b2 >= 0xD0) {
                    if (b2 <= 0xD7) {
                        i = j + 1;      # RSTn belongs to the scan
                        continue;
                    }
                }
                store64(marker_out, b2);
                done = 1;               # any other marker ends the scan
            }
        }
    }
    if (i < start) { return 0; }
    return i - start;
}

# ================================================================
# _chitra_jpeg_structural_espan — the entropy bytes the decode CAN read, summed over
# every scan, computed before a single plane exists (jpeg-7 / cc-1 / gate-8,
# 1.1.1). Returns the sum; *scans_out receives how many scan headers it read.
#
# ⛔ WHY IT EXISTS. GATE 2 — the whole-image amplification bound on the summed
# entropy spans — ran after every scan had been DECODED, i.e. after every plane
# had been allocated, on the stated premise that the sum "can only" be known
# then. It cannot be wrong about the sum, but the premise was false: every input
# to it is byte-structural. `_chitra_jpeg_entropy_span` never consults the bit reader,
# and the walk between scans only skips segments by their length fields. So
# GATE 0 — the weaker bound on `len` B-3 put in front — was all that stood
# before the planes, and `len` counts padding: 4,200 bytes of APP1 bought the
# 16,658-byte three-scan file back B-3's exact 50,354,832-byte refusal, and
# 12,300 bytes (before the frame or after EOI) did the same for a single scan.
#
# ⚠ AT LEAST AS LENIENT AS THE DECODE, NEVER STRICTER. It reads exactly the
# fields that place the next scan — Ls, Ns, the Cs list — and skips everything
# else by length, including DQT / DHT / DRI, which the decode parses but always
# consumes to exactly their length on success. Wherever it stops short of full
# coverage (a malformed or duplicate scan header, a refused marker, EOI, the
# input running out) the decode is CERTAIN to refuse at that same point or
# earlier. Hence:
#   - every component named: the sum is EXACTLY the denominator GATE 2 sees
#     after the decode, so the early gate refuses precisely what GATE 2 would,
#     and nothing it would not;
#   - stopped after >= 1 scan: the decode will refuse anyway, and the sum is
#     every entropy byte it could read first — refusing now when those bytes
#     cannot fund the geometry stops it paying for planes it will throw away;
#   - stopped before any scan (*scans_out = 0): no plane is ever allocated, so
#     there is nothing to prevent; the caller does not gate, and the decode
#     reports its own, more specific, error.
# It parses nothing into the frame and allocates nothing.
# ================================================================
fn _chitra_jpeg_structural_espan(frame, src, len, scans_out): i64 {
    store64(scans_out, 0);
    var ncomp = _chitra_jpeg_frame_num_components(frame);
    var full = (1 << ncomp) - 1;
    # Progressive (1.4.0): a component recurs scan after scan, so the walk
    # neither refuses a repeat across scans nor stops at first coverage — it
    # runs to EOI (or wherever the decode would refuse), as the progressive
    # driver does. Within ONE scan a repeat is still malformed in both modes.
    var prog = _chitra_jpeg_frame_prog(frame);
    var smask = 0;
    var cur[24];
    _chitra_cur_init(&cur, src, len);
    _chitra_cur_skip(&cur, _chitra_jpeg_frame_sos_offset(frame));
    var total = 0;
    var scans = 0;
    var mask = 0;
    var done = 0;
    var walking = 0;
    var ls = 0;
    var ns = 0;
    var i = 0;
    var j = 0;
    var cs = 0;
    var fi = 0;
    var start = 0;
    var span = 0;
    var mk = 0;
    var b = 0;
    var m = 0;
    var act = 0;
    var seglen = 0;
    while (done == 0) {
        # ---- one scan header; the cursor is at its Ls field ----
        if (_chitra_cur_can_read(&cur, 3) == 0) { done = 1; }
        if (done == 0) {
            ls = _chitra_cur_u16_be(&cur);
            ns = _chitra_cur_u8(&cur);
            if (ns < 1) { done = 1; }
            if (ns > ncomp) { done = 1; }
        }
        if (done == 0) {
            if (ls != 6 + 2 * ns) { done = 1; }
        }
        if (done == 0) {
            if (_chitra_cur_can_read(&cur, 2 * ns + 3) == 0) { done = 1; }
        }
        i = 0;
        smask = 0;
        if (done == 1) { i = ns; }                  # ns is unvalidated here
        while (i < ns) {
            if (done == 0) {
                cs = _chitra_cur_u8(&cur);
                _chitra_cur_skip(&cur, 1);                 # Td/Ta: not needed to place scans
                fi = 0 - 1;
                j = 0;
                while (j < ncomp) {
                    if (_chitra_jpeg_frame_comp_id(frame, j) == cs) { fi = j; }
                    j = j + 1;
                }
                if (fi < 0) { done = 1; }
                if (done == 0) {
                    # Covers both a repeat inside this scan and (baseline) a
                    # component an earlier scan already decoded — the decode
                    # refuses both.
                    if ((smask & (1 << fi)) != 0) { done = 1; }
                    if (prog == 0) {
                        if ((mask & (1 << fi)) != 0) { done = 1; }
                    }
                }
                if (done == 0) {
                    mask = mask | (1 << fi);
                    smask = smask | (1 << fi);
                }
            }
            i = i + 1;
        }
        if (done == 0) {
            _chitra_cur_skip(&cur, 3);                     # Ss, Se, Ah/Al
            start = _chitra_cur_pos(&cur);
            span = _chitra_jpeg_entropy_span(src, len, start, &mk);
            total = total + span;
            scans = scans + 1;
            _chitra_cur_skip(&cur, span);
            if (prog == 0) {
                if (mask == full) { done = 1; }
            }
        }
        # ---- the walk to the next SOS, by length only ----
        walking = 0;
        if (done == 0) { walking = 1; }
        while (walking == 1) {
            if (_chitra_cur_can_read(&cur, 2) == 0) { walking = 0; done = 1; }
            if (walking == 1) {
                b = _chitra_cur_u8(&cur);
                if (b != 0xFF) { walking = 0; done = 1; }
            }
            if (walking == 1) {
                m = _chitra_cur_u8(&cur);
                while (m == 0xFF) {
                    if (_chitra_cur_can_read(&cur, 1) == 0) { m = 0xD9; }
                    if (m == 0xFF) { m = _chitra_cur_u8(&cur); }
                }
                if (m == 0xD9) { walking = 0; done = 1; }
            }
            if (walking == 1) {
                act = _chitra_jpeg_marker_action(m);
                if (act >= 13) { walking = 0; done = 1; }
                if (act == 1) { walking = 0; done = 1; }
                if (act == 10) { walking = 0; done = 1; }
                if (act == 2) { walking = 0; }      # next scan header follows
            }
            if (walking == 1) {
                if (act != 3) {                     # 3 = standalone: no length
                    if (_chitra_cur_can_read(&cur, 2) == 0) { walking = 0; done = 1; }
                    if (walking == 1) {
                        seglen = _chitra_cur_u16_be(&cur);
                        if (seglen < 2) { walking = 0; done = 1; }
                    }
                    if (walking == 1) {
                        if (_chitra_cur_can_read(&cur, seglen - 2) == 0) { walking = 0; done = 1; }
                    }
                    if (walking == 1) { _chitra_cur_skip(&cur, seglen - 2); }
                }
            }
        }
    }
    store64(scans_out, scans);
    return total;
}

# ================================================================
# Decode a baseline scan (1 or 3 components, any chroma subsampling) into a
# ChitraImage. The MCU is max_h x max_v data units wide/tall; each component i
# contributes Hi x Vi 8x8 blocks per MCU at its own (subsampled) plane
# resolution. After decode, each component plane is box-upsampled to full
# resolution and (for 3 components) converted YCbCr -> RGB. DRI/RSTn restart
# intervals reset the DC predictors and byte-align the entropy stream.
# Returns the ChitraImage ptr, or 0 with *err_out set.
# ================================================================
fn _chitra_jpeg_decode_one_scan(frame, src, len, entropy_start, espan, planes, comppw,
  zz, unclean_out, err_out): i64 {
    var ncomp = _chitra_jpeg_frame_num_components(frame);
    var w = _chitra_jpeg_frame_width(frame);
    var h = _chitra_jpeg_frame_height(frame);
    var max_h = _chitra_jpeg_frame_max_h(frame);
    var max_v = _chitra_jpeg_frame_max_v(frame);
    var mcu_w = 8 * max_h;
    var mcu_h = 8 * max_v;
    var mcu_cols = (w + mcu_w - 1) / mcu_w;
    var mcu_rows = (h + mcu_h - 1) / mcu_h;

    # ---- ONE geometry rule, per T.81 § A.2 --------------------------------
    #
    # A scan is INTERLEAVED (§ A.2.3) when it carries more than one component,
    # and NON-INTERLEAVED (§ A.2.2) when it carries exactly one. The difference
    # is entirely in the grid the MCU loop walks and how many data units an MCU
    # holds, so it is expressed once, here, rather than as two decoders:
    #
    #   interleaved      MCU = max_h x max_v data units
    #                    grid = ceil(w / 8*max_h) x ceil(h / 8*max_v)
    #                    blocks per component per MCU = H_i x V_i
    #   non-interleaved  MCU = ONE data unit, raster order
    #                    grid = ceil(x_i/8) x ceil(y_i/8) over that component's
    #                           OWN sample dimensions (§ A.1.1):
    #                           x_i = ceil(X*H_i/H_max), y_i = ceil(Y*V_i/V_max)
    #                    blocks per MCU = 1
    #
    # This REPLACES 0.6.0's effective-geometry collapse, which forced
    # H = V = max_h = max_v = 1 for a one-component frame. That was correct only
    # because with Nf = 1 the lone component IS the maximum — and the rule above
    # gives the identical answer there (x_1 = ceil(X*H/H) = X, so the grid is
    # ceil(X/8)), while also being right for a one-component SCAN of a
    # THREE-component frame, which the collapse would have got badly wrong.
    # ADR 0006 claimed 0.8.0 could build on the collapse; it could not.
    var ns = _chitra_jpeg_frame_scan_ns(frame);
    var s_cols = mcu_cols;
    var s_rows = mcu_rows;
    var sfi = 0;
    var xi = 0;
    var yi = 0;
    if (ns == 1) {
        sfi = _chitra_jpeg_scan_comp(frame, 0);
        xi = (w * _chitra_jpeg_frame_comp_h(frame, sfi) + max_h - 1) / max_h;
        yi = (h * _chitra_jpeg_frame_comp_v(frame, sfi) + max_v - 1) / max_v;
        s_cols = (xi + 7) / 8;
        s_rows = (yi + 7) / 8;
    }

    # Decompression-bomb cap. The PNG path bounds inflate output against IDAT
    # input at CHITRA_MAX_INFLATE_RATIO; the JPEG path had no analogue, and it
    # needs one MORE than PNG does: the entropy bit-reader zero-pads past
    # end-of-data, so a hostile file needs no real scan payload at all. A
    # ~150-byte file declaring SOF0 4096x4096x3 drives ~786k IDCT blocks and
    # ~117 MB of allocation that the bump allocator never reclaims, so a
    # handful of them exhausts a long-running consumer (mabda decodes into
    # textures). Capping the RGBA output against the input length bounds the
    # planes too — they sum to under 1x the RGBA buffer for every supported
    # sampling. A genuinely flat 4096x4096 JPEG still carries ~2 bits per
    # block (~98 KB, ~685:1), so 4096:1 leaves ~6x headroom over the most
    # compressible real image while rejecting the geometry-only bomb by
    # three orders of magnitude.
    # 0.6.1 put the denominator on the ENTROPY SPAN rather than the file length,
    # after a 16,556-byte file padded with 16,404 bytes of skipped APPn segments
    # allocated 117,463,728 bytes. 0.8.0 splits the check in two, because with
    # several scans one whole-image test against one span is wrong in both
    # directions: GATE 1 below bounds each scan's planes against THAT scan's
    # span, and GATE 2 in the driver bounds the RGBA output against the summed
    # spans of the scans actually decoded.

    # per-component arrays (<= 3 components)

    var preds[32];
    var dctabs[32];
    var actabs[32];
    var quants[32];
    var comph[32];
    var compv[32];

    var ci = 0;
    var td = 0;
    var ta = 0;
    var tq = 0;
    var chh = 0;
    var cvv = 0;
    var cpw = 0;
    var cph = 0;
    var pl = 0;
    var scanfi[32];      # scan position -> frame component index
    var rc = 0;
    var done = 0;
    # Iterate THE SCAN, in scan order. T.81 § A.2.3 composes an interleaved MCU
    # from the components in the order the SCAN HEADER lists them. Within one
    # scan that is frame order — § B.2.3 requires it, and _chitra_jpeg_parse_sos has
    # enforced it since 1.1.1 (jpeg-12). Through 1.1.0 this comment said a scan
    # "may name them {Cb, Y, Cr}, and libjpeg writes such scans"; libjpeg
    # neither writes nor reads one. What differs from frame order is the SET: a
    # scan names a SUBSET of the frame's components (Cb alone, say), so the
    # loop still walks the scan's own list rather than the frame's.
    #
    # Per-scan quantities (tables, block counts) are indexed by SCAN POSITION;
    # `planes` and `comppw` are indexed by FRAME COMPONENT, because a plane
    # outlives the scan that fills it.
    var fi = 0;
    while (done == 0) {
        if (ci >= ns) { done = 1; }
        if (done == 0) {
            fi = _chitra_jpeg_scan_comp(frame, ci);
            td = _chitra_jpeg_scan_td(frame, ci);
            ta = _chitra_jpeg_scan_ta(frame, ci);
            tq = _chitra_jpeg_frame_comp_tq(frame, fi);
            chh = _chitra_jpeg_frame_comp_h(frame, fi);
            cvv = _chitra_jpeg_frame_comp_v(frame, fi);
            # Blocks per MCU for THIS scan. One for a non-interleaved scan,
            # whatever H_i/V_i say — § A.2.2 is explicit that the factors do not
            # affect the ordering there.
            if (ns == 1) {
                chh = 1;
                cvv = 1;
            }
            if ((_chitra_jpeg_frame_huff_present(frame) & (1 << td)) == 0) { rc = CHITRA_ERR_JPEG_SOS; done = 1; }
            if (done == 0) {
                if ((_chitra_jpeg_frame_huff_present(frame) & (1 << (4 + ta))) == 0) {
                    rc = CHITRA_ERR_JPEG_SOS;
                    done = 1;
                }
            }
            if (done == 0) {
                if ((_chitra_jpeg_frame_quant_present(frame) & (1 << tq)) == 0) {
                    rc = CHITRA_ERR_JPEG_SOF;
                    done = 1;
                }
            }
            if (done == 0) {
                # plane = the scan's own grid x its blocks-per-MCU x 8. For an
                # interleaved scan that is the familiar mcu_cols*H_i*8; for a
                # non-interleaved one it is ceil(x_i/8)*8 — an EXACT fit over
                # the component's own sample dimensions, with no unwritten
                # margin, which is the property 0.6.0 established and this rule
                # keeps in both layouts.
                cpw = s_cols * chh * 8;
                cph = s_rows * cvv * 8;
                if (cpw * cph > _chitra_lim_raw(_chitra_jpeg_frame_ctx(frame))) {
                    rc = CHITRA_ERR_DIMENSIONS;
                    done = 1;
                }
            }
            if (done == 0) {
                # GATE 1 — amplification, per scan, against THIS scan's entropy
                # span, before this scan's allocations. Measured on a flat
                # 1024x1024 with a chroma-first scan script, per-scan spans run
                # [2050, 12289, 2049] at 2x2 and [514, 12289, 513] at 4x4 — so
                # testing the whole output against the FIRST scan's span would
                # reject files djpeg reads. Each scan's planes against that
                # scan's own bytes is the honest pairing.
                if (cpw * cph > espan * CHITRA_MAX_JPEG_RATIO) {
                    rc = CHITRA_ERR_DIMENSIONS;
                    done = 1;
                }
            }
            if (done == 0) {
                # Lazy, and at most once per component. Coverage-once means a
                # scan names only components no earlier scan decoded, so a plane
                # that already exists belongs to a component this scan cannot
                # name — re-allocating is what would silently discard the
                # previous scan's samples.
                pl = load64(planes + fi * 8);
                if (pl == 0) {
                    pl = _chitra_alloc(_chitra_jpeg_frame_ctx(frame), cpw * cph);
                    if (pl == 0) { rc = CHITRA_ERR_OOM; done = 1; }
                }
            }
            if (done == 0) {
                store64(planes + fi * 8, pl);
                store64(&preds + ci * 8, 0);
                store64(&dctabs + ci * 8, _chitra_jpeg_frame_huff(frame, 0, td));
                store64(&actabs + ci * 8, _chitra_jpeg_frame_huff(frame, 1, ta));
                store64(&quants + ci * 8, load64(frame + _CHITRA_JF_QUANT) + tq * 64 * 8);
                store64(&comph + ci * 8, chh);
                store64(&compv + ci * 8, cvv);
                store64(comppw + fi * 8, cpw);
                store64(&scanfi + ci * 8, fi);
                ci = ci + 1;
            }
        }
    }
    if (rc != 0) { store64(err_out, chitra_err(rc)); return 0; }
    done = 0;

    var ri = _chitra_jpeg_frame_restart_interval(frame);
    var reader[72];   # _CHITRA_BR_SIZE — 72 since 1.1.1's restart-sequence fields
    # Bound the reader to THIS SCAN's entropy span, not to the rest of the file.
    #
    # 0.7.0 gave it `len - entropy_start` and gated `seen_iend` on _CHITRA_BR_EOD, which
    # is set when the reader runs out of bytes. But `_chitra_jpeg_br_load_byte` returns
    # early on a real marker WITHOUT setting _CHITRA_BR_EOD — so a file truncated inside
    # its entropy data with a genuine FF D9 appended stopped at that marker,
    # left _CHITRA_BR_EOD clear, and reported a cleanly closed stream. Measured on a
    # 689-byte fixture cut in half mid-scan: sum 232,762 against a correct
    # 223,824, `seen_iend = 1`, where djpeg says "premature end of data
    # segment". The signal 0.7.0 added was defeated by the one shape it most
    # needed to catch.
    #
    # Handing it `espan` — the span _chitra_jpeg_entropy_span already computed, which
    # ends at the first marker that is neither stuffing nor RSTn — makes running
    # out of scan data indistinguishable from what it is: end of data. It is
    # also the correct bound on its own terms. An entropy reader has no business
    # reading past the end of its own scan, and that matters far more once
    # multi-scan lands, where the bytes after a scan are the NEXT SCAN'S HEADER.
    _chitra_jpeg_br_init(&reader, src + entropy_start, espan);

    var mcu_count = s_cols * s_rows;
    var mi = 0;
    var mcu_x = 0;
    var mcu_y = 0;
    var comp = 0;
    var by = 0;
    var bx = 0;
    var ch2 = 0;
    var cv2 = 0;
    var cpw2 = 0;
    var dctab = 0;
    var actab = 0;
    var quant = 0;
    var plane = 0;
    var pr = 0;
    var berr = 0;
    var px = 0;
    var py = 0;
    var r = 0;
    var c = 0;
    var rrc = 0;
    var k = 0;
    while (done == 0) {
        if (mi >= mcu_count) { done = 1; }
        if (done == 0) {
            if (ri > 0) {
                if (mi > 0) {
                    if ((mi % ri) == 0) {
                        rrc = _chitra_jpeg_br_restart(&reader);
                        if (rrc != 0) { store64(err_out, chitra_err(CHITRA_ERR_JPEG_ENTROPY)); done = 1; }
                        if (done == 0) {
                            k = 0;
                            while (k < ns) { store64(&preds + k * 8, 0); k = k + 1; }
                        }
                    }
                }
            }
        }
        if (done == 0) {
            mcu_x = mi % s_cols;
            mcu_y = mi / s_cols;
            comp = 0;
            while (comp < ns) {
                ch2 = load64(&comph + comp * 8);
                cv2 = load64(&compv + comp * 8);
                cpw2 = load64(comppw + load64(&scanfi + comp * 8) * 8);
                dctab = load64(&dctabs + comp * 8);
                actab = load64(&actabs + comp * 8);
                quant = load64(&quants + comp * 8);
                plane = load64(planes + load64(&scanfi + comp * 8) * 8);
                by = 0;
                while (by < cv2) {
                    bx = 0;
                    while (bx < ch2) {
                        pr = load64(&preds + comp * 8);
                        pr = _chitra_jpeg_decode_coefs(&reader, dctab, actab, pr, quant, zz, &berr);
                        store64(&preds + comp * 8, pr);
                        if (load64(&berr) != 0) {
                            store64(err_out, load64(&berr));
                            done = 1;
                            bx = ch2;
                            by = cv2;
                            comp = ns;
                            mi = mcu_count;
                        }
                        if (done == 0) {
                            px = (mcu_x * ch2 + bx) * 8;
                            py = (mcu_y * cv2 + by) * 8;
                            _chitra_jpeg_idct_nat(zz, plane + py * cpw2 + px, cpw2);
                            bx = bx + 1;
                        }
                    }
                    if (done == 0) { by = by + 1; }
                }
                if (done == 0) { comp = comp + 1; }
            }
            if (done == 0) { mi = mi + 1; }
        }
    }
    # Did this scan close cleanly? Three independent ways it did not:
    #   - the reader had to fabricate bits (_CHITRA_BR_EOD, 0.7.0 / B-5 — truncation,
    #     or a marker the decoder never asked for);
    #   - a restart marker arrived out of its modulo-8 sequence (jpeg-6,
    #     1.1.1 — an interval was lost or repeated, so later MCUs sit in the
    #     wrong place although every bit was real);
    #   - entropy bytes remain that no MCU consumed (jpeg-6, 1.1.1 — a repeated
    #     interval with renumbered markers, or bytes spliced in before the
    #     marker that ends the scan; libjpeg's "extraneous bytes").
    # None of these is an error — chitra returns the image, as libjpeg does —
    # but each means `seen_iend` must not claim a clean close.
    var unclean = _chitra_jpeg_br_eod(&reader);
    if (_chitra_jpeg_br_damaged(&reader) == 1) { unclean = 1; }
    if (load64(err_out) == 0) {
        if (_chitra_jpeg_br_tail_clean(&reader) == 0) { unclean = 1; }
    }
    store64(unclean_out, unclean);
    if (load64(err_out) != 0) { return 0; }
    return 1;
}

# ================================================================
# Chroma upsampling (1.4.0): libjpeg-turbo's "fancy" triangle filters, the
# default of `djpeg` and of every decoder that reads JPEG for display.
#
# Through 1.3.x chitra upsampled by BOX replication and matched
# `djpeg -nosmooth`. Box puts each chroma sample at the corner of the block
# it covers; JFIF sites chroma at the block's CENTRE, and the triangle filter
# reconstructs that siting. Measured against the SOURCE pixels a JPEG was
# encoded from (selah's fixtures, box-chroma-upsampling issue), box left
# ~30 % more mean error at 4:2:0 (2.345 vs 1.808) and a worst pixel 78
# levels off instead of 54 — the whole gap, since the 4:4:4 and grey
# controls were equal. ADR 0012.
#
# Returns a pointer to w samples of component plane `plane` (stride `pw`,
# sampling hi x vi of max_h x max_v) upsampled to output row y of a w x h
# image: the plane row itself for a full-resolution component, else `dst`,
# which it fills.
# Exactly libjpeg-turbo's jdsample.c selection and arithmetic:
#
#   ratio 1x1                 copy
#   ratio 2x1, dsw > 2        h2v1_fancy: 3/4 nearer + 1/4 further sample,
#                             biases +1 (left output) / +2 (right output), >> 2
#   ratio 1x2                 h1v2_fancy: same weights vertically,
#                             biases +1 (upper) / +2 (lower), >> 2
#   ratio 2x2, dsw > 2        h2v2_fancy: 9/16 3/16 3/16 1/16 via column sums
#                             3*near + far, biases +8 (left) / +7 (right), >> 4
#   anything else             box (libjpeg's int_upsample / h2v1 / h2v2 plain)
#
# dsw / dsh are the component's REAL sample dimensions, § A.1.1's
# ceil(X*Hi/Hmax) x ceil(Y*Vi/Vmax) — libjpeg's downsampled_width/height. The
# neighbour of an edge sample is the edge sample itself: the first and last
# columns reuse themselves, and the rows above the first and below the last
# real row are that row (libjpeg's context-row wraparound / bottom pointers).
#
# ⚠ architecture/004's exact-fit property still holds, and is why the clamps
# are not optional: a neighbour index is clamped into [0, dsw) x [0, dsh),
# which every scan writes in full (each plane is ceil(dsw/8)*8 wide or more,
# and coverage-once means every component's every block was decoded before
# this runs). The filter never reads the plane's padding margin, so the
# read-of-uninitialised class the box-only rule guarded against stays closed.
# ================================================================
fn _chitra_jpeg_upsample_row(plane, pw, hi, vi, max_h, max_v, w, h, y, dst): i64 {
    var x = 0;
    var row = 0;
    if (hi == max_h) {
        if (vi == max_v) { return plane + y * pw; }    # full resolution: the plane row itself
    }
    var dsw = (w * hi + max_h - 1) / max_h;
    var dsh = (h * vi + max_v - 1) / max_v;
    var mode = 0;                    # 0 box, 1 h2v1, 2 h1v2, 3 h2v2
    if (hi * 2 == max_h) {
        if (dsw > 2) {
            if (vi == max_v) { mode = 1; }
            if (vi * 2 == max_v) { mode = 3; }
        }
    }
    if (hi == max_h) {
        if (vi * 2 == max_v) { mode = 2; }
    }
    var c = 0;
    var near = 0;
    var far = 0;
    var bias = 0;
    var nb = 0;
    var r = 0;
    if (mode == 0) {
        row = plane + (y * vi / max_v) * pw;
        while (x < w) {
            store8(dst + x, load8(row + (x * hi / max_h)));
            x = x + 1;
        }
        return dst;
    }
    # Modes 1 and 3 walk INPUT columns: each input sample (or column sum)
    # yields the output pair 2c, 2c+1, with its left and right neighbours
    # carried from the previous step instead of recomputed.
    var n2 = 0;
    var cur = 0;
    var prv = 0;
    var nxt = 0;
    if (mode == 1) {
        row = plane + y * pw;
        cur = load8(row);
        prv = cur;
        c = 0;
        while (c < dsw) {
            nxt = cur;
            if (c + 1 < dsw) { nxt = load8(row + c + 1); }
            n2 = c * 2;
            if (n2 < w) { store8(dst + n2, (3 * cur + prv + 1) >> 2); }
            if (n2 + 1 < w) { store8(dst + n2 + 1, (3 * cur + nxt + 2) >> 2); }
            prv = cur;
            cur = nxt;
            c = c + 1;
        }
        return dst;
    }
    # Vertical neighbour row for modes 2 and 3: the row above for an upper
    # output row, the row below for a lower one, clamped to the real rows.
    r = y >> 1;
    if ((y & 1) == 0) {
        nb = r - 1;
        if (nb < 0) { nb = 0; }
        bias = 1;
    } else {
        nb = r + 1;
        if (nb > dsh - 1) { nb = dsh - 1; }
        bias = 2;
    }
    near = plane + r * pw;
    far = plane + nb * pw;
    if (mode == 2) {
        while (x < w) {
            store8(dst + x, (3 * load8(near + x) + load8(far + x) + bias) >> 2);
            x = x + 1;
        }
        return dst;
    }
    # mode 3 — h2v2: column sums 3*near + far, then the same 3:1 horizontally.
    cur = 3 * load8(near) + load8(far);
    prv = cur;
    c = 0;
    while (c < dsw) {
        nxt = cur;
        if (c + 1 < dsw) { nxt = 3 * load8(near + c + 1) + load8(far + c + 1); }
        n2 = c * 2;
        if (n2 < w) { store8(dst + n2, (3 * cur + prv + 8) >> 4); }
        if (n2 + 1 < w) { store8(dst + n2 + 1, (3 * cur + nxt + 7) >> 4); }
        prv = cur;
        cur = nxt;
        c = c + 1;
    }
    return dst;
}

fn _chitra_jpeg_build_image(frame, planes, comppw, closed, err_out): i64 {
    var ncomp = _chitra_jpeg_frame_num_components(frame);
    var w = _chitra_jpeg_frame_width(frame);
    var h = _chitra_jpeg_frame_height(frame);
    var max_h = _chitra_jpeg_frame_max_h(frame);
    var max_v = _chitra_jpeg_frame_max_v(frame);

    # ---- upsample (_chitra_jpeg_upsample_row) + color convert -> RGBA8 ----
    var ctx = _chitra_jpeg_frame_ctx(frame);
    if (w * h * 4 > _chitra_lim_raw(ctx)) { store64(err_out, chitra_err(CHITRA_ERR_DIMENSIONS)); return 0; }
    var rgba = _chitra_alloc(ctx, w * h * 4);
    if (rgba == 0) { store64(err_out, chitra_err(CHITRA_ERR_OOM)); return 0; }
    # Upsample ratios come from the FRAME. comph/compv hold blocks-per-MCU for
    # the scan just decoded — a different quantity that merely coincides for a
    # single interleaved scan. H_i/H_max is what the upsampler needs.
    var p0 = load64(planes + 0);
    var h0 = _chitra_jpeg_frame_comp_h(frame, 0);
    var v0 = _chitra_jpeg_frame_comp_v(frame, 0);
    var pw0 = load64(comppw + 0);
    var p1 = 0;
    var p2 = 0;
    var h1 = 0;
    var v1 = 0;
    var pw1 = 0;
    var h2 = 0;
    var v2 = 0;
    var pw2 = 0;
    var y = 0;
    var x = 0;
    var o = 0;
    var yy = 0;
    var cb = 0;
    var cr = 0;
    if (ncomp == 1) {
        while (y < h) {
            x = 0;
            while (x < w) {
                yy = load8(p0 + (y * v0 / max_v) * pw0 + (x * h0 / max_h));
                o = (y * w + x) * 4;
                store8(rgba + o + 0, yy);
                store8(rgba + o + 1, yy);
                store8(rgba + o + 2, yy);
                store8(rgba + o + 3, 255);
                x = x + 1;
            }
            y = y + 1;
        }
    }
    # ---- which colour space are these three components in? ----------------
    # A 3-component baseline JPEG is USUALLY YCbCr, and chitra assumed so
    # unconditionally through 0.6.0. It is not always: `cjpeg -rgb` emits RGB
    # components, and applying the BT.601 inverse to them hue-rotates the whole
    # image with no error raised (measured: 1149 of 1536 bytes wrong, max delta
    # 235 — a blue pixel returned dark red).
    #
    # The decision order matches libjpeg's, most authoritative first:
    #   1. An Adobe APP14 transform, if the file carries one. It is an explicit
    #      statement by the encoder, so nothing overrides it.
    #   2. Otherwise the SOF0 component ids: 'R','G','B' (0x52/0x47/0x42) names
    #      the space outright. This is the fallback libjpeg uses, and it is what
    #      catches an RGB file whose APP14 was stripped by a metadata tool.
    #   3. Otherwise YCbCr — the JFIF default, and what component ids 1,2,3 mean.
    #   0. BEFORE ALL OF THEM (B-2, 1.0.3): a JFIF APP0. JFIF § 4.1 DEFINES the
    #      sample space — three components are Y/Cb/Cr — so a file that declares
    #      itself JFIF has already answered this, and neither of the weaker
    #      rules below may overturn it.
    #      ⛔ Rule 2 used to apply to JFIF files, and six edited bytes
    #      (component ids 1,2,3 -> 'R','G','B') therefore turned an ordinary
    #      cjpeg image into a whole-image colour error with NO error code, while
    #      `source_color_type` reported 0x113 and actively told the consumer the
    #      samples were RGB. Every colour byte of a 64x64 fixture came back
    #      wrong; djpeg and ImageMagick both decode the same bytes correctly.
    #      libjpeg has never had the hole: `default_decompress_parms` tests
    #      `saw_JFIF_marker` first, then the Adobe marker, then the ids. This is
    #      that order.
    var is_rgb = 0;
    var adobe = _chitra_jpeg_frame_adobe_transform(frame);
    if (ncomp == 3) {
        if (_chitra_jpeg_frame_saw_jfif(frame) == 0) {
            if (adobe == 0) { is_rgb = 1; }
            if (adobe < 0) {
                if (_chitra_jpeg_frame_comp_id(frame, 0) == 0x52) {
                    if (_chitra_jpeg_frame_comp_id(frame, 1) == 0x47) {
                        if (_chitra_jpeg_frame_comp_id(frame, 2) == 0x42) { is_rgb = 1; }
                    }
                }
            }
        }
    }

    if (ncomp == 3) {
        p1 = load64(planes + 8);
        p2 = load64(planes + 16);
        h1 = _chitra_jpeg_frame_comp_h(frame, 1);
        v1 = _chitra_jpeg_frame_comp_v(frame, 1);
        pw1 = load64(comppw + 8);
        h2 = _chitra_jpeg_frame_comp_h(frame, 2);
        v2 = _chitra_jpeg_frame_comp_v(frame, 2);
        pw2 = load64(comppw + 16);
        # One upsampled row per component, refilled per output row. w is
        # bounded by CHITRA_MAX_DIM through the SOF0 parse, and w*h*4 by the
        # check above, so 3*w cannot overflow.
        var rows = _chitra_alloc(ctx, w * 3);
        if (rows == 0) { store64(err_out, chitra_err(CHITRA_ERR_OOM)); return 0; }
        var r0 = rows;
        var r1 = rows + w;
        var r2 = rows + w * 2;
        var a0 = 0;
        var a1 = 0;
        var a2 = 0;
        var cbias = 288230376151711744 + 32768;  # 2^58 + ONE_HALF: floor shift, see _chitra_jpeg_descale
        var cbias16 = 288230376151711744 >> 16;
        var xb = 0;
        var xr = 0;
        var rr = 0;
        var gg = 0;
        var bb = 0;
        var cmask = 0 - 256;                     # every bit above the low byte
        y = 0;
        while (y < h) {
            a0 = _chitra_jpeg_upsample_row(p0, pw0, h0, v0, max_h, max_v, w, h, y, r0);
            a1 = _chitra_jpeg_upsample_row(p1, pw1, h1, v1, max_h, max_v, w, h, y, r1);
            a2 = _chitra_jpeg_upsample_row(p2, pw2, h2, v2, max_h, max_v, w, h, y, r2);
            x = 0;
            o = rgba + y * w * 4;
            if (is_rgb == 1) {
                # RGB components: the samples ARE the output — the transform to
                # apply is the identity, not BT.601.
                while (x < w) {
                    store32(o, load8(a0 + x) | (load8(a1 + x) << 8) | (load8(a2 + x) << 16) | 4278190080);
                    o = o + 4;
                    x = x + 1;
                }
            } else {
                while (x < w) {
                    yy = load8(a0 + x);
                    cb = load8(a1 + x);
                    cr = load8(a2 + x);
                    xb = cb - 128;
                    xr = cr - 128;
                    # One test per channel: a value outside 0..255 has a bit
                    # above the low byte set (negative ones all of them).
                    rr = yy + ((91881 * xr + cbias) >> 16) - cbias16;
                    if ((rr & cmask) != 0) { if (rr < 0) { rr = 0; } else { rr = 255; } }
                    gg = yy + ((cbias - 22554 * xb - 46802 * xr) >> 16) - cbias16;
                    if ((gg & cmask) != 0) { if (gg < 0) { gg = 0; } else { gg = 255; } }
                    bb = yy + ((116130 * xb + cbias) >> 16) - cbias16;
                    if ((bb & cmask) != 0) { if (bb < 0) { bb = 0; } else { bb = 255; } }
                    store32(o, rr | (gg << 8) | (bb << 16) | 4278190080);
                    o = o + 4;
                    x = x + 1;
                }
            }
            y = y + 1;
        }
    }

    # ---- four components: CMYK samples, YCCK transformed to CMYK (1.4.0) ----
    # chitra_jpeg_decode_cmyk only (the frame walk refuses 4 components on
    # every RGBA entry). Each plane is upsampled exactly as a YCbCr one is —
    # libjpeg treats every component alike — and then:
    #   CMYK (no APP14, or Adobe transform 0): the samples, as stored;
    #   YCCK (Adobe transform 2): Y/Cb/Cr through the BT.601 arithmetic above,
    #     each result inverted — C = 255 - R, M = 255 - G, Y = 255 - B — and K
    #     passed through: libjpeg's ycck_cmyk_convert, bit for bit.
    # Nothing here converts to RGB: what the C, M, Y, K values MEAN (an ICC
    # profile, or an uncalibrated formula) is the caller's decision.
    var adobe4 = _chitra_jpeg_frame_adobe_transform(frame);
    if (ncomp == 4) {
        p1 = load64(planes + 8);
        p2 = load64(planes + 16);
        var p3 = load64(planes + 24);
        h1 = _chitra_jpeg_frame_comp_h(frame, 1);
        v1 = _chitra_jpeg_frame_comp_v(frame, 1);
        pw1 = load64(comppw + 8);
        h2 = _chitra_jpeg_frame_comp_h(frame, 2);
        v2 = _chitra_jpeg_frame_comp_v(frame, 2);
        pw2 = load64(comppw + 16);
        var h3 = _chitra_jpeg_frame_comp_h(frame, 3);
        var v3 = _chitra_jpeg_frame_comp_v(frame, 3);
        var pw3 = load64(comppw + 24);
        var rows4 = _chitra_alloc(ctx, w * 4);
        if (rows4 == 0) { store64(err_out, chitra_err(CHITRA_ERR_OOM)); return 0; }
        var q0 = 0;
        var q1 = 0;
        var q2 = 0;
        var q3 = 0;
        var kb = 288230376151711744 + 32768;     # 2^58 + ONE_HALF, as the YCbCr loop
        var kb16 = 288230376151711744 >> 16;
        var kx = 0;
        var kr = 0;
        var kg = 0;
        var kbb = 0;
        var kxb = 0;
        var kxr = 0;
        var kk = 0;
        y = 0;
        while (y < h) {
            q0 = _chitra_jpeg_upsample_row(p0, pw0, h0, v0, max_h, max_v, w, h, y, rows4);
            q1 = _chitra_jpeg_upsample_row(p1, pw1, h1, v1, max_h, max_v, w, h, y, rows4 + w);
            q2 = _chitra_jpeg_upsample_row(p2, pw2, h2, v2, max_h, max_v, w, h, y, rows4 + w * 2);
            q3 = _chitra_jpeg_upsample_row(p3, pw3, h3, v3, max_h, max_v, w, h, y, rows4 + w * 3);
            o = rgba + y * w * 4;
            kx = 0;
            while (kx < w) {
                kk = load8(q3 + kx);
                if (adobe4 == 2) {
                    yy = load8(q0 + kx);
                    kxb = load8(q1 + kx) - 128;
                    kxr = load8(q2 + kx) - 128;
                    kr = yy + ((91881 * kxr + kb) >> 16) - kb16;
                    if (kr < 0) { kr = 0; }
                    if (kr > 255) { kr = 255; }
                    kg = yy + ((kb - 22554 * kxb - 46802 * kxr) >> 16) - kb16;
                    if (kg < 0) { kg = 0; }
                    if (kg > 255) { kg = 255; }
                    kbb = yy + ((116130 * kxb + kb) >> 16) - kb16;
                    if (kbb < 0) { kbb = 0; }
                    if (kbb > 255) { kbb = 255; }
                    store32(o, (255 - kr) | ((255 - kg) << 8) | ((255 - kbb) << 16) | (kk << 24));
                } else {
                    store32(o, load8(q0 + kx) | (load8(q1 + kx) << 8) | (load8(q2 + kx) << 16) | (kk << 24));
                }
                o = o + 4;
                kx = kx + 1;
            }
            y = y + 1;
        }
    }

    # 0.7.0 — say whether the stream actually closed, instead of claiming it
    # always did.
    #
    # Through 0.6.1 this field was hardcoded to 1 on the JPEG path, so the one
    # accessor that exists to report "the stream ended the way the format says
    # it should" was a constant. A JPEG truncated inside its entropy stream
    # decoded to fabricated zero-padded MCUs, returned success, and reported a
    # clean close — measured on a 689-byte file, chopping 8 to 60 bytes gave
    # byte sums of 215,484 / 229,896 / 143,178 against a correct 223,824, with
    # no signal of any kind.
    #
    # Two independent things have to hold, and neither alone is sufficient:
    #   - the entropy decoder never had to fabricate bits (_CHITRA_BR_EOD), which is
    #     what catches data removed from the middle or the end of the scan; and
    #   - the scan was terminated by a real EOI marker, which is what catches an
    #     EOI-stripped file whose pixels happen to be complete.
    # This mirrors PNG, where 0 means "tolerated IEND-less clean end" rather
    # than "corrupt" — chitra still returns the image either way, as libjpeg
    # does. The caller decides what a partial decode is worth.
    # `closed` is decided by the DRIVER, which is the only place that can see
    # every scan: any scan that ran out of data, had a restart marker out of
    # sequence or left entropy bytes unconsumed (jpeg-6, 1.1.1), or a file
    # whose last scan did not end at a real EOI, means the stream did not
    # close cleanly. It is the record's seen_iend, set by _chitra_image_new.
    #
    # JPEG sentinel: 0x100 | ncomp, with bit 4 set when the components are RGB
    # rather than YCbCr — so 0x101 gray, 0x103 YCbCr, 0x113 RGB. Without the
    # distinction an Adobe transform=0 file reports 0x103 and a consumer has no
    # way to learn that chitra applied no colour transform to it, which is
    # exactly the fact the 0.6.1 repair exists to establish.
    var sentinel = 256 + ncomp;
    if (is_rgb == 1) { sentinel = sentinel + 16; }
    # Four components (1.4.0): 0x104 CMYK with no Adobe marker; bit 6 (0x40)
    # set when an Adobe APP14 is present — by Adobe's convention its CMYK
    # values are INVERTED (0 = full ink), and chitra does not undo that; bit 5
    # (0x20) set when the file was YCCK and chitra transformed it. So 0x104,
    # 0x144 (Adobe CMYK) or 0x164 (Adobe YCCK -> CMYK).
    if (ncomp == 4) {
        if (adobe4 >= 0) { sentinel = sentinel + 64; }
        if (adobe4 == 2) { sentinel = sentinel + 32; }
    }
    # Baseline is 8-bit by definition; 12-bit precision rejects at the SOF parse.
    return _chitra_image_new(ctx, w, h, rgba, closed, sentinel, 8, err_out);
}

# ================================================================
# _chitra_jpeg_decode_scans — the multi-scan driver (0.8.0).
#
# Owns everything that outlives a scan: the component planes and their strides,
# the IDCT scratch, the running entropy total, and the decision about whether
# the stream closed. Each iteration parses one scan header, measures that scan's
# entropy span, decodes it, and stops the moment every frame component is
# covered.
#
# TERMINATION IS THE COVERAGE BITMASK, not a scan counter. _chitra_jpeg_parse_sos
# refuses a component that is already covered and requires Ns >= 1, so every
# successful iteration sets at least one new bit and at most Nf (<= 3) can
# succeed. That bounds the index itself rather than a proxy for it, which is why
# there is no scan limit and no resume-monotonicity tripwire — neither could
# fire before coverage does.
#
# The loop EXITS on full coverage before walking any further, so an ordinary
# single-scan JPEG never enters the resume walk at all. That is deliberate: it
# means no byte after a single scan's entropy data is newly parsed, and no file
# that decoded before this release can newly reject on trailing junk.
# ================================================================
fn _chitra_jpeg_decode_scans(frame, src, len, err_out): i64 {
    store64(err_out, 0);
    var ncomp = _chitra_jpeg_frame_num_components(frame);
    var w = _chitra_jpeg_frame_width(frame);
    var h = _chitra_jpeg_frame_height(frame);

    # ⛔⛔ GATE 0 (B-3, 1.0.3) — REFUSE BEFORE THE PLANES, NOT AFTER THEM.
    # GATE 2 below is the honest whole-image bound, and through 1.1.0 it ran
    # only once every scan had been decoded — every plane already allocated.
    # A 4,250-byte file declaring 4096x4096 Nf=3 therefore spent 50,354,832
    # bytes to return CHITRA_ERR_DIMENSIONS, 11,848:1 on the REFUSAL path, and
    # the bump allocator never gives it back: ~40 such files exhaust the
    # stdlib's 2 GiB ALLOC_MAX.
    #
    # ⚠ STRICTLY WEAKER THAN GATE 2, WHICH IS WHY IT IS SAFE HERE.
    # `total_espan` is a sum of spans inside the file, so it can never exceed
    # `len`. Anything this refuses, GATE 2 would refuse too — no accept/reject
    # outcome moves, and the code returned is the same.
    # ⇒ It does NOT replace GATE 2. `len` counts bytes no scan ever reads
    # (skipped APPn padding is the 0.6.1 lesson), so only the summed entropy
    # spans can see through a padded file — which is why GATE 2 now ALSO runs
    # ahead of the planes, below (jpeg-7, 1.1.1).
    # ⚠ SINCE 1.1.1 GATE 0 IS NO LONGER WHAT KEEPS THE PLANES UNPAID. Wherever
    # the structural walk reads a scan header, the early GATE 2 refuses all
    # that GATE 0 does, at the same cost. What GATE 0 still decides is the
    # CODE for a frame none of whose scan headers can be read (DIMENSIONS
    # rather than that header's own error — nothing is allocated either way),
    # and it is O(1). Pinned as exactly that by
    # test_gate0_still_names_a_headerless_bomb.
    if (w * h * 4 > len * CHITRA_MAX_JPEG_RATIO) {
        store64(err_out, chitra_err(CHITRA_ERR_DIMENSIONS));
        return 0;
    }

    # ⛔⛔ GATE 2, AHEAD OF THE PLANES (jpeg-7 / cc-1 / gate-8, 1.1.1).
    # B-3's premise — that the summed span "can only" be known once every scan
    # has been decoded — was false: it is byte-structural, and
    # _chitra_jpeg_structural_espan computes it without decoding or allocating
    # anything. Until this existed GATE 0 was the only bound in front of the
    # planes, and padding defeats GATE 0 by construction: a 16,658-byte
    # three-scan file with 4,200 bytes of APP1 still spent B-3's exact
    # 50,354,832 bytes before GATE 2 refused it, and a single-scan file padded
    # with 12,300 bytes — before the frame or after EOI — did the same. Same
    # test, same denominator, same code as GATE 2; it now simply runs first.
    # See _chitra_jpeg_structural_espan for why its sum is exact whenever the decode
    # can succeed, and when it does not gate at all.
    var pscans = 0;
    var ptotal = _chitra_jpeg_structural_espan(frame, src, len, &pscans);
    if (pscans > 0) {
        if (w * h * 4 > ptotal * CHITRA_MAX_JPEG_RATIO) {
            store64(err_out, chitra_err(CHITRA_ERR_DIMENSIONS));
            return 0;
        }
    }

    # Progressive (1.4.0): its own scan model from here on, behind the same
    # two gates (jpeg_prog.cyr) and one more. The progression rules bound the
    # COEFFICIENT work of any accepted file, but every scan also walks every
    # block it covers, and a valid file may carry ~900 scans (64 coefficients
    # x 14 bit positions per component), each a few bytes: on a 16.7 MP image
    # that is seconds of CPU from tens of kilobytes. Real encoders write 6-20
    # (cjpeg 10, mozjpeg ~12-20, Photoshop 3-5). The scan count is
    # byte-structural, so the pre-pass's count refuses before any buffer
    # exists; CHITRA_ERR_DIMENSIONS, as every other work-amplification cap.
    if (_chitra_jpeg_frame_prog(frame) == 1) {
        if (pscans > _CHITRA_MAX_PROG_SCANS) {
            store64(err_out, chitra_err(CHITRA_ERR_DIMENSIONS));
            return 0;
        }
        return _chitra_jpeg_decode_progressive(frame, src, len, err_out);
    }

    var planes[32];      # by FRAME component index; CHITRA_MAX_COMPONENTS is 4
    var comppw[32];
    var i = 0;
    while (i < CHITRA_MAX_COMPONENTS) {
        store64(&planes + i * 8, 0);
        store64(&comppw + i * 8, 0);
        i = i + 1;
    }
    # Per-decode scratch, hoisted out of the per-scan worker so a file with
    # three scans allocates it once rather than three times.
    var zz = _chitra_alloc(_chitra_jpeg_frame_ctx(frame), 512);
    if (zz == 0) { store64(err_out, chitra_err(CHITRA_ERR_OOM)); return 0; }
    # The coefficient block must start all-zero (_chitra_jpeg_decode_coefs
    # writes only non-zero coefficients; _chitra_jpeg_idct_nat re-zeroes it).
    i = 0;
    while (i < 64) {
        store64(zz + i * 8, 0);
        i = i + 1;
    }

    var sos_off = _chitra_jpeg_frame_sos_offset(frame);
    var entropy_start = 0;
    var espan = 0;
    var endmark = 0;
    var total_espan = 0;
    var last_marker = 0;
    var any_unclean = 0;
    var unclean = 0;
    var full = (1 << ncomp) - 1;
    var done = 0;
    while (done == 0) {
        entropy_start = _chitra_jpeg_parse_sos(frame, src, len, sos_off, err_out);
        if (load64(err_out) != 0) { return 0; }
        espan = _chitra_jpeg_entropy_span(src, len, entropy_start, &endmark);
        total_espan = total_espan + espan;
        last_marker = endmark;
        unclean = 0;
        if (_chitra_jpeg_decode_one_scan(frame, src, len, entropy_start, espan,
            &planes, &comppw, zz, &unclean, err_out) == 0) {
            return 0;
        }
        if (unclean == 1) { any_unclean = 1; }
        if (_chitra_jpeg_frame_covered(frame) == full) { done = 1; }
        if (done == 0) {
            sos_off = _chitra_jpeg_resume_to_next_scan(frame, src, len, entropy_start + espan, err_out);
            if (load64(err_out) != 0) { return 0; }
            if (sos_off == 0) {
                # ⚠ An EQUIVALENT mutant (gate-6, 1.1.1): without this test the
                # loop re-parses offset 0 as a scan header, SOI's FF D8 is no
                # valid Ls, and the refusal comes back with the same 17. Kept,
                # because that is an accident of two byte values, not a bound.
                # The file ended with components still undecoded. An omitted
                # component is NOT neutral: Y = Cb = Cr = 0 through the BT.601
                # constants is RGB(0, 135, 0) — solid green, which decodes
                # cleanly and looks plausible. Refuse instead.
                store64(err_out, chitra_err(CHITRA_ERR_JPEG_SOS));
                return 0;
            }
        }
    }

    # GATE 2 — the whole-image amplification bound, against the summed spans of
    # the scans ACTUALLY decoded. Nothing here is a pre-pass an attacker could
    # pad: every byte counted is a byte some scan's entropy decoder read.
    # ⚠ BACKSTOP SINCE 1.1.1 — the same test already ran ahead of the planes on
    # _chitra_jpeg_structural_espan's sum, which equals `total_espan` for every file
    # that gets this far (both walks place each scan at the same offset and
    # measure it with the same function). So this cannot fire while the two
    # walks agree, and no test can pin it on its own — deleting it alone is an
    # equivalent mutant, stated here so a sweep does not re-flag it. It stays
    # as the bound of record computed from the bytes the decoders actually
    # read: if a later change ever lets the two walks diverge, this is what
    # still holds. The early copy is pinned by the cost cells in jpeg.tcyr and
    # jpeg_multiscan.tcyr.
    if (w * h * 4 > total_espan * CHITRA_MAX_JPEG_RATIO) {
        store64(err_out, chitra_err(CHITRA_ERR_DIMENSIONS));
        return 0;
    }

    var closed = 1;
    if (any_unclean == 1) { closed = 0; }
    if (last_marker != 0xD9) { closed = 0; }
    return _chitra_jpeg_build_image(frame, &planes, &comppw, closed, err_out);
}

# ================================================================
# chitra_jpeg_decode — the top-level public decode. Parse (src, len) JPEG bytes
# -> an owned RGBA8 ChitraImage. Returns the ChitraImage ptr on success, or 0
# with *err_out set to a ChitraErr (left 0 on success). Mirrors chitra_png_decode.
# ================================================================
# @public
fn chitra_jpeg_decode(src, len, err_out): i64 {
    return _chitra_jpeg_decode_ctx(src, len, 0, err_out);
}

# The JPEG decode held to the decode context `ctx` (1.4.0; 0 = defaults).
fn _chitra_jpeg_decode_ctx(src, len, ctx, err_out): i64 {
    store64(err_out, 0);
    var frame = _chitra_jpeg_scan_markers_ctx(src, len, ctx, err_out);
    if (frame == 0) { return 0; }
    return _chitra_jpeg_decode_scans(frame, src, len, err_out);
}

# ================================================================
# chitra_jpeg_decode_rgba8 — convenience wrapper. Decode (src, len) and return
# the RGBA8 pixel pointer directly, writing width/height through w_out / h_out
# (>=8-byte slots). Returns 0 on any failure. Mirrors chitra_png_decode_rgba8.
# ================================================================
# @public
fn chitra_jpeg_decode_rgba8(src, len, w_out, h_out): i64 {
    store64(w_out, 0);
    store64(h_out, 0);
    var err = 0;
    var img = chitra_jpeg_decode(src, len, &err);
    if (img == 0) { return 0; }
    store64(w_out, chitra_image_width(img));
    store64(h_out, chitra_image_height(img));
    return chitra_image_pixels(img);
}

# ================================================================
# _chitra_jpeg_declared_dims — the dimensions SOF0 declares, without decoding or
# allocating anything.
#
# This walks segments structurally, exactly as _chitra_jpeg_scan_markers does —
# by length, honouring standalone markers and § B.1.1.2 fill bytes — but it
# parses nothing and stores nothing. It is not a second header parser: it
# validates no field, builds no table, and its only output is (w, h). Anything
# it does not understand returns 0, and the real parser then has the final say
# on the same bytes.
#
# The reason it exists rather than reusing _chitra_jpeg_scan_markers: that
# function allocates the quantization and Huffman stores as it meets DQT and
# DHT segments, so using it to answer "how big is this image?" costs ~22 KB for
# any real JPEG — on a budget REFUSAL, which is the path this API exists to
# make cheap. Reading the geometry alone costs nothing.
# Returns 1 with *w_out / *h_out set, or 0.
# ================================================================
fn _chitra_jpeg_declared_dims(src, len, w_out, h_out): i64 {
    store64(w_out, 0);
    store64(h_out, 0);
    var cur[24];
    _chitra_cur_init(&cur, src, len);
    _chitra_cur_skip(&cur, 2);                     # SOI, already checked by the caller
    var done = 0;
    var found = 0;
    var b = 0;
    var m = 0;
    var seglen = 0;
    while (done == 0) {
        if (_chitra_cur_can_read(&cur, 2) == 0) { done = 1; }
        if (done == 0) {
            b = _chitra_cur_u8(&cur);
            if (b != 0xFF) { done = 1; }
        }
        if (done == 0) {
            # Collapse a run of fill bytes (T.81 § B.1.1.2).
            m = _chitra_cur_u8(&cur);
            while (m == 0xFF) {
                if (_chitra_cur_can_read(&cur, 1) == 0) { m = 0; }
                if (m == 0xFF) { m = _chitra_cur_u8(&cur); }
            }
            if (m == 0xC0 || m == 0xC2) {
                # SOF0: length(2) precision(1) height(2) width(2)
                if (_chitra_cur_can_read(&cur, 7) == 0) { done = 1; }
                if (done == 0) {
                    seglen = _chitra_cur_u16_be(&cur);
                    _chitra_cur_skip(&cur, 1);
                    store64(h_out, _chitra_cur_u16_be(&cur));
                    store64(w_out, _chitra_cur_u16_be(&cur));
                    found = 1;
                    done = 1;
                }
            }
            if (done == 0) {
                if (m == 0xD9) { done = 1; }        # EOI before any SOF0
                if (m == 0xDA) { done = 1; }        # SOS before any SOF0
            }
            if (done == 0) {
                # Standalone markers carry no length.
                if (m == 0x01) { continue; }
                if (m >= 0xD0) {
                    if (m <= 0xD7) { continue; }
                }
                if (_chitra_cur_can_read(&cur, 2) == 0) { done = 1; }
                if (done == 0) {
                    seglen = _chitra_cur_u16_be(&cur);
                    if (seglen < 2) { done = 1; }
                }
                if (done == 0) {
                    if (_chitra_cur_can_read(&cur, seglen - 2) == 0) { done = 1; }
                }
                if (done == 0) { _chitra_cur_skip(&cur, seglen - 2); }
            }
        }
    }
    return found;
}

# ================================================================
# _chitra_declared_rgba_bytes — the size of the RGBA8 buffer the file SAYS it
# will decode to, or 0 if that cannot be read from the header.
#
# Every format states its own dimensions in its header, and the output contract
# is always `w * h * 4`. Nothing here validates and nothing here allocates —
# the decoder still does all of that, so an unreadable or hostile header simply
# returns 0 and the caller's decode reports the real error. That asymmetry is
# what keeps this from being "a probe that accepts what the decoder refuses":
# it can only be consulted, never obeyed.
# ================================================================
fn _chitra_declared_rgba_bytes(src, len): i64 {
    return _chitra_declared_rgba_bytes_via(src, len, 0);
}

# The same probe, with any allocation it makes (BMP's header record — the
# 128-byte refusal cost) taken from Allocator `a` and returned to it (1.4.0).
fn _chitra_declared_rgba_bytes_via(src, len, a): i64 {
    var cur[24];
    var w = 0;
    var h = 0;
    if (chitra_png_check_signature(src, len) == 1) {
        # IHDR is the first chunk: 8-byte signature, 4-byte length, 4-byte type,
        # then width and height as big-endian u32 (PNG § 11.2.2).
        _chitra_cur_init(&cur, src, len);
        _chitra_cur_skip(&cur, 16);
        if (_chitra_cur_can_read(&cur, 8) == 0) { return 0; }
        w = _chitra_cur_u32_be(&cur);
        h = _chitra_cur_u32_be(&cur);
    }
    if (chitra_jpeg_check_signature(src, len) == 1) {
        if (_chitra_jpeg_declared_dims(src, len, &w, &h) == 0) { return 0; }
    }
    if (chitra_bmp_check_signature(src, len) == 1) {
        # The real header parser, held to NO pixel cap beyond CHITRA_MAX_DIM
        # (1.4.0): this only reads the dimensions, and the budget decides the
        # size question. Under the fixed 16.7 MP cap a larger BMP read as
        # "unreadable" here, so an over-budget one was refused by the decoder
        # as CHITRA_ERR_DIMENSIONS instead of here as CHITRA_ERR_BUDGET.
        var probe[544];                  # _CHITRA_CTX_SIZE
        _chitra_ctx_init(&probe, a, CHITRA_MAX_DIM * CHITRA_MAX_DIM, CHITRA_MAX_DIM * CHITRA_MAX_DIM * 4);
        var berr = 0;
        var hdr = _chitra_bmp_parse_header_ctx(src, len, &probe, &berr);
        if (hdr != 0) {
            w = _chitra_bmp_hdr_width(hdr);
            h = _chitra_bmp_hdr_height(hdr);
            if (h < 0) { h = 0 - h; }    # negative height = top-down rows
        }
        _chitra_ctx_release(&probe, 0, 0);
        if (hdr == 0) { return 0; }
    }
    if (chitra_gif_check_signature(src, len) == 1) {
        # The Logical Screen Descriptor follows the 6-byte signature, and the
        # canvas — not the first frame's rect — is what chitra returns.
        if (len < 10) { return 0; }
        w = _chitra_gif_u16_le(src + 6);
        h = _chitra_gif_u16_le(src + 8);
    }
    if (w <= 0 || h <= 0) { return 0; }
    if (w > CHITRA_MAX_DIM || h > CHITRA_MAX_DIM) { return 0; }
    return w * h * 4;
}

# ================================================================
# chitra_image_decode_budget — decode, unless the image is bigger than the
# caller is willing to spend on it.
#
# THE CONTRACT, stated in full because a memory guarantee that is not exact is
# not a guarantee:
#
#   chitra will not BEGIN a decode whose RGBA8 output would exceed `max_bytes`.
#   A refusal returns 0 with *err_out = CHITRA_ERR_BUDGET, having allocated
#   16 bytes — the ChitraErr itself — for PNG, JPEG and GIF, and 128 for BMP.
#   MEASURED, not estimated. BMP is the outlier because its dimension read goes
#   through _chitra_bmp_parse_header, the real parser, rather than through a private
#   copy of the header layout; 128 bytes is the right price for having no
#   second opinion about what a BMP header says.
#
#   ⭐ THE BUDGET GOVERNS SIZE (1.4.0, fixed-16-mp-cap issue). Through 1.3.x the
#   fixed caps fired first — CHITRA_MAX_PIXELS (4096 x 4096) and the 256 MB
#   CHITRA_MAX_RAW_BYTES — so a 4097 x 4096 PNG was refused as
#   CHITRA_ERR_DIMENSIONS under a 512 MiB budget its 67 MB output was far
#   inside: an 8K screenshot, three 4K monitors, a tall page capture. A budgeted
#   decode is now held to the budget's own limits: pixels up to max_bytes / 4,
#   and single working buffers up to ~2 x max_bytes (PNG's inflated stream is
#   up to 2 bytes per output byte at depth 16), never below the fixed caps. A
#   side above CHITRA_MAX_DIM is still refused, and every amplification ratio
#   (CHITRA_MAX_INFLATE_RATIO and the JPEG / BMP / GIF ones) still bounds the
#   work per input byte, so the bomb defence never depended on the pixel cap.
#   chitra_image_decode and the per-format entry points keep the fixed caps.
#
# What the budget does NOT cover, named rather than glossed:
#   - Working buffers during a decode that IS begun. These are bounded by the
#     limits above and the amplification ratios, not by `max_bytes` itself.
#     Budgeting N bounds the OUTPUT at N; peak working set is a small multiple
#     of it (about 4x for an Adam7 16-bit RGBA PNG, the worst case).
#   - sankoch's allocations, which chitra does not route: ~41 KB of one-time
#     table setup on the process's first PNG decode. Not chitra's to predict.
#   - The cumulative total across calls. chitra_image_decode_budget allocates
#     from the global bump allocator, which never frees (architecture/003), so
#     this bounds ONE decode, not a process. A long-running caller uses
#     chitra_image_decode_budget_via, below.
#
# A file whose header cannot be read is NOT refused here — it is handed to the
# router, which reports the real reason. Refusing it would make this function
# a second opinion on validity, which is exactly what it must never be.
#
# `max_bytes <= 0` is a refusal, not "unlimited" — a budget of zero means zero.
# Callers who want no ceiling call chitra_image_decode.
# ================================================================
# @public
fn chitra_image_decode_budget(src, len, max_bytes, err_out): i64 {
    return chitra_image_decode_budget_via(0, src, len, max_bytes, err_out);
}

# A decode context for a budget of `max_bytes` of output from Allocator `a`
# (1.4.0): pixels up to max_bytes / 4 and single working buffers up to ~2 x
# max_bytes (PNG's inflated stream is up to 2 bytes per output byte at depth
# 16), never below the fixed caps. Above 2^36 bytes the budget exceeds any
# output a CHITRA_MAX_DIM x CHITRA_MAX_DIM image can declare (17.2 GB), so it
# is clamped there before it is doubled, which keeps every product in range.
fn _chitra_budget_ctx_init(ctx, a, max_bytes): i64 {
    var mb = max_bytes;
    if (mb > 68719476736) { mb = 68719476736; }
    var mp = mb / 4;
    if (mp < CHITRA_MAX_PIXELS) { mp = CHITRA_MAX_PIXELS; }
    var mr = mb * 2 + mb / 32 + 1048576;
    if (mr < CHITRA_MAX_RAW_BYTES) { mr = CHITRA_MAX_RAW_BYTES; }
    _chitra_ctx_init(ctx, a, mp, mr);
    return ctx;
}

# ================================================================
# chitra_image_decode_budget_via — chitra_image_decode_budget, with every
# allocation of the decode taken from the caller's Allocator `a` (1.4.0,
# every-decode-leaks issue).
#
# `a` is a stdlib Allocator (lib/alloc.cyr: allocator_new, alloc_via /
# free_via) — a free-list, an arena reset per request, anything that follows
# the vtable contract — or 0 for the global bump allocator, which makes this
# exactly chitra_image_decode_budget.
#
#   - Every working buffer (the inflated PNG stream, JPEG planes and tables,
#     BMP / GIF index planes, LZW dictionaries) is returned to `a` before this
#     returns, so a decode's peak is its output plus ONE decode's working set,
#     and nothing but the result outlives the call.
#   - On success the image record and its pixels are the caller's: release
#     both with ONE call to chitra_image_free(img), after the last use of the
#     pixels. On a refusal everything the decode allocated is already back.
#   - The ChitraErr on a refusal is still 16 bytes of the GLOBAL allocator
#     (chitra_err has no allocator and no free; error records are not per
#     decode state), and sankoch's one-time tables are its own.
#   - Blocks from `a` are zeroed before use — the decoders were written against
#     the global allocator's zeroed memory.
#
# Thread-safe in the same sense every decode is: the limits and the
# allocator live in a context on this call's stack, not in a global, so
# concurrent decodes with different budgets or allocators do not interact
# (`a` itself must tolerate whatever concurrency the caller gives it).
# ================================================================
# @public
fn chitra_image_decode_budget_via(a, src, len, max_bytes, err_out): i64 {
    store64(err_out, 0);
    if (max_bytes <= 0) {
        store64(err_out, chitra_err(CHITRA_ERR_BUDGET));
        return 0;
    }
    if (_chitra_declared_rgba_bytes_via(src, len, a) > max_bytes) {
        store64(err_out, chitra_err(CHITRA_ERR_BUDGET));
        return 0;
    }
    var ctx[544];                        # _CHITRA_CTX_SIZE
    _chitra_budget_ctx_init(&ctx, a, max_bytes);
    var img = _chitra_image_decode_ctx(src, len, &ctx, err_out);
    if (img == 0) {
        _chitra_ctx_release(&ctx, 0, 0);
        return 0;
    }
    _chitra_ctx_release(&ctx, img, chitra_image_pixels(img));
    return img;
}

# ================================================================
# chitra_jpeg_decode_cmyk — a 4-component JPEG's samples, without a colour
# guess (1.4.0, cmyk-ycck-jpeg-refused issue; ADR 0014).
#
# ADR 0009 refuses to turn CMYK into RGB because that needs a colour-space
# choice the file does not make, and chitra_jpeg_decode still refuses these
# files. But the samples themselves are fully determined by the JPEG and its
# Adobe APP14: this returns them, in a ChitraImage whose 4 bytes per pixel are
# C, M, Y, K (not R, G, B, A):
#   - Adobe transform 0, or no APP14: the samples as stored;
#   - Adobe transform 2 (YCCK): converted to CMYK exactly as libjpeg does;
#   - any other transform: CHITRA_ERR_UNSUPPORTED (it names no 4-component
#     space; libjpeg's fallback to YCCK is a guess);
#   - a 1- or 3-component file: CHITRA_ERR_JPEG_COMPONENTS — it is not CMYK,
#     and chitra_image_decode is the entry for it.
# chitra_image_source_color_type says which: 0x104 (no Adobe marker — values
# as the writer chose), 0x144 (Adobe CMYK), 0x164 (Adobe YCCK, converted).
# By Adobe's convention an Adobe file's CMYK is INVERTED (255 = no ink), and
# chitra returns it as stored; a consumer that wants an uncalibrated RGB
# preview of an Adobe file computes R = C * K / 255 on these values, and the
# accurate conversion is the file's ICC profile (APP2), which chitra does not
# read. Baseline and progressive, any sampling.
#
# Born with the long-running-consumer shape, because it has no 1.3.x callers
# to keep compatible: `a` is a stdlib Allocator (0 = the global one), and
# `max_bytes` is a budget on the w * h * 4 output with
# chitra_image_decode_budget_via's contract — refused cheaply as
# CHITRA_ERR_BUDGET when over it, size limits derived from it, every working
# buffer returned before this returns, and the result released with
# chitra_image_free.
# ================================================================
# @public
fn chitra_jpeg_decode_cmyk(a, src, len, max_bytes, err_out): i64 {
    store64(err_out, 0);
    if (max_bytes <= 0) {
        store64(err_out, chitra_err(CHITRA_ERR_BUDGET));
        return 0;
    }
    if (chitra_jpeg_check_signature(src, len) == 0) {
        store64(err_out, chitra_err(CHITRA_ERR_SIGNATURE));
        return 0;
    }
    var w = 0;
    var h = 0;
    if (_chitra_jpeg_declared_dims(src, len, &w, &h) == 1) {
        if (w * h * 4 > max_bytes) {
            store64(err_out, chitra_err(CHITRA_ERR_BUDGET));
            return 0;
        }
    }
    var ctx[544];                        # _CHITRA_CTX_SIZE
    _chitra_budget_ctx_init(&ctx, a, max_bytes);
    var img = 0;
    var frame = _chitra_jpeg_scan_markers_mode(src, len, &ctx, 1, err_out);
    if (frame != 0) { img = _chitra_jpeg_decode_scans(frame, src, len, err_out); }
    if (img == 0) {
        _chitra_ctx_release(&ctx, 0, 0);
        return 0;
    }
    _chitra_ctx_release(&ctx, img, chitra_image_pixels(img));
    return img;
}

# ================================================================
# chitra_image_decode — format-sniffing top-level decode. Routes by signature,
# in order: the 8-byte PNG magic, then JPEG SOI (0xFFD8), then BMP 'BM', then
# GIF 'GIF87a'/'GIF89a' — the format-agnostic entry the "chitra" name was
# chosen for. Unrecognised bytes are REJECTED here; there is deliberately no
# fall-through to a default decoder. Returns a ChitraImage ptr, or 0 with
# *err_out set (CHITRA_ERR_SIGNATURE for an unrecognized format).
# ================================================================
# @public
fn chitra_image_decode(src, len, err_out): i64 {
    return _chitra_image_decode_ctx(src, len, 0, err_out);
}

# The router, held to the decode context `ctx` (1.4.0; 0 = defaults).
fn _chitra_image_decode_ctx(src, len, ctx, err_out): i64 {
    store64(err_out, 0);
    if (chitra_png_check_signature(src, len) == 1) {
        return _chitra_png_decode_ctx(src, len, ctx, err_out);
    }
    if (chitra_jpeg_check_signature(src, len) == 1) {
        return _chitra_jpeg_decode_ctx(src, len, ctx, err_out);
    }
    if (chitra_bmp_check_signature(src, len) == 1) {
        return _chitra_bmp_decode_ctx(src, len, ctx, err_out);
    }
    if (chitra_gif_check_signature(src, len) == 1) {
        return _chitra_gif_decode_ctx(src, len, ctx, err_out);
    }
    store64(err_out, chitra_err(CHITRA_ERR_SIGNATURE));
    return 0;
}
