# @public — chitra GIF decoder: GIF bytes -> canonical RGBA8 (first frame).
#
# gif.cyr — the block walk, the frame geometry, and the palette pass. LZW lives
# next door in gif_lzw.cyr.
#
# **This decodes the FIRST frame only.** GIF is the one format chitra handles
# that describes a *sequence* rather than an image, and `ChitraImage` has one
# `pixels` pointer, no frame count, and no delay. The reasoning, the cost, and
# the shape a future multi-frame surface would take are all in
# ADR 0005 (docs/adr/0005-gif-first-frame-only.md). The cost worth repeating
# here, because it is the one place this is visibly lossy: an *optimised*
# animation whose first frame is a background plate will decode to that plate,
# not to what a viewer shows.
#
# Four things about GIF framing that the LZW layer cannot tell you:
#
#   1. There are TWO geometries. The Logical Screen Descriptor gives the
#      canvas; each image descriptor gives a rect *within* it, at an (left,top)
#      offset. They are frequently equal and occasionally not.
#   2. There are TWO palettes. A Global Color Table applies unless an image
#      carries its own Local Color Table, which wins for that image only.
#   3. Transparency is not in the image — it is in a Graphic Control Extension
#      that PRECEDES the image descriptor, and it names a palette index.
#   4. Rows may be INTERLACED in four passes, on a different schedule from
#      PNG's Adam7 (GIF interlaces rows only; Adam7 interlaces both axes).
#
# Uncovered canvas — the area outside the first frame's rect — is emitted as
# **transparent** (alpha 0) rather than filled with the background color.
# chitra did not decode those pixels; alpha 0 says exactly that, where a
# background fill would assert a color the frame never specified.

var GIF_MAX_COLORS = 256;

# Output:input amplification ceiling, the GIF analogue of PNG's inflate ratio
# and JPEG's output:input cap. Without it a ~800-byte file declaring a
# 4096x4096 logical screen allocated ~67 MB of canvas that the bump allocator
# never reclaims.
#
# This one is DELIBERATELY looser than PNG's 1100:1, and the reason is worth
# stating rather than hiding in a round number: LZW's legitimate compression of
# degenerate content is close to the bomb ratio. One full dictionary cycle
# (codes 258..4095) encodes ~7.4 M identical pixels in ~5.8 KB, so a SOLID
# 4096x4096 GIF is a real ~13 KB file — about 5100:1. A PNG-tight cap would
# reject it. 16384:1 admits anything down to 4 KB, keeping ~3x headroom over
# that floor while still rejecting the observed 797-byte bomb by two orders of
# magnitude. The honest summary: this bounds the extreme case, not the merely
# aggressive one, because for LZW those are nearer together than for DEFLATE.
var CHITRA_MAX_GIF_RATIO = 16384;

# Block introducers (spec § 15-27).
var GIF_BLOCK_IMAGE     = 0x2C;   # Image Descriptor
var GIF_BLOCK_EXTENSION = 0x21;   # Extension Introducer
var GIF_BLOCK_TRAILER   = 0x3B;   # end of stream
var GIF_EXT_GRAPHIC_CTL = 0xF9;   # Graphic Control Extension (carries transparency)

fn _gif_u16_le(p): i64 {
    return load8(p) | (load8(p + 1) << 8);
}

# ================================================================
# chitra_gif_check_signature — 1 if the bytes open with "GIF87a" or "GIF89a".
# ================================================================
# @public
fn chitra_gif_check_signature(src, len): i64 {
    if (len < 6) { return 0; }
    if (load8(src + 0) != 0x47) { return 0; }    # 'G'
    if (load8(src + 1) != 0x49) { return 0; }    # 'I'
    if (load8(src + 2) != 0x46) { return 0; }    # 'F'
    if (load8(src + 3) != 0x38) { return 0; }    # '8'
    # '7' or '9' — GIF87a and GIF89a differ in features, not in framing, and
    # chitra reads only framing the two share.
    if (load8(src + 4) != 0x37) {
        if (load8(src + 4) != 0x39) { return 0; }
    }
    if (load8(src + 5) != 0x61) { return 0; }    # 'a'
    return 1;
}

# ================================================================
# Walk a sub-block chain (length byte + payload, terminated by a 0 length),
# copying the payload into `out` when it is non-zero. Returns the byte offset
# JUST PAST the terminator, or -1 if the chain runs off the end of the input.
#
# Every GIF payload of unbounded size — LZW data, comments, application data —
# is carried this way, so this one walk is both the skip path and the gather
# path. `out_cap` bounds the gather; the caller passes the input length, so a
# chain cannot make chitra hold more than the file itself.
# ================================================================
fn _gif_walk_blocks(src, len, pos, out, out_cap, written_out): i64 {
    var written = 0;
    var p = pos;
    var n = 0;
    var i = 0;
    var done = 0;
    var rc = 0;
    while (done == 0) {
        if (p >= len) { rc = 0 - 1; done = 1; }
        if (done == 0) {
            n = load8(src + p);
            p = p + 1;
            if (n == 0) {
                done = 1;                      # terminator
            } else {
                if (p + n > len) { rc = 0 - 1; done = 1; }
                if (done == 0) {
                    if (out != 0) {
                        if (written + n > out_cap) { rc = 0 - 1; done = 1; }
                        if (done == 0) {
                            i = 0;
                            while (i < n) {
                                store8(out + written + i, load8(src + p + i));
                                i = i + 1;
                            }
                            written = written + n;
                        }
                    }
                    if (done == 0) { p = p + n; }
                }
            }
        }
    }
    if (rc != 0) { return 0 - 1; }
    if (written_out != 0) { store64(written_out, written); }
    return p;
}

# GIF interlace: four passes over ROWS only (unlike PNG's Adam7, which
# subsamples both axes). Pass starts 0/4/2/1 with steps 8/8/4/2.
fn _gif_pass_start(p): i64 {
    if (p == 0) { return 0; }
    if (p == 1) { return 4; }
    if (p == 2) { return 2; }
    return 1;
}

fn _gif_pass_step(p): i64 {
    if (p == 0) { return 8; }
    if (p == 1) { return 8; }
    if (p == 2) { return 4; }
    return 2;
}

# ================================================================
# chitra_gif_decode — decode the FIRST frame of (src, len) into an owned RGBA8
# ChitraImage sized to the LOGICAL SCREEN. Returns the ChitraImage ptr, or 0
# with *err_out set. See ADR 0005 for the first-frame decision.
# ================================================================
# @public
fn chitra_gif_decode(src, len, err_out): i64 {
    store64(err_out, 0);
    if (chitra_gif_check_signature(src, len) == 0) {
        store64(err_out, chitra_err(CHITRA_ERR_SIGNATURE));
        return 0;
    }
    # 6-byte signature + 7-byte Logical Screen Descriptor.
    if (len < 13) {
        store64(err_out, chitra_err(CHITRA_ERR_TRUNCATED));
        return 0;
    }

    var screen_w = _gif_u16_le(src + 6);
    var screen_h = _gif_u16_le(src + 8);
    var packed = load8(src + 10);

    if (screen_w <= 0 || screen_h <= 0) {
        store64(err_out, chitra_err(CHITRA_ERR_DIMENSIONS));
        return 0;
    }
    if (screen_w > CHITRA_MAX_DIM || screen_h > CHITRA_MAX_DIM) {
        store64(err_out, chitra_err(CHITRA_ERR_DIMENSIONS));
        return 0;
    }
    if (screen_w * screen_h > CHITRA_MAX_PIXELS) {
        store64(err_out, chitra_err(CHITRA_ERR_DIMENSIONS));
        return 0;
    }

    var pos = 13;
    var gct_off = 0;
    var gct_n = 0;
    if ((packed & 0x80) != 0) {
        gct_n = 1 << ((packed & 7) + 1);
        gct_off = pos;
        if (pos + gct_n * 3 > len) {
            store64(err_out, chitra_err(CHITRA_ERR_GIF_PALETTE));
            return 0;
        }
        pos = pos + gct_n * 3;
    }

    # ---- block walk to the first image descriptor -----------------------
    # Extensions before it are skipped by their sub-block chain — which is
    # what makes an UNKNOWN extension harmless rather than a parse failure.
    # Only the Graphic Control Extension is read, for its transparent index.
    var transparent = 0 - 1;
    var found = 0;
    var walking = 1;
    var b = 0;
    var label = 0;
    var gce_packed = 0;
    var next = 0;
    var rcode = 0;

    while (walking == 1) {
        if (pos >= len) { rcode = CHITRA_ERR_GIF_NO_IMAGE; walking = 0; }
        if (walking == 1) {
            b = load8(src + pos);
            if (b == GIF_BLOCK_TRAILER) {
                rcode = CHITRA_ERR_GIF_NO_IMAGE;
                walking = 0;
            }
            if (walking == 1) {
                if (b == GIF_BLOCK_EXTENSION) {
                    if (pos + 2 > len) { rcode = CHITRA_ERR_TRUNCATED; walking = 0; }
                    if (walking == 1) {
                        label = load8(src + pos + 1);
                        if (label == GIF_EXT_GRAPHIC_CTL) {
                            # GCE layout (spec § 23): block size, packed,
                            # delay(2), transparent index, terminator. The
                            # block size is fixed at 4 and IS CHECKED — every
                            # field after it is addressed by a fixed offset, so
                            # a GCE declaring any other size would have chitra
                            # read the packed byte and the transparent index
                            # from bytes that are not those fields.
                            if (pos + 7 > len) { rcode = CHITRA_ERR_TRUNCATED; walking = 0; }
                            if (walking == 1) {
                                if (load8(src + pos + 2) != 4) {
                                    rcode = CHITRA_ERR_GIF_HEADER;
                                    walking = 0;
                                }
                            }
                            if (walking == 1) {
                                gce_packed = load8(src + pos + 3);
                                # A GCE applies to the graphic that FOLLOWS it,
                                # so the last one before the image descriptor
                                # governs — including one that turns
                                # transparency OFF. `transparent` is
                                # function-scoped, so it must be cleared
                                # explicitly; leaving it set let an earlier
                                # GCE's index survive a later GCE that revoked
                                # it, keying pixels the file said were opaque.
                                if ((gce_packed & 1) != 0) {
                                    transparent = load8(src + pos + 6);
                                } else {
                                    transparent = 0 - 1;
                                }
                            }
                        }
                        if (walking == 1) {
                            next = _gif_walk_blocks(src, len, pos + 2, 0, 0, 0);
                            if (next < 0) { rcode = CHITRA_ERR_TRUNCATED; walking = 0; }
                            if (walking == 1) { pos = next; }
                        }
                    }
                } else {
                    if (b == GIF_BLOCK_IMAGE) {
                        found = 1;
                        walking = 0;
                    } else {
                        # Not a legal block introducer at this position.
                        rcode = CHITRA_ERR_GIF_HEADER;
                        walking = 0;
                    }
                }
            }
        }
    }
    if (rcode != 0) { store64(err_out, chitra_err(rcode)); return 0; }
    if (found == 0) { store64(err_out, chitra_err(CHITRA_ERR_GIF_NO_IMAGE)); return 0; }

    # ---- image descriptor (10 bytes) ------------------------------------
    if (pos + 10 > len) {
        store64(err_out, chitra_err(CHITRA_ERR_TRUNCATED));
        return 0;
    }
    var fx = _gif_u16_le(src + pos + 1);
    var fy = _gif_u16_le(src + pos + 3);
    var fw = _gif_u16_le(src + pos + 5);
    var fh = _gif_u16_le(src + pos + 7);
    var ipacked = load8(src + pos + 9);
    pos = pos + 10;

    if (fw <= 0 || fh <= 0) {
        store64(err_out, chitra_err(CHITRA_ERR_DIMENSIONS));
        return 0;
    }
    # The frame rect must lie inside the canvas it claims to paint. A frame
    # hanging off the edge is malformed, not something to clamp — clamping
    # would silently decode a different image than the file describes.
    if (fx + fw > screen_w || fy + fh > screen_h) {
        store64(err_out, chitra_err(CHITRA_ERR_GIF_HEADER));
        return 0;
    }

    # Local color table wins over the global one, for this image only.
    var pal_off = gct_off;
    var pal_n = gct_n;
    if ((ipacked & 0x80) != 0) {
        pal_n = 1 << ((ipacked & 7) + 1);
        pal_off = pos;
        if (pos + pal_n * 3 > len) {
            store64(err_out, chitra_err(CHITRA_ERR_GIF_PALETTE));
            return 0;
        }
        pos = pos + pal_n * 3;
    }
    if (pal_n <= 0) {
        # Neither table present: the indices name nothing.
        store64(err_out, chitra_err(CHITRA_ERR_GIF_PALETTE));
        return 0;
    }

    var interlaced = 0;
    if ((ipacked & 0x40) != 0) { interlaced = 1; }

    # ---- LZW data: min code size byte, then the sub-block chain ----------
    if (pos >= len) {
        store64(err_out, chitra_err(CHITRA_ERR_TRUNCATED));
        return 0;
    }
    var min_code_size = load8(src + pos);
    pos = pos + 1;

    # Gather the sub-blocks. Bounded by the input length, so the compressed
    # side can never exceed the file.
    var comp = alloc(len);
    if (comp == 0) { store64(err_out, chitra_err(CHITRA_ERR_OOM)); return 0; }
    var comp_len = 0;
    next = _gif_walk_blocks(src, len, pos, comp, len, &comp_len);
    if (next < 0) {
        store64(err_out, chitra_err(CHITRA_ERR_TRUNCATED));
        return 0;
    }

    # ---- amplification cap ----------------------------------------------
    # Measured against `comp_len`, the LZW bytes actually gathered, NOT the
    # file length: appending ignored trailing junk after the trailer would
    # otherwise inflate the allowance and defeat the cap. Checked HERE, before
    # the index plane and the canvas are allocated — a cap that fires after the
    # allocation it is meant to prevent is decoration.
    #
    # The ratio bounds THE FRAME, which is what the LZW stream actually
    # expands into. It deliberately does NOT bound the logical screen.
    #
    # 0.5.3 shipped a second check that did — `screen_w * screen_h * 4` against
    # the same allowance — and it rejected valid files. An optimised animation
    # names a large canvas and paints a small first frame into it; that is the
    # normal shape of the format, not an attack. Measured: an 81-byte GIF with a
    # 1920x1080 logical screen, which ImageMagick reads without complaint, was
    # refused with CHITRA_ERR_DIMENSIONS, because the canvas needs 506 bytes of
    # allowance at 16384:1 and the whole file is 81.
    #
    # The canvas and the frame are different quantities and need different
    # bounds. A large canvas is not amplification — the file DECLARED those
    # dimensions, exactly as a PNG's IHDR declares its own, and the honest bound
    # is the same one PNG uses: CHITRA_MAX_DIM and CHITRA_MAX_PIXELS at the
    # screen-descriptor parse above, plus CHITRA_MAX_RAW_BYTES on the output
    # buffer below. A hostile GIF naming a 4096x4096 canvas and a 1x1 frame is
    # therefore capped at 64 MB rather than rejected, and it is the same
    # accepted risk PNG carries and SECURITY.md records: the bomb and the
    # legitimate image are the same file shape, so a ratio cannot separate them
    # and rejecting on one refuses real files.
    if (fw * fh > comp_len * CHITRA_MAX_GIF_RATIO) {
        store64(err_out, chitra_err(CHITRA_ERR_DIMENSIONS));
        return 0;
    }

    # ---- decompress to palette indices ----------------------------------
    var npix = fw * fh;
    var idx = alloc(npix);
    if (idx == 0) { store64(err_out, chitra_err(CHITRA_ERR_OOM)); return 0; }
    var got = _gif_lzw_decode(comp, comp_len, min_code_size, idx, npix, err_out);
    if (got < 0) { return 0; }
    # A stream that ends early is well-formed (see gif_lzw.cyr); the tail stays
    # at whatever the allocator gave us, so zero it rather than emit whatever
    # was there. Index 0 is a real palette entry, which is the honest choice:
    # the alternative is inventing a transparency the file never declared.
    var z = got;
    while (z < npix) { store8(idx + z, 0); z = z + 1; }
    # 0.7.0: remember whether the frame was actually filled. Zero-filling the
    # tail is the right DECODE, but returning it with no signal meant a caller
    # could not tell a complete frame from a prefix followed by palette entry 0
    # at full alpha — which is what a GIF truncated inside its sub-block chain
    # produces.
    var frame_complete = 1;
    if (got < npix) { frame_complete = 0; }

    # ---- canvas: logical screen, transparent where this frame paints nothing
    var out_size = screen_w * screen_h * 4;
    if (out_size > CHITRA_MAX_RAW_BYTES) {
        store64(err_out, chitra_err(CHITRA_ERR_DIMENSIONS));
        return 0;
    }
    var rgba = alloc(out_size);
    if (rgba == 0) { store64(err_out, chitra_err(CHITRA_ERR_OOM)); return 0; }
    var q = 0;
    while (q < out_size) { store8(rgba + q, 0); q = q + 1; }

    var pal = src + pal_off;
    var row = 0;
    var col = 0;
    var pass = 0;
    var src_row = 0;
    var dst_y = 0;
    var pi = 0;
    var pe = 0;
    var o = 0;

    if (interlaced == 0) {
        row = 0;
        while (row < fh) {
            col = 0;
            while (col < fw) {
                pi = load8(idx + row * fw + col);
                if (pi >= pal_n) {
                    store64(err_out, chitra_err(CHITRA_ERR_GIF_PALETTE));
                    return 0;
                }
                o = rgba + ((fy + row) * screen_w + (fx + col)) * 4;
                pe = pal + pi * 3;
                store8(o + 0, load8(pe + 0));
                store8(o + 1, load8(pe + 1));
                store8(o + 2, load8(pe + 2));
                if (pi == transparent) { store8(o + 3, 0); } else { store8(o + 3, 255); }
                col = col + 1;
            }
            row = row + 1;
        }
    } else {
        # Interlaced: consecutive decoded rows belong to the four passes in
        # turn, so the source row counter advances linearly while the
        # destination row jumps by the pass step.
        src_row = 0;
        pass = 0;
        while (pass < 4) {
            dst_y = _gif_pass_start(pass);
            while (dst_y < fh) {
                col = 0;
                while (col < fw) {
                    pi = load8(idx + src_row * fw + col);
                    if (pi >= pal_n) {
                        store64(err_out, chitra_err(CHITRA_ERR_GIF_PALETTE));
                        return 0;
                    }
                    o = rgba + ((fy + dst_y) * screen_w + (fx + col)) * 4;
                    pe = pal + pi * 3;
                    store8(o + 0, load8(pe + 0));
                    store8(o + 1, load8(pe + 1));
                    store8(o + 2, load8(pe + 2));
                    if (pi == transparent) { store8(o + 3, 0); } else { store8(o + 3, 255); }
                    col = col + 1;
                }
                src_row = src_row + 1;
                dst_y = dst_y + _gif_pass_step(pass);
            }
            pass = pass + 1;
        }
    }

    var img = alloc(CHITRA_IMAGE_SIZE);
    if (img == 0) { store64(err_out, chitra_err(CHITRA_ERR_OOM)); return 0; }
    store64(img + IMAGE_WIDTH_OFFSET, screen_w);
    store64(img + IMAGE_HEIGHT_OFFSET, screen_h);
    store64(img + IMAGE_PIXELS_OFFSET, rgba);
    store64(img + IMAGE_CHANNELS_OFFSET, 4);
    # 0.7.0 — the GIF analogue of PNG's IEND question: did the stream deliver
    # the frame it promised? Hardcoded to 1 through 0.6.1, so a truncated GIF
    # reported a clean end while handing back a prefix. chitra still returns
    # the partial image (ADR 0005's posture: decode what is there), but the
    # caller can now tell.
    store64(img + IMAGE_SEEN_IEND_OFFSET, frame_complete);
    # src_ctype sentinel: 0x300 | (bits per palette index). Distinct from PNG's
    # raw color_type, JPEG's 0x100 | ncomp, and BMP's 0x200 | bpp.
    store64(img + IMAGE_SRC_CTYPE_OFFSET, 768 + min_code_size);
    return img;
}

# ================================================================
# chitra_gif_decode_rgba8 — convenience wrapper, mirroring the other formats.
# ================================================================
# @public
fn chitra_gif_decode_rgba8(src, len, w_out, h_out): i64 {
    store64(w_out, 0);
    store64(h_out, 0);
    var err = 0;
    var img = chitra_gif_decode(src, len, &err);
    if (img == 0) { return 0; }
    store64(w_out, chitra_image_width(img));
    store64(h_out, chitra_image_height(img));
    return chitra_image_pixels(img);
}
