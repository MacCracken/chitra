# @internal — JPEG Huffman decode tables (0.3.0, bite 3).
# jpeg_huffman.cyr — the canonical Huffman decode-table representation and its
# construction from a DHT's BITS (code-length counts) + HUFFVAL (symbols). This
# module is frame-independent table machinery, so it is included BEFORE
# jpeg_markers.cyr (whose DHT parser drives the build into frame-owned storage).
# The entropy bit-reader, the DECODE procedure and _chitra_jpeg_decode_block all live
# in this module.
#
# Construction follows ITU-T T.81 Annex C (HUFFSIZE/HUFFCODE generation) folded
# into the Annex F figure F.15 decoder-table derivation (MINCODE/MAXCODE/VALPTR).
# The DECODE procedure (Annex F.2.2.3), implemented here as _chitra_jpeg_decode:
#   code = nextbit(); L = 1
#   while code > maxcode[L]: L += 1; code = (code << 1) | nextbit()
#   value = huffval[ valptr[L] + code - mincode[L] ]
# maxcode[L] == -1 marks "no codes of length L".

# ================================================================
# HuffTable record (i64 fields). One per table; 8 live in the frame (4 DC,
# 4 AC). Codes are at most 16 bits; symbols at most 256 (T.81 § B.2.4.2).
#   +0    mincode[0..16]   (17 i64) — smallest code of each length L
#   +136  maxcode[0..16]   (17 i64) — largest code of each length L (-1 = none)
#   +272  valptr[0..16]    (17 i64) — huffval index of first symbol of length L
#   +408  count            (1 i64)  — number of symbols (Σ BITS)
#   +416  huffval[0..255]  (256 i64)— symbol values, in DHT order
# ================================================================
var _CHITRA_HT_MINCODE = 0;
var _CHITRA_HT_MAXCODE = 136;    # 17*8
var _CHITRA_HT_VALPTR  = 272;    # 34*8
var _CHITRA_HT_COUNT   = 408;    # 51*8
var _CHITRA_HT_HUFFVAL = 416;    # 52*8
var _CHITRA_HT_SIZE    = 2464;   # (52 + 256) * 8

fn _chitra_jpeg_huff_mincode(t, L): i64 { return load64(t + _CHITRA_HT_MINCODE + L * 8); }
fn _chitra_jpeg_huff_maxcode(t, L): i64 { return load64(t + _CHITRA_HT_MAXCODE + L * 8); }
fn _chitra_jpeg_huff_valptr(t, L): i64  { return load64(t + _CHITRA_HT_VALPTR + L * 8); }
fn _chitra_jpeg_huff_count(t): i64      { return load64(t + _CHITRA_HT_COUNT); }
fn _chitra_jpeg_huff_val(t, i): i64     { return load64(t + _CHITRA_HT_HUFFVAL + i * 8); }

# ================================================================
# Build the MINCODE/MAXCODE/VALPTR decode arrays from BITS. `table` already has
# its HUFFVAL[] and COUNT filled by the caller; `bits` is a 17-i64 array with
# bits[L] = number of codes of length L (L in 1..16; index 0 unused).
#
# Canonical codes are consecutive integers per length, the whole space shifting
# left by one bit at each length step. Over-subscription (more codes than the
# length can hold) is rejected — the security-critical check that stops a
# malformed table from producing out-of-range code values. Returns 0 on success
# or CHITRA_ERR_JPEG_DHT.
# ================================================================
fn _chitra_jpeg_huff_build(table, bits): i64 {
    var z = 0;
    while (z <= 16) {
        store64(table + _CHITRA_HT_MINCODE + z * 8, 0);
        store64(table + _CHITRA_HT_MAXCODE + z * 8, 0 - 1);
        store64(table + _CHITRA_HT_VALPTR + z * 8, 0);
        z = z + 1;
    }
    var code = 0;
    var j = 0;          # running symbol index into HUFFVAL
    var L = 1;
    var cnt = 0;
    var rc = 0;
    var done = 0;
    while (done == 0) {
        if (L > 16) { done = 1; }
        if (done == 0) {
            cnt = load64(bits + L * 8);
            if (cnt > 0) {
                store64(table + _CHITRA_HT_VALPTR + L * 8, j);
                store64(table + _CHITRA_HT_MINCODE + L * 8, code);
                code = code + cnt - 1;                    # largest code of length L
                store64(table + _CHITRA_HT_MAXCODE + L * 8, code);
                if (code >= (1 << L)) { rc = CHITRA_ERR_JPEG_DHT; done = 1; }
                if (done == 0) {
                    code = code + 1;
                    j = j + cnt;
                }
            }
            if (done == 0) {
                code = code << 1;
                L = L + 1;
            }
        }
    }
    return rc;
}

# ================================================================
# Entropy bit-reader (T.81 § F.2.2 + § B.1.1.5 byte stuffing). MSB-first bit
# pull over the entropy-coded segment after SOS. A 0xFF in the stream is either
# followed by 0x00 (a stuffing byte to discard, the 0xFF is real data) or by a
# marker code (RSTn / EOI / ...), at which point the reader stops and records
# the marker; subsequent bit reads pad with zeros. The 72-byte record:
#   +0 base  +8 pos  +16 end  +24 buf (current byte)  +32 cnt (bits left in buf)
#   +40 marker (the marker byte after a 0xFF, or 0)
#   +48 eod — set when the reader needs a byte its span does not contain, which
#             is what distinguishes "ran out of scan" from a real EOI (0.7.0)
#   +56 rstnext — the n of the RSTn the next restart must find (1.1.1)
#   +64 damaged — set when the scan is structurally inconsistent although no
#             bit was fabricated: a restart marker out of sequence (1.1.1)
# ================================================================
var _CHITRA_BR_BASE   = 0;
var _CHITRA_BR_POS    = 8;
var _CHITRA_BR_END    = 16;
var _CHITRA_BR_BUF    = 24;
var _CHITRA_BR_CNT    = 32;
var _CHITRA_BR_MARKER = 40;
# +48 eod — set the moment the reader needs a byte the input does not contain.
# It is NOT the same question as _CHITRA_BR_MARKER: a scan that ends at a real EOI and
# a scan that simply runs out both leave the reader zero-padding, and only this
# flag tells them apart. That distinction is what lets a caller learn its JPEG
# was truncated (0.7.0), which it previously could not.
var _CHITRA_BR_EOD    = 48;
# ⛔ jpeg-6 (1.1.1) — T.81 § B.2.1 numbers restart markers modulo 8, and a scan
# whose markers do not follow that sequence has lost or repeated an interval.
# _chitra_jpeg_br_restart used to accept ANY D0..D7, so a duplicated interval decoded
# shifted by one interval, or every marker rewritten to D0, still reported
# seen_iend = 1 — djpeg says "found marker 0xd2 instead of RST3" for the same
# bytes. That is NOT fabrication, so it must not touch _CHITRA_BR_EOD (CLAUDE.md JPEG
# item 5: _CHITRA_BR_EOD is the fabrication point and nothing else); it has its own flag.
var _CHITRA_BR_RSTNEXT = 56;
var _CHITRA_BR_DAMAGED = 64;
var _CHITRA_BR_SIZE   = 72;

fn _chitra_jpeg_br_init(reader, base, len): i64 {
    store64(reader + _CHITRA_BR_BASE, base);
    store64(reader + _CHITRA_BR_POS, 0);
    store64(reader + _CHITRA_BR_END, len);
    store64(reader + _CHITRA_BR_BUF, 0);
    store64(reader + _CHITRA_BR_CNT, 0);
    store64(reader + _CHITRA_BR_MARKER, 0);
    store64(reader + _CHITRA_BR_EOD, 0);
    store64(reader + _CHITRA_BR_RSTNEXT, 0);
    store64(reader + _CHITRA_BR_DAMAGED, 0);
    return 0;
}

fn _chitra_jpeg_br_marker(reader): i64 { return load64(reader + _CHITRA_BR_MARKER); }
# 1 once the reader has had to fabricate bits because the input ran out.
fn _chitra_jpeg_br_eod(reader): i64    { return load64(reader + _CHITRA_BR_EOD); }
fn _chitra_jpeg_br_pos(reader): i64    { return load64(reader + _CHITRA_BR_POS); }
# 1 once a restart marker arrived out of its modulo-8 sequence (jpeg-6, 1.1.1).
fn _chitra_jpeg_br_damaged(reader): i64 { return load64(reader + _CHITRA_BR_DAMAGED); }

# Resync at a restart-interval boundary (T.81 § F.2.1.3.1 / E.1.1): discard the
# partial byte (byte-align), then consume the expected RSTn marker (FF D0..D7).
# After decoding `restart_interval` MCUs the stream is byte-aligned at an RSTn;
# _CHITRA_BR_POS points at its 0xFF (whether or not the bit-reader auto-detected it).
# Returns 0 on success (including "the span is exhausted" — see below), -1 if
# something other than a restart marker sits where one must be.
fn _chitra_jpeg_br_restart(reader): i64 {
    store64(reader + _CHITRA_BR_CNT, 0);
    var base = load64(reader + _CHITRA_BR_BASE);
    var pos = load64(reader + _CHITRA_BR_POS);
    var end = load64(reader + _CHITRA_BR_END);
    # ⛔ jpeg-5 (1.1.1) — THE SCAN RAN OUT, WHICH IS TRUNCATION, NOT CORRUPTION.
    # With the span exhausted there is no marker to consume and nothing wrong
    # with what was read, so this returns 0 and the caller resets the DC
    # predictors as at any restart. The next bit the decoder asks for cannot be
    # supplied, and `_chitra_jpeg_br_bit` sets _CHITRA_BR_EOD at that FABRICATION point, exactly
    # as for a truncated scan without DRI — so `seen_iend` comes back 0. Through
    # 1.1.0 this returned -1 and the decoder refused the file as
    # CHITRA_ERR_JPEG_ENTROPY, "corrupt entropy stream": a partial download of
    # any restart-interval JPEG (common from cameras and phones) was refused
    # outright, while the same cut without DRI decoded with seen_iend = 0 and
    # djpeg decodes both ("Premature end of JPEG file").
    if (pos >= end) { return 0; }
    # Skip 0xFF fill bytes (T.81 § B.1.1.2), leaving pos on the LAST 0xFF so
    # the marker code sits at pos+1.
    var skip = 1;
    while (skip == 1) {
        skip = 0;
        if (pos + 1 < end) {
            if (load8(base + pos) == 0xFF) {
                if (load8(base + pos + 1) == 0xFF) {
                    pos = pos + 1;
                    skip = 1;
                }
            }
        }
    }
    if (pos + 1 >= end) { return 0 - 1; }
    if (load8(base + pos) != 0xFF) { return 0 - 1; }
    var m = load8(base + pos + 1);
    if (m < 0xD0) { return 0 - 1; }
    if (m > 0xD7) { return 0 - 1; }
    # jpeg-6 (1.1.1): restart markers count D0..D7 modulo 8 (T.81 § B.2.1). A
    # marker out of sequence means an interval was lost or repeated. The decode
    # still resyncs on it — that is what a restart marker is for — but the scan
    # did not close cleanly, and the caller reports that through seen_iend.
    var want = load64(reader + _CHITRA_BR_RSTNEXT);
    if (m != 0xD0 + want) { store64(reader + _CHITRA_BR_DAMAGED, 1); }
    store64(reader + _CHITRA_BR_RSTNEXT, (want + 1) & 7);
    store64(reader + _CHITRA_BR_POS, pos + 2);
    store64(reader + _CHITRA_BR_MARKER, 0);
    return 0;
}

# 1 iff every entropy byte the reader has NOT consumed is part of a restart
# marker (jpeg-6, 1.1.1). Called once the last MCU of a scan has decoded: a
# well-formed scan ends with at most a partial byte of 1-bit padding, which the
# reader has already loaded, so nothing is left. Anything else — data bytes, or
# a stuffed FF 00 — is entropy data no MCU used: an interval repeated in the
# stream, or bytes spliced in before the marker that ends the scan. libjpeg
# reports it as "N extraneous bytes before marker". A trailing RSTn is tolerated
# because libjpeg is silent about one: it is a marker, not data.
fn _chitra_jpeg_br_tail_clean(reader): i64 {
    var base = load64(reader + _CHITRA_BR_BASE);
    var i = load64(reader + _CHITRA_BR_POS);
    var end = load64(reader + _CHITRA_BR_END);
    var clean = 1;
    var b = 0;
    var fill = 0;
    while (i < end) {
        b = load8(base + i);
        i = i + 1;
        if (b != 0xFF) {
            clean = 0;
            i = end;
        }
        if (b == 0xFF) {
            # Collapse a fill run (§ B.1.1.2) to the marker code it precedes.
            fill = 1;
            while (fill == 1) {
                fill = 0;
                if (i < end) {
                    if (load8(base + i) == 0xFF) {
                        i = i + 1;
                        fill = 1;
                    }
                }
            }
            b = 0;
            if (i < end) {
                b = load8(base + i);
                i = i + 1;
            }
            # Only an RSTn may follow; FF 00 is a stuffed DATA byte.
            if (b < 0xD0) {
                clean = 0;
                i = end;
            }
            if (b > 0xD7) {
                clean = 0;
                i = end;
            }
        }
    }
    return clean;
}

# Load one data byte (8 bits) into the buffer. Only called when CNT == 0. On a
# stuffing pair (FF 00) the 0xFF is loaded and the 0x00 discarded. On a marker
# (FF xx, xx != 0) or end-of-data, the marker is recorded (xx, or EOI for a
# trailing lone FF) and CNT is left 0 so callers pad with zero bits.
fn _chitra_jpeg_br_load_byte(reader): i64 {
    if (load64(reader + _CHITRA_BR_MARKER) != 0) { return 0; }
    var base = load64(reader + _CHITRA_BR_BASE);
    var pos = load64(reader + _CHITRA_BR_POS);
    var end = load64(reader + _CHITRA_BR_END);
    var b = 0;
    var b2 = 0;
    if (pos >= end) {
        store64(reader + _CHITRA_BR_EOD, 1);
        return 0;
    }
    b = load8(base + pos);
    pos = pos + 1;
    if (b == 0xFF) {
        # T.81 § B.1.1.2: a marker may be preceded by ANY number of 0xFF fill
        # bytes. Collapse the run so "FF FF D0" resolves to RST0 instead of a
        # bogus marker 0xFF — which made _chitra_jpeg_br_restart reject a perfectly
        # well-formed restart stream. `b` stays 0xFF (every byte in the run is
        # the same value), and pos-1 still points at the LAST 0xFF, which is
        # exactly where the restart resync expects to find it.
        var fill = 1;
        while (fill == 1) {
            fill = 0;
            if (pos < end) {
                if (load8(base + pos) == 0xFF) {
                    pos = pos + 1;
                    fill = 1;
                }
            }
        }
        if (pos >= end) {
            # A trailing 0xFF run with nothing after it. The EOI is synthesized,
            # not read — so this is end-of-data, not a clean close.
            store64(reader + _CHITRA_BR_MARKER, 0xD9);
            store64(reader + _CHITRA_BR_EOD, 1);
            store64(reader + _CHITRA_BR_POS, pos - 1);
            return 0;
        }
        b2 = load8(base + pos);
        if (b2 == 0x00) { pos = pos + 1; }     # stuffing — discard, keep 0xFF
        if (b2 != 0x00) {
            store64(reader + _CHITRA_BR_MARKER, b2);
            store64(reader + _CHITRA_BR_POS, pos - 1);  # leave pos at the 0xFF for resync
            return 0;
        }
    }
    store64(reader + _CHITRA_BR_BUF, b);
    store64(reader + _CHITRA_BR_CNT, 8);
    store64(reader + _CHITRA_BR_POS, pos);
    return 0;
}

# Read one bit MSB-first. Returns 0 past end / after a marker (zero padding).
fn _chitra_jpeg_br_bit(reader): i64 {
    var cnt = load64(reader + _CHITRA_BR_CNT);
    if (cnt == 0) {
        _chitra_jpeg_br_load_byte(reader);
        cnt = load64(reader + _CHITRA_BR_CNT);
    }
    # ⛔⛔ B-5 (1.0.3) — THE FABRICATION POINT, AND THEREFORE THE ONLY HONEST
    # PLACE TO SET _CHITRA_BR_EOD. Reaching here means a bit was asked for and the scan
    # could not supply it, so the zero returned below is invented. That is
    # precisely what _CHITRA_BR_EOD is defined to mean twenty lines above: "set the
    # moment the reader needs a byte the input does not contain."
    #
    # `_chitra_jpeg_br_load_byte` already set it for a span that simply ran out. What
    # it did NOT set it for was a LATCHED MARKER — and the only markers inside
    # a scan's span are RSTn, because _chitra_jpeg_entropy_span ends the span at the
    # first marker that is neither stuffing nor a restart. So an RSTn the
    # decoder never asked for (no DRI, DRI=0, or the wrong interval) latched,
    # every subsequent MCU was fabricated from zero bits, and `seen_iend` still
    # came back 1 — a positive assertion of a clean close over an image whose
    # bottom half is invented. Two bytes inserted mid-scan were enough.
    #
    # ⚠ Setting it at the latch instead would be wrong: a LEGITIMATE restart
    # also latches, and `_chitra_jpeg_br_restart` then consumes it and clears
    # _CHITRA_BR_MARKER. Nothing is fabricated on that path and it must keep reporting
    # a clean close. Fabrication, not latching, is the event worth recording.
    if (cnt == 0) {
        store64(reader + _CHITRA_BR_EOD, 1);
        return 0;
    }
    cnt = cnt - 1;
    store64(reader + _CHITRA_BR_CNT, cnt);
    return (load64(reader + _CHITRA_BR_BUF) >> cnt) & 1;
}

# RECEIVE: read n bits as an unsigned value (T.81 § F.2.2.4).
fn _chitra_jpeg_br_bits(reader, n): i64 {
    var v = 0;
    var i = 0;
    while (i < n) {
        v = (v << 1) | _chitra_jpeg_br_bit(reader);
        i = i + 1;
    }
    return v;
}

# EXTEND a value received with n bits to its signed coefficient (T.81 § F.2.2.1,
# figure F.12): values below 2^(n-1) are negative.
fn _chitra_jpeg_extend(v, n): i64 {
    if (n == 0) { return 0; }
    if (v < (1 << (n - 1))) {
        return v - (1 << n) + 1;
    }
    return v;
}

# DECODE a single Huffman-coded symbol (T.81 § F.2.2.3, figure F.16). Walks the
# maxcode table, extending the code one bit per length until it fits. Returns
# the symbol (0..255), or -1 on an undecodable code (no length matched, or an
# index outside the table's symbol list — incomplete-table defense).
fn _chitra_jpeg_decode(reader, table): i64 {
    var code = _chitra_jpeg_br_bit(reader);
    var L = 1;
    var maxc = _chitra_jpeg_huff_maxcode(table, 1);
    var done = 0;
    var bad = 0;
    while (done == 0) {
        if (code <= maxc) { done = 1; }
        if (done == 0) {
            L = L + 1;
            if (L > 16) { done = 1; bad = 1; }
            if (done == 0) {
                code = (code << 1) | _chitra_jpeg_br_bit(reader);
                maxc = _chitra_jpeg_huff_maxcode(table, L);
            }
        }
    }
    # The three refusals below back each other up (gate-4, 1.1.1): for a table
    # _chitra_jpeg_huff_build made from the BITS that also set its count, a code that
    # matches length L indexes inside the table, and one that matches no length
    # reaches L = 17, where the index checks refuse it. Neutering any one alone
    # is an equivalent mutant; they are defence in depth, kept deliberately.
    if (bad == 1) { return 0 - 1; }
    var idx = _chitra_jpeg_huff_valptr(table, L) + code - _chitra_jpeg_huff_mincode(table, L);
    if (idx < 0) { return 0 - 1; }
    if (idx >= _chitra_jpeg_huff_count(table)) { return 0 - 1; }
    return _chitra_jpeg_huff_val(table, idx);
}

# Decode one 8x8 block's 64 coefficients in zig-zag order into zz_out (64 i64,
# de-zig-zag is done at dequant). DC is differential against `pred`; AC uses
# run/size (RRRR/SSSS) coding with ZRL (16-zero run) and EOB (T.81 § F.2.2.2).
# Returns the new DC predictor value; on a corrupt stream sets *err_out to a
# CHITRA_ERR_JPEG_ENTROPY ChitraErr and returns 0.
fn _chitra_jpeg_decode_block(reader, dct, act, pred, zz_out, err_out): i64 {
    store64(err_out, 0);
    var i = 0;
    while (i < 64) { store64(zz_out + i * 8, 0); i = i + 1; }

    var t = _chitra_jpeg_decode(reader, dct);
    if (t < 0) { store64(err_out, chitra_err(CHITRA_ERR_JPEG_ENTROPY)); return 0; }
    # DC magnitude category: 0..11 for 8-bit baseline (T.81 Table F.1).
    if (t > 11) { store64(err_out, chitra_err(CHITRA_ERR_JPEG_ENTROPY)); return 0; }
    var diff = 0;
    if (t > 0) { diff = _chitra_jpeg_extend(_chitra_jpeg_br_bits(reader, t), t); }
    var dc = pred + diff;
    store64(zz_out + 0, dc);

    var k = 1;
    var rs = 0;
    var r = 0;
    var s = 0;
    var done = 0;
    while (done == 0) {
        if (k > 63) { done = 1; }
        if (done == 0) {
            rs = _chitra_jpeg_decode(reader, act);
            if (rs < 0) { store64(err_out, chitra_err(CHITRA_ERR_JPEG_ENTROPY)); done = 1; }
            if (done == 0) {
                r = (rs >> 4) & 15;
                s = rs & 15;
                # AC magnitude category: 0..10 for 8-bit baseline (T.81 Table F.2);
                # s==0 is EOB (r==0) or ZRL (r==15). s in 11..15 is out of spec.
                if (s > 10) { store64(err_out, chitra_err(CHITRA_ERR_JPEG_ENTROPY)); done = 1; }
            }
            if (done == 0) {
                if (s == 0) {
                    if (r == 15) {
                        # ZRL: a run of 16 zeros, filling k..k+15. Legal only
                        # while that run ends inside the block. Overrunning it
                        # is exactly as corrupt as the r-run overrun rejected
                        # below, and used to slip out of the loop as a CLEAN
                        # decode — a corrupt stream reported as success.
                        k = k + 16;
                        if (k > 64) {
                            store64(err_out, chitra_err(CHITRA_ERR_JPEG_ENTROPY));
                            done = 1;
                        }
                    }
                    if (r != 15) { done = 1; }     # EOB: remaining coeffs are zero
                }
                if (s != 0) {
                    k = k + r;
                    if (k > 63) { store64(err_out, chitra_err(CHITRA_ERR_JPEG_ENTROPY)); done = 1; }
                    if (done == 0) {
                        store64(zz_out + k * 8, _chitra_jpeg_extend(_chitra_jpeg_br_bits(reader, s), s));
                        k = k + 1;
                    }
                }
            }
        }
    }
    if (load64(err_out) != 0) { return 0; }
    return dc;
}
